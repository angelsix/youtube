<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: headers inside a real table (a header has no column outside one): resizable
       and fixed columns, a right-aligned header, and a hued table. Avalonia 12.1's TableView has no
       sorting, so there is no sorted state to show. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="TableViewColumnHeaderPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- Caption naming the states shown -->
      <TextBlock Text="Drag a column edge to resize" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <!-- Resizable columns; the last one right-aligns its header with its numbers -->
      <TableView Width="{size:SurfaceWidthLg}">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="140" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Group" Binding="{Binding ToolTip}" Width="80" HorizontalContentAlignment="Right" />
        </TableView.Columns>
        <NativeMenuItem Header="Zoom in" Gesture="Ctrl+Add" ToolTip="View" />
      </TableView>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Resizing turned off" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <!-- No grips: the header edges are plain hairlines -->
      <TableView Width="{size:SurfaceWidthLg}" CanUserResizeColumns="False">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="120" />
        </TableView.Columns>
        <NativeMenuItem Header="Zoom out" Gesture="Ctrl+Subtract" />
      </TableView>
      <!-- Caption naming the state shown. It names the hue the example below carries, so it
           takes that hue and the accent's text role -->
      <TextBlock Text="Headers follow the hue" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
      <!-- The header text and its hairlines take the table's hue -->
      <TableView Width="{size:SurfaceWidthLg}" theme:Accent.Kind="Warning">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="120" />
        </TableView.Columns>
        <NativeMenuItem Header="Delete" Gesture="Delete" />
      </TableView>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TableViewColumnHeader" Orientation="Vertical" ContentTemplate="{StaticResource TableViewColumnHeaderPreview}" />

    </Border>
  </Design.PreviewWith>
  <Orientation x:Key="TableViewColumnHeaderPreviewOrientation">Vertical</Orientation>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">

    <!-- Visual defaults: caption-weight text over the header bar's own fill, with the same
         right-hand hairline and padding as the cells beneath, so the columns line up -->
    <!-- No fill, not even Transparent: a hit-testable header would cover the grip half that overhangs it -->
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    <Setter Property="FontSize" Value="{size:FontSizeSm}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    <Setter Property="BorderBrush" Value="{color:AccentDividerDefault}" />
    <Setter Property="BorderThickness" Value="{size:Edges Right={size:ThicknessSmDouble}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPaddingWide}, Vertical={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="TableViewColumnHeader">
        <!-- Layout root overlapping the label and its resize grip -->
        <Panel>
          <!-- The column's name -->
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <!-- PART_Resizer: the grip dragged to resize the column -->
          <Thumb Name="PART_Resizer"
                 Theme="{StaticResource DefaultTableViewColumnResizer}"
                 IsEnabled="{Binding Column.CanUserEffectivelyResize, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=False}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Last column: the table's frame already closes it -->
    <Style Selector="^:nth-last-child(1)">
      <Setter Property="BorderThickness" Value="{size:Edges}" />
    </Style>

    <!-- Last column: its grip stays inside the column, as there is no next column to straddle -->
    <Style Selector="^:nth-last-child(1) /template/ Thumb#PART_Resizer">
      <Setter Property="Margin" Value="{size:Edges}" />
    </Style>

  </ControlTheme>

  <!-- Resize grip -->
  <ControlTheme x:Key="DefaultTableViewColumnResizer" TargetType="Thumb">

    <!-- Visual defaults: an invisible hit strip straddling the column's right hairline -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{size:SpacingLg}" />
    <Setter Property="Margin" Value="{size:Edges Right={size:Scaled Value={size:SpacingMd}, By=-1}}" />
    <!-- Theme Exception: the grip sits on the column's right edge; no alignment token means "the far edge" -->
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The grip's hit area -->
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: a column that cannot be resized shows no grip and changes no cursor -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
