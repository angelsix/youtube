<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default">
  <!-- Design preview: the pull indicator lives INSIDE the container that hosts it (task 140: the
       standalone RefreshVisualizer gallery entry is retired; its control theme stays). TWO columns,
       each example sized to fit inside the ~412px half-pane: the page must not scroll at 1200x800 -->
  <DataTemplate x:Key="RefreshContainerPreview">
    <UniformGrid Columns="2" ColumnSpacing="{size:SpacingXl}">
      <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
        <!-- Caption naming the states shown -->
        <TextBlock Text="Real use · pull to refresh" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The pull is touch or pen only, so the gallery can never start one: the arrow would sit
             there for ever, turning nothing. The arrow below runs its real cycle on its own instead
             (the looping demonstration in the first container's styles) -->
        <TextBlock Width="190"
                   Text="Pull is touch or pen only — the arrow loops its real cycle."
                   FontSize="{size:FontSizeSm}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />
        <!-- Real use: a fixed-size container wrapping a short scrollable list that fills the frame.
             Its spinner slot is sized down to the everyday glyph (part style below): the stock
             visualizer otherwise sizes itself to the container's pull dimension (100px+) and the
             container's idle pose lifts it UP by ITS HEIGHT, parking the resting arrow 126px clear
             of the frame (AVLG001 on every earlier capture). At the glyph size the lift stays
             inside the frame, so the resting arrow reads at the head of the list (task 140
             redirect) -->
        <RefreshContainer Width="190" Height="160" HorizontalContentAlignment="Stretch" ClipToBounds="True">
          <!-- Uses the container's own themed default visualizer. Assigning a bespoke one before the
               template realizes leaves the refresh deferral over-counted, so the headless crawl never
               sees it leave the Refreshing state (AVLG009). The default visualizer self-sizes to the
               pull dimension (100px) and escapes the frame, so it is clamped to the everyday glyph HERE,
               on the instance: a /template/ part style cannot reach it (the container inserts it after the
               template realizes), but an instance style re-applies on insertion. The slot's top margin
               keeps the resting arrow clear of the frame's top border -->
          <RefreshContainer.Styles>
            <!-- Clamp the default visualizer's BOX to the everyday glyph; a /template/ part style cannot reach
                 it because the container inserts it after the template realizes, but an instance style re-applies
                 on insertion. The inner arrow binds its size to the visualizer's raw height (the container forces
                 100px), so it is clamped too, or it overflows the frame (AVLG001) -->
            <Style Selector="RefreshVisualizer">
              <Setter Property="MaxWidth" Value="{size:IconSizeMd}" />
              <Setter Property="MaxHeight" Value="{size:IconSizeMd}" />
            </Style>
            <Style Selector="PathIcon">
              <Setter Property="MaxWidth" Value="{size:IconSizeMd}" />
              <Setter Property="MaxHeight" Value="{size:IconSizeMd}" />
            </Style>
            <!-- The pull-to-refresh gesture answers to touch and pen only, so the gallery can never
                 start one: without this the arrow sat there for ever, turning nothing (Luke, 21 Oct
                 2026). This style runs the arrow through its real cycle on its own — the pull's
                 rotation, the refreshing spin, and the return to rest — so a desktop user can see
                 what a pull looks like. It lives in the PREVIEW example only: the control theme
                 itself never animates the arrow, so the real control's behaviour is untouched -->
            <Style Selector="PathIcon#PART_Icon">
              <Style.Animations>
                <!-- Theme Exception: the literal duration is the demo cycle's own three-beat clock
                     (a pull, a refreshing spin, a return to rest), not one of the theme's generic
                     animation beats; a token would make the three phases impossible to place -->
                <Animation IterationCount="1000" Duration="0:0:3.2" FillMode="Both">
                  <!-- Pull: the arrow turns with the pull, one full turn as the content comes down -->
                  <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                  </KeyFrame>
                  <KeyFrame Cue="30%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                  </KeyFrame>
                  <!-- Refreshing: the arrow spins, as it does while the refresh runs -->
                  <KeyFrame Cue="85%">
                    <Setter Property="RotateTransform.Angle" Value="1080" />
                  </KeyFrame>
                  <!-- Return: the arrow settles back at rest (1080 degrees is three full turns, so
                       the pose at the end is the resting pose again) -->
                  <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="1080" />
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </RefreshContainer.Styles>
          <ScrollViewer>
            <!-- Inset lives on the content's Margin, never the viewer's Padding, so the last row scrolls fully into view -->
            <StackPanel Spacing="{size:SpacingMd}" Margin="{size:Edges All={size:SpacingMd}}">
              <TextBlock Text="First" />
              <TextBlock Text="Second" />
              <TextBlock Text="Third" />
              <TextBlock Text="Fourth" />
              <TextBlock Text="Fifth" />
              <TextBlock Text="Sixth" />
              <TextBlock Text="Seventh" />
              <TextBlock Text="Eighth" />
            </StackPanel>
          </ScrollViewer>
        </RefreshContainer>
        <!-- Caption naming the states shown -->
        <TextBlock Text="Indicator in the spinner slot" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The indicator in a REAL container, at the everyday glyph size. A bottom-to-top pull
             parks the indicator at the foot of the container, where the stock resting pull lifts it
             clear of the content, so the arrow reads inside the frame. Same themed default visualizer
             as above, clamped to the everyday glyph on the instance so it stays inside the frame -->
        <RefreshContainer Width="190" Height="120" PullDirection="BottomToTop" ClipToBounds="True">
          <!-- Same themed default visualizer as above, clamped to the everyday glyph on the instance for
               the same reason. This one pulls bottom-to-top, so its resting arrow sits at the foot of the
               list, clear of the top border either way -->
          <RefreshContainer.Styles>
            <!-- Same two-instance clamp as above: the default visualizer's box and its inner arrow, both to the
                 everyday glyph, so neither escapes the frame (AVLG001) while the deferral still completes -->
            <Style Selector="RefreshVisualizer">
              <Setter Property="MaxWidth" Value="{size:IconSizeMd}" />
              <Setter Property="MaxHeight" Value="{size:IconSizeMd}" />
            </Style>
            <Style Selector="PathIcon">
              <Setter Property="MaxWidth" Value="{size:IconSizeMd}" />
              <Setter Property="MaxHeight" Value="{size:IconSizeMd}" />
            </Style>
          </RefreshContainer.Styles>
          <ScrollViewer>
            <!-- Inset lives on the content's Margin, never the viewer's Padding, so the last row scrolls fully into view -->
            <StackPanel Spacing="{size:SpacingMd}" Margin="{size:Edges All={size:SpacingMd}}">
              <TextBlock Text="Pull up to refresh" />
            </StackPanel>
          </ScrollViewer>
        </RefreshContainer>
      </StackPanel>
      <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
        <!-- Caption naming the states shown -->
        <TextBlock Text="Live control · idle (16px)" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The live control at its native resting size. The stock idle pose pulls the arrow up by the
             control's height (the refresh animation's resting pull, task 130); the inner grid carries an
             equal opposing offset so the resting arrow lands dead-centre in its visual area -->
        <Border Width="190"
                Height="{size:Scaled Value={size:IconSizeMd}, By=3}"
                Padding="{size:Edges All={size:SpacingLg}}"
                ClipToBounds="True"
                Background="{color:BackgroundDefault}"
                BorderBrush="{color:BorderDefault}"
                BorderThickness="{size:ThicknessSm}"
                CornerRadius="{size:RadiusSm}">
          <Grid Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <!-- Theme Exception: literal offset cancels the stock idle-pull render transform
                 (mirrors the pinned 16px instance height); the motion itself belongs to task 130 -->
            <Grid.RenderTransform>
              <TranslateTransform X="0" Y="16" />
            </Grid.RenderTransform>
            <RefreshVisualizer Width="{size:IconSizeMd}"
                               Height="{size:IconSizeMd}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
          </Grid>
        </Border>
        <!-- Caption naming the states shown -->
        <TextBlock Text="Live control · 48px" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The same live control enlarged: the arrow grows with the control; the inner grid's opposing
             offset cancels the stock idle pull so the arrow rests dead-centre. The box matches the
             accent box's proportion (three glyph heights): short enough proportions push the
             countered grid past the bottom edge (AVLG001), so the headroom keeps its painted bounds
             inside the frame while the arrow still reads centred (task 140 redirect) -->
        <Border Width="190"
                Height="{size:Scaled Value={size:ControlHeightLg}, By=3}"
                Padding="{size:Edges All={size:SpacingLg}}"
                ClipToBounds="True"
                Background="{color:BackgroundDefault}"
                BorderBrush="{color:BorderDefault}"
                BorderThickness="{size:ThicknessSm}"
                CornerRadius="{size:RadiusSm}">
          <!-- Centre-aligned like the 16px box: the opposing offset then cancels the stock idle pull
               instead of stacking below the layout position (task 140 redirect) -->
          <Grid Width="{size:ControlHeightLg}" Height="{size:ControlHeightLg}" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <!-- Theme Exception: literal offset cancels the stock idle-pull render transform
                 (mirrors the pinned 48px instance height); the motion itself belongs to task 130 -->
            <Grid.RenderTransform>
              <TranslateTransform X="0" Y="48" />
            </Grid.RenderTransform>
            <RefreshVisualizer Width="{size:ControlHeightLg}"
                               Height="{size:ControlHeightLg}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
          </Grid>
        </Border>
        <!-- Caption naming the states shown -->
        <TextBlock Text="Follows the accent" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The arrow takes the control's own hue: two accents side by side; each inner grid's
             opposing offset cancels the stock idle pull so both arrows rest dead-centre -->
        <Border Width="190"
                Height="{size:Scaled Value={size:ControlHeightLg}, By=3}"
                Padding="{size:Edges All={size:SpacingLg}}"
                ClipToBounds="True"
                Background="{color:BackgroundDefault}"
                BorderBrush="{color:BorderDefault}"
                BorderThickness="{size:ThicknessSm}"
                CornerRadius="{size:RadiusSm}">
          <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <!-- Visual area: the icon's nominal square -->
            <Grid Width="{size:ControlHeightLg}" Height="{size:ControlHeightLg}">
              <!-- Theme Exception: literal offset cancels the stock idle-pull render transform
                   (mirrors the pinned 48px instance height); the motion itself belongs to task 130 -->
              <Grid.RenderTransform>
                <TranslateTransform X="0" Y="48" />
              </Grid.RenderTransform>
              <RefreshVisualizer Width="{size:ControlHeightLg}"
                                 Height="{size:ControlHeightLg}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 theme:Accent.Kind="Warning" />
            </Grid>
            <!-- Visual area: the icon's nominal square -->
            <Grid Width="{size:ControlHeightLg}" Height="{size:ControlHeightLg}">
              <!-- Theme Exception: literal offset cancels the stock idle-pull render transform
                   (mirrors the pinned 48px instance height); the motion itself belongs to task 130 -->
              <Grid.RenderTransform>
                <TranslateTransform X="0" Y="48" />
              </Grid.RenderTransform>
              <RefreshVisualizer Width="{size:ControlHeightLg}"
                                 Height="{size:ControlHeightLg}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 theme:Accent.Kind="Success" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </UniformGrid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="RefreshContainer" ContentTemplate="{StaticResource RefreshContainerPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type RefreshContainer}"
                TargetType="RefreshContainer">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the spinner over the content; clips the idle-raised visualizer to the frame -->
        <Grid ClipToBounds="True">
          <!-- The content being pulled to refresh -->
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <!-- The pull-to-refresh spinner, sized by the part style below -->
          <Grid Name="PART_RefreshVisualizerPresenter" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Spinner slot: centred over the content, raised only while refreshing. The container anchors it
         Top (pull-down) or Bottom (pull-up) itself and drives the visualizer's idle lift, so this style
         only sizes the slot and insets it from the border it rests against — the margin keeps the resting
         arrow clear of the frame's edge on BOTH ends (Luke: the indicator must not touch the top of its
         container, nor the bottom of it on a pull-up) -->
    <Style Selector="^ /template/ Grid#PART_RefreshVisualizerPresenter">
      <Setter Property="Width" Value="{size:ControlHeightLg}" />
      <Setter Property="Height" Value="{size:ControlHeightLg}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="{size:Edges All={size:SpacingLg}}" />
    </Style>

    <!-- The container's own themed default visualizer self-sizes to the pull dimension (100px); capping
         it to the everyday glyph keeps the resting lift inside the frame. It is routed through the default
         (never a bespoke instance assigned before the template realizes) so the refresh deferral completes
         headlessly — a pre-template custom visualizer leaves the deferral over-counted and the crawl stalls
         in the Refreshing state (AVLG009). The indicator is CENTRED in the slot: the slot is the container's
         own spinner place, so the arrow belongs in the middle of the frame, not against its left edge. This
         /template/ style DOES reach the indicator: the container adds the visualizer to the presenter it
         finds in its own template, so the visualizer is a child of this template's part (Luke, 21 Oct 2026 —
         the arrow used to float half a frame to the left, over the frame's edge) -->
    <Style Selector="^ /template/ Grid#PART_RefreshVisualizerPresenter RefreshVisualizer">
      <Setter Property="MaxWidth" Value="{size:IconSizeMd}" />
      <Setter Property="MaxHeight" Value="{size:IconSizeMd}" />
      <!-- Theme Exception: the indicator is a lone glyph in the middle of its slot, so it is centred
           there; the general control alignment would park it against the slot's left edge, where it
           reads as a stray mark rather than a spinner -->
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
