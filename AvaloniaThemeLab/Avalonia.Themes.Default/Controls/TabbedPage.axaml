<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: one strip shows the selectable states at once: index 0 selected (hue Dark3 underline
       on the divider, semibold text), middle unselected, last disabled. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="TabbedPagePreview">
    <Border Width="360" Height="240">
      <TabbedPage>
        <ContentPage Header="Home">
          <TextBlock Text="Home page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Favorites">
          <TextBlock Text="Favorites page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Profile" IsEnabled="False">
          <TextBlock Text="Profile page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
      </TabbedPage>
    </Border>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TabbedPage" Orientation="Horizontal" ContentTemplate="{StaticResource TabbedPagePreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- TabbedPage TabControl theme -->
  <ControlTheme x:Key="TabbedPageTabControlTheme" TargetType="TabControl">
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="CornerRadius" Value="0" />
    <!-- No frame of its own: the hosted page draws the ONE divider between the strip and the content,
         exactly as TabControl's content container draws it. A second line here would double the
         divider (the extra-thick rule Luke saw) and the page's own border would make a third. -->
    <Setter Property="BorderThickness" Value="{size:Edges}" />
    <Setter Property="Padding" Value="{size:Edges}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Docks the tab strip against the page -->
        <DockPanel>
          <!-- Outer frame around the tab strip -->
          <Border Name="PART_TabStrip"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Margin="0"
                  Padding="{TemplateBinding Padding}"
                  DockPanel.Dock="{TemplateBinding TabStripPlacement}">
            <!-- The row of tabs -->
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Spreads the tabs evenly across the strip -->
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </Border>
          <!-- Layout root cross-fading between pages -->
          <Panel ClipToBounds="True">
            <!-- The outgoing page, during a transition -->
            <ContentPresenter Name="PART_SelectedContentHost2"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="False" />
            <!-- The selected tab's page -->
            <ContentPresenter Name="PART_SelectedContentHost"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid,
           ^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid">
      <Setter Property="Rows" Value="0" />
      <Setter Property="Columns" Value="1" />
    </Style>
  </ControlTheme>

  <!-- TabbedPage TabItem theme -->
  <ControlTheme x:Key="TabbedPageTabItemTheme" TargetType="TabItem">
    <Setter Property="FontSize" Value="{size:FontSizeLg}" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}}" />
    <Setter Property="Margin" Value="{size:Edges}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightMd}" />
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Focus is the tab's own inset border: an outside ring is cut by the strip and page clips -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="IndicatorTemplate">
      <DataTemplate>
        <!-- Underline filling the pipe slot: the accent's selection indicator, the placement styles set its extent -->
        <Border Background="{color:AccentIndicatorDefault}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the tab; the item's padding rides on the header so the pipe can span the whole face -->
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Layout root stacking the pipe under the header -->
          <Panel>
            <!-- The face's padding rides on the header, so the pipe can span the whole tab face -->
            <Border Padding="{TemplateBinding Padding}"
                    HorizontalAlignment="{theme:ContainerHorizontalAlignment}"
                    VerticalAlignment="{theme:ContainerVerticalAlignment}">
              <!-- Stacks the icon above its label -->
              <StackPanel Name="PART_HeaderPanel"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <!-- The tab's icon -->
                <ContentPresenter Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"
                                  ContentTemplate="{TemplateBinding IconTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- The tab's label -->
                <ContentPresenter Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  FontFamily="{TemplateBinding FontFamily}"
                                  FontWeight="{TemplateBinding FontWeight}" />
              </StackPanel>
            </Border>
            <!-- Bar marking the selected tab: spans the whole tab face, hugging the page-side edge -->
            <ContentPresenter Name="PART_SelectedPipe"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Content="{TemplateBinding DataContext}"
                              ContentTemplate="{TemplateBinding IndicatorTemplate}"
                              IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Selected state: semibold label over the hue's underline -->
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Placement: the underline sits on the divider, the rounded corners face away from the page.
         Only the corners away from the line curve; the corners that meet it stay square, so the
         tab and the divider read as one piece (task 125's approach, per placement). -->
    <Style Selector="^[TabStripPlacement=Top] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: pipe hugs the bottom edge when the strip is on top; an edge-hugging alignment is intrinsic to the indicator, no token expresses it -->
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Height" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom]">
      <!-- The line runs along the top edge here, so the top pair is square and the bottom pair curves -->
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: pipe hugs the top edge when the strip is on the bottom; an edge-hugging alignment is intrinsic to the indicator, no token expresses it -->
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Height" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Right=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: pipe hugs the left edge, the page side when the strip is on the right; an edge-hugging alignment is intrinsic to the indicator, no token expresses it -->
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Width" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Left=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: pipe hugs the right edge, the page side when the strip is on the left; an edge-hugging alignment is intrinsic to the indicator, no token expresses it -->
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Width" Value="{size:SpacingSm}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="TextElement.Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Selected state: the selected row's tint. The tab is a selected row, so it takes the
         selected-row role (Light6) and not the outlined control's pressed fill (Light7): with the
         pressed fill the resting selection would wear exactly the colour a pressed UNSELECTED tab
         wears, and the two states would be indistinguishable. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{color:SelectedBackgroundDefault}" />
    </Style>

    <!-- Focus visible (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <!-- The focus weight equals the tab's resting weight (0), so focusing a tab never resizes it -->
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ StackPanel#PART_HeaderPanel">
      <Setter Property="Spacing" Value="{size:SpacingMd}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage">
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Theme Exception: the tab placement is a layout enum, not a theme token, and it is pinned here
         so the strip's side is a fact the theme can key on: the hosted page squares the edge that meets
         the tabs, and a selector needs a definite value to match. Auto would resolve to Top on desktop
         and Bottom on mobile, and the page's corners would follow the platform, not the theme. -->
    <Setter Property="TabPlacement" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root for the tabbed page -->
        <Panel Background="{TemplateBinding Background}">
          <!-- The tabs and their pages -->
          <TabControl Name="PART_TabControl"
                      Theme="{StaticResource TabbedPageTabControlTheme}"
                      ItemContainerTheme="{StaticResource TabbedPageTabItemTheme}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
