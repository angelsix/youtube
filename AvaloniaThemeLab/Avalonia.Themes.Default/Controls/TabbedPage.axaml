<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <!-- One strip shows the selectable states at once: index 0 selected (hue Dark3 underline on the divider, semibold text), middle unselected, last disabled. -->
      <default:LightDarkPreview Title="TabbedPage States" Orientation="Horizontal">
        <DataTemplate>
          <Border Width="360" Height="240">
            <TabbedPage>
              <ContentPage Header="Home">
                <TextBlock Text="Home page" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ContentPage>
              <ContentPage Header="Favorites">
                <TextBlock Text="Favorites page" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ContentPage>
              <ContentPage Header="Profile" IsEnabled="False">
                <TextBlock Text="Profile page" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ContentPage>
            </TabbedPage>
          </Border>
        </DataTemplate>
      </default:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- Backgrounds -->
  <!-- Theme-coloured states are setters on TabbedPageTabItemTheme: a {color:} brush here never sees a ThemeRegion or Accent.Kind -->
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundUnselected" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundDisabled" Color="Transparent" />


  <!-- Tab item sizing & shape -->

  <!-- Icon + text header layout -->

  <!-- Tab strip (bar) styling -->
  <SolidColorBrush x:Key="TabbedPageTabStripBackground" Color="Transparent" />

  <!-- TabbedPage TabControl theme -->
  <ControlTheme x:Key="TabbedPageTabControlTheme" TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource TabbedPageTabStripBackground}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:Edges Bottom={size:ThicknessSm}}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Docks the tab strip against the page -->
        <DockPanel>
          <!-- Outer frame around the tab strip -->
          <Border Name="PART_TabStrip"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Margin="0"
                  Padding="{TemplateBinding Padding}"
                  DockPanel.Dock="{TemplateBinding TabStripPlacement}">
            <!-- The row of tabs -->
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Spreads the tabs evenly across the strip -->
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </Border>
          <!-- Layout root cross-fading between pages -->
          <Panel ClipToBounds="True">
            <!-- The outgoing page, during a transition -->
            <ContentPresenter Name="PART_SelectedContentHost2"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="False" />
            <!-- The selected tab's page -->
            <ContentPresenter Name="PART_SelectedContentHost"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid,
           ^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid">
      <Setter Property="Rows" Value="0" />
      <Setter Property="Columns" Value="1" />
    </Style>

    <!-- Divider on the strip's page side -->
    <Style Selector="^[TabStripPlacement=Bottom]">
      <Setter Property="BorderThickness" Value="{size:Edges Top={size:ThicknessSm}}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="BorderThickness" Value="{size:Edges Right={size:ThicknessSm}}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="BorderThickness" Value="{size:Edges Left={size:ThicknessSm}}" />
    </Style>
  </ControlTheme>

  <!-- TabbedPage TabItem theme -->
  <ControlTheme x:Key="TabbedPageTabItemTheme" TargetType="TabItem">
    <Setter Property="FontSize" Value="{size:FontSizeXxl}" />
    <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundUnselected}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}, Vertical={size:SpacingMd}}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="{size:ControlHeightLg}" />
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Focus is the tab's own inset border: an outside ring is cut by the strip and page clips -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="IndicatorTemplate">
      <DataTemplate>
        <Border Background="{color:AccentBrush Dark3}"
                CornerRadius="0"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the pipe over the tab -->
        <Panel>
          <!-- Outer frame around the tab -->
          <Border Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- Stacks the icon above its label -->
            <StackPanel Name="PART_HeaderPanel"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <!-- The tab's icon -->
              <ContentPresenter Name="PART_IconPresenter"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <!-- The tab's label -->
              <ContentPresenter Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}" />
            </StackPanel>
          </Border>
          <!-- Bar marking the selected tab -->
          <ContentPresenter Name="PART_SelectedPipe"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding DataContext}"
                            ContentTemplate="{TemplateBinding IndicatorTemplate}"
                            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Selected state: semibold label over the hue's underline -->
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Placement: the underline sits on the divider, the rounded corners face away from the page -->
    <Style Selector="^[TabStripPlacement=Top] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: pipe sits at the bottom edge when the strip is on top. Luke to validate -->
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Height" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom]">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: top-edge pipe, strip on bottom. Luke to validate -->
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Height" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Right=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: left-edge pipe, the page side when the strip is on the right. Luke to validate -->
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Width" Value="{size:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Left=True}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: right-edge pipe, the page side when the strip is on the left. Luke to validate -->
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Width" Value="{size:SpacingSm}" />
    </Style>

    <!-- Pointer-over -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundDisabled}" />
      <Setter Property="TextElement.Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Focus visible -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ StackPanel#PART_HeaderPanel">
      <Setter Property="Spacing" Value="{size:SpacingMd}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontSize" Value="{size:FontSizeSm}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage">
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root for the tabbed page -->
        <Panel Background="{TemplateBinding Background}">
          <!-- The tabs and their pages -->
          <TabControl Name="PART_TabControl"
                      Theme="{StaticResource TabbedPageTabControlTheme}"
                      ItemContainerTheme="{StaticResource TabbedPageTabItemTheme}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
