<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- The item theme has no gallery entry of its own (task 137): the drop-down's rows are shown
       inside the ComboBox preview, where a user actually meets them. -->
  <!-- The declared reason for that (task 176): the gallery lists a control only when the theme
       gives it a {Name}Preview, so a control shown inside another entry would otherwise vanish
       from the gallery with no record of why. This marker IS the record: it names the entry that
       shows the row, and the gallery reads it as a deliberate exclusion. -->

  <default:PreviewShownIn x:Key="ComboBoxItemPreviewShownIn"
                           ShownIn="{x:Type ComboBox}"
                           Reason="A drop-down row is met inside the drop-down that holds it." />


  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Parallel to the drop-down's curved frame (Rule 19): the container's radius pulled in by its own padding and border.
         Inset = the 5px gap from the popup frame's bounds to the item (its 1px border + 4px padding); the frame's radius and border are the container's own tokens -->
    <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={size:RadiusMd}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled Value={size:SpacingMd}, By=1.25}}, All=True}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}, Vertical={size:SpacingLg}}" />
    <!-- A row in a drop-down fills the list's width, and so does its content: the highlight and hit area span the row, not the label -->
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <!-- Focus is the item's own inset border (below): an outset ring is cut by the popup's scroller and crosses its frame -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The item's label; its corners are the item's own concentric radius, carried straight through -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ^[(theme|Preview.State)=Hover] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ^[(theme|Preview.State)=Pressed] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Disabled state: the whole row fades, selected or not, so a chosen-but-unavailable item still reads as chosen -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Selected state: the outlined column, not the filled one — a light fill stage with default-weight text,
         so a chosen row reads as picked without going dark (Decision, 18 Oct 2026) -->
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:SelectedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ^:selected[(theme|Preview.State)=Hover] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:SelectedBackgroundHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Selected pressed state -->
    <Style Selector="^:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ^:selected[(theme|Preview.State)=Pressed] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:SelectedBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         It comes AFTER the selected styles, and repeats the selected combination, so a chosen row keeps
         its focus ring: the selected styles set BorderBrush to Transparent, and a rule that lands earlier
         is beaten by them, which left a selected row's keyboard focus invisible (AVLG031/AVLG033). -->
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     ^:selected:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
