<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:design="clr-namespace:Avalonia.Themes.Default.Design"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- The grips of a text field's selection: the START and END grips bracket the selection, the
       CARET grip marks a bare insertion point. The demo control below gives the field a REAL
       selection and seats the theme's own grips on the field's text geometry, so a drag on a grip
       moves the field's selection. -->
  <DataTemplate x:Key="TextSelectionHandlePreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- Sample data: literal text and a pinned selection (characters 4-15) are preview content, not theme values.
           Each field takes a MARGIN below it: the grips hang BELOW the field's line of text and are
           drawn on the control's own canvas, so they take no layout space of their own. The field
           reserves the room its grip needs inside itself (the demo control measures the grip), and
           this margin is the GAP on top of that: one spacing step between the grip's ink and the
           caption underneath, so a grip never paints over the text below it. -->
      <design:TextSelectionHandleDemo Width="360"
                                       Margin="{size:Edges Bottom={size:SpacingLg}}"
                                       Text="The quick brown fox jumps over the lazy dog"
                                       SelectionStart="4" SelectionEnd="15" />

      <!-- One caption per grip pair, naming what each one does -->
      <TextBlock Width="360" TextWrapping="Wrap"
                 FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"
                 Text="Start and end grips bracket the selection. Drag the end grip right to widen the selection, the start grip left to narrow it." />

      <!-- One line, no API names: what the grips are for -->
      <TextBlock Width="360" TextWrapping="Wrap" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"
                 Text="The grips of a text field's selection — the accent-coloured touches you grab with a finger, and the theme's own grip artwork." />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TextSelectionHandle" Orientation="Horizontal" ContentTemplate="{StaticResource TextSelectionHandlePreview}" />
    </Border>
  </Design.PreviewWith>

  <GeometryGroup x:Key="TextSelectionHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16"/>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,16"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>

  <GeometryGroup x:Key="TextCaretHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16">
          <RectangleGeometry.Transform>
            <TransformGroup >
              <RotateTransform CenterX="16"
                               Angle="-45"/>
            </TransformGroup>
          </RectangleGeometry.Transform>
        </RectangleGeometry>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,22.7"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>
  <ControlTheme x:Key="{x:Type TextSelectionHandle}"
                TargetType="TextSelectionHandle">
    <!-- The grip fill: the same solid accent face as the TextBox selection (task 48), so handles and selection agree.
         The solid-fill role (Dark3) is the theme's single spelling for a solid accent face, and it
         resolves against the same hue the TextBox's selection face does, so the two always agree. -->
    <Setter Property="Background"
            Value="{color:SolidFillDefault}" />
    <Setter Property="HorizontalAlignment"
            Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- Layout root stacking the grip over its hit area -->
          <Grid>
            <!-- Enlarged touch area around the grip -->
            <Border x:Name="PART_HitTarget" IsHitTestVisible="True" Background="Transparent">
              <!-- The grip artwork, filled from the control's own Background so it follows the pane and accent -->
              <Viewbox Name="PART_HandlePathIcon" Cursor="Arrow">
                <Path x:Name="PART_GripArtwork"
                      Data="{DynamicResource TextSelectionHandlePath}"
                      Fill="{TemplateBinding Background}"
                      Stroke="{TemplateBinding Background}"
                      StrokeThickness="{size:Scaled Value={size:ThicknessSmDouble}, By=0.5}"/>
              </Viewbox>
            </Border>
            <!-- The line joining the grip to the caret -->
            <Border Name="PART_Indicator"
                    HorizontalAlignment="Center"
                    Width="{size:ThicknessSmDouble}"
                    VerticalAlignment="Top"
                    Height="{size:Scaled Value={size:SpacingLg}, By=0.625}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:caret /template/ Path#PART_GripArtwork">
      <Setter Property="Data" Value="{DynamicResource TextCaretHandlePath}" />
    </Style>
    <Style Selector="^:start /template/ Viewbox#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1"/>
      </Setter>
    </Style>
    <!-- Theme Exception: caret/end/start indicators anchor centre/left/right. Luke to validate -->
    <Style Selector="^:caret /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:end /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- The same three shapes, keyed on the STANDALONE grip's own attached property.
         Avalonia's own handles reach these rules through the internal :start/:end/:caret
         pseudo-classes, which the framework re-derives on every arrange; a grip that stands on
         its own (the demo control's) carries the shape as an attached property instead, so the
         same artwork and the same indicator anchor are reached either way. -->
    <Style Selector="^[(design|GripShape.Shape)=Start] /template/ Path#PART_GripArtwork">
      <Setter Property="Data" Value="{DynamicResource TextSelectionHandlePath}" />
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=Start] /template/ Viewbox#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1"/>
      </Setter>
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=Start] /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=End] /template/ Path#PART_GripArtwork">
      <Setter Property="Data" Value="{DynamicResource TextSelectionHandlePath}" />
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=End] /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=Caret] /template/ Path#PART_GripArtwork">
      <Setter Property="Data" Value="{DynamicResource TextCaretHandlePath}" />
    </Style>
    <Style Selector="^[(design|GripShape.Shape)=Caret] /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ Border#PART_HitTarget">
      <Setter Property="Padding" Value="{size:Edges Bottom={size:SpacingXxl}}" />
    </Style>
    <Style Selector="^ /template/ Viewbox#PART_HandlePathIcon">
      <Setter Property="Height" Value="{size:ControlHeightSm}" />
    </Style>
    <!-- The indicator line takes the control's own Background -->
    <Style Selector="^ /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
