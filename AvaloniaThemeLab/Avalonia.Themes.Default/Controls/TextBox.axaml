<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: every input kind and state in one column. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="TextBoxPreview">
    <StackPanel Spacing="{size:SpacingLg}" HorizontalAlignment="Left">
      <TextBox Width="256" Text="Default" />
      <TextBox Width="256" theme:Preview.State="Hover" Text="Hover" />
      <TextBox Width="256" theme:Preview.State="Focused" Text="Focused" />
      <!-- Hue inherits down, so one instance proves both accent and focus together -->
      <TextBox Width="256" theme:Accent.Kind="Warning" theme:Preview.State="Focused" Text="Warning · Focused" />
      <TextBox Width="256" Text="Error">
        <DataValidationErrors.Error>
          <sys:Exception><x:Arguments><x:String>Error</x:String></x:Arguments></sys:Exception>
        </DataValidationErrors.Error>
      </TextBox>
      <TextBox Width="256" IsEnabled="False" Text="Disabled" />
      <TextBox Width="256" IsReadOnly="True" Text="Read only" />
      <TextBox Width="256" AcceptsReturn="True" TextWrapping="Wrap" Text="Multiline&#x0a;second line" />
      <TextBox Width="256" TextAlignment="Center" Text="Center aligned" />
      <TextBox Width="256" PlaceholderText="Empty with placeholder" />
      <TextBox Width="256" PlaceholderText="Floating placeholder" UseFloatingPlaceholder="True" />
      <TextBox Width="256" PlaceholderText="Floating placeholder" UseFloatingPlaceholder="True" Text="Floated over content" />
      <TextBox Width="256" Classes="clearButton" Text="Clear button" />
      <!-- Both passwords rest masked; the reveal affordance is proved by the crawler flipping the toggle (mask to plaintext, eye to eye-off) -->
      <TextBox Width="256" PasswordChar="*" Classes="revealPasswordButton" Text="Hidden password" />
      <TextBox Width="256" PasswordChar="*" Classes="revealPasswordButton" Text="Reveal password" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TextBox" ContentTemplate="{StaticResource TextBoxPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- Context fly-outs -->
  <MenuFlyout x:Key="DefaultTextBoxContextFlyout" ShowMode="{OnFormFactor Desktop=Standard, Mobile=Transient}">
    <MenuItem Header="Cut" Command="{Binding $parent[TextBox].Cut}" IsEnabled="{Binding $parent[TextBox].CanCut}" InputGesture="{x:Static TextBox.CutGesture}" />
    <MenuItem Header="Copy" Command="{Binding $parent[TextBox].Copy}" IsEnabled="{Binding $parent[TextBox].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}"/>
    <MenuItem Header="Paste" Command="{Binding $parent[TextBox].Paste}" IsEnabled="{Binding $parent[TextBox].CanPaste}" InputGesture="{x:Static TextBox.PasteGesture}"/>
  </MenuFlyout>
  <MenuFlyout x:Key="HorizontalTextBoxContextFlyout" ShowMode="{OnFormFactor Desktop=Standard, Mobile=Transient}" FlyoutPresenterTheme="{StaticResource HorizontalMenuFlyoutPresenter}" ItemContainerTheme="{StaticResource HorizontalMenuItem}">
    <MenuItem Header="Cut" Command="{Binding $parent[TextBox].Cut}" IsEnabled="{Binding $parent[TextBox].CanCut}" IsVisible="{Binding $parent[TextBox].CanCut}" />
    <MenuItem Header="Copy" Command="{Binding $parent[TextBox].Copy}" IsEnabled="{Binding $parent[TextBox].CanCopy}" IsVisible="{Binding $parent[TextBox].CanCopy}" />
    <MenuItem Header="Paste" Command="{Binding $parent[TextBox].Paste}" IsEnabled="{Binding $parent[TextBox].CanPaste}" />
  </MenuFlyout>

  <!-- Small frameless icon button seated in the field's right edge: the field's frame is its frame, so it
       follows that frame's right-hand curve, carries no face of its own, and pads by the field's padding so
       the icon sits where the text would -->
  <!-- ============================================================
       Glyph motion: ONE definition, shared by every glyph that grows on hover and
       shrinks on press (the field's clear and reveal buttons, the numeric field's
       clear button, and the spinner's up and down arrows).

       WHY A SHARED THEME: the motion must be the SAME mechanism everywhere — one
       pivot, one pair of scale factors, one duration — so a fix to one glyph is a
       fix to all of them, and a second definition can never drift from the first.

       THE PIVOT: RenderTransformOrigin is a RelativePoint. The RELATIVE form
       ("50%,50%") is the centre of the element; the ABSOLUTE form ("0.5,0.5") is a
       point 0.5 PIXELS from the top-left corner, so a glyph scaled about it grows
       down and right instead of outwards. This theme uses the relative form, so the
       glyph grows about its own centre.

       The motion rides the GLYPH, never the face: the face is the painted hit area
       and must hold still, or a grown glyph would be clipped by the field's edge.
       The part that carries it is named PART_Glyph, and it must be a template part
       of the control that hosts the glyph — a theme's style reaches its own
       template's parts, so the spinner's arrow reaches its arrow's own presenter
       through this same theme, and no arrow re-declares the motion.
       ============================================================ -->
  <ControlTheme x:Key="DefaultGlyphMotion" TargetType="Control">
    <!-- Resting glyph transform: identity, so the hover and press states below animate FROM here -->
    <Style Selector="^ /template/ ContentPresenter#PART_Glyph">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Hover: the glyph GROWS ~2px over its 16px rest size. TransformScale multiplies the token by
         By (scale = Value x By), so 0.98 x 1.153 ~= 1.13: a visibly-slight grow that reads at icon
         size where a whole-face scale was sub-pixel. The face holds still, so nothing clips. -->
    <Style Selector="^:pointerover:not(:disabled) /template/ ContentPresenter#PART_Glyph">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.153}" />
    </Style>
    <!-- Pressed: the glyph DIPS ~2.5px: 0.98 x 0.84 ~= 0.82. Deeper than the bare 0.94x sketch so
         the shrink beats the 1.5px proof bar even through headless sub-pixel rounding (16 -> 13.1),
         yet still reads as a quick settle, not a collapse. -->
    <Style Selector="^:pressed:not(:disabled) /template/ ContentPresenter#PART_Glyph">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=0.84}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DefaultTextBoxFieldIconButton" TargetType="Button" BasedOn="{StaticResource DefaultGlyphMotion}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The face: the painted, rounded hit area; it never scales, so a grown glyph is never clipped
             by the field's edge (the whole-button grow used to die under the field's clip) -->
        <Border Name="PART_Face"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The glyph: the only part that grows on hover and shrinks on press, so the motion reads
               clearly at icon size where a whole-face scale was sub-pixel -->
          <ContentPresenter Name="PART_Glyph"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- The glyph's grow/shrink is NOT declared here: it comes from DefaultGlyphMotion, the one
         definition every growing glyph in the theme shares (the spinner's arrows use the same one).
         What this theme owns is the FACE's own states, which the field's frame draws around it. -->
    <!-- Hover: the field's hover fill on the face -->
    <Style Selector="^:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>
    <!-- Pressed: the field's pressed fill on the face -->
    <Style Selector="^:pressed:not(:disabled)">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- Clear button inside the field, on the field-icon-button terms above -->
  <ControlTheme x:Key="DefaultTextBoxClearButton" TargetType="Button" BasedOn="{StaticResource DefaultTextBoxFieldIconButton}">
    <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={Binding $parent[TextBox].CornerRadius}, Thickness={Binding $parent[TextBox].BorderThickness}, Right=True}" />
  </ControlTheme>

  <!-- Reveal-password toggle inside the field: the same frameless face, and revealing keeps it frameless —
       the eye icon alone says the state, never a filled button face -->
  <ControlTheme x:Key="DefaultTextBoxRevealButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultTextBoxFieldIconButton}">
    <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={Binding $parent[TextBox].CornerRadius}, Thickness={Binding $parent[TextBox].BorderThickness}, Right=True}" />
    <Style Selector="^:checked">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="CaretBrush" Value="{color:AccentBorderDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <!-- Selected text: the filled column (Dark3 fill, Light10 ink), following the hue like every other state.
         The face and its ink come from the solid-fill policy ({color:SolidFillDefaultBrush} / {color:OnSolidFillInkDefaultBrush}), the
         same pair SelectableTextBlock and the checked controls use, so a bright-seeded hue takes its bright face -->
    <Setter Property="SelectionBrush" Value="{color:SolidFillDefaultBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{color:OnSolidFillInkDefaultBrush}" />
    <Setter Property="PlaceholderForeground" Value="{color:DimTextDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="ContextFlyout" Value="{OnFormFactor Desktop={StaticResource DefaultTextBoxContextFlyout}, Mobile={StaticResource HorizontalTextBoxContextFlyout}}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Rows: optional floating label, then the framed field -->
          <Grid RowDefinitions="Auto,*">
            <!-- Label that floats above the field (own row, so it never crowds the text); hidden unless the
                 field floats, so a plain field keeps its former size and position -->
            <TextBlock Grid.Row="0"
                       Name="PART_FloatingPlaceholder"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       Margin="{size:Edges All={size:SpacingMd}}"
                       FontSize="{size:FontSizeSm}"
                       IsVisible="False"
                       Text="{TemplateBinding PlaceholderText}" />

            <!-- Single frame border owning the field; content sits inside its stroke -->
            <Border Grid.Row="1"
                    Name="PART_BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}">
              <!-- Columns: leading content, text, trailing content -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Caller content pinned to the field's left edge -->
                <ContentPresenter Grid.Column="0"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding InnerLeftContent}"/>

                <!-- Scrolls the text when it overflows; the field's Padding is its Margin, and it paints nothing, so a
                     field with its own Background is one tone (the theme's viewer fill drew a lighter slab across the text) -->
                <ScrollViewer Grid.Column="1"
                              Name="PART_ScrollViewer"
                              Margin="{TemplateBinding Padding}"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                  <!-- Layout root stacking the prompt behind the text -->
                  <Panel>
                    <!-- Prompt shown while the field is empty; it stretches to the slot so TextAlignment operates over the whole field -->
                    <TextBlock Name="PART_Placeholder"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               Text="{TemplateBinding PlaceholderText}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>

                    <!-- The editable text and caret -->
                    <TextPresenter Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   LineHeight="{TemplateBinding LineHeight}"
                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                   PasswordChar="{TemplateBinding PasswordChar}"
                                   RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   CaretBrush="{TemplateBinding CaretBrush}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Panel>
                  <ScrollViewer.Styles>
                    <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                      <Setter Property="Cursor" Value="IBeam" />
                    </Style>
                  </ScrollViewer.Styles>
                </ScrollViewer>

                <!-- Caller content pinned to the field's right edge -->
                <ContentPresenter Grid.Column="2"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding InnerRightContent}"/>
              </Grid>
            </Border>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Named sub-element styles -->
    <Style Selector="^ /template/ TextBlock#PART_FloatingPlaceholder">
      <Setter Property="Cursor" Value="IBeam"/>
    </Style>

    <!-- Floating placeholder row reserved: a floating field keeps the label laid out (transparent while
         empty) so filling the field never changes its height; a plain field leaves it collapsed, so it
         keeps its former size and position -->
    <Style Selector="^[UseFloatingPlaceholder=true] /template/ TextBlock#PART_FloatingPlaceholder">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Placeholder opacity -->
    <Style Selector="^ /template/ TextBlock#PART_Placeholder">
      <Setter Property="Opacity" Value="{size:Scaled Value={size:DisabledOpacity}, By=1.667}" />
    </Style>

    <!-- Hover state: house outlined-field fill across the whole frame -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />

      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{color:OverlayWeakBrush}" />
        <Setter Property="BorderBrush" Value="{color:OverlayWeakBrush}" />
      </Style>
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus, ^[(theme|Preview.State)=Focused]">
      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      </Style>
    </Style>

    <!-- Error state -->
    <Style Selector="^:error /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{color:AccentErrorBrush}"/>
    </Style>

    <!-- Touch mode -->
    <Style Selector="^:touch-mode">
      <Setter Property="ContextFlyout" Value="{StaticResource HorizontalTextBoxContextFlyout}" />
    </Style>

    <!-- Floating placeholder shown: fade in over the reserved row (opacity, never visibility), so the
         field's height is identical empty and filled -->
    <Style Selector="^[UseFloatingPlaceholder=true]:not(:empty) /template/ TextBlock#PART_FloatingPlaceholder">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Reveal password button class -->
    <Style Selector="^.revealPasswordButton[AcceptsReturn=False][IsReadOnly=False]:not(TextBox:empty)">
      <Setter Property="InnerRightContent">
        <Template>
          <ToggleButton Theme="{StaticResource DefaultTextBoxRevealButton}"
                        IsChecked="{Binding $parent[TextBox].RevealPassword, Mode=TwoWay}"
                        ClipToBounds="True">
            <Panel>
              <PathIcon Data="{icons:Eye}"
                        Height="{size:IconSizeMd}" Width="{size:IconSizeMd}"
                        IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
              <PathIcon Data="{icons:EyeOff}"
                        Height="{size:IconSizeMd}" Width="{size:IconSizeMd}"
                        IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
            </Panel>
          </ToggleButton>
        </Template>
      </Setter>
    </Style>

    <!-- Clear button class: persists while there is text (never pops in on focus) -->
    <Style Selector="^.clearButton[AcceptsReturn=False][IsReadOnly=False]:not(TextBox:empty)">
      <Setter Property="InnerRightContent">
        <Template>
          <Button Theme="{StaticResource DefaultTextBoxClearButton}"
                  Command="{Binding $parent[TextBox].Clear}"
                  ClipToBounds="True">
            <PathIcon Data="{icons:Close}" Height="{size:IconSizeMd}" Width="{size:IconSizeMd}"/>
          </Button>
        </Template>
      </Setter>
    </Style>
  </ControlTheme>

  <!-- Error message of a frameless field: it sits inside the host's frame, so it keeps the text's inset clear of the
       frame's curved corners -->
  <ControlTheme x:Key="DefaultFramelessDataValidationErrors"
                TargetType="DataValidationErrors"
                BasedOn="{StaticResource {x:Type DataValidationErrors}}">
    <Style Selector="^ /template/ ContentControl#PART_ErrorIndicator">
      <Setter Property="Margin" Value="{size:Edges All={size:SpacingMd}}" />
    </Style>
  </ControlTheme>

  <!-- Frameless field: sits inside another control's frame, which draws every state (ComboBox, CalendarView picker) -->
  <ControlTheme x:Key="DefaultFramelessTextBox"
                TargetType="TextBox"
                BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <!-- One style per state the base theme paints: a comma list holding an always-true branch lost to them (measured) -->
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theme|Preview.State)=Hover] /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theme|Preview.State)=Focused] /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:error /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^ /template/ DataValidationErrors">
      <Setter Property="Theme" Value="{StaticResource DefaultFramelessDataValidationErrors}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
