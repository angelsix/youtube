<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- One cell of the gallery: the glyph at the everyday icon size, its name beneath it.
       The name sits a comfortable step below the glyph, so a caption reads as belonging to
       the icon above it -->
  <DataTemplate x:Key="IconsCell" x:DataType="default:IconEntry">
    <StackPanel Orientation="Vertical" Spacing="{size:SpacingMd}">
      <!-- The glyph itself, centred in the cell -->
      <PathIcon Data="{Binding Geometry}"
                Width="{size:IconSizeMd}"
                Height="{size:IconSizeMd}"
                HorizontalAlignment="Center" />
      <!-- The icon's name, so a cell can be looked up -->
      <TextBlock Text="{Binding Name}"
                 FontSize="{size:FontSizeSm}"
                 Foreground="{color:DimTextDefault}"
                 TextAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- Design preview: the whole set, one cell per icon the theme generates. The container takes
       the pane's own content width rather than a fixed one, so it never overflows the pane: when
       the pane narrows, the cells wrap to fewer columns instead of being clipped -->
  <!-- Stacked panes (Rule 20): the set needs width more than height, so the light and dark panes
       stack vertically and each lays the cells out across the full page width -->
  <Orientation x:Key="IconsPreviewOrientation">Vertical</Orientation>

  <DataTemplate x:Key="IconsPreview">
    <default:Icons />
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="Icons" ContentTemplate="{StaticResource IconsPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type default:Icons}" TargetType="default:Icons">

    <!-- Visual defaults. The glyphs take the ink from here, so they follow the accent the pane
         carries (the gallery's accent picker) rather than a pinned colour; the cell names use
         the dimmed text role, so they read as captions -->
    <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <!-- The frame breathes: the top and bottom edges step out as far as the rows step
         apart from each other, so the first glyph and the last caption sit the same
         distance from the border as one row sits from the next. The sides keep the
         ordinary content step, so the cells sit close to the frame's edges -->
    <Setter Property="Padding"
            Value="{size:Edges Top={size:Scaled Value={size:SpacingXxl}, By=1.5},
                              Bottom={size:Scaled Value={size:SpacingXxl}, By=1.5},
                              Left={size:ContentPadding},
                              Right={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- One cell per icon: the cell template, and the wrapping grid the cells sit in -->
    <Setter Property="ItemTemplate" Value="{StaticResource IconsCell}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <!-- Cells wrap onto a new row when the row is full; every cell is the same width, so
             the glyphs line up in columns. The cell is wide enough for the longest icon name.
             The rows are set far apart (an Xxl step and a half) so a caption reads as
             belonging to the glyph above it, not to the row below; the columns stay on a
             modest step so as many cells as fit the pane's width share each row -->
        <WrapPanel ItemSpacing="{size:SpacingMd}"
                   LineSpacing="{size:Scaled Value={size:SpacingXxl}, By=1.5}"
                   ItemWidth="{size:Scaled Value={size:ControlMinWidth}, By=2}" />
      </ItemsPanelTemplate>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The frame the icon cells sit in -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The wrapping grid of icon cells -->
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
