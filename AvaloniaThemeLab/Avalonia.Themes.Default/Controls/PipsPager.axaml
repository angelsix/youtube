<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: pip states from live selection/disabled properties. The designer and the lab gallery both show
       this key, so it is declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="PipsPagerPreview">
    <!-- Hover and pressed need pointer interaction -->
    <StackPanel Orientation="Vertical" Spacing="{size:SpacingXl}">
      <PipsPager NumberOfPages="5" SelectedPageIndex="2" />
      <PipsPager NumberOfPages="5" SelectedPageIndex="0" />
      <PipsPager NumberOfPages="5" SelectedPageIndex="4" />
      <PipsPager NumberOfPages="5" SelectedPageIndex="2" IsEnabled="False" />
      <PipsPager NumberOfPages="5" SelectedPageIndex="2" Orientation="Vertical" />
      <!-- Chevrons are hidden by default; shown here mid-range, faded out at the first/last page -->
      <StackPanel Orientation="Vertical" Spacing="{size:SpacingXl}">
        <PipsPager NumberOfPages="5" SelectedPageIndex="2" IsPreviousButtonVisible="True" IsNextButtonVisible="True" />
        <PipsPager NumberOfPages="5" SelectedPageIndex="0" IsPreviousButtonVisible="True" IsNextButtonVisible="True" />
        <PipsPager NumberOfPages="5" SelectedPageIndex="4" IsPreviousButtonVisible="True" IsNextButtonVisible="True" />
      </StackPanel>
      <!-- The arrows' half-strength grow and press, pinned so both states show without a pointer -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingXl}">
        <PipsPager NumberOfPages="5" SelectedPageIndex="2" theme:Preview.State="Hover" />
        <PipsPager NumberOfPages="5" SelectedPageIndex="2" theme:Preview.State="Pressed" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="PipsPager" Orientation="Vertical" ContentTemplate="{StaticResource PipsPagerPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Navigation button
       ============================================================ -->
  <ControlTheme x:Key="PipsPagerNavigationButtonTheme" TargetType="Button">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Square icon button, one icon-ladder step and a half wide -->
    <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=1.5}" />
    <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=1.5}" />
    <Setter Property="Padding" Value="0" />
    <!-- The glyph sits dead centre in the button, so the arrows read symmetrically around the pip strip -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The pip's shape -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state: a half-strength grow, like HyperlinkButton's (task 111) -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.045}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: a half-strength shrink, like HyperlinkButton's (task 111) -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.01}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>
  </ControlTheme>

  <!-- Previous button theme -->
  <ControlTheme x:Key="PipsPagerPreviousButtonTheme" TargetType="Button" BasedOn="{StaticResource PipsPagerNavigationButtonTheme}" />

  <!-- Next button theme -->
  <ControlTheme x:Key="PipsPagerNextButtonTheme" TargetType="Button" BasedOn="{StaticResource PipsPagerNavigationButtonTheme}" />

  <!-- ============================================================
       Pager item
       ============================================================ -->
  <ControlTheme x:Key="PipsPagerItemTheme" TargetType="ListBoxItem">
    <!-- Visual defaults -->
    <!-- One square pip-cell footprint on both axes, so the centre-to-centre pitch is the same in a row and a column -->
    <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=1.5}" />
    <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=1.5}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the pip over its backing -->
        <Grid Background="Transparent">
          <!-- Hit area behind the pip -->
          <Ellipse Name="PipBackground"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="Transparent"
                   Stroke="Transparent"
                   StrokeThickness="1" />
          <!-- The dot representing one page -->
          <Ellipse Name="Pip"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Pip default fill and transitions -->
    <Style Selector="^ /template/ Ellipse#PipBackground">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="{theme:AnimationNormalMs}" />
          <BrushTransition Property="Stroke" Duration="{theme:AnimationNormalMs}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{size:SpacingMd}" />
      <Setter Property="Height" Value="{size:SpacingMd}" />
      <Setter Property="Fill" Value="{color:AccentBrush Light1}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{theme:AnimationNormalMs}" />
          <DoubleTransition Property="Height" Duration="{theme:AnimationNormalMs}" />
          <BrushTransition Property="Fill" Duration="{theme:AnimationNormalMs}" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{size:SpacingLg}" />
      <Setter Property="Height" Value="{size:SpacingLg}" />
      <Setter Property="Fill" Value="{color:AccentGlyphDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{size:SpacingMd}" />
      <Setter Property="Height" Value="{size:SpacingMd}" />
      <Setter Property="Fill" Value="{color:AccentGlyphDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ Ellipse#Pip">
      <Setter Property="Fill" Value="{color:AccentBrush Light2}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{size:SpacingLg}" />
      <Setter Property="Height" Value="{size:SpacingLg}" />
      <Setter Property="Fill" Value="{color:AccentGlyphDefault}" />
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{size:SpacingLg}" />
      <Setter Property="Height" Value="{size:SpacingLg}" />
      <Setter Property="Fill" Value="{color:AccentGlyphDefault}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type PipsPager}" TargetType="PipsPager">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:SurfaceBorderless}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <!-- Breathing room around the whole control, and an even gap between the arrows and the dots -->
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPadding}}" />
    <!-- Hug the arrows and the dots; never stretch to the host's width -->
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="PreviousButtonTheme" Value="{StaticResource PipsPagerPreviousButtonTheme}" />
    <Setter Property="NextButtonTheme" Value="{StaticResource PipsPagerNextButtonTheme}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Rounded face painting the theme's recessed fill behind the arrows and the dots -->
        <Border Name="PART_RootPanel"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="False">
          <!-- Breathing room between the dots and the arrows -->
          <Border Padding="{TemplateBinding Padding}">
            <!-- Lays the arrows and the dot strip out in a row or column -->
            <StackPanel Orientation="{TemplateBinding Orientation}">
              <!-- Goes to the previous page -->
              <Button Name="PART_PreviousButton"
                      Theme="{TemplateBinding PreviousButtonTheme}"
                      IsVisible="{TemplateBinding IsPreviousButtonVisible}"
                      theme:Preview.State="{Binding (theme:Preview.State), RelativeSource={RelativeSource TemplatedParent}}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                <!-- The back arrow -->
                <PathIcon Name="PreviousButtonIcon"
                          Data="{icons:ChevronLeft}" />
              </Button>

              <!-- One dot per page, the current one selected -->
              <ListBox Name="PART_PipsPagerList"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden"
                       ItemsSource="{Binding TemplateSettings.Pips, RelativeSource={RelativeSource TemplatedParent}}"
                       SelectedIndex="{Binding SelectedPageIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                       AutoScrollToSelectedItem="False"
                       ClipToBounds="False"
                       ItemContainerTheme="{StaticResource PipsPagerItemTheme}">
                <ListBox.Styles>
                  <Style Selector="ScrollViewer">
                    <Setter Property="ClipToBounds" Value="False" />
                    <!-- One background throughout: the strip shows the face's recessed fill -->
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Lays the pips out in a row or column -->
                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=PipsPager}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="0" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>

              <!-- Goes to the next page -->
              <Button Name="PART_NextButton"
                      Theme="{TemplateBinding NextButtonTheme}"
                      IsVisible="{TemplateBinding IsNextButtonVisible}"
                      theme:Preview.State="{Binding (theme:Preview.State), RelativeSource={RelativeSource TemplatedParent}}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                <!-- The forward arrow -->
                <PathIcon Name="NextButtonIcon"
                          Data="{icons:ChevronRight}" />
              </Button>
            </StackPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Navigation icon sizes -->
    <Style Selector="^ /template/ PathIcon#PreviousButtonIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^ /template/ PathIcon#NextButtonIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Vertical navigation icons -->
    <Style Selector="^:vertical /template/ Button#PART_PreviousButton PathIcon#PreviousButtonIcon">
      <Setter Property="Data" Value="{icons:ChevronUp}" />
    </Style>
    <Style Selector="^:vertical /template/ Button#PART_NextButton PathIcon#NextButtonIcon">
      <Setter Property="Data" Value="{icons:ChevronDown}" />
    </Style>

    <!-- The strip's own extent, so it is big enough for its pips from the VERY FIRST layout.
         Avalonia's PipsPager sizes the strip from the pip cells it can already see; on the first
         layout there are none yet, so it falls back to a hard-coded 12px cell and sets the strip
         to pages × 12. This theme's pip cells are 24px, so the strip was first arranged at half
         the extent its pips need and the arrow at that end landed on top of the first and last
         pips — the overlap Luke saw on the first load into the Carousel page, which vanished a
         layout pass later. The floors below state the same extent the strip ends up with, so the
         first pass is already the right one. They are a MinWidth/MinHeight, not a Width/Height:
         the control owns the extent, and only this floor is the theme's to state. The horizontal
         pager's floor is a WIDTH and the vertical pager's is a HEIGHT — a strip that is as wide as
         it is tall would put the pips in a band instead of a line. -->

    <!-- The vertical pager stacks its pips, so its strip is sized by HEIGHT, not width. -->
    <Style Selector="^:vertical /template/ ListBox#PART_PipsPagerList">
      <Setter Property="MinHeight">
        <MultiBinding Converter="{x:Static default:PipsPagerStripExtentConverter.Instance}">
          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="NumberOfPages" />
          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="MaxVisiblePips" />
          <size:Scaled Value="{size:IconSizeMd}" By="1.5" />
        </MultiBinding>
      </Setter>
    </Style>

    <!-- The horizontal pager's strip is sized by WIDTH, and the same floor keeps the pips from
         being arranged in a band narrower than they need on the very first layout. -->
    <Style Selector="^:horizontal /template/ ListBox#PART_PipsPagerList">
      <Setter Property="MinWidth">
        <MultiBinding Converter="{x:Static default:PipsPagerStripExtentConverter.Instance}">
          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="NumberOfPages" />
          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="MaxVisiblePips" />
          <size:Scaled Value="{size:IconSizeMd}" By="1.5" />
        </MultiBinding>
      </Setter>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- First page state: the back arrow stays in the layout at zero opacity, so the control never changes size -->
    <Style Selector="^:first-page /template/ Button#PART_PreviousButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Last page state: the forward arrow stays in the layout at zero opacity, so the control never changes size -->
    <Style Selector="^:last-page /template/ Button#PART_NextButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
