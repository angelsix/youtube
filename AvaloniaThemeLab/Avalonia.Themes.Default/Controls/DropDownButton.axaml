<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: one column, every button the same fixed width, each carrying a flyout so a click drops something. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="DropDownButtonPreview">
    <!-- Every example carries a flyout so a click drops something. Each flyout opens BELOW the button,
         left-aligned (task 78): Placement is set on the flyout so the list hangs off the lower-left edge
         instead of centred over the face. -->
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <DropDownButton Width="240" Content="Default">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Width="240" theme:Preview.State="Hover" Content="Hover">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Width="240" theme:Preview.State="Pressed" Content="Pressed">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Width="240" theme:Preview.State="Focused" Content="Focused">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Width="240" IsEnabled="False" Content="Disabled" />
      <DropDownButton Width="240" theme:Accent.Kind="Warning" Content="Warn">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Width="240" theme:Accent.Kind="Success" Content="OK">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="First" />
            <MenuItem Header="Second" />
            <MenuItem Header="Third" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="DropDownButton" Orientation="Vertical" ContentTemplate="{StaticResource DropDownButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPaddingWide}, Vertical={size:ContentPadding}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- No grow/push transforms: behaves like ComboBox (fill-stage changes only). A hover scale on a
         control whose flyout opens over it feeds the pointer-over state back into the transition and
         flickers on release (task 78). -->

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the button -->
        <Border x:Name="RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Places the arrow right of the label -->
          <!-- Clips here, inside the stroke: a clip on the rounded frame cuts at r and shaves its own stroke -->
          <Grid ColumnDefinitions="*,Auto"
                ClipToBounds="True">

            <!-- The button's label -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <!-- The arrow marking this as a dropdown -->
            <PathIcon x:Name="DropDown"
                      Grid.Column="1"
                      UseLayoutRounding="False"
                      IsHitTestVisible="False"
                      Data="{icons:DropDown}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Drop-down glyph: the right margin equals the face's horizontal padding, so the arrow sits off the frame -->
    <Style Selector="^ /template/ PathIcon#DropDown">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:ContentPaddingWide}}" />
    </Style>

    <!-- Hover state: fill-stage change only (like ComboBox) — no grow/push transform, so the open flyout cannot feed the pointer-over state back into a transition -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Pressed state: fill-stage change only -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         Painted on the frame part, as Button does: the control's own border metrics stay put,
         so nothing relays the ring into the neighbour rows' layout -->
    <Style Selector="^:focus-visible /template/ Border#RootBorder, ^[(theme|Preview.State)=Focused] /template/ Border#RootBorder">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
