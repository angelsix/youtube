<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
    <!-- Focus adorner template -->
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <!-- The focus ring, just outside the control and following its corners -->
        <!-- Outset by its own width plus the halo's; the radius reads the focused control (AdornedElement) -->
        <Border Margin="{size:Edges All={size:Scaled Value={size:Thickness}, By=-3}}"
                BorderThickness="{size:ThicknessMd}"
                BorderBrush="{color:AccentBrush Dark1}"
                CornerRadius="{default:ConcentricCorners Radius={ReflectionBinding Path=(AdornerLayer.AdornedElement).CornerRadius, RelativeSource={RelativeSource Self}}, Thickness={ReflectionBinding Path=(AdornerLayer.AdornedElement).BorderThickness, RelativeSource={RelativeSource Self}}, Inset={ReflectionBinding Path=Margin, RelativeSource={RelativeSource Self}}, Stroke={ReflectionBinding Path=BorderThickness, RelativeSource={RelativeSource Self}}, All=True}">
          <!-- Light halo between the ring and the control -->
          <Border BorderThickness="{size:ThicknessSm}"
                  BorderBrush="{color:AccentBrush Light10}"
                  CornerRadius="{default:ConcentricCorners Radius={Binding $parent[Border].CornerRadius}, Thickness={Binding $parent[Border].BorderThickness}, Stroke={ReflectionBinding Path=BorderThickness, RelativeSource={RelativeSource Self}}, All=True}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
