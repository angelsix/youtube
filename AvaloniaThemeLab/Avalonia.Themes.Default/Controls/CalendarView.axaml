<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:design="clr-namespace:Avalonia.Themes.Default.Design"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
                    mc:Ignorable="d">
  <!-- Design preview: the shared state column, declared before Design.PreviewWith uses it. Cell states
       (:selected/:in-range/:today) derive from the engine's own selection model, not Preview.State —
       so each calendar packs its public options densely instead of multiplying instances -->
  <DataTemplate x:Key="CalendarViewPreview">
    <!-- Standard stacked-preview spacing (the SpacingXl every other stacked preview uses) -->
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- Default -->
      <controls:CalendarView HorizontalAlignment="Stretch" />

      <!-- One calendar carries every dense option at once: week-number gutter, event dots,
           a selected range (painting :in-range days), and the Primary hue tinting nav + selection.
           Left-aligned on purpose: the theme now keeps the card's desired width constant across
           display modes (the gutter placeholder holds the week-number column's width while the
           engine hides its labels), so clicking into year view must not narrow this example -->
      <controls:CalendarView x:DataType="design:CalendarViewDesignModel"
                             theme:Accent.Kind="Primary"
                             IsWeekNumberVisible="True"
                             SelectedDate="2026-09-18"
                             RangeStart="2026-09-14"
                             RangeEnd="2026-09-25"
                             DataContext="{x:Static design:CalendarViewDesignData.Sample}"
                             Events="{Binding Events}" />
      <!-- Picker chrome is a distinct surface (inline root, hover/focus rings). Fixed sample date so the
           typed value, its left padding and its centring are visible; fixed width matching the calendars above -->
      <controls:CalendarView DisplayAsPicker="True" theme:Accent.Kind="Subtle"
                             SelectedDate="2026-09-18" Width="268" />
      <!-- Same picker pinned focused: the concentric focus ring on the frame, centred on its stroke -->
      <controls:CalendarView DisplayAsPicker="True" theme:Accent.Kind="Subtle"
                             SelectedDate="2026-09-18" Width="268" theme:Preview.State="Focused" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="CalendarView" ContentTemplate="{StaticResource CalendarViewPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Header & Arrows
       ============================================================ -->
  <ControlTheme x:Key="DefaultCalendarViewNavButton" TargetType="Button">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingLg}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- A chevron centred in its button, not at the theme-wide Left content alignment -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation: rest transform none, tweened over the fast duration (same tokens as Button) -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The header label or a nav arrow -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Chevron arrows only (the .navarrow class): the header label and the picker arrow keep their
         rest size. Hover grows the chevron slightly, painting over its neighbours (Button's hover) -->
    <Style Selector="^.navarrow:pointerover">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: the chevron shrinks (Button's press) -->
    <Style Selector="^.navarrow:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
    </Style>

    <!-- Pressed ink dims while held -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Event marker strip
       ============================================================ -->
  <ControlTheme x:Key="DefaultCalendarMarkerStrip" TargetType="ItemsControl">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The dots themselves, no chrome at all -->
        <ItemsPresenter Name="PART_ItemsPresenter"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================
       Day cell
       ============================================================ -->
  <!-- The declared reason the day cell has no gallery entry of its own (task 176): a cell is met
       inside the calendar that holds it, and the CalendarView preview shows the grid. The gallery
       lists a control only when the theme gives it a {Name}Preview, so without this marker the cell
       would vanish from the gallery with no record of why. -->

  <default:PreviewShownIn x:Key="CalendarViewCellPreviewShownIn"
                           ShownIn="{x:Type controls:CalendarView}"
                           Reason="A day cell is met inside the calendar that holds it." />


  <ControlTheme x:Key="{x:Type controls:CalendarViewCell}" TargetType="controls:CalendarViewCell">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- A day, month or year sits in the middle of its cell and its selection disc, whatever the theme-wide content
         alignment is: the theme-wide Left (for text fields and dropdowns) put every number at its cell's left edge -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="FontSize" Value="{size:FontSizeMd}" />
    <!-- Tabular figures keep each digit's advance weight-stable, so switching a day to SemiBold on
         selection never nudges its centred number sideways -->
    <Setter Property="FontFeatures">
      <media:FontFeatureCollection>
        <media:FontFeature Tag="tnum" Value="1" />
      </media:FontFeatureCollection>
    </Setter>
    <!-- Tight tracking pulls a two-digit day's ink mass back towards the cell centreline: with tnum
         every digit earns the widest digit's advance, so '12' measures 18.14px (Normal) / 18.77px
         (SemiBold) yet its ink centroid sat +0.49px / +1.16px right of centre (measured headless,
         Inter 14px, 2026-10-18). Tracking subtracts equally from BOTH weights, so the pair keeps
         snapping to one shared box and the weight-stability guarantee survives: measured at -0.45,
         -0.5 and -0.55 both weights land on the same 18px box (centre delta 0.00px), whereas -0.25
         splits them 18px vs 19px and revives the 0.5px selection jump. Single digits lose only their
         TRAILING tracking slot: the glyph itself never moves (rendered pixels verified byte-identical
         before/after), so no visible offset arises. Raw double rather than a token: no spacing token
         sits at this sub-point magnitude. -->
    <Setter Property="LetterSpacing" Value="-0.5" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root: the filled cell plus a constant-footprint selection/focus ring laid over it -->
        <Panel>
          <!-- Filled background of the cell; its border stays at zero in every state so the inner
               panel (label + marker dots) never rearranges when selection or focus changes -->
          <Border Name="Fill"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <!-- Overlays the label and its marker dots -->
            <Panel>
              <!-- The day number, month or year label -->
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <!-- Row of event dots along the cell's bottom edge -->
              <ItemsControl Name="MarkerStrip"
                            Theme="{StaticResource DefaultCalendarMarkerStrip}"
                            ItemsSource="{TemplateBinding Markers}"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{size:SpacingSm}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Small enough that a selected day's concentric ring never touches the dot -->
                    <Ellipse Width="{size:SpacingMd}"
                             Height="{size:SpacingMd}"
                             Fill="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Border>
          <!-- Selection / keyboard-focus outline: a concentric overlay painted over the fill, occupying
               no layout space of its own so turning it on never displaces the label or the marker dots -->
          <Border Name="SelectionRing"
                  Margin="{size:ThicknessSm}"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Background="Transparent"
                  BorderThickness="{size:ThicknessMd}"
                  CornerRadius="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Stroke={size:ThicknessMd}, All=True}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Fill spacing: inset by default so day cells read as separate squares -->
    <Style Selector="^ /template/ Border#Fill">
      <Setter Property="Margin" Value="{size:ThicknessSm}" />
    </Style>

    <!-- Marker strip spacing: lifted off the bottom edge so the dots keep clear of the selection ring's
         inner stroke wherever it paints -->
    <Style Selector="^ /template/ ItemsControl#MarkerStrip">
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingMd}}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border#Fill">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Inactive state -->
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Today state -->
    <Style Selector="^:today /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>

    <!-- Preview band state -->
    <Style Selector="^:preview /template/ Border#Fill">
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="Margin" Value="{size:Edges Vertical={size:ThicknessSm}}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- In-range band state -->
    <Style Selector="^:in-range /template/ Border#Fill">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Margin" Value="{size:Edges Vertical={size:ThicknessSm}}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus state: reveal the concentric outline ring (the fill keeps its zero border) -->
    <Style Selector="^:day-focused /template/ Border#SelectionRing">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{color:AccentFocusBrush}" />
    </Style>

    <!-- Selected state: tint the fill and reveal the concentric outline ring -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Fill">
        <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      </Style>
      <Style Selector="^ /template/ Border#SelectionRing">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="BorderBrush" Value="{color:DimTextDefault}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
        <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
      </Style>
    </Style>

    <!-- Blackout state -->
    <Style Selector="^:blackout">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Fill">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>

    <!-- Day title class -->
    <Style Selector="^.title">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="FontSize" Value="{size:FontSizeSm}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      </Style>
    </Style>

    <!-- Zoom cell class -->
    <Style Selector="^.zoom">
      <Setter Property="MinHeight" Value="{size:ControlHeightMd}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type controls:CalendarView}" TargetType="controls:CalendarView">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingLg}}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HeaderBackground" Value="{color:BackgroundDefault}" />
    <Setter Property="MarkerBrush" Value="{color:AccentBorderDefault}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root overlaying the two presentations -->
        <Panel>
          <!-- The inline calendar card -->
          <Border Name="InlineRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- Rows: header, then the active presentation -->
            <Grid RowDefinitions="Auto,*">
              <!-- Header row: month label left, arrows right -->
              <Grid ColumnDefinitions="*,Auto,Auto"
                    Background="{TemplateBinding HeaderBackground}">
                <!-- Zooms out from month to year to decade -->
                <Button Name="PART_HeaderButton"
                        Theme="{StaticResource DefaultCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}"
                        Content="{TemplateBinding HeaderText}" />
                <!-- Goes to the previous month, year or decade -->
                <Button Name="PART_PreviousButton"
                        Classes="navarrow"
                        Grid.Column="1"
                        Theme="{StaticResource DefaultCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}">
                  <PathIcon Name="PreviousArrow"
                            Data="{icons:ChevronLeft}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
                </Button>
                <!-- Goes to the next month, year or decade -->
                <Button Name="PART_NextButton"
                        Classes="navarrow"
                        Grid.Column="2"
                        Theme="{StaticResource DefaultCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}">
                  <PathIcon Name="NextArrow"
                            Data="{icons:ChevronRight}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
                </Button>
              </Grid>
              <!-- Month and zoom presentations overlaid; swapped by the styles below -->
              <Panel Grid.Row="1">
                 <!-- Month grid: gutter column + seven day columns. Gutter labels are static parts the control
                      fills with text; day titles and cells are added into this grid by the control at runtime -->
                <Grid Name="PART_MonthBody"
                      ColumnDefinitions="Auto,*,*,*,*,*,*,*"
                      RowDefinitions="Auto,*,*,*,*,*,*">
                  <!-- Holds the week-number gutter's width while the engine hides its labels outside
                       month view: an always-measured spacer spanning the six day rows of column 0, so
                       the card's desired width never drops when clicked into year or decade view -->
                  <Border Name="GutterSpacer"
                          Grid.RowSpan="6" Grid.Row="1" Grid.Column="0"
                          IsHitTestVisible="False"
                          Background="Transparent" />
                  <TextBlock Classes="weeknumber" Grid.Row="1" Grid.Column="0" Focusable="False" />
                  <TextBlock Classes="weeknumber" Grid.Row="2" Grid.Column="0" Focusable="False" />
                  <TextBlock Classes="weeknumber" Grid.Row="3" Grid.Column="0" Focusable="False" />
                  <TextBlock Classes="weeknumber" Grid.Row="4" Grid.Column="0" Focusable="False" />
                  <TextBlock Classes="weeknumber" Grid.Row="5" Grid.Column="0" Focusable="False" />
                  <TextBlock Classes="weeknumber" Grid.Row="6" Grid.Column="0" Focusable="False" />
                </Grid>
                <!-- The grid of months or years when zoomed out -->
                <UniformGrid Name="PART_ZoomGrid"
                             Columns="4" />
              </Panel>
            </Grid>
          </Border>

          <!-- The picker presentation: text box and open button -->
          <Border Name="PickerRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{size:ControlHeightSm}"
                  IsVisible="False">
            <!-- Places the open button right of the text -->
            <Grid ColumnDefinitions="*,Auto">
              <!-- The date, typed or filled from the calendar -->
              <!-- Frameless: the picker's own frame draws every state -->
              <TextBox Name="PART_TextBox"
                       Theme="{StaticResource DefaultFramelessTextBox}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="{theme:ControlVerticalAlignment}" />
              <!-- Opens the calendar popup -->
              <Button Name="PART_PickerButton"
                      Grid.Column="1"
                      Theme="{StaticResource DefaultCalendarViewNavButton}"
                      Foreground="{TemplateBinding Foreground}"
                      Focusable="False">
                <PathIcon Name="PickerArrow"
                            Data="{icons:ChevronDown}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
              </Button>
            </Grid>
          </Border>

          <!-- Keyboard-focus outline for the inline card: a concentric overlay stretched to the control's
               bounds and inset by its own margin so its stroke centres on the frame's inner edge. Revealed
               on :focus-visible; constant footprint, so focusing never resizes the control or shifts content -->
          <Border Name="InlineFocusRing"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Background="Transparent"
                  BorderBrush="{color:AccentFocusBrush}"
                  BorderThickness="{size:ThicknessMd}"
                  Margin="{size:ThicknessSm}"
                  CornerRadius="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Stroke={size:ThicknessMd}, All=True}" />
          <!-- Focus outline for the picker frame, revealed on :picker:focus-within; centred on the frame's
               stroke (no inset margin) so no grey frame pixel shows outside the ring -->
          <Border Name="PickerFocusRing"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Background="Transparent"
                  BorderBrush="{color:AccentFocusBrush}"
                  BorderThickness="{size:ThicknessMd}"
                  CornerRadius="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Inset={ReflectionBinding Path=Margin, RelativeSource={RelativeSource Self}}, Stroke={size:ThicknessMd}, All=True}" />

          <!-- The calendar shown when picking from the text box -->
          <Popup Name="PART_Popup"
                 PlacementTarget="{TemplateBinding}"
                 IsLightDismissEnabled="True">
            <!-- The same control, inline, driving the same selection -->
            <controls:CalendarView Name="PopupCalendar"
                          DisplayAsPicker="False"
                          SelectionMode="{TemplateBinding SelectionMode}"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          MinDate="{TemplateBinding MinDate}"
                          MaxDate="{TemplateBinding MaxDate}"
                          IsDateDisabled="{TemplateBinding IsDateDisabled}"
                          Markers="{TemplateBinding Markers}"
                          Events="{TemplateBinding Events}"
                          IsWeekNumberVisible="{TemplateBinding IsWeekNumberVisible}"
                          WeekNumberRule="{TemplateBinding WeekNumberRule}"
                          SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}"
                          RangeStart="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RangeStart, Mode=TwoWay}"
                          RangeEnd="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RangeEnd, Mode=TwoWay}" />
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Header button text -->
    <Style Selector="^ /template/ Button#PART_HeaderButton">
      <Setter Property="FontSize" Value="{size:FontSizeLg}" />
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>

    <!-- Picker text box: MinWidth sized off the date typeface; content padding matches every other field -->
    <Style Selector="^ /template/ TextBox#PART_TextBox">
      <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPadding}, Vertical={size:SpacingMd}}" />
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <Setter Property="MinWidth" Value="{size:Scaled Value={size:FontSizeMd}, By=8}" />
    </Style>

    <!-- Zoom grid: invisible in month view; hit-testing off so it steals no clicks -->
    <Style Selector="^ /template/ UniformGrid#PART_ZoomGrid">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Zoomed-out views: swap to the zoom grid without collapsing the month block -->
    <Style Selector="^:year, ^:decade">
      <Style Selector="^ /template/ UniformGrid#PART_ZoomGrid">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Grid#PART_MonthBody">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
    </Style>

    <!-- Week number labels: static template parts, styled like any other themed node -->
    <!-- No FontStyle=Italic here: on macOS the first slanted request for the hidden .AppleSystemUIFont makes
         CoreText refuse that name for the rest of the process, so every font resolved afterwards falls back
         to Helvetica (measured 25 September 2026: 13px lines instead of 16px once a calendar had opened). -->
    <Style Selector="^ /template/ TextBlock.weeknumber">
      <Setter Property="FontSize" Value="{size:FontSizeSm}" />
      <Setter Property="FontWeight" Value="{theme:FontWeightBold}" />
      <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
      <!-- Theme Exception: Centres the week number in its gutter column; the theme's horizontal content
           alignment is Left (text fields), which would hug the number to the column edge -->
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingSm}}" />
    </Style>

    <!-- Gutter width once week numbers switch on -->
    <Style Selector="^:hasweeknumbers /template/ TextBlock.weeknumber">
      <Setter Property="MinWidth" Value="{size:Scaled Value={size:FontSizeSm}, By=2}" />
    </Style>

    <!-- Gutter spacer: the engine hides the week-number LABELS outside month view (IsVisible=False),
         which would empty the Auto gutter column and drop the card's desired width. The spacer keeps
         measuring the same slot in every display mode, so a Left-aligned calendar holds its month-view
         width through year and decade alike. Sized off the SAME tokens as the labels above (their
         MinWidth plus their left Margin), so the gutter it holds is exactly the labels' own width. -->
    <Style Selector="^:hasweeknumbers /template/ Border#GutterSpacer">
      <Setter Property="MinWidth" Value="{size:Scaled Value={size:FontSizeSm}, By=2}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingSm}}" />
    </Style>

    <!-- Picker presentation -->
    <Style Selector="^:picker">
      <Style Selector="^ /template/ Border#InlineRoot">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#PickerRoot">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <!-- Picker hover state -->
    <Style Selector="^:picker:pointerover /template/ Border#PickerRoot">
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state: reveal the inline card's concentric outline; the frame keeps its rest thickness -->
    <Style Selector="^:focus-visible /template/ Border#InlineFocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Picker focus state: reveal the picker frame's concentric outline; the frame keeps its rest thickness.
         Paired with the Preview.State hook so a pinned Focused preview paints the same ring (house pattern) -->
    <Style Selector="^:picker:focus-within /template/ Border#PickerFocusRing, ^[(theme|Preview.State)=Focused] /template/ Border#PickerFocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
