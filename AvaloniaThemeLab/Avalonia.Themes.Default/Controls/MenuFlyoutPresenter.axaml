<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- The declared reason this control has no gallery entry of its own (task 176): the flyout
       surface is met inside the menus that open it — the ContextMenu preview shows the framed
       surface, and the Menu preview's File drop-down shows the hosted-flyout panel. The gallery
       lists a control only when the theme gives it a {Name}Preview, so without this marker the
       surface would vanish from the gallery with no record of why. -->

  <default:PreviewShownIn x:Key="MenuFlyoutPresenterPreviewShownIn"
                           ShownIn="{x:Type ContextMenu}"
                           Reason="The flyout surface is met inside the menus that open it." />

  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Even inset all round (matches ComboBox's popup); the list's own rows carry their padding -->
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="MaxWidth" Value="{size:Scaled Value={size:BaseSize}, By=456}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <!-- Disable horizontal scrolling so the scroller hands the list a finite width and every row stretches to it (as ComboBox's popup does) -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <!-- A flyout surface fills its allotted width (as ComboBox's popup does); that finite width is what lets every row stretch -->
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- A button's drop-down opens at the button's own width, not at its content's width (task 109).
         The presenter is created in code by the flyout and lives in the popup's host, so the button
         cannot size it from its own template; the presenter reaches the button through the popup
         that hosts it (its logical parent) and that popup's placement target. Only a button's
         flyout is sized this way: a text field's context menu keeps the width its content asks for. -->
    <Setter Property="MinWidth"
            Value="{Binding $parent[Popup].PlacementTarget, Converter={x:Static default:FlyoutPlacementTargetWidthConverter.Instance}}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Panel behind the menu -->
        <Border Name="LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Scrolls the menu when it overflows -->
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        Theme="{StaticResource DefaultMenuScrollViewer}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <!-- The menu entries -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"
                            Grid.IsSharedSizeScope="True" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- The menu scroller fills the frame (its own theme left-aligns it); that finite width is what lets every row stretch -->
    <Style Selector="^ /template/ ScrollViewer">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="HorizontalMenuFlyoutPresenter" TargetType="MenuFlyoutPresenter"  BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
    <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
