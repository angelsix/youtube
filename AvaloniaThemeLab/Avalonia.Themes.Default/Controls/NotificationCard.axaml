<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: the Normal card, then one card per NotificationType severity. The designer and the lab
       gallery both show this key, so it is declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="NotificationCardPreview">
    <!-- The Normal card comes first: it has no severity of its own, so it takes the hue the pane's
         accent picker selects. Avalonia has no 'normal' NotificationType - a card with no type IS an
         Information card (the property's default) - so the Normal card is marked with the normal
         class, and the theme's Information rule leaves a marked card alone. -->
    <!-- Cards stack vertically: each carries the theme's wide shadow margin, so a shared row would overflow a half-width pane -->
    <StackPanel Orientation="Vertical" Spacing="{size:SpacingXl}">
      <NotificationCard Classes="normal" Content="Normal" />
      <NotificationCard NotificationType="Information" Content="Information" />
      <NotificationCard NotificationType="Success" Content="Success" />
      <NotificationCard NotificationType="Warning" Content="Warning" />
      <NotificationCard NotificationType="Error" Content="Error" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="NotificationCard" Orientation="Vertical" ContentTemplate="{StaticResource NotificationCardPreview}" />

    </Border>
  </Design.PreviewWith>
  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <!-- Visual defaults -->
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Width" Value="{size:SurfaceWidthMd}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,75%"/>
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Carries the dismiss transform while the card is closing -->
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <!-- Layout root stacking the shadow behind the card -->
          <Panel>
            <!-- Drop shadow behind the card -->
            <Border x:Name="PART_ShadowBorder"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"/>
            <!-- Outer frame around the card -->
            <Border x:Name="PART_OuterBorder"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <!-- The card surface: no local clip, so the theme's web-style ControlClipToBounds governs and a child growing past the edge is not cut -->
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <!-- Bar on top, then the message beside a dismiss control in its corner -->
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                  <!-- Color bar marking the notification type; a Border so its top corners can follow the frame's curve -->
                  <Border x:Name="PART_HeaderBar" Grid.Row="0" Grid.ColumnSpan="2" />
                  <!-- The notification's message -->
                  <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Grid.Column="0" Content="{TemplateBinding Content}" />
                  <!-- Dismisses the card when clicked; sits in the body's top-right corner, inset from the frame by a spacing token -->
                  <Button Name="PART_CloseButton" Grid.Row="1" Grid.Column="1"
                          NotificationCard.CloseOnClick="True">
                    <PathIcon Data="{icons:Close}" />
                  </Button>
                </Grid>
              </Border>
            </Border>
          </Panel>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>

    <!-- Entrance: fades the card in while it rises and settles onto its resting scale -->
    <ControlTheme.Animations>
      <Animation Duration="0:0:0.45" Easing="QuadraticEaseIn" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="TranslateTransform.Y" Value="20"/>
          <Setter Property="ScaleTransform.ScaleX" Value="0.85"/>
          <Setter Property="ScaleTransform.ScaleY" Value="0.85"/>
        </KeyFrame>
        <KeyFrame Cue="30%">
          <Setter Property="TranslateTransform.Y" Value="-20"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="TranslateTransform.Y" Value="0"/>
          <Setter Property="ScaleTransform.ScaleX" Value="1"/>
          <Setter Property="ScaleTransform.ScaleY" Value="1"/>
        </KeyFrame>
      </Animation>
    </ControlTheme.Animations>

    <!-- Closing: scales and slides the card out as it is dismissed -->
    <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Setter Property="RenderTransformOrigin" Value="50%,0%"/>
      <Style.Animations>
        <Animation Duration="0:0:0.75" Easing="QuadraticEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0"/>
            <Setter Property="ScaleTransform.ScaleY" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="TranslateTransform.X" Value="800"/>
            <Setter Property="ScaleTransform.ScaleY" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleY" Value="0"/>
            <Setter Property="TranslateTransform.X" Value="800"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:1.25" Easing="QuadraticEaseOut" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Shadow border (elevation behind card) -->
    <Style Selector="^ /template/ Border#PART_ShadowBorder">
      <Setter Property="Background" Value="{color:OverlayMediumBrush}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingLg}, Top={size:SpacingLg}, Right={size:SpacingLg}, Bottom={size:SpacingXxl}}" />
    </Style>

    <!-- Outer border margin (offset from edge for shadow visibility) -->
    <Style Selector="^ /template/ Border#PART_OuterBorder">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingLg}, Top={size:SpacingLg}, Right={size:SpacingLg}, Bottom={size:SpacingXxl}}" />
    </Style>

    <!-- Header bar: the coloured band marking the notification type, tinted by the card's hue.
         Its top corners follow the frame's inner curve (concentric), so it does not paint past the rounded top once the card no longer clips -->
    <Style Selector="^ /template/ Border#PART_HeaderBar">
      <Setter Property="Height" Value="{size:ThicknessXxlDouble}" />
      <Setter Property="Background" Value="{color:AccentTintDefault}" />
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Top=True}" />
    </Style>

    <!-- Message: padded a step further in than the default content padding, so the text sits inside the
         card rather than on its edge. The body takes its height from the close button beside it, so the
         card is no taller than the button. The text is centred in the body, so the space above and below
         it is the same and its middle lines up with the close button beside it. -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Padding" Value="{size:Edges All={size:ContentPaddingWide}}" />
      <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    </Style>

    <!-- Close button: pinned in the top-right corner and inset from the card's edge by the same content
         padding the message uses, so the gap to the right of the button and the gap below it are the same
         and the text's inset matches the button's -->
    <Style Selector="^ /template/ Button#PART_CloseButton">
      <!-- Theme Exception: Top pins the button to the top-right corner; an edge-hugging alignment has no theme token -->
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="{size:Edges All={size:ContentPaddingWide}}" />
    </Style>

    <!-- Hue overrides: Information, Success, Warning and Error each pin their hue, so the bar, border and
         text follow from one block (Rule 16). Information is the Primary accent.
         The NORMAL card - the one with no severity of its own - pins no hue at all: it takes the
         ambient accent the pane selected, like every other accent-following control in the gallery.
         Avalonia has no 'normal' NotificationType (the property's default is Information), so every
         card - the Normal one included - carries the :information pseudo-class. The Normal card is
         therefore marked with the normal class, and the Information rule leaves a marked card
         alone. Success, Warning and Error pin their own hue whatever the ambient accent is. -->
    <Style Selector="^:information:not(.normal)">
      <Setter Property="theme:Accent.Kind" Value="Primary" />
    </Style>
    <Style Selector="^:success">
      <Setter Property="theme:Accent.Kind" Value="Success" />
    </Style>
    <Style Selector="^:warning">
      <Setter Property="theme:Accent.Kind" Value="Warning" />
    </Style>
    <Style Selector="^:error">
      <Setter Property="theme:Accent.Kind" Value="Error" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
