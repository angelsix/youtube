<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: two swipable pages. Declared before Design.PreviewWith uses it; the theme defines no state hooks,
       so a single default instance is the fullest honest view -->
  <DataTemplate x:Key="CarouselPagePreview">
    <CarouselPage Width="360" Height="200">
      <ContentPage Header="Page 1">
        <TextBlock Text="First page" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ContentPage>
      <ContentPage Header="Page 2">
        <TextBlock Text="Second page" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ContentPage>
    </CarouselPage>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="CarouselPage" Orientation="Vertical" ContentTemplate="{StaticResource CarouselPagePreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CarouselPage}" TargetType="CarouselPage">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingLg}, Vertical={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The swipeable pages -->
        <Carousel Name="PART_Carousel"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  ItemTemplate="{TemplateBinding PageTemplate}"
                  PageTransition="{TemplateBinding PageTransition}"
                  ItemsPanel="{TemplateBinding ItemsPanel}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
