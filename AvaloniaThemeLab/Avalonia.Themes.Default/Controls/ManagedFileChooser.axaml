<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:Avalonia.Dialogs"
        xmlns:internal="using:Avalonia.Dialogs.Internal"
        xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
        xmlns:default="clr-namespace:Avalonia.Themes.Default"
        xmlns:design="clr-namespace:Avalonia.Themes.Default.Design"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:color="using:AngelSix.ThemeEngine.Colors"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: the REAL chooser over a REAL folder. The view model is created in C#
       (Design/ManagedFileChooserDesignData.cs) and browses a sample folder of dummy files, so the
       preview shows the browsing UI a user meets - places rail, typed path, file list, Save/Cancel -
       instead of an empty shell. Each pane instantiates its own copy of the template, and the
       design data hands out a NEW view model per read, so the light and dark panes never share one.
       Stacked panes (Rule 20): the chooser needs the room its four columns take, so the light and
       dark panes stack vertically and each gets the full page width -->
  <Orientation x:Key="ManagedFileChooserPreviewOrientation">Vertical</Orientation>

  <DataTemplate x:Key="ManagedFileChooserPreview">
    <StackPanel Orientation="Vertical" Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- The picker surface, browsable: the places rail on the left, the path box across the top,
           the file list in the middle and the file-name row with the actions at the bottom -->
      <dialogs:ManagedFileChooser Width="832" Height="600"
                                   DataContext="{x:Static design:ManagedFileChooserDesignData.Sample}" />

      <!-- The overwrite prompt: the platform convention puts the refusal first and the confirmation
           second, the way the theme's own pickers put their dismiss face before their accept face -->
      <dialogs:ManagedFileChooserOverwritePrompt FileName="report.pdf" HorizontalAlignment="Left"
                                                 Width="{size:SurfaceWidthSm}" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ManagedFileChooser" Orientation="Vertical" ContentTemplate="{StaticResource ManagedFileChooserPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- Quick links: PART_ShadowBorder sits inside the ListBox's own template, so a dedicated
       ListBox theme reaches it where the ManagedFileChooser theme could not (two /template/ hops) -->
  <ControlTheme x:Key="DefaultManagedFileChooserQuickLinks" TargetType="ListBox">
    <Setter Property="Margin" Value="0"/>
    <!-- Borderless surface: no border of its own, so it fills with SurfaceBorderless (ThemeRules) -->
    <Setter Property="Background" Value="{color:SurfaceBorderless}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!-- Like the reference rail, the entries start at the top of the surface: no top/bottom inset -->
    <Setter Property="Padding" Value="{size:Edges}"/>
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the shadow behind the list -->
        <Panel>
          <!-- Inset shadow for depth (themed — replaces hardcoded BoxShadow) -->
          <Border x:Name="PART_ShadowBorder"
                  IsHitTestVisible="False"/>
          <!-- Outer frame around the quick links list -->
          <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <!-- Scrolls the quick links when they overflow -->
            <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}" VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
              <!-- The quick link entries -->
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="{TemplateBinding Padding}"/>
            </ScrollViewer>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemContainerTheme">
      <ControlTheme TargetType="ListBoxItem">
        <!-- The same inset the theme's own list rows use (ListBoxItem.axaml): one horizontal inset
             and a symmetric vertical one, so the label rides centred and the icon starts at the
             row's standard inset from the rail's edge. The rail's row must NOT add a second
             inset of its own: the stock chooser's places start at the row's own padding. -->
        <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}, Vertical={size:ContentPadding}}" />
        <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
        <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
        <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
        <!-- The places are reached with the pointer, as in the stock: the rail itself declares
             Focusable="False", and its rows follow it out of the tab order. A place press
             NAVIGATES the chooser (the stock behaviour), which rebuilds the file list - so a
             keyboard- or proof-driven press on a place would tear down the rows a measurement had
             just taken. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <!-- Outer frame around one quick link; the outline fill alone marks hover/selection -->
            <Border x:Name="LayoutRoot">
              <!-- The quick link's icon and name -->
              <ContentPresenter Name="PART_ContentPresenter"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter>

        <!-- Themed defaults for inner template elements (Rule 2). The frame takes NO inset of its
             own: the row's padding above already places the icon at the list's standard inset, and
             a second margin here would push it twice as far in - which is what left the stock's
             left-aligned places looking centred in a wide rail. The fill spans the whole row, as
             it does in the theme's own list rows. -->
        <Style Selector="^ /template/ Border#LayoutRoot">
          <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
          <Setter Property="Margin" Value="{size:Edges}" />
        </Style>

        <!-- Selected rows are outlined, not filled (ThemeRules): light fill stage, TextDefault text -->
        <Style Selector="^:pointerover /template/ Border#LayoutRoot">
          <Setter Property="Background" Value="{color:HoverBackgroundDefault}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#LayoutRoot">
          <Setter Property="Background" Value="{color:SelectedBackgroundDefault}"/>
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#LayoutRoot">
          <Setter Property="Background" Value="{color:SelectedBackgroundHover}"/>
        </Style>
        <Style Selector="^:selected:pressed /template/ Border#LayoutRoot">
          <Setter Property="Background" Value="{color:SelectedBackgroundPressed}"/>
        </Style>
        <!-- Disabled state: the whole row fades, as in the theme's own ListBoxItem theme -->
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
        </Style>
      </ControlTheme>
    </Setter>

    <!-- Inset shadow for depth (Rule 2: no {theme:...} inside ControlTemplate) -->
    <Style Selector="^ /template/ Border#PART_ShadowBorder">
      <Setter Property="Background" Value="{color:OverlayWeakBrush}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:ThicknessXxlDouble}}" />
    </Style>
    <!-- The scroller is transparent so the rail's own surface fill shows through; its frame would
         otherwise paint the rest-fill over the whole rail and outline it like a boxed control -->
    <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dialogs:ManagedFileChooser}" TargetType="dialogs:ManagedFileChooser">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <ControlTheme.Resources>
      <ResourceDictionary>
        <!-- Icon artwork: intrinsic glyphs, exempt from theming per ThemeRules.md -->
        <GradientStops x:Key="IconRes.FolderBackGradientStops">
        </GradientStops>
        <GradientStops x:Key="IconRes.FolderFrontGradientStops">
          <GradientStop Offset="0" Color="#FFFFDA6F"/>
          <GradientStop Offset="1" Color="#FFFEC326"/>
        </GradientStops>
        <DrawingGroup x:Key="LevelUp">
          <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
          <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M14.5,0L6.39,0 5.39,2 2.504,2C1.677,2 1,2.673 1,3.5L1,10.582 1,10.586 1,15.414 3,13.414 3,16 7,16 7,13.414 9,15.414 9,13 14.5,13C15.327,13 16,12.327 16,11.5L16,1.5C16,0.673 15.327,0 14.5,0" />
          <GeometryDrawing Brush="#FFDCB679" Geometry="F1M14,3L7.508,3 8.008,2 8.012,2 14,2z M14.5,1L7.008,1 6.008,3 2.504,3C2.227,3 2,3.224 2,3.5L2,9.582 4.998,6.586 9,10.586 9,12 14.5,12C14.775,12 15,11.776 15,11.5L15,1.5C15,1.224 14.775,1 14.5,1" />
          <GeometryDrawing Brush="#FF00529C" Geometry="F1M8,11L5,8 2,11 2,13 4,11 4,15 6,15 6,11 8,13z" />
          <GeometryDrawing Brush="#FFF0EFF1" Geometry="F1M8.0001,1.9996L7.5001,3.0006 14.0001,3.0006 14.0001,1.9996z" />
        </DrawingGroup>
        <internal:ResourceSelectorConverter x:Key="Icons">
          <DrawingGroup x:Key="Icon_Folder">
            <GeometryDrawing Geometry="M 0 0 L 16 16"/>
            <GeometryDrawing Geometry="M 0 3 C 0,1 0,1 2,1 L 5 1 C 5.5,1 6,1 6.5,1.5 L 8 3 L 14 3 C 16,3 16,3 16,5
                        L 16,12 C 16,14 16,14 14,14
                        L 2,14 C 0,14 0,14 0,12 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="1%,4%" EndPoint="23%,20%">
                  <GradientStop Offset="0" Color="#FFFFC018"/>
                  <GradientStop Offset="1" Color="#FFDFA32D"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 0 4.5 L 8 4.5 L 8 9 L 0 9 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0%,4.5%" EndPoint="0%,5%">
                  <GradientStop Offset="0" Color="#00D7A018"/>
                  <GradientStop Offset="1" Color="#7FD7A018"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 0 9 C 0,5 0,5 2,5 L 5 5 C 5.5,5 6,5 6.5,4.75 L 8 4 L 14 4 C 16,4 16,4 16,6
                                                    L 16,11 C 16,13 16,13 14,13
                                                    L 2,13 C 0,13 0,13 0,11 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="1%,6%" EndPoint="23%,19%">
                  <GradientStop Offset="0" Color="#FFFFE69D"/>
                  <GradientStop Offset="1" Color="#FFFFC937"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 0 9 C 0,5 0,5 2,5 L 5 5 C 5.5,5 6,5 6.5,4.75 L 8 4 L 14 4
                                                    L 8 4.25 C 6,5.25 5.5,5.25 5.125,5.25 L 2 5.25 C 0,5.25 0,5.25 0,9.25 z" Brush="#7FFFFFFF"/>
          </DrawingGroup>
          <DrawingGroup x:Key="Icon_File">
            <GeometryDrawing Geometry="M 0 0 L 16 16"/>
            <GeometryDrawing Geometry="M 2 0 L 10 0 L 14 4 L 14 16 L 2 16 Z" Brush="#FF797774"/>
            <GeometryDrawing Geometry="M 3 1 L 9.7 1 L 13 4.3 L 13 15 L 3 15 Z" Brush="#FFFAFAFA"/>
            <GeometryDrawing Geometry="L 9 1 L 9 5 L 14 5 L 14 4 L 10 4 L 10 1 Z" Brush="#FF797774"/>
          </DrawingGroup>
          <DrawingGroup x:Key="Icon_Volume">
            <GeometryDrawing Geometry="M 0 0 L 16 16"/>
            <GeometryDrawing Geometry="M 4 5 L 12 5 L 14.5 7.5 C 15,8 15,8 15,9 L 1 9 C 1,8 1,8 1.5 7.5 Z" Brush="#FFE1E3E6"/>
            <GeometryDrawing Geometry="M 12 5 L 14.5 7.5 C 15,8 15,8 15,9 L 10 9 L 10 5 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="12%,5%" EndPoint="11.5%,5.5%">
                  <GradientStop Offset="0" Color="#FFCDCFD1"/>
                  <GradientStop Offset="1" Color="#00CDCFD1"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 4 5 L 1.5 7.5 C 1,8 1,8 1,9 L 4 9 L 6 9 L 6 5 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="4%,5%" EndPoint="4.5%,5.5%">
                  <GradientStop Offset="0" Color="#FFCDCFD1"/>
                  <GradientStop Offset="1" Color="#00CDCFD1"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 1 9 C 1,8 1,8 2,8 L 14 8
                                                    C 15,8 15,8 15,9 L 15 11
                                                    C 15,12 15,12 14,12 L 2 12
                                                    C 1,12 1,12 1,11 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0%,8%" EndPoint="0%,12%">
                  <GradientStop Offset="0" Color="#FF737374"/>
                  <GradientStop Offset="1" Color="#FFA8A8A8"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 2 9 C 2,8 2,8 3,8 L 13 8
                                                    C 14,8 14,8 14,9 L 14 10
                                                    C 14,11 14,11 13,11 L 3 11
                                                    C 2,11 2,11 2,10 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0%,8%" EndPoint="0%,11%">
                  <GradientStop Offset="0" Color="#FF333333"/>
                  <GradientStop Offset="1" Color="#FF5A5A5A"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing>
              <GeometryDrawing.Geometry>
                <EllipseGeometry Rect="2.5,8.5,2,2"/>
              </GeometryDrawing.Geometry>
              <GeometryDrawing.Brush>
                <RadialGradientBrush GradientOrigin="3.5%,9.5%" Center="3.5%,9.5%">
                  <GradientStop Offset="0.8" Color="#4001FF01"/>
                  <GradientStop Offset="1" Color="#0001FF01"/>
                </RadialGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing>
              <GeometryDrawing.Geometry>
                <EllipseGeometry Rect="3,9,1,1"/>
              </GeometryDrawing.Geometry>
              <GeometryDrawing.Brush>
                <RadialGradientBrush GradientOrigin="3.5%,9.5%" Center="3.25%,9.75%">
                  <GradientStop Offset="0" Color="#FFB6FFB6"/>
                  <GradientStop Offset="1" Color="#FF01FF01"/>
                </RadialGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 3.23483495705 9.76516504295 A 0.375,0.375 180 1 0 3.76516504295,9.23483495705 A 0.4375,0.4375 135 0 1 3.23483495705,9.76516504295 Z" Brush="#FF00B300"/>
          </DrawingGroup>
        </internal:ResourceSelectorConverter>
      </ResourceDictionary>
    </ControlTheme.Resources>
    <Setter Property="Background" Value="{color:BackgroundDefault}"/>
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="Template"
            x:DataType="internal:ManagedFileChooserViewModel">
      <ControlTemplate>
        <!-- Outer frame around the whole dialog -->
        <Border x:Name="PART_FrameBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Layout root docking the panels around the file list -->
          <DockPanel>
            <!-- Shortcuts to common folders, down the left; sized by their widest entry. The rows
                 are NOT virtualised, for the same reason as the file list: the dark pane sits below
                 the fold in the stacked gallery, and a virtualising list would realise only the
                 first place of it. -->
            <ListBox x:Name="PART_QuickLinks" Theme="{StaticResource DefaultManagedFileChooserQuickLinks}" DockPanel.Dock="Left" ItemsSource="{Binding QuickLinks}" SelectedIndex="{Binding QuickLinksSelectedIndex}" Focusable="False">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- One shortcut: its icon and name -->
                  <StackPanel Orientation="Horizontal" Background="Transparent" Spacing="{size:SpacingMd}">
                    <Image Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" VerticalAlignment="Center">
                      <Image.Source>
                        <DrawingImage Drawing="{Binding IconKey, Converter={StaticResource Icons}}"/>
                      </Image.Source>
                    </Image>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- The address bar across the top -->
            <DockPanel x:Name="NavBar" DockPanel.Dock="Top">
              <!-- Line below the address bar -->
              <Rectangle x:Name="NavBarSeparator" Height="{size:ThicknessSmDouble}" DockPanel.Dock="Bottom"/>
              <!-- Places the buttons either side of the path -->
              <DockPanel x:Name="NavBarInner">
                <!-- Goes to the parent folder -->
                <Button x:Name="GoUpButton" Command="{Binding GoUp}" DockPanel.Dock="Left">
                  <PathIcon Data="{icons:ArrowUp}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}"/>
                </Button>
                <!-- Reloads the current folder -->
                <Button x:Name="RefreshButton" Command="{Binding Refresh}" DockPanel.Dock="Right">
                  <PathIcon Data="{icons:Refresh}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}"/>
                </Button>
                <!-- The current folder path, editable; the inner vertical scrollbar is hidden (not
                     disabled) so the field reads as a clean text field rather than a boxed widget
                     whose scrollbar arrows crowd the placeholder at its right edge; hiding keeps
                     the content scrollable so the proof crawler can still exercise it -->
                <TextBox x:Name="Location" Text="{Binding Location}" PlaceholderText="Folder path"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">
                  <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding EnterPressed}" Gesture="Enter"/>
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>
            </DockPanel>
            <!-- The action bar across the bottom -->
            <DockPanel x:Name="BottomBar" DockPanel.Dock="Bottom">
              <!-- Line above the action bar -->
              <Rectangle x:Name="BottomBarSeparator" Height="{size:ThicknessSmDouble}" DockPanel.Dock="Top"/>
              <!-- Stacks the file name row above the buttons -->
              <DockPanel x:Name="BottomBarInner">
                <!-- The file name and filter row -->
                <DockPanel x:Name="BottomBarTop" DockPanel.Dock="Top">
                  <!-- Limits the list to matching file types -->
                  <ComboBox DockPanel.Dock="Right"
                      IsVisible="{Binding ShowFilters}"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}" />
                  <!-- The file name being saved or opened -->
                  <TextBox x:Name="FileName" Text="{Binding FileName}" PlaceholderText="File name" IsVisible="{Binding !SelectingFolder}" />
                </DockPanel>
                <!-- Toggles hidden files in the list; its own row so the buttons keep their face -->
                <CheckBox IsChecked="{Binding ShowHiddenFiles}" Content="Show hidden files" DockPanel.Dock="Left"/>
                <!-- The confirm and cancel buttons -->
                <UniformGrid x:Name="Finalize" HorizontalAlignment="Right" Rows="1">
                  <Button Command="{Binding Ok}" Content="Save" IsDefault="True"/>
                  <Button Command="{Binding Cancel}" Content="Cancel" IsCancel="True"/>
                </UniformGrid>
              </DockPanel>
            </DockPanel>

            <!-- Layout root docking the headers above the files -->
            <DockPanel Grid.IsSharedSizeScope="True">
              <!-- Column headings for the file list; the name column takes the slack. Thin 1px
                   splitters sit between the columns (their own Auto cells, shared with the rows) -->
              <Grid x:Name="FileHeaders" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{size:Scaled Value={size:IconSizeMd}, By=1.25}" SharedSizeGroup="Icon" />
                  <ColumnDefinition Width="*" SharedSizeGroup="Name" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="SplitA" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Modified" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="SplitB" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Type" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="SplitC" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderName" Grid.Column="1" Text="Name" />
                <Rectangle x:Name="HeaderSplitA" Grid.Column="2" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="HeaderModified" Grid.Column="3" Text="Date Modified" />
                <Rectangle x:Name="HeaderSplitB" Grid.Column="4" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="HeaderType" Grid.Column="5" Text="Type" />
                <Rectangle x:Name="HeaderSplitC" Grid.Column="6" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="HeaderSize" Grid.Column="7" Text="Size" />
              </Grid>
              <!-- The files and folders in this folder. The rows are NOT virtualised: the gallery
                   stacks the light and dark panes, so the dark pane sits below the fold and a
                   virtualising list would realise only the first row of it - the pane would look
                   empty. A plain panel realises every row, so both panes show the same list. -->
              <ListBox x:Name="PART_Files"
                  ItemsSource="{Binding Items}"
                  SelectionMode="{Binding SelectionMode}"
                  SelectedItems="{Binding SelectedItems}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="internal:ManagedFileChooserItemViewModel">
                    <!-- One row: icon, name, date, type and size; the splitter cells share the
                         header's groups so the 1px rules line up across every row -->
                    <Grid Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Icon" />
                        <ColumnDefinition SharedSizeGroup="Name" />
                        <ColumnDefinition SharedSizeGroup="SplitA" />
                        <ColumnDefinition SharedSizeGroup="Modified" />
                        <ColumnDefinition SharedSizeGroup="SplitB" />
                        <ColumnDefinition SharedSizeGroup="Type" />
                        <ColumnDefinition SharedSizeGroup="SplitC" />
                        <ColumnDefinition SharedSizeGroup="Size" />
                      </Grid.ColumnDefinitions>
                      <Image Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" VerticalAlignment="Center">
                        <Image.Source>
                          <DrawingImage Drawing="{Binding IconKey, Converter={StaticResource Icons}}"/>
                        </Image.Source>
                      </Image>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                      <Rectangle x:Name="RowSplitA" Grid.Column="2" VerticalAlignment="Stretch"
                                 Width="{size:ThicknessSmDouble}"
                                 Margin="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Modified}" VerticalAlignment="Center"/>
                      <Rectangle x:Name="RowSplitB" Grid.Column="4" VerticalAlignment="Stretch"
                                 Width="{size:ThicknessSmDouble}"
                                 Margin="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}"/>
                      <TextBlock Grid.Column="5" Text="{Binding Type}" VerticalAlignment="Center"/>
                      <Rectangle x:Name="RowSplitC" Grid.Column="6" VerticalAlignment="Stretch"
                                 Width="{size:ThicknessSmDouble}"
                                 Margin="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}"/>
                      <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock.Text>
                          <Binding Path="Size">
                            <Binding.Converter>
                              <internal:FileSizeStringConverter/>
                            </Binding.Converter>
                          </Binding>
                        </TextBlock.Text>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Themed defaults for inner template elements (Rule 2) -->
    <Style Selector="^ /template/ DockPanel#NavBar">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXl}, Top={size:SpacingMd}, Right={size:SpacingXl}}" />
    </Style>
    <!-- Single hairline under the address bar (neutral groove tone) -->
    <Style Selector="^ /template/ Rectangle#NavBarSeparator">
      <Setter Property="Fill" Value="{color:BorderDefault}" />
      <Setter Property="Margin" Value="{size:Edges Top={size:SpacingMd}}" />
    </Style>
    <Style Selector="^ /template/ DockPanel#NavBarInner">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}" />
    </Style>
    <Style Selector="^ /template/ Button#GoUpButton">
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingXl}}" />
    </Style>
    <Style Selector="^ /template/ Button#RefreshButton">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXl}}" />
    </Style>
    <Style Selector="^ /template/ DockPanel#BottomBar">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXl}, Right={size:SpacingXl}, Bottom={size:SpacingMd}}" />
    </Style>
    <!-- Single hairline above the action bar (the same groove tone as the one under the path) -->
    <Style Selector="^ /template/ Rectangle#BottomBarSeparator">
      <Setter Property="Fill" Value="{color:BorderDefault}" />
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingMd}}" />
    </Style>
    <Style Selector="^ /template/ DockPanel#BottomBarInner">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}" />
    </Style>
    <Style Selector="^ /template/ DockPanel#BottomBarTop">
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingMd}}" />
    </Style>
    <Style Selector="^ /template/ Grid#FileHeaders">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXxl}, Top={size:SpacingMd}, Bottom={size:SpacingMd}}" />
    </Style>
    <!-- The thin 1px column splitters between the headings; the file rows mirror them via the shared size groups -->
    <Style Selector="^ /template/ Rectangle#HeaderSplitA, ^ /template/ Rectangle#HeaderSplitB, ^ /template/ Rectangle#HeaderSplitC">
      <Setter Property="Width" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Fill" Value="{color:BorderDefault}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingMd}, Right={size:SpacingMd}}" />
    </Style>
    <!-- The same 1px rules between the rows' columns -->
    <Style Selector="^ /template/ Rectangle#RowSplitA, ^ /template/ Rectangle#RowSplitB, ^ /template/ Rectangle#RowSplitC">
      <Setter Property="Fill" Value="{color:BorderDefault}" />
    </Style>
    <!-- Places rail keeps the reference's 200px width: the names inside it are trimmed, so a long
         one never widens the rail and squeezes the file list -->
    <Style Selector="^ /template/ ListBox#PART_QuickLinks">
      <Setter Property="Width" Value="{size:Scaled Value={size:ControlHeightMd}, By=5}" />
    </Style>
    <!-- The file list fills whatever is left BELOW the header row; frameless too: the reference lists
         files without a box, the nav hairline and the bottom bar's rule are the only lines in the
         centre region -->
    <Style Selector="^ /template/ ListBox#PART_Files">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{size:Edges}" />
      <Setter Property="Margin" Value="{size:Edges}" />
    </Style>
    <!-- The path and file-name fields stretch across their rows, flanked by the toolbar buttons and the filter combo -->
    <Style Selector="^ /template/ TextBox#Location">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>
    <Style Selector="^ /template/ TextBox#FileName">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>

    <Style Selector="^ /template/ DockPanel#NavBar Button, ^ /template/ DockPanel#NavBar TextBox">
      <Setter Property="Height" Value="{size:ControlHeightMd}"/>
    </Style>
    <!-- The stretched path and file-name fields take the taller control height so their 16.9px
         text lines clear the slot instead of being clipped at 14px -->
    <Style Selector="^ /template/ TextBox#Location, ^ /template/ TextBox#FileName">
      <Setter Property="Height" Value="{size:ControlHeightMd}" />
    </Style>
    <Style Selector="^ /template/ DockPanel#NavBar Button">
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}"/>
      <Setter Property="Width" Value="{size:ControlHeightMd}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="^ /template/ DockPanel#NavBar Button:not(:pointerover):not(:pressed)">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="^ /template/ UniformGrid#Finalize > Button">
      <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}"/>
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}"/>
      <Setter Property="MinWidth" Value="{size:ControlMinWidth}"/>
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingMd}}"/>
    </Style>

    <!-- Focus state (Rule 21): the frame carries the focus ring -->
    <Style Selector="^:focus-visible /template/ Border#PART_FrameBorder">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dialogs:ManagedFileChooserOverwritePrompt}" TargetType="dialogs:ManagedFileChooserOverwritePrompt">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPaddingWide}}" />
    <Setter Property="MinWidth" Value="{size:SurfaceWidthSm}" />
    <Setter Property="MaxWidth" Value="{size:SurfaceWidthLg}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the overwrite prompt -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Stacks the heading, the warning and its buttons -->
          <StackPanel x:Name="PART_OverwritePromptRoot">
            <!-- Heading for the prompt -->
            <TextBlock x:Name="PART_OverwritePromptHeading"
                       FontWeight="{theme:FontWeightSemiBold}"
                       FontSize="{size:FontSizeLg}"
                       Text="Replace file?" />
            <!-- Warns that the file already exists -->
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding FileName, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} already exists. Do you want to replace it?'}" />
            <!-- The confirm and cancel buttons: the refusal comes first and the confirmation second,
                 the platform order the theme's own pickers use for their dismiss and accept faces -->
            <StackPanel x:Name="PART_OverwritePromptButtons"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
              <Button theme:Accent.Kind="Destructive" Content="No"
                      IsCancel="True"
                      Command="{Binding Cancel, RelativeSource={RelativeSource TemplatedParent}}"  />
              <Button theme:Accent.Kind="Success" Content="Yes"
                      IsDefault="True"
                      Command="{Binding Confirm, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- OverwritePrompt buttons MinWidth (Rule 2: no {theme:...} inside ControlTemplate) -->
    <Style Selector="^ /template/ StackPanel#PART_OverwritePromptButtons Button">
      <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    </Style>

    <!-- Tighter rhythm inside the prompt: heading, warning and buttons sit close together -->
    <Style Selector="^ /template/ StackPanel#PART_OverwritePromptRoot">
      <Setter Property="Spacing" Value="{size:SpacingLg}" />
    </Style>
    <Style Selector="^ /template/ StackPanel#PART_OverwritePromptButtons">
      <Setter Property="Spacing" Value="{size:SpacingXxl}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
