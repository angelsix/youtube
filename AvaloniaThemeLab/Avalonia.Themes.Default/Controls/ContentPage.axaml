<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: scaffold only — the theme defines no hover/press/state selectors, so the shared template shows
       the page chrome once per pane. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ContentPagePreview">
    <Border Width="340" Height="280">
      <ContentPage Header="Sample Page">
        <TextBlock Text="Content goes here"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </ContentPage>
    </Border>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ContentPage" Orientation="Horizontal" ContentTemplate="{StaticResource ContentPagePreview}" />
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ContentPage}" TargetType="ContentPage">

    <!-- Visual defaults -->
    <!-- A page is a SURFACE, not a stage: it takes the default surface fill every other content
         container takes (TabControl's content area, SplitView's pane, ListBox, ScrollViewer), so a
         page reads as the near-white sheet the content sits on. The accent fills are the FILLED
         column (a pressed or selected face), never a page's own ground. -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <!-- The outline that makes a near-white surface legible against the canvas, the same role the
         content containers draw their frame with -->
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <!-- Content alignment lets the child decide (Stretch): a page's content is laid out by its own alignment, not forced left -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Hosted-by-a-page-host corners (Rule 19): the behaviour tags the hosted page with a
         Square&lt;Side&gt; class naming the edge the HOST'S chrome sits on, and these square the border
         pair that meets it while the opposite pair keeps {size:RadiusSm}. A class beats the bare-type
         specificity above, so these win wherever the host docks; the border thickness stays
         {size:ThicknessSm} throughout. One class per edge, so a tab strip on top and a navigation
         bar on top share the same rule. -->
    <Style Selector="^.SquareTop">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
    </Style>
    <Style Selector="^.SquareBottom">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    </Style>
    <Style Selector="^.SquareLeft">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Right=True}" />
    </Style>
    <Style Selector="^.SquareRight">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Left=True}" />
    </Style>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root docking the bars around the content -->
        <DockPanel>
          <!-- Visibility managed in code-behind -->
          <ContentPresenter Name="PART_TopCommandBar"
                            DockPanel.Dock="Top"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            IsVisible="False" />

          <!-- Visibility managed in code-behind -->
          <ContentPresenter Name="PART_BottomCommandBar"
                            DockPanel.Dock="Bottom"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            IsVisible="False" />

          <!-- The page's content -->
          <ContentPresenter Name="PART_ContentPresenter"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
