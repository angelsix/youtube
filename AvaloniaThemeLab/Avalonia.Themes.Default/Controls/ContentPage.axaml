<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: scaffold only — the theme defines no hover/press/state selectors, so the shared template shows
       the page chrome once per pane. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ContentPagePreview">
    <Border Width="340" Height="280">
      <ContentPage Header="Sample Page">
        <TextBlock Text="Content goes here"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </ContentPage>
    </Border>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ContentPage" Orientation="Horizontal" ContentTemplate="{StaticResource ContentPagePreview}" />
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ContentPage}" TargetType="ContentPage">

    <!-- Visual defaults -->
    <!-- Stage: the same fill, border and corners Carousel rests on (task 8) so a page reads as a raised surface -->
    <Setter Property="Background" Value="{color:AccentBrush Light6}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <!-- Content alignment lets the child decide (Stretch): a page's content is laid out by its own alignment, not forced left -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Hosted-by-a-TabbedPage corners (Rule 19): the behaviour tags the hosted page with a
         Tabs&lt;Side&gt; class named for the strip's docked side, and these square the border pair that
         meets the tabs while the opposite pair keeps {size:RadiusSm}. A class beats the bare-type
         specificity above, so these win wherever the strip docks; the border thickness stays
         {size:ThicknessSm} throughout. -->
    <Style Selector="^.TabsTop">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
    </Style>
    <Style Selector="^.TabsBottom">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    </Style>
    <Style Selector="^.TabsLeft">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Right=True}" />
    </Style>
    <Style Selector="^.TabsRight">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Left=True}" />
    </Style>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root docking the bars around the content -->
        <DockPanel>
          <!-- Visibility managed in code-behind -->
          <ContentPresenter Name="PART_TopCommandBar"
                            DockPanel.Dock="Top"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            IsVisible="False" />

          <!-- Visibility managed in code-behind -->
          <ContentPresenter Name="PART_BottomCommandBar"
                            DockPanel.Dock="Bottom"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            IsVisible="False" />

          <!-- The page's content -->
          <ContentPresenter Name="PART_ContentPresenter"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
