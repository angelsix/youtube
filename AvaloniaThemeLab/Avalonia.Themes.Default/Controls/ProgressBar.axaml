<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Controls.Converters"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: every axis the theme styles — value position, range, text/format, indeterminate,
       disabled, accent hue, both orientations. Each bar is a nameable state with a short label beside it,
       and the values differ visibly (empty, quarter, three-quarter, full). Declared before Design.PreviewWith -->
  <DataTemplate x:Key="ProgressBarPreview">
    <StackPanel Spacing="{size:SpacingXxl}">
      <!-- Horizontal bars: one labelled row each, values chosen to read apart -->
      <StackPanel Spacing="{size:SpacingLg}">
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Empty" Width="100" />
          <ProgressBar Value="0" Maximum="100" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Quarter" Width="100" />
          <ProgressBar Value="25" Maximum="100" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Three-quarter" Width="100" />
          <ProgressBar Value="75" Maximum="100" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Full" Width="100" />
          <ProgressBar Value="100" Maximum="100" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <!-- Centre the caption on its taller (33px) bar like the other rows -->
          <TextBlock Text="Percent shown" Width="100" VerticalAlignment="Center" />
          <ProgressBar ShowProgressText="True" Value="50" Maximum="100" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <!-- Centre the caption on its taller (33px) bar like the other rows -->
          <TextBlock Text="Custom format" Width="100" VerticalAlignment="Center" />
          <ProgressBar ShowProgressText="True" ProgressTextFormat="\{1\} percent" Minimum="50" Maximum="100" Value="70" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Loading…" Width="100" />
          <ProgressBar IsIndeterminate="True" Width="190" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Disabled" Width="100" />
          <ProgressBar Value="50" Maximum="100" Width="190" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" Width="300">
          <TextBlock Text="Warning hue" Width="100" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
          <ProgressBar Value="50" Maximum="100" Width="190" theme:Accent.Kind="Warning" />
        </StackPanel>
      </StackPanel>
      <!-- Same axes rotated: the :vertical branch grows upward and rotates the text -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingXxl}">
        <ProgressBar Orientation="Vertical" Value="50" Maximum="100" Width="8" Height="120" />
        <!-- Wider face: the rotated percent text needs room to lay out without escaping the track -->
        <ProgressBar Orientation="Vertical" ShowProgressText="True" Value="50" Maximum="100" Width="40" Height="120" />
        <ProgressBar Orientation="Vertical" IsIndeterminate="True" Width="8" Height="120" />
        <ProgressBar Orientation="Vertical" IsIndeterminate="True" Width="8" Height="120" theme:Accent.Kind="Warning" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ProgressBar" Orientation="Vertical" ContentTemplate="{StaticResource ProgressBarPreview}" />

    </Border>
  </Design.PreviewWith>

  <converters:StringFormatConverter x:Key="StringFormatConverter"/>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">

    <!-- Visual defaults -->
    <Setter Property="Foreground" Value="{color:SolidFillDefaultBrush}" />
    <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:SpacingLg}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <!-- The track the progress fills -->
        <Border
            x:Name="ProgressBarRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            ClipToBounds="True"
            CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Layout root stacking the bars and the text -->
          <Panel>
            <!-- Shown when progress has a known value -->
            <Panel x:Name="DeterminateRoot" Opacity="1">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
              </Panel.Transitions>
              <!-- Progress text over the empty track, hidden beneath the fill -->
              <Panel x:Name="Part_TrackHost" IsVisible="{TemplateBinding ShowProgressText}">
                <TextBlock x:Name="PART_TrackText" IsHitTestVisible="False">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource StringFormatConverter}">
                      <TemplateBinding Property="ProgressTextFormat"/>
                      <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                      <TemplateBinding Property="Percentage"/>
                      <TemplateBinding Property="Minimum"/>
                      <TemplateBinding Property="Maximum"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Panel>
              <!-- The filled portion of the bar -->
              <Border
                  x:Name="PART_Indicator"
                  Margin="{TemplateBinding Padding}"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}">
                <!-- Clipse here, not on the rounded frame: a clip on the curved border casts its radius wrong -->
                <Panel x:Name="Part_FillHost" ClipToBounds="True" IsVisible="{TemplateBinding ShowProgressText}">
                  <TextBlock x:Name="PART_FillText" IsHitTestVisible="False">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource StringFormatConverter}">
                        <TemplateBinding Property="ProgressTextFormat"/>
                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <TemplateBinding Property="Percentage"/>
                        <TemplateBinding Property="Minimum"/>
                        <TemplateBinding Property="Maximum"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Panel>
              </Border>
            </Panel>
            <!-- Shown when progress is indeterminate -->
            <Panel x:Name="IndeterminateRoot" Opacity="0">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
              </Panel.Transitions>
              <!-- First of two blocks sweeping the track -->
              <Border
                  x:Name="IndeterminateProgressBarIndicator"
                  Margin="{TemplateBinding Padding}"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
              <!-- Second of two blocks sweeping the track -->
              <Border
                  x:Name="IndeterminateProgressBarIndicator2"
                  Margin="{TemplateBinding Padding}"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
            </Panel>
            <!-- Vertical label: one turned copy centred on the face, plain text with no box -->
            <LayoutTransformControl
                x:Name="PART_LayoutTransformControl"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{TemplateBinding ShowProgressText}">
              <!-- The progress percentage, when shown -->
              <TextBlock x:Name="PART_CenterText" IsHitTestVisible="False">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource StringFormatConverter}">
                    <TemplateBinding Property="ProgressTextFormat"/>
                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <TemplateBinding Property="Percentage"/>
                    <TemplateBinding Property="Minimum"/>
                    <TemplateBinding Property="Maximum"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </LayoutTransformControl>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Progress text: two coincident copies, one per surface it crosses; inset from the bar's ends -->
    <Style Selector="^ /template/ TextBlock#PART_TrackText">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <!-- Padding around the glyph: a full spacing step clear of the bar's ends and of its top
           and bottom edges, so the label sits in the bar rather than cutting into it -->
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingLg}}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_FillText">
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
      <Setter Property="Foreground" Value="{color:OnSolidFillInkDefaultBrush}" />
      <!-- The same padding as the track copy, so the two coincide where they overlap -->
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingLg}}" />
    </Style>
    <!-- Centred copy on a vertical face: plain text, no painted box. The on-fill ink clears the
         mid-blue fill in the light pane and the lighter blue fill in the dark pane; over the pale
         track it still reads comfortably in both palettes. -->
    <Style Selector="^:vertical /template/ TextBlock#PART_CenterText">
      <Setter Property="Foreground" Value="{color:OnSolidFillInkDefaultBrush}" />
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingSm}}" />
    </Style>
    <!-- The turned label's own centring: the layout transform places the rotated text's line box
         on the face's centre line, but the glyphs ride high in that line box, so the ink lands to
         the left of the centre. A symmetric margin pulls the ink back onto the centre line
         without changing the face's usable width. -->
    <Style Selector="^:vertical /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingSm}, Right={size:SpacingSm}}" />
    </Style>
    <Style Selector="^:horizontal /template/ TextBlock#PART_CenterText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The split copies serve horizontal bars only; on a vertical face they straddle the fill edge -->
    <Style Selector="^:vertical /template/ TextBlock#PART_TrackText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:vertical /template/ TextBlock#PART_FillText">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Template: determinate indicator positioning -->
    <Style Selector="^:horizontal /template/ Border#PART_Indicator">
      <!-- Theme Exception: indicator anchors left so it grows from the left. Luke to validate -->
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    </Style>
    <Style Selector="^:vertical /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <!-- Theme Exception: indicator anchors bottom so it grows upward. Luke to validate -->
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Orientation: dimensions -->
    <Style Selector="^:horizontal">
      <Setter Property="MinHeight" Value="{size:SpacingLg}" />
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="{size:SpacingLg}" />
    </Style>

    <!-- Template: vertical layout rotation -->
    <Style Selector="^:vertical /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Setter Property="LayoutTransform">
        <Setter.Value>
          <RotateTransform Angle="90" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Indeterminate: panel visibility -->
    <Style Selector="^:indeterminate /template/ Panel#DeterminateRoot">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:indeterminate /template/ Panel#IndeterminateRoot">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Indeterminate: horizontal animation -->
    <Style Selector="^:horizontal:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.5">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:horizontal:indeterminate /template/ Border#IndeterminateProgressBarIndicator2">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0.75">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Indeterminate: vertical animation -->
    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.5">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator2">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:0.75">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Template: indeterminate container dimensions -->
    <Style Selector="^:horizontal /template/ Border#IndeterminateProgressBarIndicator">
      <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
    </Style>
    <Style Selector="^:horizontal /template/ Border#IndeterminateProgressBarIndicator2">
      <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
    </Style>
    <Style Selector="^:vertical /template/ Border#IndeterminateProgressBarIndicator">
      <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
    </Style>
    <Style Selector="^:vertical /template/ Border#IndeterminateProgressBarIndicator2">
      <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
