<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- No design preview: a popup host is populated by popups opened at runtime; empty standalone it shows no chrome of its own -->
  <!-- The declared reason for that (task 176): the gallery lists a control only when the theme gives
       it a {Name}Preview, so this host would vanish from the gallery with no record of why. The
       marker is that record: it is filled by a popup at runtime, never shown on its own. -->

  <default:PreviewExcluded x:Key="OverlayPopupHostPreviewExcluded"
                            Reason="A popup host is filled by a popup opened at runtime." />

  <ControlTheme x:Key="{x:Type OverlayPopupHost}" TargetType="OverlayPopupHost">
    <!-- Visual defaults -->
    <Setter Property="Foreground" Value="{color:TextDefault}"/>
    <Setter Property="FontSize" Value="{size:FontSizeMd}"/>
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="FontStyle" Value="Normal" />
    <Setter Property="Inline.TextDecorations" Value="" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Applies the popup's own scaling and rotation -->
        <LayoutTransformControl LayoutTransform="{TemplateBinding Transform}">
          <!-- Hosts overlays such as tooltips and adorners -->
          <VisualLayerManager Name="PART_VisualLayerManager">
            <!-- The popup's content -->
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"/>
          </VisualLayerManager>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
