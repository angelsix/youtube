<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:Avalonia.Themes.Default"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: a few real controls plus a refusal-case TextBlock whose explicit Foreground
       must survive the per-pane inherited colour (Rule 13: an explicit value beats inheritance) -->
  <DataTemplate x:Key="LightDarkPreviewPreview">
    <StackPanel Spacing="{size:SpacingXl}" Width="220">
      <Button Content="Click me" Width="200" />
      <CheckBox Content="Checked" IsChecked="True" Width="200" />
      <TextBox PlaceholderText="Type here" Width="200" />
      <TextBlock Text="Hello, theme" />
      <!-- Refusal case: explicit Foreground wins over the pane's inherited colour. The ink is the
           TRUE Warning hue at its accent-text stage: theme:Accent.Kind="Warning" puts this block on
           the Warning ramp, and {color:AccentTextDefault} picks that ramp's accent-ink stage (Dark3).
           The seed ({color:AccentWarningBrush}) is unreadable as text on the light canvas (1.84:1),
           and the ramp's higher-chroma stages (Dark1/Dark2) sit on the yellow of the Favourite hue.
           Dark3 is the amber one: light #B05E1E (4.62:1 on the canvas), dark #DD902F (6.14:1) -->
      <TextBlock Text="Explicit warning ink" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
      <!-- The caption names the token, so the picture says which one it is. It names the hue it
           shows, so it carries that hue and takes the accent's text role -->
      <TextBlock Text="Warning · AccentTextDefault" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <p:LightDarkPreview Title="LightDarkPreview" PaneContentTemplate="{StaticResource LightDarkPreviewPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- One accent swatch: a dot in its own hue, ringed when it is the picked one. The item carries its
       hue as its own Accent.Kind, so a pick recolours the preview's content and never the swatches.
       Task 148: the dot paints the LIST-ROW PRESSED fill ({color:PressedBackgroundDefault}, the
       outlined control's pressed stage of the item's own hue) — the exact colour a ComboBoxItem shows
       while pressed, read from ComboBoxItem.axaml's :pressed state — replacing the old checked-face
       {color:AccentBrush Dark3}. -->
  <ControlTheme x:Key="LightDarkPreviewSwatch" TargetType="ListBoxItem" x:DataType="theme:AccentKind">
    <!-- Visual defaults -->
    <Setter Property="theme:Accent.Kind" Value="{Binding}" />
    <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingSm}}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Width" Value="{size:IconSizeLg}" />
    <Setter Property="Height" Value="{size:IconSizeLg}" />
    <Setter Property="ToolTip.Tip" Value="{Binding}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The ring around the swatch -->
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The dot painted in the swatch's hue -->
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Setter Property="BorderBrush" Value="{color:TextDefault}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBrush}" />
    </Style>
  </ControlTheme>

  <!-- The row of accent swatches in a pane's header -->
  <ControlTheme x:Key="LightDarkPreviewSwatches" TargetType="ListBox">
    <!-- Visual defaults -->
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="SelectionMode" Value="AlwaysSelected" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource LightDarkPreviewSwatch}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The swatches -->
        <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>

  <!-- Two identical panes, the second flipped into a dark region; each presents an independent
       instantiation of the caller's template -->
  <ControlTheme x:Key="{x:Type p:LightDarkPreview}" TargetType="p:LightDarkPreview">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Text root: a design preview has no Window above it, so the inherited font properties a Window
         gives every control (Rule 13) are established here instead; inside a Window they restate the same values.
         Ink colour is deliberately NOT set on the control: it would resolve once in the light region and
         inherit as an already-resolved value into the dark pane (near-black on dark). Each pane's border
         carries it instead, from the per-pane style below, so the brush resolves in that pane's own region. -->
    <Setter Property="FontSize" Value="{size:FontSizeMd}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <!-- Where each pane places its caption and content across its width; a page lays it out (Center floats them mid-pane) -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The two panes, in equal cells: side by side each takes half the width, stacked each takes the full width -->
        <UniformGrid x:Name="PART_Panes">
          <!-- Light -->
          <!-- The pane's own inset. Its bottom edge gives up SpacingLg (8px) to the scrolled content's
               own inset below, and the grid's RowSpacing gives up the same 8px on the top edge
               (SpacingXl 12 -> SpacingMd 4), so the header-to-content gap is unchanged at 12px
               (4 + 8) and the content lands exactly where it did before. The left, top and right
               keep their full SpacingXxl, so the caption and the swatches sit exactly where they
               did, and the content keeps its horizontal centring. -->
          <Border Name="PART_LightPane" Padding="{size:Edges Left={size:SpacingXxl}, Top={size:SpacingXxl}, Right={size:SpacingXxl}, Bottom={size:SpacingLg}}" Background="{color:SurfaceDefaultBrush}">
            <!-- A Grid, not a StackPanel: the pane's content is a scrolling viewport, and a StackPanel
                 measures its children with an infinite height, so a viewer inside one never scrolls.
                 Theme Exception: the grid is Top-aligned, not stretched. A stretched grid hands its
                 leftover pixels to a row, which moved the preview content down by 1px; the rows are
                 content-sized, so the grid takes exactly the height its rows need.
                 The content row is a STAR row, so it takes whatever height the pane has left over
                 after the header. That is what makes the viewport BOUNDED: when the pane is given
                 a fixed height (a page that wants a fixed-height preview), the viewer takes the
                 remaining height and CLIPS and SCROLLS the too-tall content instead of letting it
                 spill out of the pane. When the pane is free to grow, the star row is measured
                 with an infinite height and takes the content's own height, so nothing changes.
                 Theme Exception: the grid's RowSpacing is SpacingMd (4px), not SpacingXl (12px).
                 The content's own inset (below) takes the 8px the header-to-content gap gives up,
                 so the content stays exactly where it was while the viewport it sits in reaches
                 8px further up and leaves the control's hover grow inside the clip. -->
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,*" RowSpacing="{size:SpacingMd}" VerticalAlignment="Top">
              <!-- The pane's header: its caption and, below it, the accent picker -->
              <StackPanel Grid.Row="0" Spacing="{size:SpacingXl}">
                <!-- The pane's caption -->
                <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Light'}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                <!-- The pane's accent picker, below the caption -->
                <ListBox Theme="{StaticResource LightDarkPreviewSwatches}" IsVisible="{TemplateBinding IsAccentPickerVisible}"
                         SelectedItem="{TemplateBinding SelectedAccent, Mode=TwoWay}" ItemsSource="{x:Static p:LightDarkPreview.AccentChoices}"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              </StackPanel>
              <!-- The preview content, in the theme's own auto-hide scrolling viewport: the pane keeps
                   what it can show and the bars fade out at rest, so nothing ever spills out of the pane.
                   The viewer takes the height the pane has left (a bounded pane scrolls; a pane free to
                   grow takes the content's own height), and the horizontal axis is squeezed to the
                   pane's width rather than spilled: every preview's content measures to a fixed width
                   that fits, so nothing is ever clipped sideways.
                   The content carries a vertical MARGIN, and the margin is the room a preview control
                   needs INSIDE the viewport. A scroll viewport clips to its own rectangle (Rule 18: "a
                   grow at the very edge of a viewport is still cut there"), and the theme's hover grow
                   is a scale of 1.07 (PressedScale 0.98 x 1.07 = 1.0486), so a control whose box
                   touches the viewport's top or bottom edge grows PAST it and loses that edge. The
                   focus ring reaches 3px outside the control (a 2px ring plus a 1px halo), so it
                   needs the same room. The margin is MEASURED, not guessed: across every gallery entry
                   the largest growth that fell outside a viewport was 1.361px (a Button's bottom edge)
                   and the largest growth on any edge was 4.86px vertically (a 200px-tall RepeatButton),
                   so one spacing step (8px) covers the growth plus the ring's 3px (4.86 + 3 = 7.86px).
                   The horizontal axis needs no inset: the measured worst side deficit across the
                   gallery was 0px, because the content is centred in a viewport far wider than the
                   controls that grow. It is a MARGIN on the scrolled content, not the viewer's
                   Padding: a viewer's Padding is left out of its scroll extent, so padded content
                   ended past the furthest scroll (AVLG010), while a Margin IS counted by the extent. -->
              <ScrollViewer Grid.Row="1" Background="Transparent" BorderThickness="{size:Edges}" AllowAutoHide="True"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" theme:Accent.Kind="{TemplateBinding SelectedAccent}"
                                Margin="{size:Edges Top={size:SpacingLg}, Bottom={size:SpacingLg}}"
                                ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Dark -->
          <!-- The dark pane's inset matches the light one's exactly (see the light pane above) -->
          <Border Name="PART_DarkPane" Padding="{size:Edges Left={size:SpacingXxl}, Top={size:SpacingXxl}, Right={size:SpacingXxl}, Bottom={size:SpacingLg}}" theme:ThemeRegion.IsDark="True" Background="{color:SurfaceDefaultBrush}">
            <!-- The dark pane lays out exactly like the light one -->
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,*" RowSpacing="{size:SpacingMd}" VerticalAlignment="Top">
              <!-- The pane's header: its caption and, below it, the accent picker -->
              <StackPanel Grid.Row="0" Spacing="{size:SpacingXl}">
                <!-- The pane's caption -->
                <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Dark'}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                <!-- The pane's accent picker, below the caption -->
                <ListBox Theme="{StaticResource LightDarkPreviewSwatches}" IsVisible="{TemplateBinding IsAccentPickerVisible}"
                         SelectedItem="{TemplateBinding SelectedAccent, Mode=TwoWay}" ItemsSource="{x:Static p:LightDarkPreview.AccentChoices}"
                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              </StackPanel>
              <!-- The preview content, in the theme's own auto-hide scrolling viewport -->
              <ScrollViewer Grid.Row="1" Background="Transparent" BorderThickness="{size:Edges}" AllowAutoHide="True"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" theme:Accent.Kind="{TemplateBinding SelectedAccent}"
                                Margin="{size:Edges Top={size:SpacingLg}, Bottom={size:SpacingLg}}"
                                ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </UniformGrid>
      </ControlTemplate>
    </Setter>

    <!-- Compact captions: the Label control theme pads its content on every side (task 32), but a pane
         caption sits flush against its swatches, so the two captions take zero padding instead -->
    <Style Selector="^ /template/ Label">
      <Setter Property="Padding" Value="{size:Edges}" />
    </Style>

    <!-- Per-pane text colour: each pane's border carries the inherited ink as TextElement.Foreground,
         which TemplatedControl.Foreground and TextBlock.Foreground share; the attached property is not
         resolved until it reaches a consumer, so each pane resolves AccentBrush Dark8 in ITS OWN region
         and the dark pane gets the dark palette's ink instead of the light-resolved near-black a single
         Foreground on the control would propagate down (Rule 13) -->
    <Style x:SetterTargetType="Border" Selector="^ /template/ Border#PART_LightPane, ^ /template/ Border#PART_DarkPane">
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Dark8}" />
    </Style>

    <!-- The scrolling viewport carries the theme's own Foreground (TextDefault), and a control's
         Foreground beats an inherited one: without this the viewer's TextDefault would shadow the
         pane's per-region ink and every preview's plain text would change colour (the light pane's
         "Hello, theme" went from the pane's AccentBrush Dark8 #080808 to TextDefault #010101, the
         dark pane's from #E1E1E1 to #EEEEEE). The viewer takes the SAME token the pane's border
         takes, resolved in the pane's OWN region, so each pane's content keeps the ink the pane
         gives it and the dark pane still gets the dark palette's ink (Rule 13) -->
    <Style Selector="^ /template/ ScrollViewer">
      <Setter Property="Foreground" Value="{color:AccentBrush Dark8}" />
    </Style>

    <!-- Side by side: one row of two equal columns -->
    <Style Selector="^[Orientation=Horizontal] /template/ UniformGrid#PART_Panes">
      <Setter Property="Rows" Value="1" />
    </Style>

    <!-- Stacked: one column of two equal rows -->
    <Style Selector="^[Orientation=Vertical] /template/ UniformGrid#PART_Panes">
      <Setter Property="Columns" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
