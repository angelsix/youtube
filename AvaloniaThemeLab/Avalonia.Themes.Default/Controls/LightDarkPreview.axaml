<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:Avalonia.Themes.Default"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: a few real controls plus a refusal-case TextBlock whose explicit Foreground
       must survive the per-pane inherited colour (Rule 13: an explicit value beats inheritance) -->
  <DataTemplate x:Key="LightDarkPreviewPreview">
    <StackPanel Spacing="{size:SpacingXl}" Width="220">
      <Button Content="Click me" Width="200" />
      <CheckBox Content="Checked" IsChecked="True" Width="200" />
      <TextBox PlaceholderText="Type here" Width="200" />
      <TextBlock Text="Hello, theme" />
      <!-- Refusal case: explicit Foreground wins over the pane's inherited colour. The ink is the
           TRUE Warning hue at its accent-text stage: theme:Accent.Kind="Warning" puts this block on
           the Warning ramp, and {color:AccentBrush Dark3} picks that ramp's most vibrant ink stage.
           The seed ({color:AccentWarningBrush}) is unreadable as text on the light canvas (1.84:1),
           and the ramp's higher-chroma stages (Dark1/Dark2) sit on the yellow of the Favourite hue.
           Dark3 is the amber one: light #89661b (5.19:1 on the canvas), dark #c59d44 (6.27:1) -->
      <TextBlock Text="Explicit warning ink" theme:Accent.Kind="Warning" Foreground="{color:AccentBrush Dark3}" />
      <!-- The caption names the token, so the picture says which one it is -->
      <TextBlock Text="Warning · AccentBrush Dark3" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:DimTextDefault}" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <p:LightDarkPreview Title="LightDarkPreview" PaneContentTemplate="{StaticResource LightDarkPreviewPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- One accent swatch: a dot in its own hue, ringed when it is the picked one. The item carries its
       hue as its own Accent.Kind, so a pick recolours the preview's content and never the swatches -->
  <ControlTheme x:Key="LightDarkPreviewSwatch" TargetType="ListBoxItem" x:DataType="theme:AccentKind">
    <!-- Visual defaults -->
    <Setter Property="theme:Accent.Kind" Value="{Binding}" />
    <Setter Property="Background" Value="{color:AccentBrush Dark3}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingSm}}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Width" Value="{size:IconSizeLg}" />
    <Setter Property="Height" Value="{size:IconSizeLg}" />
    <Setter Property="ToolTip.Tip" Value="{Binding}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The ring around the swatch -->
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The dot painted in the swatch's hue -->
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Setter Property="BorderBrush" Value="{color:TextDefault}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBrush}" />
    </Style>
  </ControlTheme>

  <!-- The row of accent swatches in a pane's header -->
  <ControlTheme x:Key="LightDarkPreviewSwatches" TargetType="ListBox">
    <!-- Visual defaults -->
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="SelectionMode" Value="AlwaysSelected" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource LightDarkPreviewSwatch}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The swatches -->
        <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>

  <!-- Two identical panes, the second flipped into a dark region; each presents an independent
       instantiation of the caller's template -->
  <ControlTheme x:Key="{x:Type p:LightDarkPreview}" TargetType="p:LightDarkPreview">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Text root: a design preview has no Window above it, so the inherited font properties a Window
         gives every control (Rule 13) are established here instead; inside a Window they restate the same values.
         Ink colour is deliberately NOT set on the control: it would resolve once in the light region and
         inherit as an already-resolved value into the dark pane (near-black on dark). Each pane's border
         carries it instead, from the per-pane style below, so the brush resolves in that pane's own region. -->
    <Setter Property="FontSize" Value="{size:FontSizeMd}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <!-- Where each pane places its caption and content across its width; a page lays it out (Center floats them mid-pane) -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The two panes, in equal cells: side by side each takes half the width, stacked each takes the full width -->
        <UniformGrid x:Name="PART_Panes">
          <!-- Light -->
          <Border Name="PART_LightPane" Padding="{size:Edges All={size:SpacingXxl}}" Background="{color:SurfaceDefaultBrush}">
            <StackPanel Spacing="{size:SpacingXl}">
              <!-- The pane's caption -->
              <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Light'}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <!-- The pane's accent picker, below the caption -->
              <ListBox Theme="{StaticResource LightDarkPreviewSwatches}" IsVisible="{TemplateBinding IsAccentPickerVisible}"
                       SelectedItem="{TemplateBinding SelectedAccent, Mode=TwoWay}" ItemsSource="{x:Static p:LightDarkPreview.AccentChoices}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <!-- The preview content -->
              <ContentControl HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" theme:Accent.Kind="{TemplateBinding SelectedAccent}"
                              ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
            </StackPanel>
          </Border>

          <!-- Dark -->
          <Border Name="PART_DarkPane" Padding="{size:Edges All={size:SpacingXxl}}" theme:ThemeRegion.IsDark="True" Background="{color:SurfaceDefaultBrush}">
            <StackPanel Spacing="{size:SpacingXl}">
              <!-- The pane's caption -->
              <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Dark'}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <!-- The pane's accent picker, below the caption -->
              <ListBox Theme="{StaticResource LightDarkPreviewSwatches}" IsVisible="{TemplateBinding IsAccentPickerVisible}"
                       SelectedItem="{TemplateBinding SelectedAccent, Mode=TwoWay}" ItemsSource="{x:Static p:LightDarkPreview.AccentChoices}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <!-- The preview content -->
              <ContentControl HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" theme:Accent.Kind="{TemplateBinding SelectedAccent}"
                              ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </ControlTemplate>
    </Setter>

    <!-- Compact captions: the Label control theme pads its content on every side (task 32), but a pane
         caption sits flush against its swatches, so the two captions take zero padding instead -->
    <Style Selector="^ /template/ Label">
      <Setter Property="Padding" Value="{size:Edges}" />
    </Style>

    <!-- Per-pane text colour: each pane's border carries the inherited ink as TextElement.Foreground,
         which TemplatedControl.Foreground and TextBlock.Foreground share; the attached property is not
         resolved until it reaches a consumer, so each pane resolves AccentBrush Dark8 in ITS OWN region
         and the dark pane gets the dark palette's ink instead of the light-resolved near-black a single
         Foreground on the control would propagate down (Rule 13) -->
    <Style x:SetterTargetType="Border" Selector="^ /template/ Border#PART_LightPane, ^ /template/ Border#PART_DarkPane">
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Dark8}" />
    </Style>

    <!-- Side by side: one row of two equal columns -->
    <Style Selector="^[Orientation=Horizontal] /template/ UniformGrid#PART_Panes">
      <Setter Property="Rows" Value="1" />
    </Style>

    <!-- Stacked: one column of two equal rows -->
    <Style Selector="^[Orientation=Vertical] /template/ UniformGrid#PART_Panes">
      <Setter Property="Columns" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
