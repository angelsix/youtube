<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: location/hue folded onto the state instances so nothing repeats. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ButtonSpinnerPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <ButtonSpinner Width="240" Content="Default" />
      <ButtonSpinner Width="240" ButtonSpinnerLocation="Left"
                     theme:Accent.Kind="Warning"
                     Content="Left · Warning" />
      <ButtonSpinner Width="240" theme:Preview.State="Hover"
                     theme:Accent.Kind="Success"
                     Content="Hover · Success" />
      <ButtonSpinner Width="240" theme:Preview.State="Pressed"
                     Content="Pressed" />
      <ButtonSpinner Width="240" ButtonSpinnerLocation="Left"
                     theme:Accent.Kind="Warning"
                     IsEnabled="False"
                     Content="Disabled · Left" />
      <ButtonSpinner Width="240" theme:Accent.Kind="Destructive"
                     Content="Error · Destructive">
        <DataValidationErrors.Error>
          <sys:Exception>
            <x:Arguments>
              <x:String>Error</x:String>
            </x:Arguments>
          </sys:Exception>
        </DataValidationErrors.Error>
      </ButtonSpinner>
      <ButtonSpinner Width="240" ShowButtonSpinner="False"
                     theme:Accent.Kind="Subtle"
                     Content="No spinner · Subtle" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ButtonSpinner" Orientation="Horizontal" ContentTemplate="{StaticResource ButtonSpinnerPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- The spinner's arrow button. Its glyph GROWS on hover and SHRINKS on press through
       DefaultGlyphMotion — the one definition the field's clear and reveal glyphs use too — so
       the arrow and the clear button are the same mechanism, not two lookalike definitions.
       For that, the arrow's chevron needs a presenter of its OWN: a theme's style reaches the
       parts of its own template, and the chevron arrives as CONTENT, not as a template part. -->
  <ControlTheme x:Key="DefaultButtonSpinnerRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource DefaultGlyphMotion}">

    <!-- Visual defaults -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Theme Exception: Stretch required to make spinner button hover effects full height -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />

    <!-- Template: deliberately not BasedOn the RepeatButton theme -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The face: the painted, rounded hit area. It NEVER scales, so the grown chevron is
             never clipped by the frame's edge. -->
        <Border Name="PART_Face"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The glyph: the chevron, the only part that grows and shrinks. It is given the
               icon's own size so its box IS the icon's box, and the scale therefore pivots
               exactly on the chevron's centre. It keeps the button's own alignment tokens, so
               the chevron sits where the old whole-presenter put it. -->
          <ContentPresenter Name="PART_Glyph"
                            Width="{size:IconSizeMd}"
                            Height="{size:IconSizeMd}"
                            HorizontalAlignment="{theme:ControlHorizontalAlignment}"
                            VerticalAlignment="{theme:ControlVerticalAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">

    <!-- Visual defaults -->
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPaddingWide}}" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Outer frame around the value and its buttons -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <!-- Layout root docking the buttons beside the value -->
            <DockPanel>
              <!-- The stacked up and down buttons: the up arrow takes the OUTER column and the
                   down arrow the inner one, so the up arrow always sits on the control's outer
                   edge and the down arrow on the inner one, next to the value. The two columns
                   swap when the spinner sits on the left, so "outer" is always the control's
                   own outer edge -->
              <Grid Name="PART_SpinnerPanel"
                    TabIndex="2"
                    ColumnDefinitions="Auto,Auto"
                    DockPanel.Dock="Right"
                    IsVisible="{TemplateBinding ShowButtonSpinner}">

                <!-- Steps the value down, repeating while held: the inner arrow -->
                <RepeatButton Name="PART_DecreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource DefaultButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}">
                  <PathIcon Data="{icons:ChevronDown}" />
                </RepeatButton>

                <!-- Steps the value up, repeating while held: the outer arrow -->
                <RepeatButton Name="PART_IncreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource DefaultButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}">
                  <PathIcon Data="{icons:ChevronUp}" />
                </RepeatButton>

              </Grid>

              <!-- The value the spinner is stepping -->
              <ContentPresenter Name="PART_ContentPresenter"
                                TabIndex="1"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Background="{TemplateBinding Background}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Spinner button padding -->
    <Style Selector="^ /template/ RepeatButton">
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingXl}}" />
      <Setter Property="BorderThickness" Value="{size:Edges Left={TemplateBinding BorderThickness}}" />
    </Style>

    <!-- Spinner icon size -->
    <Style Selector="^ /template/ RepeatButton > PathIcon">
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Arrow columns: the down arrow takes the inner column and the up arrow the outer one, so the
         up arrow always sits on the control's outer edge and the down arrow next to the value. The
         :left block swaps the two columns, because the outer edge moves to the other side -->
    <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Grid.Column" Value="0" />
    </Style>
    <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Grid.Column" Value="1" />
    </Style>

    <!-- Corner radius: the parts touching the frame follow its inner curve (ThemeRules: concentric corners) -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Left=True}" />
    </Style>
    <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Right=True}" />
    </Style>

    <!-- Hover state: on the buttons, not the Border (IsPointerOver quirk) -->
    <Style Selector="^ /template/ RepeatButton:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Hover content area -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:pointerover,
                     ^[(theme|Preview.State)=Hover] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ^[(theme|Preview.State)=Pressed] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <Style Selector="^ /template/ RepeatButton:pressed:not(:disabled)">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus-visible /template/ Border">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{color:AccentErrorBrush}" />
    </Style>
    
    <!-- Accent class: hue-agnostic, resolves against the control's Accent.Kind -->

    <!-- Left spinner position -->
    <Style Selector="^:left">
      <Style Selector="^ /template/ Grid#PART_SpinnerPanel">
        <Setter Property="DockPanel.Dock" Value="Left" />
      </Style>
      <Style Selector="^ /template/ RepeatButton">
        <Setter Property="BorderThickness" Value="{size:Edges Right={TemplateBinding BorderThickness}}" />
      </Style>
      <!-- Corner radius: the spinner on the left swaps which parts touch the frame -->
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Right=True}" />
      </Style>
      <!-- The outer edge is now the LEFT one, so the up arrow moves to the first column and the
           down arrow to the second -->
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, Left=True}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
    </Style>

    <!-- No spinner: the value fills the frame -->
    <Style Selector="^[ShowButtonSpinner=False] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={TemplateBinding CornerRadius}, Thickness={TemplateBinding BorderThickness}, All=True}" />
    </Style>

  </ControlTheme>

</ResourceDictionary>
