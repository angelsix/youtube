<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Avalonia.Controls.Converters"
        xmlns:default="clr-namespace:Avalonia.Themes.Default"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:color="using:AngelSix.ThemeEngine.Colors"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:icons="using:AngelSix.ThemeEngine.Icons">

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <!-- Tree written once; each pane (light + dark) instantiates its own copy -->
      <default:LightDarkPreview Title="TreeViewItem States" Orientation="Horizontal">
        <DataTemplate>
          <!-- Multiple lets the two selected samples coexist; narrow tree fits a half-width pane -->
          <TreeView SelectionMode="Multiple" Width="260">
            <!-- Open item: collapse chevron, and hosts the state samples beneath -->
            <TreeViewItem Header="Open - expanded" IsExpanded="True">
              <!-- Closed item with a child: expand chevron; its leaf child hits :empty (no chevron) -->
              <TreeViewItem Header="Closed - has child">
                <TreeViewItem Header="Leaf - empty" />
              </TreeViewItem>
              <!-- Plain selected: the hue's Dark3 fill with Light10 text -->
              <TreeViewItem Header="Selected" IsSelected="True" />
              <!-- Selected with a child: the chevron sits on the accent fill -->
              <TreeViewItem Header="Selected - has child" IsSelected="True">
                <TreeViewItem Header="Child" />
              </TreeViewItem>
              <!-- Forced hover: hover-background fill -->
              <TreeViewItem Header="Hovered" theme:Preview.State="Hover" />
              <!-- Disabled: flat chrome, dimmed text -->
              <TreeViewItem Header="Disabled" IsEnabled="False" />
              <!-- Disabled + selected together: no fill, dimmed text on the canvas -->
              <TreeViewItem Header="Disabled + Selected" IsEnabled="False" IsSelected="True" />
            </TreeViewItem>
          </TreeView>
        </DataTemplate>
      </default:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- Chevron sub-theme -->
  <ControlTheme x:Key="DefaultTreeViewExpandCollapseChevron" TargetType="ToggleButton">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Width" Value="{size:FontSizeSm}" />
    <Setter Property="Height" Value="{size:FontSizeSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The chevron: right when collapsed, down when expanded -->
        <Border Background="Transparent"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Path x:Name="ChevronPath"
                Fill="{TemplateBinding Foreground}"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Chevron glyph: a style, not a template value, so the expanded (checked) glyph can replace it -->
    <Style Selector="^ /template/ Path#ChevronPath">
      <Setter Property="Data" Value="{icons:ChevronRight}" />
    </Style>

    <Style Selector="^:checked /template/ Path#ChevronPath">
      <Setter Property="Data" Value="{icons:ChevronDown}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}, Vertical={size:SpacingSm}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- HorizontalContentAlignment and VerticalContentAlignment not on TreeViewItem -->
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking children under the item -->
        <StackPanel>
          <!-- Outer frame around the item row -->
          <Border Name="PART_LayoutRoot"
                  Focusable="True"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}"
                  TemplatedControl.IsTemplateFocusTarget="True">
            <!-- Places the chevron left of the item's label -->
            <Grid Name="PART_Header"
                  ColumnDefinitions="Auto, *">
              <!-- Indented area holding the chevron -->
              <Panel Name="PART_ExpandCollapseChevronContainer">
                <!-- Expands and collapses this item's children -->
                <ToggleButton Name="PART_ExpandCollapseChevron"
                              Theme="{StaticResource DefaultTreeViewExpandCollapseChevron}"
                              Focusable="False"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
              </Panel>
              <!-- The item's label -->
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Focusable="False"
                                Background="Transparent"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <!-- This item's child items -->
          <ItemsPresenter Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover, ^[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover, ^:pressed[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Dark3}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot:pointerover, ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Dark4}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Selected pressed state -->
    <Style Selector="^:pressed:selected /template/ Border#PART_LayoutRoot:pointerover, ^:pressed:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Dark5}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Disabled selected state -->
    <Style Selector="^:disabled:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Empty state -->
    <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Width" Value="{size:FontSizeSm}" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Margin" Value="{size:Edges Horizontal={size:SpacingXxl}}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
