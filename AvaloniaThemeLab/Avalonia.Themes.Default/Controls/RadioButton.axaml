<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: a switchable group plus every interaction state and accent hue. Declared before
       Design.PreviewWith uses it, so the designer and the lab gallery both show this key -->
  <DataTemplate x:Key="RadioButtonPreview">
    <StackPanel Spacing="{size:SpacingXl}">
      <!-- Interactive group: the three choices share one parent and no GroupName, so they form one selection
           group per pane (Avalonia groups un-named radios by parent; a GroupName is window-wide, which pooled
           the light and dark panes into one group and broke the crawler's restore). Sample data, not theme -->
      <StackPanel Spacing="{size:SpacingXl}">
        <RadioButton Content="Choice One" />
        <RadioButton IsChecked="True" Content="Choice Two" />
        <RadioButton Content="Choice Three" />
      </StackPanel>
      <!-- Each pinned example sits alone in its own parent (no GroupName), so it holds its intended state in both panes -->
      <Panel>
        <RadioButton Content="Unselected" />
      </Panel>
      <Panel>
        <RadioButton theme:Preview.State="Hover" Content="Hover" />
      </Panel>
      <Panel>
        <RadioButton IsChecked="True" Content="Selected" />
      </Panel>
      <Panel>
        <RadioButton theme:Preview.State="Pressed" IsChecked="True" Content="Pressed" />
      </Panel>
      <Panel>
        <RadioButton theme:Preview.State="Focused" IsChecked="True" Content="Focused" />
      </Panel>
      <Panel>
        <RadioButton IsEnabled="False" Content="Disabled" />
      </Panel>
      <!-- Hues tint the AccentBrush-driven ring and dot; combine them with states instead of repeating rows -->
      <Panel>
        <RadioButton theme:Accent.Kind="Warning" Content="Warning" />
      </Panel>
      <Panel>
        <RadioButton theme:Accent.Kind="Success" theme:Preview.State="Focused" IsChecked="True" Content="Success + Focused" />
      </Panel>
      <Panel>
        <RadioButton theme:Accent.Kind="Warning" IsChecked="True" IsEnabled="False" Content="Warning Disabled" />
      </Panel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="RadioButton" Orientation="Horizontal" ContentTemplate="{StaticResource RadioButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">

    <!-- Visual defaults: no background in any state, so the face wash is transparent throughout -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <!-- The ring: drawn in the control's text colour (Luke, 20 Oct 2026: the border role read too light),
         so it matches the label; only the checked dot takes the lighter solid fill -->
    <Setter Property="BorderBrush" Value="{color:TextDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Press animation: the whole control scales about its centre, ring and label together -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <!-- Layout root placing the circle beside its label -->
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

          <!-- Click-area wash: the button-like face that steps through the hover and pressed stages -->
          <Border x:Name="PART_Border"
                  Grid.ColumnSpan="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />

          <!-- Radio indicator, centred against the label -->
          <Grid x:Name="PART_CheckBoxGrid"
                Grid.Column="0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

            <!-- The ring: hollow, its stroke rides the control's border brush -->
            <Ellipse x:Name="RingEllipse"
                     Fill="Transparent"
                     Stroke="{TemplateBinding BorderBrush}"
                     UseLayoutRounding="False" />

            <!-- The solid centre dot revealed when selected -->
            <Ellipse x:Name="DotEllipse"
                     Opacity="0"
                     UseLayoutRounding="False" />
          </Grid>

          <!-- The radio button's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Indicator size: pinned to the icon square so the dot inset never resizes the ring -->
    <Style Selector="^ /template/ Grid#PART_CheckBoxGrid">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- The ring fills the indicator square and carries its rest stroke weight -->
    <Style Selector="^ /template/ Ellipse#RingEllipse">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="StrokeThickness" Value="{size:ThicknessSmDouble}" />
    </Style>

    <!-- The dot: large enough to read, small enough to leave a clear transparent gap inside the ring -->
    <Style Selector="^ /template/ Ellipse#DotEllipse">
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.55}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.55}" />
    </Style>

    <!-- Hover state: no background wash, only the ring's accent step and the whole control grows
         slightly, a clear step above the pressed stage below -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
      <Setter Property="BorderBrush" Value="{color:HoverTextDefault}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: the whole control sinks about its centre, ring and label together -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1}" />
      <Setter Property="BorderBrush" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Checked state: the ring keeps the control's text colour (Luke's spec: the ring reads as the
         label), and the dot in its centre carries the ACCENT, so a checked radio in Warning reads
         Warning. The dot is a MARK, not a filled face, so it takes the accent's own mark role
         ({color:AccentGlyphDefault}, Dark1) rather than the solid-fill column (Dark3): Dark1 is the
         VIVID stage in the light palette (Primary #2D789C, not the near-black #005F83 of Dark3) and
         the DEEPER stage in the dark one (Primary #4D95BB, not the pale #65ADD4), so the dot reads as
         the accent in BOTH palettes instead of collapsing into the black ring in light and washing
         out in dark. The same role the theme's other small accent marks take (the picker's pip, the
         switch's knob, the menu's check glyph). -->
    <Style Selector="^:checked">
      <Setter Property="BorderBrush" Value="{color:TextDefault}" />

      <Style Selector="^ /template/ Ellipse#DotEllipse">
        <Setter Property="Fill" Value="{color:AccentGlyphDefault}" />
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         Painted on the ring part, as CheckBox does on its box: the control's own metrics stay put -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <!-- The focus weight is 0, the weight the PINNED focus example has always drawn (task 175):
           the focus border is announced by its COLOUR, and a 1px frame would grow the control
           by 2px and shift every row below it -->
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The ring takes the focus colour; {size:ThicknessSm} is a Thickness and would read as 0 in the
         double StrokeThickness slot, so the ring keeps its rest weight and signals focus by colour -->
    <Style Selector="^:focus-visible /template/ Ellipse#RingEllipse, ^[(theme|Preview.State)=Focused] /template/ Ellipse#RingEllipse">
      <Setter Property="Stroke" Value="{color:AccentFocusBorderBrush}" />
    </Style>

    <!-- Accent-coloured label text: a radio that carries its own hue colours its TEXT by that hue,
         exactly the way a Label does (Label.axaml's accent rule) - the text takes the accent-text
         stage {color:AccentTextDefault} (Dark3) of the hue the radio names, so a Warning radio's
         label reads as amber instead of the near-black body ink the neutral role gives
         (Luke, 22 Oct 2026: "the text doesn't follow the accent ... it should colour its text by
         accent the way Label does"). The selector matches only a hue SET ON THIS RADIO, so a radio
         that merely inherits a hue from a tinted ancestor - and the neutral radio in a plain pane -
         keeps its TextDefault body ink, exactly as a plain Label does. It comes after the state
         styles, so an accented radio keeps its hue's ink in hover, pressed and focus too, instead of
         dropping back to the neutral hover ink. The ring and the checked dot are untouched: the ring
         keeps the control's text colour (Luke's spec) and the dot the accent's own mark role. -->
    <Style Selector="^[(theme|Accent.Kind)=Primary], ^[(theme|Accent.Kind)=Success], ^[(theme|Accent.Kind)=Warning], ^[(theme|Accent.Kind)=Info], ^[(theme|Accent.Kind)=Error], ^[(theme|Accent.Kind)=Destructive], ^[(theme|Accent.Kind)=Subtle]">
      <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
