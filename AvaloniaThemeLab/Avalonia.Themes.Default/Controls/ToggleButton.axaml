<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: one vertical column, one fixed width wide enough for the longest label. States are pinned on
       UNPINNED-HUE instances wherever possible, so the crawler's state pass proves them live; the pinned Checked and
       Checked·Warning·Hover rows stay untouched by the crawler and hold the filled column in the resting frame.
       Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ToggleButtonPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <ToggleButton Width="240" Content="Unchecked" />
      <ToggleButton Width="240" theme:Preview.State="Hover" Content="Hover" />
      <ToggleButton Width="240" theme:Preview.State="Pressed" Content="Pressed" />
      <ToggleButton Width="240" theme:Preview.State="Focused" Content="Focused" />
      <ToggleButton Width="240" IsEnabled="False" Content="Disabled" />
      <ToggleButton Width="240" IsChecked="True" Content="Checked" />
      <ToggleButton Width="240" theme:Accent.Kind="Warning" theme:Preview.State="Hover" IsChecked="True" Content="Checked · Warning · Hover" />
      <ToggleButton Width="240" IsChecked="True" IsEnabled="False" Content="Checked · Disabled" />
      <ToggleButton Width="240" IsThreeState="True" IsChecked="{x:Null}" Content="Indeterminate" />
      <ToggleButton Width="240" theme:Accent.Kind="Success" IsThreeState="True" IsChecked="{x:Null}" Content="Indeterminate · Success" />
      <ToggleButton Width="240" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" Content="Indeterminate · Disabled" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ToggleButton" Orientation="Vertical" ContentTemplate="{StaticResource ToggleButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">

    <!-- Visual defaults: identical to Button (outlined column) -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPaddingWide}, Vertical={size:ContentPadding}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The button's label -->
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Hover state: identical to Button -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: identical to Button -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: identical to Button (whole-face dimming, no recoloured fill) -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>

    <!-- ============================================================
         Checked column (filled): the solid-fill face ({default:SolidFill}) and its on-fill
         ink ({default:OnSolidInk}) — both chosen by the solid-fill policy
         ============================================================ -->

    <!-- Checked default: the solid-fill face with the on-fill ink the policy picks for it -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{default:SolidFill}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{default:OnSolidInk}" />
    </Style>

    <!-- Checked hover: the solid face steps one stage deeper ({default:SolidFillHover}); the on-fill ink
         is re-picked against that face, so it keeps >= 4.5:1 whichever column the hue wears -->
    <Style Selector="^:checked:pointerover, ^:checked[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{default:SolidFillHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{default:OnSolidInk}" />
    </Style>

    <!-- Checked pressed: the solid face steps two stages deeper ({default:SolidFillPressed}); the on-fill ink
         is re-picked against that face, so it keeps >= 4.5:1 whichever column the hue wears -->
    <Style Selector="^:checked:pressed, ^:checked[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{default:SolidFillPressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{default:OnSolidInk}" />
    </Style>

    <!-- Checked disabled: unlike CheckBox (only its tick-box is filled), a ToggleButton's WHOLE face is the
         solid fill, so the label rides on the vivid fill. The flat {size:DisabledOpacity} fades fill and
         on-fill ink toward each other (converging on the light canvas), dropping the label to ~1.1:1. Holding
         the face at a stronger-than-flat disabled opacity (the Scaled idiom TextBox and Slider use) restores
         the fill's depth so the Light10 label clears the plain-disabled contrast floor in both panes, while
         staying well below the enabled checked state so it still reads as disabled. Hue-independent: opacity
         is pure alpha, so it holds when the hues shift. -->
    <Style Selector="^:checked:disabled">
      <Setter Property="Opacity" Value="{size:Scaled Value={size:DisabledOpacity}, By=2.5}" />
    </Style>

    <!-- ============================================================
         Indeterminate column: the outlined ramp one stage deeper than rest
         ============================================================ -->

    <!-- Indeterminate default -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Indeterminate hover -->
    <Style Selector="^:indeterminate:pointerover, ^:indeterminate[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Indeterminate pressed -->
    <Style Selector="^:indeterminate:pressed, ^:indeterminate[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
