<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: the table as a user meets it, a header over rows that scroll beneath it.
       Sample rows are NativeMenuItem objects (Header, Gesture, ToolTip): a stock type with three
       readable properties, so the preview needs no data class of its own. The designer and the lab
       gallery both show this key, so it is declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="TableViewPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- Caption naming the state shown -->
      <TextBlock Text="Rows scroll under a fixed header" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <!-- A short viewport over more rows than fit, one chosen; the header stays put while the rows scroll -->
      <TableView Width="{size:SurfaceWidthLg}" Height="{size:Scaled Value={size:BaseSize}, By=200}" SelectedIndex="1">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="2*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="100" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Does" Binding="{Binding ToolTip}" Width="3*" />
        </TableView.Columns>
        <NativeMenuItem Header="New" Gesture="Ctrl+N" ToolTip="Blank document" />
        <NativeMenuItem Header="Open" Gesture="Ctrl+O" ToolTip="Open a file" />
        <NativeMenuItem Header="Save" Gesture="Ctrl+S" ToolTip="Write to disk" />
        <!-- A row the user cannot pick dims on its own -->
        <TableViewRow IsEnabled="False">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Print" Gesture="Ctrl+P" ToolTip="No printer" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <NativeMenuItem Header="Find" Gesture="Ctrl+F" ToolTip="Find text" />
        <NativeMenuItem Header="Replace" Gesture="Ctrl+H" ToolTip="Swap text" />
        <NativeMenuItem Header="Undo" Gesture="Ctrl+Z" ToolTip="Undo a change" />
        <NativeMenuItem Header="Redo" Gesture="Ctrl+Y" ToolTip="Redo a change" />
      </TableView>
      <!-- Caption naming the state shown. It names the hue the example below carries, so it
           takes that hue and the accent's text role -->
      <TextBlock Text="Selection follows the hue" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Success" Foreground="{color:AccentTextDefault}" />
      <!-- The whole table in another hue: frame, hairlines and the chosen rows take it -->
      <TableView Width="{size:SurfaceWidthLg}" SelectionMode="Multiple" theme:Accent.Kind="Success">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="2*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="100" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Does" Binding="{Binding ToolTip}" Width="3*" />
        </TableView.Columns>
        <TableViewRow IsSelected="True">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Cut" Gesture="Ctrl+X" ToolTip="Move selection" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <TableViewRow>
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Copy" Gesture="Ctrl+C" ToolTip="Copy selection" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <TableViewRow IsSelected="True">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Paste" Gesture="Ctrl+V" ToolTip="Insert copy" />
          </TableViewRow.DataContext>
        </TableViewRow>
      </TableView>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <!-- The whole table dims; its chosen row still reads as chosen -->
      <TableView Width="{size:SurfaceWidthLg}" IsEnabled="False" SelectedIndex="0">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="Command" Binding="{Binding Header}" Width="2*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Shortcut" Binding="{Binding Gesture}" Width="100" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Does" Binding="{Binding ToolTip}" Width="3*" />
        </TableView.Columns>
        <NativeMenuItem Header="Close" Gesture="Ctrl+W" ToolTip="Close the document" />
        <NativeMenuItem Header="Quit" Gesture="Ctrl+Q" ToolTip="Quit the app" />
      </TableView>
    </StackPanel>
  </DataTemplate>
  <Orientation x:Key="TableViewPreviewOrientation">Vertical</Orientation>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TableView" Orientation="Vertical" ContentTemplate="{StaticResource TableViewPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TableView}" TargetType="TableView">

    <!-- Visual defaults: the same outlined container as ListBox -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- A cell too narrow for its text ends in an ellipsis rather than spilling into the next column -->
    <Setter Property="TextBlock.TextTrimming" Value="{x:Static TextTrimming.CharacterEllipsis}" />

    <!-- ScrollViewer options: fixed-width columns may run wider than the table, so both bars may show -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the table. Its Padding insets the scroller off the rounded
             edge so the scroller's square corners never paint over the frame's corner arcs -->
        <Border Name="border"
                ClipToBounds="{TemplateBinding ClipToBounds}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Scrolls the rows under the column headers -->
          <ScrollViewer Name="PART_ScrollViewer"
                        Theme="{StaticResource DefaultTableViewScrollViewer}"
                        VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                        HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        IsScrollInertiaEnabled="{TemplateBinding (ScrollViewer.IsScrollInertiaEnabled)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
            <!-- The rows. The frame's Padding supplies the gutter, so no margin here -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

  <!-- Scroller with the column headers -->
  <ControlTheme x:Key="DefaultTableViewScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">

    <!-- Template: the stock scroller with a header bar docked above the scrolled rows -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root placing the bars beside the header and rows -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <!-- Header bar over the rows; shares their column so star widths match -->
          <DockPanel Name="PART_ContentPanel">
            <!-- The column headers' strip; clips headers scrolled sideways out of view -->
            <Border Name="PART_HeaderBar" DockPanel.Dock="Top" ClipToBounds="True">
              <!-- One header per column, following the rows' horizontal offset -->
              <TableViewColumnHeadersPresenter />
            </Border>
            <!-- The scrolling rows; ScrollReveal marks the viewer 'scrolling' while they move -->
            <ScrollContentPresenter Name="PART_ContentPresenter"
                                    default:ScrollReveal.Apply="True"
                                    Background="{TemplateBinding Background}"
                                    HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                    VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                    HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                    VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                    Padding="{TemplateBinding Padding}"
                                    ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
              <ScrollContentPresenter.GestureRecognizers>
                <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                         CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                         IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"/>
              </ScrollContentPresenter.GestureRecognizers>
            </ScrollContentPresenter>
          </DockPanel>
          <!-- The horizontal scrollbar -->
          <ScrollBar Name="PART_HorizontalScrollBar"
                     Orientation="Horizontal"
                     AllowAutoHide="{TemplateBinding AllowAutoHide}"
                     Grid.Row="1"/>
          <!-- The vertical scrollbar, beside the header and rows -->
          <ScrollBar Name="PART_VerticalScrollBar"
                     Orientation="Vertical"
                     AllowAutoHide="{TemplateBinding AllowAutoHide}"
                     Grid.Column="1"/>
          <!-- Fills the corner where the two bars meet -->
          <Panel x:Name="PART_ScrollBarsSeparator"
                 Grid.Row="1"
                 Grid.Column="1"
                 Opacity="0" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Header bar: a borderless surface ruled off from the rows by the accent hairline.
         Its top corners run parallel to the table's frame (Rule 19): Inset = the frame's 1px border + 4px padding.
         Its 1px side padding matches the rows' resting focus border, so header and cell columns line up -->
    <Style Selector="^ /template/ Border#PART_HeaderBar">
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="BorderBrush" Value="{color:AccentDividerDefault}" />
      <Setter Property="BorderThickness" Value="{size:Edges Bottom={size:ThicknessSmDouble}}" />
      <Setter Property="Padding" Value="{size:Edges Horizontal={size:ThicknessSmDouble}}" />
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={size:RadiusSm}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled Value={size:SpacingMd}, By=1.25}}, Top=True}" />
    </Style>

    <!-- Auto hide mode: the header and rows run under the bars -->
    <Style Selector="^[AllowAutoHide=True] /template/ DockPanel#PART_ContentPanel">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Grid.RowSpan" Value="2" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
