<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: the box's own states in the left column, the drop-down's item states in the right
       column, pinned inside a real open drop-down so they read as the rows a user picks from. The
       ComboBoxItem theme has no gallery entry of its own (task 137): its states live here. -->
  <DataTemplate x:Key="ComboBoxPreview">
    <!-- Two columns: the box states and the item states, side by side so both fit the pane at the default window size -->
    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{size:SpacingXl}">
      <!-- Left column: the box's own states -->
      <StackPanel Grid.Column="0" Spacing="{size:SpacingLg}">
        <!-- Caption naming the state shown -->
        <TextBlock Text="Rest · nothing chosen" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Resting face with nothing chosen: the prompt shows -->
        <ComboBox Width="180" PlaceholderText="Select…">
          <ComboBoxItem>Rest</ComboBoxItem>
          <ComboBoxItem>Second</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Selected" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- A value chosen: the face carries the chosen value -->
        <ComboBox Width="180" SelectedIndex="1">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Hover" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Pointer over the closed box -->
        <ComboBox Width="180" SelectedIndex="1" theme:Preview.State="Hover">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Pressed" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Held down on the closed box -->
        <ComboBox Width="180" SelectedIndex="1" theme:Preview.State="Pressed">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Focused" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Keyboard focus rings the frame (Rule 21) -->
        <ComboBox Width="180" SelectedIndex="1" theme:Preview.State="Focused">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Focused · Warning hue" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- An accented box keeps its own hue for the focus ring while FocusColorOnAccents is off (Rule 21) -->
        <ComboBox Width="180" SelectedIndex="1" theme:Preview.State="Focused" theme:Accent.Kind="Warning">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Unusable: faded to the disabled strength -->
        <ComboBox Width="180" SelectedIndex="1" IsEnabled="False">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Failed validation" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Failed validation lights the error border and keeps the box's height -->
        <ComboBox Width="180" SelectedIndex="1">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Error</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Editable" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Free-text mode swaps the picker face for a text field -->
        <ComboBox Width="180" SelectedIndex="1" IsEditable="True">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <!-- Right column: the drop-down's item states -->
      <StackPanel Grid.Column="1" Spacing="{size:SpacingLg}">
        <!-- Caption naming the section and the state of the first row -->
        <TextBlock Text="Items" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The list as the drop-down paints it: the popup's own frame (fill, border, radius and inset
             are the popup border's tokens) holding real ComboBoxItems, so every row carries the item
             theme exactly as a user's list does. The rows sit in their own list, not in the box above:
             a drop-down keeps one chosen row, so pinning "Selected" on several of one box would leave
             only the last one chosen and the labels would lie. -->
        <Border Width="190"
                Background="{color:BackgroundDefault}"
                BorderBrush="{color:BorderDefault}"
                BorderThickness="{size:ThicknessSm}"
                CornerRadius="{size:RadiusMd}"
                Padding="{size:Edges All={size:SpacingMd}}">
          <!-- The rows of the list, packed as a list packs them -->
          <StackPanel>
            <ComboBoxItem>Rest</ComboBoxItem>
            <ComboBoxItem theme:Preview.State="Hover">Hover</ComboBoxItem>
            <ComboBoxItem theme:Preview.State="Pressed">Pressed</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Selected</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Preview.State="Hover">Selected · Hover</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Warning">Selected · Warning</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Success">Selected · Success</ComboBoxItem>
            <ComboBoxItem IsEnabled="False">Disabled</ComboBoxItem>
            <ComboBoxItem IsSelected="True" IsEnabled="False">Selected · Disabled</ComboBoxItem>
          </StackPanel>
        </Border>
        <!-- Caption naming the state shown -->
        <TextBlock Text="Open · the real drop-down" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The box with its own drop-down open, so the real popup frame and its live rows are shown too (kept last so the popup overlays nothing) -->
        <ComboBox Width="190" SelectedIndex="1" IsDropDownOpen="True">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ComboBox" Orientation="Horizontal" ContentTemplate="{StaticResource ComboBoxPreview}" />
    </Border>
  </Design.PreviewWith>

  <x:Int32 x:Key="ComboBoxPopupMaxNumberOfItems">15</x:Int32>
  <x:Int32 x:Key="ComboBoxPopupMaxNumberOfItemsThatCanBeShownOnOneSide">7</x:Int32>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">

    <!-- Visual defaults -->
    <!-- Face inset: wide on the left for the text, even top/bottom so a centred value sits true -->
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}, Top={size:SpacingMd}, Bottom={size:SpacingMd}}" />
    <!-- Focus ring is the default focus ADORNER (outset, concentric, consumes no layout — Rule 19 / task 67).
         Previously nulled so the ring rode on the border bump, which grew the box 2px on focus; the bump is gone,
         so the box keeps its rest size and the adorner carries the 2px ring -->
    <Setter Property="MaxDropDownHeight" Value="504" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="PlaceholderForeground" Value="{color:DimTextDefault}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Layout root: value on the left, arrow right -->
          <Grid ColumnDefinitions="*,32">
            <!-- Outer frame around the closed box -->
            <Border x:Name="Background"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- Prompt shown when nothing is selected -->
            <TextBlock x:Name="PlaceholderTextBlock"
                       Grid.Column="0"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Margin="{TemplateBinding Padding}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- The selected item, when not editable -->
            <ContentControl x:Name="ContentPresenter"
                            Content="{TemplateBinding SelectionBoxItem}"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />

            <!-- The editable text, when editable -->
            <TextBox Name="PART_EditableTextBox"
                     Theme="{StaticResource DefaultFramelessTextBox}"
                     Grid.Column="0"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="Transparent"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     IsVisible="{TemplateBinding IsEditable}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
              </TextBox.Resources>
            </TextBox>

            <!-- Invisible hit area over the arrow -->
            <Border x:Name="DropDownOverlay"
                    Grid.Column="1"
                    Background="Transparent"
                    IsVisible="False"
                    HorizontalAlignment="Right" />

            <!-- The arrow marking this as a dropdown -->
            <PathIcon x:Name="DropDown"
                      Grid.Column="1"
                      UseLayoutRounding="False"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />

            <!-- The list shown when the box is open -->
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <!-- Panel behind the dropdown list; forwards the box's hue into the detached popup so items resolve their own accent -->
              <Border x:Name="PopupBorder"
                      HorizontalAlignment="Stretch"
                      theme:Accent.Kind="{Binding (theme:Accent.Kind), RelativeSource={RelativeSource TemplatedParent}}">
                <!-- Scrolls the list when it overflows; the frame's padding is the list's inset -->
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              IsScrollChainingEnabled="False"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <!-- The selectable items -->
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Frame keeps its own height; the error message sits below it instead of sharing the 32px with the box -->
    <Style Selector="^ /template/ Border#Background">
      <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    </Style>

    <Style Selector="^ /template/ Border#DropDownOverlay">
      <Setter Property="Width" Value="{size:ControlHeightSm}" />
      <Setter Property="Margin" Value="{size:Edges Top={size:BaseSize}, Right={size:BaseSize}, Bottom={size:BaseSize}}" />
    </Style>

    <!-- Chevron glyph: a style, not a template value, so it can be swapped by state -->
    <Style Selector="^ /template/ PathIcon#DropDown">
      <Setter Property="Data" Value="{icons:ChevronDown}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingXxl}}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Even inset all round (matches MenuFlyoutPresenter); the list's own rows carry their padding -->
    <Style Selector="^ /template/ Border#PopupBorder">
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>

    <!-- Scroller: no fill of its own; the popup frame paints it, and a square fill inside covers the frame's corners -->
    <Style Selector="^ /template/ ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border#Background, ^[(theme|Preview.State)=Hover] /template/ Border#Background">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Border#Background, ^[(theme|Preview.State)=Pressed] /template/ Border#Background">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Disabled state: the whole box fades to the disabled strength (Rule 6) -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21): the frame takes the focus weight and colour; neutral borrows magenta, an accented box keeps its own hue while FocusColorOnAccents is off -->
    <Style Selector="^:focus-visible /template/ Border#Background,
                     ^[(theme|Preview.State)=Focused] /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{color:AccentErrorBrush}" />
    </Style>

    <!-- Editable mode -->
    <Style Selector="^[IsEditable=true]">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
