<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- No design preview: a Window is a TopLevel that opens as its own OS surface; it cannot nest inside a preview pane -->
  <!-- The declared reason for that (task 176): the gallery lists a control only when the theme gives
       it a {Name}Preview, so the window would vanish from the gallery with no record of why. The
       marker is that record: a window is its own OS surface, never a preview pane's content. -->

  <default:PreviewExcluded x:Key="WindowPreviewExcluded"
                            Reason="A window opens as its own OS surface." />

  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <!-- Canvas color: SurfaceDefault follows the palette -->
    <Setter Property="Background" Value="{color:SurfaceDefaultBrush}"/>
    <Setter Property="TransparencyBackgroundFallback" Value="{color:SurfaceDefaultBrush}" />
    <Setter Property="TopLevel.SystemBarColor" Value="{color:SurfaceDefaultBrush}"/>
    <Setter Property="Foreground" Value="{color:AccentBrush Dark8}"/>
    <Setter Property="FontSize" Value="{size:FontSizeMd}"/>
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Content stretches to fill the client area -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the surface behind the content -->
        <Panel>
          <!-- Opaque fill used when transparency is unavailable -->
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <!-- The window surface -->
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <!-- Reserves space for the system title bar -->
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <!-- Hosts overlays such as tooltips and adorners -->
          <VisualLayerManager Name="PART_VisualLayerManager">
            <!-- The window's content -->
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
