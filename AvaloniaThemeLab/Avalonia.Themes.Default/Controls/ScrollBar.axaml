<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: no Preview.State/Error/Focus tokens exist, so every instance forces a REAL state:
       expand/collapse, disabled, orientation, thumb position. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ScrollBarPreview">
    <!-- Captions name every example's state. Each bar carries a finite range and a ViewportSize so
         the thumb measures a real span (a bare RangeBase defaults Maximum to PositiveInfinity).
         Hover and pressed cannot be pinned statically: the live states ride the bar's own pointer
         handling, and the crawler exercises them during the shot -->
    <!-- One fixed width on every horizontal bar; the vertical row beneath sets the stack's width,
         kept short enough to sit inside the narrowest pane -->
    <StackPanel Spacing="{size:SpacingLg}">
      <!-- Caption naming the state shown -->
      <TextBlock Text="Default · expanded" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
      <!-- Full track, full-width thumb and both arrows, the bar's own hue -->
      <ScrollBar Orientation="Horizontal" AllowAutoHide="False" Width="240" Minimum="0" Maximum="100" Value="20" ViewportSize="60"/>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Auto-hide · resting" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
      <!-- Collapsed: only the slim thumb draws; the track and arrows join it on pointer-over -->
      <ScrollBar Orientation="Horizontal" AllowAutoHide="True" Width="240" Minimum="0" Maximum="100" Value="20" ViewportSize="60"/>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Resting · disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
      <!-- Ghosted under the whole-bar dim -->
      <ScrollBar Orientation="Horizontal" AllowAutoHide="True" Width="240" Minimum="0" Maximum="100" Value="20" ViewportSize="60" IsEnabled="False"/>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Expanded · disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
      <!-- Arrows and full thumb, dimmed together -->
      <ScrollBar Orientation="Horizontal" AllowAutoHide="False" Width="240" Minimum="0" Maximum="100" Value="20" ViewportSize="60" IsEnabled="False"/>
      <!-- Caption naming the state shown -->
      <TextBlock Text="Scrolled far right" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
      <!-- The thumb parked near the end of the range -->
      <ScrollBar Orientation="Horizontal" AllowAutoHide="True" Width="240" Minimum="0" Maximum="100" Value="85" ViewportSize="60"/>
      <!-- Vertical bars mirror the matrix in two rows of three, each captioned beneath; the block
           stays inside the narrowest pane so no bar runs off the frame -->
      <StackPanel Spacing="{size:SpacingLg}">
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}">
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Full track, thumb and arrows -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="False" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Default" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
          </StackPanel>
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Slim thumb only until hover -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="True" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Auto-hide" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
          </StackPanel>
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Dimmed resting bar -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="True" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" IsEnabled="False" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}">
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Dimmed expanded bar -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="False" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" IsEnabled="False" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Full · disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
          </StackPanel>
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Thumb parked near the bottom of the range -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="True" Height="100" Minimum="0" Maximum="100" Value="85" ViewportSize="60" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Scrolled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}"/>
          </StackPanel>
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- Every part tinted by the Warning hue -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="False" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" theme:Accent.Kind="Warning" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Warning" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}"/>
          </StackPanel>
          <StackPanel Spacing="{size:SpacingSm}">
            <!-- The thumb in the BRIGHT solid-fill column: the Favourite hue's light thumb is a clear
                 yellow, which is the only place the bright column shows on a scroll bar -->
            <ScrollBar Orientation="Vertical" AllowAutoHide="False" Height="100" Minimum="0" Maximum="100" Value="20" ViewportSize="60" theme:Accent.Kind="Favourite" Width="20"/>
            <!-- Caption naming the state shown -->
            <TextBlock Text="Favourite" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Favourite" Foreground="{color:AccentTextDefault}"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ScrollBar" Orientation="Vertical" ContentTemplate="{StaticResource ScrollBarPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ScrollBar Thumb sub-theme -->
  <ControlTheme x:Key="DefaultScrollBarThumb" TargetType="Thumb">
    <!-- Visual defaults: the thumb is the DARKER element — it takes the solid-face fill policy
         ({default:SolidFill} rest, {default:SolidFillHover} hover, {default:SolidFillPressed} pressed)
         over the light-neutral groove, so it stands out in light and flips to the lighter element in dark -->
    <!-- The thumb takes the control's own hue at the solid-face stages, so an accented bar shows that
         accent in its thumb; the groove behind it recedes one stage lighter. The line buttons' arrow
         glyphs take the SAME policy, so an arrow is always exactly the thumb's colour in every state
         (Luke, 20 Oct 2026) -->
    <Setter Property="Background" Value="{default:SolidFill}"/>
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{default:SolidFill}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <!-- The thumb's radius: a CornerRadius-typed token that renders as EXACTLY HALF the thumb's own
         thickness (Avalonia clamps a corner to half the element), so both ends are true half-circles,
         never a wide radius squashed into a thinner box (Luke, 20 Oct 2026). Collapsed the pill is
         8px thick and RadiusSm (6) draws a 4px arc; the expanded state below grows the pill to 16px
         and raises the token to RadiusMd (12), drawing an 8px arc -->
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- The draggable thumb's shape: a plain rounded pill whose radius is exactly half its
               thickness, so both ends are true half-circles (Luke, 20 Oct 2026) -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!-- Transitions: the radius follows its token as the pill grows and shrinks -->
    <Setter Property="Transitions">
      <Transitions>
        <CornerRadiusTransition Property="CornerRadius" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Hover state: one fill stage deeper than rest, the same stage the arrow takes -->
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{default:SolidFillHover}" />
    </Style>

    <!-- Pressed state: deepest fill stage, the same stage the arrow takes -->
    <Style Selector="^:pressed  /template/ Border">
      <Setter Property="Background" Value="{default:SolidFillPressed}" />
    </Style>
  </ControlTheme>

  <!-- ScrollBar Page Button sub-theme -->
  <ControlTheme x:Key="DefaultScrollBarPageButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Visual defaults: paints nothing. The expanded bar shows every RepeatButton, and an opaque,
         outlined page button drew the empty track as a box (Luke, 1 Oct 2026) -->
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Light2}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{size:RadiusSm}"/>
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Opacity" Value="0" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Invisible click area above or below the thumb -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ScrollBar Line Button sub-theme -->
  <ControlTheme x:Key="DefaultScrollBarLineButton" TargetType="RepeatButton">
    <!-- Visual defaults: the arrow rests on the groove, revealed only when the bar expands -->
    <Setter Property="Background" Value="Transparent"/>
    <!-- The arrow glyph takes the SAME solid-face roles as the thumb, so an arrow is always exactly
         the thumb's colour in every state (Luke, 20 Oct 2026) -->
    <Setter Property="Foreground" Value="{default:SolidFill}" />
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{size:RadiusSm}"/>
    <!-- Hidden until the bar expands: IsVisible, not Opacity, so no broader Opacity style resurrects it -->
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The arrow on a line button -->
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"/>
      </ControlTemplate>
    </Setter>

    <!-- Hover state: the outlined column's hover stages of the bar's own hue -->
    <Style Selector="^:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{default:SolidFillHover}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed:not(:disabled)">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="Foreground" Value="{default:SolidFillPressed}" />
    </Style>
  </ControlTheme>

  <!-- ScrollBar main theme -->
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <!-- Visual defaults: the groove paints nothing while the bar rests; the expanded state below
         gives it the bar's own hue one stage deeper than the canvas, so an accented bar shows that
         accent in its track too, faint enough that the thumb (the darker element) stands out on it -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- No outline: a 1px border drew a dark frame round every scrollbar (Luke, 29 Sep 2026) -->
    <Setter Property="BorderThickness" Value="0" />
    <!-- The container radius: RadiusSm read small on a full-size bar -->
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />

    <!-- Vertical template -->
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Layout root for the vertical scrollbar -->
          <Grid x:Name="Root">
            <!-- The scrollbar's background -->
            <Border x:Name="VerticalRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Stacks the arrows above and below the track -->
              <Grid RowDefinitions="Auto,*,Auto">
                <!-- Scrolls up one line -->
                <RepeatButton Name="PART_LineUpButton"
                              HorizontalAlignment="Center"
                              Theme="{StaticResource DefaultScrollBarLineButton}"
                              Grid.Row="0"
                              Focusable="False"
                              AutomationProperties.Name="Line up">
                  <!-- The up arrow -->
                  <PathIcon x:Name="PART_LineUpIcon"
                            Data="{icons:ChevronUp}"/>
                </RepeatButton>

                <!-- The draggable region between the arrows -->
                <Track Grid.Row="1"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="{TemplateBinding Orientation}"
                       IsDirectionReversed="True">
                  <Track.DecreaseButton>
                    <!-- Jumps a page up when clicked -->
                    <RepeatButton Name="PART_PageUpButton"
                                  Theme="{StaticResource DefaultScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page up"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <!-- Jumps a page down when clicked -->
                    <RepeatButton Name="PART_PageDownButton"
                                  Theme="{StaticResource DefaultScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page down"/>
                  </Track.IncreaseButton>
                  <!-- The draggable thumb -->
                  <Thumb x:Name="PART_Thumb"
                         Theme="{StaticResource DefaultScrollBarThumb}"
                         AutomationProperties.Name="Position"/>
                </Track>

                <!-- Scrolls down one line -->
                <RepeatButton Name="PART_LineDownButton"
                              HorizontalAlignment="Center"
                              Theme="{StaticResource DefaultScrollBarLineButton}"
                              Grid.Row="2"
                              Focusable="False"
                              AutomationProperties.Name="Line down">
                  <!-- The down arrow -->
                  <PathIcon x:Name="PART_LineDownIcon"
                            Data="{icons:ChevronDown}"/>
                </RepeatButton>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Horizontal template -->
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Layout root for the horizontal scrollbar -->
          <Grid x:Name="Root">
            <!-- The scrollbar's background -->
            <Border x:Name="HorizontalRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Stacks the arrows either side of the track -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Scrolls left one line -->
                <RepeatButton Name="PART_LineUpButton"
                              Theme="{StaticResource DefaultScrollBarLineButton}"
                              VerticalAlignment="Center"
                              Grid.Column="0"
                              Focusable="False"
                              AutomationProperties.Name="Column left">
                  <!-- The left arrow -->
                  <PathIcon x:Name="PART_LineUpIcon"
                            Data="{icons:ChevronLeft}"/>
                </RepeatButton>

                <!-- The draggable region between the arrows -->
                <Track Grid.Column="1"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="{TemplateBinding Orientation}">
                  <Track.DecreaseButton>
                    <!-- Jumps a page left when clicked -->
                    <RepeatButton Name="PART_PageUpButton"
                                  Theme="{StaticResource DefaultScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page left"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <!-- Jumps a page right when clicked -->
                    <RepeatButton Name="PART_PageDownButton"
                                  Theme="{StaticResource DefaultScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page right"/>
                  </Track.IncreaseButton>
                  <!-- The draggable thumb -->
                  <Thumb x:Name="PART_Thumb"
                         Theme="{StaticResource DefaultScrollBarThumb}"
                         AutomationProperties.Name="Position"/>
                </Track>

                <!-- Scrolls right one line -->
                <RepeatButton Name="PART_LineDownButton"
                              Theme="{StaticResource DefaultScrollBarLineButton}"
                              VerticalAlignment="Center"
                              Grid.Column="2"
                              Focusable="False"
                              AutomationProperties.Name="Column right">
                  <!-- The right arrow -->
                  <PathIcon x:Name="PART_LineDownIcon"
                            Data="{icons:ChevronRight}"/>
                </RepeatButton>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Bar thickness: sized to hug the thumb -->
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="{size:Scaled Value={size:IconSizeMd}, By=1.25}" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="MinHeight" Value="{size:Scaled Value={size:IconSizeMd}, By=1.25}" />
    </Style>

    <!-- Default template element styles — vertical orientation -->
    <Style Selector="^:vertical /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <!-- The arrow glyph sits a step down from the button's full 16px square, leaving visible
         padding round it without growing the bar or its buttons (Luke, 20 Oct 2026) -->
    <Style Selector="^:vertical /template/ PathIcon#PART_LineUpIcon">
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
    </Style>
    <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
      <!-- Collapsed: the pill hugs half the bar's width (8px) so its ends stay true half-circles;
           expanding grows it to the full 16px -->
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.5}" />
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ PathIcon#PART_LineDownIcon">
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
    </Style>

    <!-- Default template element styles — horizontal orientation -->
    <Style Selector="^:horizontal /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ PathIcon#PART_LineUpIcon">
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
    </Style>
    <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
      <!-- Collapsed: the pill hugs half the bar's height (8px) so its ends stay true half-circles;
           expanding grows it to the full 16px -->
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.5}" />
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ PathIcon#PART_LineDownIcon">
      <Setter Property="Width" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=0.75}" />
    </Style>

    <!-- Expanded bar: the groove takes the bar's own hue and the arrow buttons join the thumb.
         An always-visible bar (AllowAutoHide=False) expands straight away; an auto-hide bar
         expands while its pointer is over it (:pointerover mirrors the framework's own
         IsPointerOver-driven IsExpanded, minus its ShowDelay/HideDelay grace periods) -->
    <Style Selector="^[AllowAutoHide=False], ^:pointerover">
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="BorderBrush" Value="{color:SurfaceBorderless}" />
      <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
        <!-- Expanded: the pill fills the bar's cross-axis (16px) and its radius rises to RadiusMd,
             still exactly half the drawn thickness -->
        <Setter Property="Width" Value="{size:IconSizeMd}" />
        <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
      </Style>
      <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
        <!-- Expanded: the pill fills the bar's cross-axis (16px) and its radius rises to RadiusMd,
             still exactly half the drawn thickness -->
        <Setter Property="Height" Value="{size:IconSizeMd}" />
        <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_LineUpButton,
                       ^ /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <!-- Disabled state: the whole bar dims together -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
