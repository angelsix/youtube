<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Exists only to carry the render-style clip (Rule 18): ContentControl keeps the template Avalonia gives it in code -->
  <ControlTheme x:Key="{x:Type ContentControl}" TargetType="ContentControl">

    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

  </ControlTheme>
</ResourceDictionary>
