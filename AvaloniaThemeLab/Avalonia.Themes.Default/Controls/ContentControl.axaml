<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <DataTemplate x:Key="ContentControlPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <ContentControl>
        <TextBlock Text="With content" />
      </ContentControl>
      <ContentControl />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ContentControl" ContentTemplate="{StaticResource ContentControlPreview}" />
    </Border>
  </Design.PreviewWith>

  <!-- Exists only to carry the render-style clip (Rule 18): ContentControl keeps the template Avalonia gives it in code -->
  <ControlTheme x:Key="{x:Type ContentControl}" TargetType="ContentControl">

    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

  </ControlTheme>
</ResourceDictionary>
