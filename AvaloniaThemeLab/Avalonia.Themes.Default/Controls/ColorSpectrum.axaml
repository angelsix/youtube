<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:converters="using:Avalonia.Controls.Converters">
  <!-- Design preview: the saturation and brightness square first, then the other component pairs,
       the ring shape and the states. Every square shares one colour seeded from the pane's accent
       (ColorSample), so dragging one moves the rest. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ColorSpectrumPreview">
    <!-- Two columns, so the squares fit the pane at the default window size -->
    <Grid x:Name="Sample" controls:ColorSample.Seed="{color:AccentColor}" ColumnDefinitions="Auto,Auto" ColumnSpacing="{size:SpacingXl}">
      <StackPanel Spacing="{size:SpacingXl}">
        <Label Content="Saturation · Brightness" />
        <ColorSpectrum Components="SaturationValue" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Ring" />
        <ColorSpectrum Shape="Ring" Components="HueSaturation" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Disabled" />
        <ColorSpectrum Components="SaturationValue" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" IsEnabled="False" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="{size:SpacingXl}">
        <Label Content="Hue · Saturation" />
        <ColorSpectrum Components="HueSaturation" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Focused" />
        <ColorSpectrum Components="SaturationValue" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" theme:Preview.State="Focused" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <controls:LightDarkPreview Title="ColorSpectrum" ContentTemplate="{StaticResource ColorSpectrumPreview}" />

    </Border>
  </Design.PreviewWith>

  <converters:EnumToBoolConverter x:Key="DefaultColorSpectrumShapeConverter" />
  <converters:CornerRadiusToDoubleConverter x:Key="DefaultColorSpectrumRadiusConverter" Corner="TopLeft" />

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ColorSpectrum}" TargetType="ColorSpectrum">

    <!-- Visual defaults -->
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinWidth" Value="{size:SurfaceWidthSm}" />
    <Setter Property="MinHeight" Value="{size:SurfaceWidthSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root: the space the square may fill -->
        <Panel x:Name="PART_LayoutRoot">
          <!-- The square itself, sized in code to the shorter side -->
          <Panel x:Name="PART_SizingPanel">
            <!-- The colour field, painted in code -->
            <Rectangle x:Name="PART_SpectrumRectangle"
                       IsHitTestVisible="False"
                       IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Box}}"
                       RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource DefaultColorSpectrumRadiusConverter}}"
                       RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource DefaultColorSpectrumRadiusConverter}}" />
            <!-- The colour field's second layer, painted in code -->
            <Rectangle x:Name="PART_SpectrumOverlayRectangle"
                       IsHitTestVisible="False"
                       IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Box}}"
                       RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource DefaultColorSpectrumRadiusConverter}}"
                       RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource DefaultColorSpectrumRadiusConverter}}" />
            <!-- The round colour field, painted in code -->
            <Ellipse x:Name="PART_SpectrumEllipse"
                     IsHitTestVisible="False"
                     IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Ring}}" />
            <!-- The round field's second layer, painted in code -->
            <Ellipse x:Name="PART_SpectrumOverlayEllipse"
                     IsHitTestVisible="False"
                     IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Ring}}" />
            <!-- Outline around the square field -->
            <Border x:Name="BorderRectangle"
                    IsHitTestVisible="False"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Box}}" />
            <!-- Outline around the round field -->
            <Ellipse x:Name="BorderEllipse"
                     IsHitTestVisible="False"
                     Stroke="{TemplateBinding BorderBrush}"
                     IsVisible="{TemplateBinding Shape, Converter={StaticResource DefaultColorSpectrumShapeConverter}, ConverterParameter={x:Static ColorSpectrumShape.Ring}}" />
            <!-- The surface the pointer drags on -->
            <!-- Transparent, not empty: a Canvas with no fill takes no pointer input -->
            <Canvas x:Name="PART_InputTarget" Background="Transparent">
              <!-- The marker on the chosen colour, placed in code -->
              <Panel x:Name="PART_SelectionEllipsePanel">
                <!-- The marker's ring -->
                <Ellipse x:Name="SelectionEllipse" IsHitTestVisible="False" />
              </Panel>
            </Canvas>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Square placement inside the layout root -->
    <Style Selector="^ /template/ Panel#PART_SizingPanel">
      <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>

    <!-- Round field outline weight -->
    <Style Selector="^ /template/ Ellipse#BorderEllipse">
      <Setter Property="StrokeThickness" Value="{size:ThicknessSmDouble}" />
    </Style>

    <!-- Marker size -->
    <Style Selector="^ /template/ Panel#PART_SelectionEllipsePanel">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:large-selector /template/ Panel#PART_SelectionEllipsePanel">
      <Setter Property="Width" Value="{size:IconSizeXl}" />
      <Setter Property="Height" Value="{size:IconSizeXl}" />
    </Style>

    <!-- Marker ring: dark on a light colour, light on a dark one, whatever the palette -->
    <Style Selector="^ /template/ Ellipse#SelectionEllipse">
      <Setter Property="StrokeThickness" Value="{size:ThicknessMdDouble}" />
      <!-- Theme Exception: the field under the ring is code-drawn artwork that never changes with the palette,
           so the ring takes the two seeds that never move either (Neutral ink, Surface paper), not a palette-mirrored stage -->
      <Setter Property="Stroke" Value="{color:AccentNeutralBrush}" />
    </Style>
    <Style Selector="^:light-selector /template/ Ellipse#SelectionEllipse">
      <!-- Theme Exception: the palette-fixed paper seed, for the reason above -->
      <Setter Property="Stroke" Value="{color:AccentSurfaceBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         Keyboard focus also draws the default outset ring; the outline carries the focus colour -->
    <Style Selector="^:focus-visible /template/ Border#BorderRectangle, ^[(theme|Preview.State)=Focused] /template/ Border#BorderRectangle">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
