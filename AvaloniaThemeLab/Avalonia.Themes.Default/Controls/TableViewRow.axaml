<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: every state a row can be in, pinned inside one real table, the way a user
       meets them (a row has no cells outside a table). Multiple selection keeps every pinned
       "Selected" row chosen. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="TableViewRowPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <!-- Caption naming the states shown -->
      <TextBlock Text="Row states" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <TableView Width="{size:Scaled Value={size:SurfaceWidthLg}, By=1.25}" SelectionMode="Multiple">
        <TableView.Columns>
          <TableViewColumn x:DataType="NativeMenuItem" Header="State" Binding="{Binding Header}" Width="2*" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Key" Binding="{Binding Gesture}" Width="120" />
          <TableViewColumn x:DataType="NativeMenuItem" Header="Note" Binding="{Binding ToolTip}" Width="2*" />
        </TableView.Columns>
        <!-- Rest: the row's plain state -->
        <TableViewRow>
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Default" Gesture="Ctrl+1" ToolTip="At rest" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- Hover: the row's hover fill, pinned -->
        <TableViewRow theme:Preview.State="Hover">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Hover" Gesture="Ctrl+2" ToolTip="Pointer over" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- Pressed: the row's pressed fill, pinned -->
        <TableViewRow theme:Preview.State="Pressed">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Pressed" Gesture="Ctrl+3" ToolTip="Button down" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- Selected: the outlined column, a light fill stage of the row's own hue -->
        <TableViewRow IsSelected="True">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Selected" Gesture="Ctrl+4" ToolTip="Chosen" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- The same rule under another accent kind: the fill takes that hue -->
        <TableViewRow IsSelected="True" theme:Accent.Kind="Warning">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Selected · Warning" Gesture="Ctrl+5" ToolTip="Chosen, in a hue" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- Disabled: the whole row dims -->
        <TableViewRow IsEnabled="False">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Disabled" Gesture="Ctrl+6" ToolTip="Unavailable" />
          </TableViewRow.DataContext>
        </TableViewRow>
        <!-- Disabled beats selection, keeping the chosen fill under the dim -->
        <TableViewRow IsEnabled="False" IsSelected="True">
          <TableViewRow.DataContext>
            <NativeMenuItem Header="Disabled + Selected" Gesture="Ctrl+7" ToolTip="Chosen, unavailable" />
          </TableViewRow.DataContext>
        </TableViewRow>
      </TableView>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="TableViewRow" Orientation="Vertical" ContentTemplate="{StaticResource TableViewRowPreview}" />

    </Border>
  </Design.PreviewWith>
  <Orientation x:Key="TableViewRowPreviewOrientation">Vertical</Orientation>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">

    <!-- Visual defaults: the list row's look (ListBoxItem, ComboBoxItem), with a resting
         transparent hairline border that focus colours in place -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Parallel to the table's curved frame (Rule 19): the frame's radius pulled in by its 1px border + 4px padding -->
    <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={size:RadiusSm}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled Value={size:SpacingMd}, By=1.25}}, All=True}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <!-- The cells carry the content padding, so the row adds none and its columns line up with the headers -->
    <Setter Property="Padding" Value="{size:Edges}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Focus is the row's own inset border (below): an outset ring is cut by the table's scroller and crosses its frame -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the row over its bottom hairline -->
        <DockPanel>
          <!-- Hairline ruling this row off from the next -->
          <Border Name="PART_Divider" DockPanel.Dock="Bottom" />
          <!-- The row face that shows hover, selection and focus -->
          <Border Name="PART_RowFace"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- One cell per column, laid out to the header widths -->
            <TableViewCellsPresenter Name="PART_CellsPresenter"
                                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- Divider -->
    <Style Selector="^ /template/ Border#PART_Divider">
      <Setter Property="Height" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Background" Value="{color:AccentDividerDefault}" />
    </Style>

    <!-- Last row: the table's frame already closes it -->
    <Style Selector="^:nth-last-child(1) /template/ Border#PART_Divider">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border#PART_RowFace,
                     ^[(theme|Preview.State)=Hover] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Border#PART_RowFace,
                     ^[(theme|Preview.State)=Pressed] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: the whole row fades, selected or not, so a chosen-but-unavailable row still reads as chosen -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Selected state: the outlined column, not the filled one, exactly as ListBoxItem and ComboBoxItem -->
    <Style Selector="^:selected /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundDefault}" />
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover /template/ Border#PART_RowFace,
                     ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundHover}" />
    </Style>

    <!-- Selected pressed state -->
    <Style Selector="^:selected:pressed /template/ Border#PART_RowFace,
                     ^:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundPressed}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         After the selected styles so a chosen row keeps its focus border; resting weight, so focus never resizes the row -->
    <Style Selector="^:focus-visible, ^:selected:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
