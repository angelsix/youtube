<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: one link per line, every instance the same width. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="HyperlinkButtonPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <HyperlinkButton Width="240" Content="Default" />
      <HyperlinkButton Width="240" theme:Preview.State="Hover" Content="Hover" />
      <HyperlinkButton Width="240" theme:Preview.State="Pressed" Content="Pressed" />
      <HyperlinkButton Width="240" theme:Preview.State="Focused" Content="Focused" />
      <HyperlinkButton Width="240" Content="Disabled" IsEnabled="False" />
      <!-- Accents recolour the text through the hue-aware ramp -->
      <HyperlinkButton Width="240" theme:Accent.Kind="Warning" theme:Preview.State="Hover" Content="Warning · Hover" />
      <HyperlinkButton Width="240" theme:Accent.Kind="Success" theme:Preview.State="Focused" Content="Success · Focused" />
      <!-- Size parity with a Button (task 83): same padding, so both measure identically tall -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" HorizontalAlignment="Left">
        <Button Width="120" Content="Button" />
        <HyperlinkButton Width="120" Content="Link" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="HyperlinkButton" Orientation="Vertical" ContentTemplate="{StaticResource HyperlinkButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton">

    <!-- Visual defaults: plain text, no fill, border or underline; the focus ring is the only frame (Rule 21) -->
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="theme:Accent.Kind" Value="Primary" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
    <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <!-- Same outer size as a Button (task 83): Button's padding, no fill or border -->
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ContentPaddingWide}, Vertical={size:ContentPadding}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The link text -->
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Hover state: the ink stays at the accent text stage (Dark3) like every other accent text;
         feedback is the half-strength grow (task 111), no invented colour or underline -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.045}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: the ink stays at Dark3; feedback is the half-strength shrink (task 111) -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.01}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <!-- The focus weight is 0, the weight the PINNED focus example has always drawn (task 175):
           the focus border is announced by its COLOUR, and a 1px frame would grow the control
           by 2px and shift every row below it -->
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Visited state: stays at the accent text stage (Dark3). The former Dark2 was lighter than
         Dark3 but fell under 4.5:1 on the light canvas for some hues (measured: Warning 2.49:1),
         so it cannot stay distinct; the ink is uniform in every state -->
    <Style Selector="^:visited">
      <Setter Property="Foreground" Value="{color:AccentTextDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
