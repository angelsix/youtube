<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: a horizontal rule stretched across the pane, and a vertical rule dividing two items in a row.
       Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="SeparatorPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <Separator />
      <!-- A vertical rule dividing two items in a row: the grid cell stretches it to the row's height -->
      <Grid ColumnDefinitions="*, Auto, *" Height="{size:ControlHeightMd}">
        <Label Content="First item" Grid.Column="0" />
        <!-- A vertical rule: its length runs down the row, so the instance names it here -->
        <Separator Grid.Column="1"
                   Margin="{size:Edges All={size:SpacingSm}}"
                   Width="{size:ThicknessSmDouble}"
                   Height="{size:ControlHeightMd}" />
        <Label Content="Second item" Grid.Column="2" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="Separator" ContentTemplate="{StaticResource SeparatorPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <!-- Visual defaults: a divider stays neutral whatever the enclosing hue -->
    <Setter Property="Background" Value="{color:NeutralDark1Brush}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="{size:ThicknessSmDouble}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="Margin" Value="{size:Edges Horizontal={size:SpacingXxl}, Vertical={size:SpacingMd}}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The divider line -->
        <Border Padding="{TemplateBinding Margin}"
                Height="{TemplateBinding Height}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
