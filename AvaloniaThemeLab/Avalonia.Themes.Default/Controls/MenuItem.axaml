<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <conv:PlatformKeyGestureConverter x:Key="KeyGestureConverter" />

  <!-- The tick drawn beside a checked item; local so the :checked:toggle style always resolves it.
       An open polyline, painted as a stroke (filling an unclosed path would draw nothing) -->
  <PathGeometry x:Key="CheckedTickPathData" Figures="M 0,5 L 4,9 L 11,1" />

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Concentric with the menu container (Rule 19): the container's RadiusMd minus its border and padding,
         so the row's curve runs parallel to the frame's -->
    <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={size:RadiusMd}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled Value={size:SpacingMd}, By=1.25}}, All=True}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Even vertical edges so the label sits true centre (was Top 4 / Bottom 8) -->
    <Setter Property="Padding" Value="{size:Edges All={size:ContentPadding}}" />
    <!-- A menu row is a container: it fills the list's width, and so does its highlight and hit area -->
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <!-- Focus is the row's own inset border (below): an outset ring is cut by the menu's scroller and crosses its frame -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the item and its submenu -->
        <Panel>
          <!-- Outer frame around the menu item -->
          <Border Name="PART_LayoutRoot"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Columns: one shared leading check-or-icon column, label, shortcut and chevron.
                 The check and the icon share the SAME cell: an item shows its check if it is a
                 toggle, otherwise its icon, never both, and the column (SharedSizeGroup on the
                 IsSharedSizeScope presenter) collapses to 0 when no item in the menu carries one -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemLeading" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemIGT" />
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemChevron" />
              </Grid.ColumnDefinitions>

              <!-- The tick shown when the item is checked -->
              <ContentControl Grid.Column="0"
                              x:Name="PART_ToggleIconPresenter"
                              IsVisible="False"
                              Theme="{StaticResource DefaultMenuItemIconTheme}" />

              <!-- The item's icon, in the same leading cell as the tick (a toggle's check wins) -->
              <ContentControl Grid.Column="0"
                              x:Name="PART_IconPresenter"
                              IsVisible="False"
                              Theme="{StaticResource DefaultMenuItemIconTheme}"
                              Content="{TemplateBinding Icon}" />

              <!-- The item's label -->
              <ContentPresenter Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Grid.Column="1"/>
              <!-- The keyboard shortcut, shown on the right -->
              <TextBlock x:Name="PART_InputGestureText"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureConverter}}"/>
              <!-- Chevron marking an item with a submenu -->
              <Path Name="PART_ChevronPath"
                    Stretch="Uniform"
                    Data="{icons:ChevronRight}"
                    Grid.Column="3" />
            </Grid>
          </Border>
          <!-- The submenu shown when opened -->
          <Popup Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <!-- Panel behind the submenu: the same even inset as every other menu surface (one source),
                 so hover fills stop short of the parent's border instead of cutting into it -->
            <Border x:Name="PART_PopupBorder"
                    Padding="{size:Edges All={size:SpacingMd}}"
                    MaxWidth="{size:Scaled Value={size:BaseSize}, By=456}"
                    HorizontalAlignment="Stretch">
              <!-- Scrolls the submenu when it overflows -->
              <ScrollViewer Theme="{StaticResource DefaultMenuScrollViewer}">
                <!-- The submenu entries -->
                <ItemsPresenter x:Name="PART_PopupItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalContentAlignment}" />
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>

    <!-- Themed defaults for inner template elements (Rule 2) -->
    <!-- Leading-cell size: centred against the ROW'S OWN highlight edge (fourth-review steer, 20 Oct 2026),
         not the menu's outer border. The slot is IconSizeMd (16) wide with NO left margin of its own (the
         row's own {size:ContentPadding} supplies the left inset) and a right margin of {size:ContentPadding}:
         the 16px ink fills the slot, so the gap from the row's highlight edge to the ink equals the gap from
         the ink to the label within 1px (both are the row's ContentPadding; the 1px concentric border shifts
         only the left side by 1). Column = 16 + 8 = 24px, so the shared size-group still collapses to 0 when
         no item carries a check or an icon. The height is IconSizeMd + 12.5% (18), clearing the glyph's
         natural line box so the DownOnly Viewbox never squashes it flatter than life (a 16px-tall slot drew
         the face flat). Both presenters share the SAME cell, so the column is one slot wide. Task 129 copies
         these tokens into TreeView. -->
    <Style Selector="^ /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=1.125}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:ContentPadding}}" />
    </Style>
    <Style Selector="^ /template/ ContentControl#PART_IconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:Scaled Value={size:IconSizeMd}, By=1.125}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:ContentPadding}}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXxl}}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    </Style>
    <!-- No extra left margin: the item's own right padding spaces the chevron from the label -->
    <Style Selector="^ /template/ Path#PART_ChevronPath">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Fill" Value="{color:AccentBrush Light1}" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    </Style>
    <Style Selector="^ /template/ Popup#PART_Popup">
      <Setter Property="HorizontalOffset" Value="{size:Scaled Value={size:SpacingMd}, By=-1}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_PopupBorder">
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>
    <Style Selector="^:icon /template/ ContentControl#PART_IconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Selected: the outlined column, not the filled one — a light fill stage of the row's own hue,
         so a chosen row reads as picked without going dark (Decision, 18 Oct 2026; ComboBoxItem is the reference) -->
    <!-- Selected: driven by the real :selected pseudo-class (IsSelected=True); no Preview.State needed -->
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot,
                     ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Light5}" />
    </Style>
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot,
                     ^:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:AccentBrush Light4}" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentBrush Dark1}" />
    </Style>
    <!-- The shortcut is secondary text; on an elevated selected row it reads at full weight so it stays legible on the fill -->
    <Style Selector="^:selected /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{color:TextDefault}" />
    </Style>

    <!-- Hover: an opaque ramp stage, not an overlay — translucency would erase the fill -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_ChevronPath,
                     ^[(theme|Preview.State)=Hover] /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentBrush Dark1}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:pressed /template/ Path#PART_ChevronPath,
                     ^[(theme|Preview.State)=Pressed] /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentBrush Dark1}" />
    </Style>

    <!-- Disabled: the whole row fades, selected or not, so a chosen-but-unavailable item still reads as chosen -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus: the row's own inset border (Rule 21); neutral borrows the focus colour, an accented row keeps its own hue -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Focused] /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>

    <Style Selector="^:open /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentBrush Dark1}" />
    </Style>

    <Style Selector="^:empty /template/ Path#PART_ChevronPath">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- The divider line between menu groups -->
          <Separator/>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^ /template/ Image#PART_ToggleIconImage">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Content">
        <Template>
          <!-- Stroked, not filled: the tick is an open polyline -->
          <Path Stroke="{Binding $parent[MenuItem].Foreground}"
                StrokeThickness="{size:ThicknessSmDouble}"
                Stretch="Uniform"
                Width="{size:IconSizeMd}" Height="{size:IconSizeMd}"
                Data="{StaticResource CheckedTickPathData}" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Content">
        <Template>
          <Ellipse Fill="{Binding $parent[MenuItem].Foreground}"
                   Margin="{size:Edges All={size:SpacingMd}}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" />
        </Template>
      </Setter>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="HorizontalMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DefaultTopLevelMenuItem}">
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXl}, Top={size:SpacingMd}, Right={size:SpacingXl}, Bottom={size:SpacingLg}}" />
    <Setter Property="Margin" Value="{size:Edges Horizontal={size:SpacingSm}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
  </ControlTheme>

  <ControlTheme x:Key="DefaultMenuItemIconTheme"
                TargetType="ContentControl">
    <!-- Visual defaults -->
    <Setter Property="Width"
            Value="{size:IconSizeMd}" />
    <Setter Property="Height"
            Value="{size:IconSizeMd}" />
    <!-- Centres the glyph in its shared leading cell (task 105): the Viewbox below binds this, so the
         check/icon ink sits equidistant from the cell's edges instead of hugging the left -->
    <Setter Property="HorizontalAlignment" Value="{theme:ButtonHorizontalContentAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Scales the icon to fit its column -->
        <Viewbox
          StretchDirection="DownOnly"
          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
          VerticalAlignment="{TemplateBinding VerticalAlignment}">
          <!-- The icon artwork -->
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
