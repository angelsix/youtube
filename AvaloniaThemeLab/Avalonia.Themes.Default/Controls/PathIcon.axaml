<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors">
  <!-- Design preview: the glyph stepped down the icon ladder (labelled, on one baseline), then tinted
       through the accent hues by its container, never by the icon itself (Rule 13). Declared before
       Design.PreviewWith uses it, so the designer and the lab gallery both show this key -->
  <DataTemplate x:Key="PathIconPreview">
    <StackPanel Orientation="Vertical" Spacing="{size:SpacingXl}">
      <!-- Sizes: the icon ladder Sm..Xl, each labelled, tops on one baseline so the scale reads as a scale.
           The row carries the default accent ink ({color:AccentTextDefault}, no Accent.Kind) so a default
           icon follows the gallery's default accent instead of staying the pane's black/grey (task 92) -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingXxl}" TextElement.Foreground="{color:AccentTextDefault}">
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}">
          <TextBlock Text="Sm" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeSm}" Height="{size:IconSizeSm}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}">
          <TextBlock Text="Md" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}">
          <TextBlock Text="Lg" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeLg}" Height="{size:IconSizeLg}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}">
          <TextBlock Text="Xl" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeXl}" Height="{size:IconSizeXl}" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <!-- Default accent · Primary: an explicit Accent.Kind on the container proves a picked hue reaches the icon;
           its ink is the accent-text stage {color:AccentTextDefault}, the same stage a neutral default reads as -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingXxl}">
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}" theme:Accent.Kind="Primary" TextElement.Foreground="{color:AccentTextDefault}">
          <TextBlock Text="Default accent · Primary" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <!-- Accents: the icon sets no Foreground; its container carries the hue and the ink, so the glyph follows it -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingXxl}">
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}" theme:Accent.Kind="Primary" TextElement.Foreground="{color:AccentTextDefault}">
          <TextBlock Text="Primary" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}" theme:Accent.Kind="Warning" TextElement.Foreground="{color:AccentTextDefault}">
          <TextBlock Text="Warning" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{size:SpacingSm}" theme:Accent.Kind="Success" TextElement.Foreground="{color:AccentTextDefault}">
          <TextBlock Text="Success" HorizontalAlignment="Center" />
          <PathIcon Data="{icons:Star}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="PathIcon" Orientation="Vertical" ContentTemplate="{StaticResource PathIconPreview}" />

    </Border>
  </Design.PreviewWith>
  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">

    <!-- Visual defaults. No Foreground: a glyph inherits its container's text colour, so it follows a hover,
         a checked fill or a disabled parent (ThemeRules Rule 13). A template wanting another colour sets it there -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{size:IconSizeMd}" />
    <Setter Property="Width" Value="{size:IconSizeMd}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The icon's background area -->
        <Border Background="{TemplateBinding Background}">
          <!-- Scales the glyph to the requested size -->
          <Viewbox Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
            <!-- The icon artwork -->
            <Path Fill="{TemplateBinding Foreground}" Data="{TemplateBinding Data}" Stretch="Uniform" />
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
