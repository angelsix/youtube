<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: every item state the theme paints, pinned INSIDE real context menus (task 139 folds the
       former MenuItem / MenuFlyoutPresenter / MenuScrollViewer previews in here): the framed flyout-surface look,
       the leading-column rhythm (glyph centred against the ROW'S OWN highlight edge, fourth-review steer), and the
       scroll viewer's overflow arrows (the last menu caps its height, so the list scrolls and the down chevron
       shows). Three menus, one per concern: states, decorations, checks-and-submenu. Declared before
       Design.PreviewWith uses it -->
  <DataTemplate x:Key="ContextMenuPreview">
    <StackPanel Spacing="{size:SpacingSm}" HorizontalAlignment="Left">
      <!-- Caption naming the first surface -->
      <TextBlock Text="States: rest · hover · pressed · focused · disabled · selected · separator" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
      <!-- States only: no check or icon anywhere, so the shared leading column collapses to 0 and the plain-row
           text inset stays tight; every pseudo-class is pinned on its own row. The separator sits ABOVE the
           disabled row (task 142): it used to sit at the very bottom of the list, under the selected row,
           which is a strange place for a divider — it now divides the interactive states from the
           unavailable one, the way a menu's groups read. -->
      <ContextMenu Width="240">
        <MenuItem Header="Rest" />
        <MenuItem Header="Ho_ver" theme:Preview.State="Hover" />
        <MenuItem Header="Pres_sed" theme:Preview.State="Pressed" />
        <MenuItem Header="Fo_cused" theme:Preview.State="Focused" />
        <Separator />
        <MenuItem Header="Dis_abled" IsEnabled="False" />
        <MenuItem Header="Sele_cted" IsSelected="True" />
      </ContextMenu>
      <!-- Caption naming the second surface: it names the example's accent, so it takes the same hue
           (task 150). The menu beneath carries ONE hue (the Warning row), so the caption is Warning
           too, at the accent-text stage. -->
      <TextBlock Text="Decorations: icon · shortcut · submenu chevron · accent hue" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
      <!-- Decorations: the icon row carries the steered centring (gap highlight-edge→ink == gap ink→label);
           the icon-less rows keep the same single icon-width column; the accent row pins a Warning hue -->
      <ContextMenu Width="240">
        <!-- The steered centring is judged against this row's OWN highlight edge (the row's inner face);
             the Highlight row above demonstrates the paint, the geometry here proves the equal gaps -->
        <MenuItem Header="With _Icon">
          <MenuItem.Icon>
            <PathIcon Data="{icons:Star}" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Short_cut" InputGesture="Ctrl+G" />
        <MenuItem Header="Plain _Row" />
        <MenuItem Header="Warn_ing Hue" theme:Accent.Kind="Warning" />
      </ContextMenu>
      <!-- Caption naming the third surface: it names the example's accent, so it takes the same hue
           (task 150). The menu beneath carries ONE hue (the nested Report Bug row), so the caption is
           Success too, at the accent-text stage. -->
      <TextBlock Text="Checks and submenu: check · radio · nested accent" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Success" Foreground="{color:AccentTextDefault}" />
      <!-- Checks and submenu: the tick and the icon share ONE leading column; the nested Report Bug pins a
           Success hue inside the sub-menu. The scroll viewer's overflow arrows are shown by the Menu entry's
           capped File drop-down (its list overflows the popup, so the down chevron draws) -->
      <ContextMenu Width="240">
        <MenuItem Header="Wi_th Check" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Ra_dio Dot" ToggleType="Radio" IsChecked="True" />
        <MenuItem Header="With _Glyph">
          <MenuItem.Icon>
            <PathIcon Data="{icons:Star}" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="More_…">
          <MenuItem Header="Recent" />
          <MenuItem Header="Clear History" />
          <MenuItem Header="Report Bug" theme:Accent.Kind="Success" />
        </MenuItem>
        <!-- The chevron marks a sub-menu; its right-side inset shares the row-padding rhythm -->
        <MenuItem Header="Sub_menu">
          <MenuItem Header="First" />
          <MenuItem Header="Second" />
        </MenuItem>
      </ContextMenu>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ContextMenu" Orientation="Horizontal" ContentTemplate="{StaticResource ContextMenuPreview}" />
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Even inset all round (matches MenuFlyoutPresenter's surface); the list's own rows carry their padding -->
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="MaxWidth" Value="{size:Scaled Value={size:BaseSize}, By=456}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <!-- Disable horizontal scrolling so the scroller hands the list a finite width and every row stretches to it (as MenuFlyoutPresenter does) -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Panel behind the menu -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                MaxWidth="{TemplateBinding MaxWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Scrolls the menu when it overflows -->
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        Theme="{StaticResource DefaultMenuScrollViewer}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <!-- The menu entries -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"
                            Grid.IsSharedSizeScope="True" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- The menu scroller fills the frame (its own theme left-aligns it); that finite width is what lets every row stretch -->
    <Style Selector="^ /template/ ScrollViewer">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
