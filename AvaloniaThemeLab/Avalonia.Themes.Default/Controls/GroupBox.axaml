<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <!-- One row per pane: the theme exposes no Preview.State or :error selectors, so its full surface is enabled/disabled plus inherited accent hue -->
      <default:LightDarkPreview Title="GroupBox States" Orientation="Horizontal">
        <DataTemplate>
          <StackPanel Orientation="Vertical" Spacing="16" Width="340">
            <GroupBox Header="Default">
              <TextBlock Text="Grouped content" />
            </GroupBox>
            <!-- Disabled rides the Warning hue so both axes show in one instance -->
            <GroupBox Header="Warning · Disabled" theme:Accent.Kind="Warning" IsEnabled="False">
              <TextBlock Text="Grouped content" />
            </GroupBox>
            <GroupBox Header="Success" theme:Accent.Kind="Success">
              <TextBlock Text="Grouped content" />
            </GroupBox>
          </StackPanel>
        </DataTemplate>
      </default:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type GroupBox}"
                TargetType="GroupBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="FontSize" Value="{size:FontSizeLg}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root: header row over the framed content, with an inset column either side -->
        <Grid x:Name="RootGrid" UseLayoutRounding="true" ColumnDefinitions="6,Auto,*,6" RowDefinitions="Auto,Auto,*,6">
          <!-- Background border, kept apart from the stroke border -->
          <Border Grid.Row="1"
                  Grid.RowSpan="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="Transparent"
                  Background="{TemplateBinding Background}" />

          <!-- Stroke border with opacity mask for the header notch; the notch starts at the header's X -->
          <Border Grid.Row="1"
                  Grid.RowSpan="3"
                  Grid.ColumnSpan="4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <Border.OpacityMask>
              <!-- Theme Exception: a control-specific converter (Rule 10) because the notch reads the header's live laid-out position, which no token or markup extension can read -->
              <MultiBinding Converter="{x:Static default:GroupBoxNotchMaskConverter.Instance}">
                <Binding ElementName="Header"
                         Path="Bounds.X" />
                <Binding ElementName="Header"
                         Path="Bounds.Width" />
                <Binding RelativeSource="{RelativeSource Self}"
                         Path="Bounds.Width" />
                <Binding RelativeSource="{RelativeSource Self}"
                         Path="Bounds.Height" />
              </MultiBinding>
            </Border.OpacityMask>
          </Border>

          <!-- Header -->
          <Border x:Name="Header"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="1">
            <!-- The group's title -->
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              UseLayoutRounding="{TemplateBinding UseLayoutRounding}" />
          </Border>

          <!-- Content -->
          <ContentPresenter Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            UseLayoutRounding="{TemplateBinding UseLayoutRounding}"
                            Margin="{TemplateBinding Padding}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Header padding, and an offset of one corner radius so the notch starts on the frame's straight edge, past its curve -->
    <Style Selector="^ /template/ Border#Header">
      <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:RadiusSmDouble}}" />
    </Style>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
