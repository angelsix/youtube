<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
  <!-- Design preview: the splitter between two panes so the bar is visible. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="GridSplitterPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*, Auto, *">
        <Border Grid.Column="0" Background="{color:BackgroundDefault}" Margin="{size:Edges All={size:SpacingSm}}" />
        <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Column="2" Background="{color:BackgroundDefault}" Margin="{size:Edges All={size:SpacingSm}}" />
      </Grid>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="GridSplitter" ContentTemplate="{StaticResource GridSplitterPreview}" />

    </Border>
  </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Background" Value="{color:AccentBrush Light6}" />
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
      <Setter Property="PreviewContent">
        <Template>
          <Rectangle Fill="{color:AccentPrimaryBrush}" />
        </Template>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- The draggable bar between two panes -->
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
</ResourceDictionary>
