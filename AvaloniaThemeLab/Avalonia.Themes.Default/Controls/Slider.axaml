<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: two columns per pane — the horizontal examples down the left, the vertical ones
       down the right — so every labelled example stays inside the 1200x800 frame. States are pinned with
       Preview.State following the house pattern (paired with the live pseudo-class in the theme); the
       accent rows prove the hue travels. Declared before Design.PreviewWith uses it.
       Theme Exception: SpacingSm (not the standard SpacingXl) and 72-tall verticals — fourteen labelled
       examples must all fit the pane without scrolling; at SpacingXl the last rows run off the bottom -->
  <DataTemplate x:Key="SliderPreview">
    <Grid ColumnDefinitions="Auto,*">
      <StackPanel Spacing="{size:SpacingSm}">
        <Label Content="Default" />
        <Slider Width="240" Value="50" />
        <Label Content="Reversed" />
        <Slider Width="240" IsDirectionReversed="True" Value="50" />
        <Label Content="Ticks outside" />
        <Slider Width="240" Value="50" TickPlacement="Outside" TickFrequency="10" />
        <Label Content="Hover" />
        <Slider Width="240" Value="50" theme:Preview.State="Hover" />
        <Label Content="Pressed" />
        <Slider Width="240" Value="50" theme:Preview.State="Pressed" />
        <Label Content="Focused" />
        <Slider Width="240" Value="50" theme:Preview.State="Focused" />
        <Label Content="Disabled" />
        <Slider Width="240" Value="50" IsEnabled="False" />
        <Label Content="Warning" theme:Accent.Kind="Warning" Foreground="{color:AccentTextDefault}" />
        <Slider Width="240" Value="50" theme:Accent.Kind="Warning" />
        <Label Content="Success" theme:Accent.Kind="Success" Foreground="{color:AccentTextDefault}" />
        <Slider Width="240" Value="50" theme:Accent.Kind="Success" />
        <Label Content="Error" theme:Accent.Kind="Error" Foreground="{color:AccentTextDefault}" />
        <Slider Width="240" Value="50">
          <DataValidationErrors.Error>
            <sys:Exception><x:Arguments><x:String>Error</x:String></x:Arguments></sys:Exception>
          </DataValidationErrors.Error>
        </Slider>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="{size:SpacingSm}" Margin="{size:Edges Left={size:SpacingXxl}}">
        <Label Content="Vertical" />
        <Slider Height="64" Orientation="Vertical" Value="50" />
        <Label Content="Vertical · Reversed" />
        <Slider Height="64" Orientation="Vertical" IsDirectionReversed="True" Value="50" />
        <Label Content="Vertical · Ticks" />
        <Slider Height="64" Orientation="Vertical" TickPlacement="Outside" TickFrequency="10" Value="50" />
        <Label Content="Vertical · Disabled" />
        <Slider Height="64" Orientation="Vertical" IsEnabled="False" Value="50" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border Width="400" Height="600">
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="Slider" ContentTemplate="{StaticResource SliderPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="DefaultSliderHorizontalRepeatButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the track over its hit area -->
        <Grid>
          <!-- Invisible area that widens the focus target -->
          <Border x:Name="FocusTarget" Background="Transparent" />
          <!-- Structural: track height -->
          <Border x:Name="TrackBackground"
                  Background="{TemplateBinding Background}"
                  VerticalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Focus target margin -->
    <Style Selector="^ /template/ Border#FocusTarget">
      <Setter Property="Margin" Value="{size:Edges Vertical={size:Scaled Value={size:IconSizeMd}, By=-0.5}}" />
    </Style>

    <!-- Track background styling -->
    <Style Selector="^ /template/ Border#TrackBackground">
      <Setter Property="Height" Value="{size:ThicknessLgDouble}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="DefaultSliderVerticalRepeatButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the track over its hit area -->
        <Grid>
          <!-- Invisible area that widens the focus target -->
          <Border x:Name="FocusTarget" Background="Transparent" />
          <!-- Structural: track width -->
          <Border x:Name="TrackBackground"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Focus target margin -->
    <Style Selector="^ /template/ Border#FocusTarget">
      <Setter Property="Margin" Value="{size:Edges Vertical={size:Scaled Value={size:IconSizeMd}, By=-0.5}}" />
    </Style>

    <!-- Track background styling -->
    <Style Selector="^ /template/ Border#TrackBackground">
      <Setter Property="Width" Value="{size:ThicknessLgDouble}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="DefaultSliderThumbTheme" TargetType="Thumb">
    <!-- Visual defaults -->
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The draggable thumb's shape -->
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">

    <!-- Visual defaults: the empty track is a track surface that recedes toward the canvas but stays
         visible (the same stage ProgressBar's empty track takes), and the filled column takes the
         control's hue through the solid-fill policy, exactly as ProgressBar's fill does -->
    <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:SolidFillDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Horizontal template -->
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Validation error message for the whole control -->
          <DataValidationErrors>
            <!-- Outer frame around the slider -->
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Layout root for the horizontal slider -->
              <Grid x:Name="SliderContainer"
                    Margin="{TemplateBinding Padding}"
                    Background="Transparent">
                <Grid.Styles>
                  <Style Selector="TickBar">
                    <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                  </Style>
                </Grid.Styles>
                <!-- Rows: ticks above, track, ticks below -->
                <Grid
                    x:Name="HorizontalTemplate"
                    ColumnDefinitions="Auto,Auto,*">
                  <Grid.RowDefinitions>
                    <!-- Structural: grid row spacing (SpacingXxl = 16) -->
                    <RowDefinition Height="{size:SpacingXxl}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{size:SpacingXxl}" />
                  </Grid.RowDefinitions>
                  <!-- Tick marks above the track -->
                  <TickBar
                      Name="TopTickBar"
                      Grid.ColumnSpan="3"
                      Ticks="{TemplateBinding Ticks}"
                      TickFrequency="{TemplateBinding Slider.TickFrequency}"
                      Orientation="{TemplateBinding Slider.Orientation}"
                      Minimum="{TemplateBinding Slider.Minimum}"
                      Maximum="{TemplateBinding Slider.Maximum}"
                      VerticalAlignment="Bottom"
                      Placement="Top"
                      IsVisible="False"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                  <!-- Structural: tick bar height -->
                  <TickBar
                      Name="BottomTickBar"
                      Grid.Row="2"
                      Grid.ColumnSpan="3"
                      Ticks="{TemplateBinding Ticks}"
                      TickFrequency="{TemplateBinding Slider.TickFrequency}"
                      Orientation="{TemplateBinding Slider.Orientation}"
                      Minimum="{TemplateBinding Slider.Minimum}"
                      Maximum="{TemplateBinding Slider.Maximum}"
                      VerticalAlignment="Top"
                      Placement="Bottom"
                      IsVisible="False"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                  <!-- The draggable region the thumb moves along -->
                  <Track
                      Name="PART_Track"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Minimum="{TemplateBinding Minimum}"
                      Maximum="{TemplateBinding Maximum}"
                      Value="{TemplateBinding Value, Mode=TwoWay}"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                      Orientation="Horizontal">
                    <Track.DecreaseButton>
                      <!-- Filled part of the track, before the thumb -->
                      <RepeatButton
                          Name="PART_DecreaseButton"
                          Theme="{StaticResource DefaultSliderHorizontalRepeatButton}"
                          Background="{TemplateBinding Foreground}"
                          Focusable="False"/>
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <!-- Empty part of the track, after the thumb -->
                      <RepeatButton
                          Name="PART_IncreaseButton"
                          Theme="{StaticResource DefaultSliderHorizontalRepeatButton}"
                          Background="{TemplateBinding Background}"
                          Focusable="False"/>
                    </Track.IncreaseButton>
                    <!-- The draggable thumb -->
                    <Thumb
                        Name="thumb"
                        Margin="0"
                        Padding="0"
                        BorderThickness="0"
                        Theme="{StaticResource DefaultSliderThumbTheme}" />
                  </Track>
                </Grid>
              </Grid>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Vertical template -->
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Validation error message for the whole control -->
          <DataValidationErrors>
            <!-- Outer frame around the slider -->
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Layout root for the vertical slider -->
              <Grid x:Name="SliderContainer"
                    Background="Transparent"
                    Margin="{TemplateBinding Padding}">
                <Grid.Styles>
                  <Style Selector="TickBar">
                    <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                  </Style>
                </Grid.Styles>
                <!-- Columns: ticks left, track, ticks right -->
                <Grid
                    x:Name="VerticalTemplate"
                    RowDefinitions="*,Auto,Auto">
                  <Grid.ColumnDefinitions>
                    <!-- Structural: grid column spacing (SpacingXxl = 16) -->
                    <ColumnDefinition Width="{size:SpacingXxl}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{size:SpacingXxl}" />
                  </Grid.ColumnDefinitions>
                  <!-- Tick marks left of the track -->
                  <TickBar
                      Name="LeftTickBar"
                      Grid.RowSpan="3"
                      Ticks="{TemplateBinding Ticks}"
                      TickFrequency="{TemplateBinding Slider.TickFrequency}"
                      Orientation="{TemplateBinding Slider.Orientation}"
                      Minimum="{TemplateBinding Slider.Minimum}"
                      Maximum="{TemplateBinding Slider.Maximum}"
                      HorizontalAlignment="Right"
                      Placement="Left"
                      IsVisible="False"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                  <!-- Structural: tick bar width -->
                  <TickBar 
                      Name="RightTickBar"
                      Grid.RowSpan="3"
                      Grid.Column="2"
                      Ticks="{TemplateBinding Ticks}"
                      TickFrequency="{TemplateBinding Slider.TickFrequency}"
                      Orientation="{TemplateBinding Slider.Orientation}"
                      Minimum="{TemplateBinding Slider.Minimum}"
                      Maximum="{TemplateBinding Slider.Maximum}"
                      HorizontalAlignment="Left"
                      Placement="Right" 
                      IsVisible="False"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                  <!-- The draggable region the thumb moves along -->
                  <Track
                      Name="PART_Track"
                      Grid.RowSpan="3"
                      Grid.Column="1"
                      Grid.ColumnSpan="1"
                      Minimum="{TemplateBinding Minimum}"
                      Maximum="{TemplateBinding Maximum}"
                      Value="{TemplateBinding Value, Mode=TwoWay}"
                      IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                      Orientation="Vertical">
                    <Track.DecreaseButton>
                      <!-- Filled part of the track, below the thumb -->
                      <RepeatButton
                          Name="PART_DecreaseButton"
                          Theme="{StaticResource DefaultSliderVerticalRepeatButton}"
                          Background="{TemplateBinding Foreground}"
                          Focusable="False"/>
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <!-- Empty part of the track, above the thumb -->
                      <RepeatButton
                          Name="PART_IncreaseButton"
                          Background="{TemplateBinding Background}"
                          Theme="{StaticResource DefaultSliderVerticalRepeatButton}"
                          Focusable="False"/>
                    </Track.IncreaseButton>
                    <!-- The draggable thumb -->
                    <Thumb
                        Name="thumb"
                        Margin="0"
                        Padding="0"
                        BorderThickness="0"
                        Theme="{StaticResource DefaultSliderThumbTheme}" />
                  </Track>
                </Grid>
              </Grid>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Template element defaults -->
    <Style Selector="^ /template/ Grid#HorizontalTemplate">
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    </Style>

    <Style Selector="^ /template/ Grid#VerticalTemplate">
      <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    </Style>

    <!-- The thumb reads like a control: filled column, round face -->
    <Style Selector="^ /template/ Thumb">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Background" Value="{color:SolidFillDefaultBrush}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>

    <!-- Tick marks recede with the groove -->
    <Style Selector="^ /template/ TickBar">
      <Setter Property="Fill" Value="{color:AccentDividerDefault}" />
    </Style>

    <Style Selector="^ /template/ TickBar#TopTickBar">
      <Setter Property="Height" Value="{size:ThicknessXxlDouble}" />
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#BottomTickBar">
      <Setter Property="Height" Value="{size:ThicknessXxlDouble}" />
      <Setter Property="Margin" Value="{size:Edges Top={size:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#LeftTickBar">
      <Setter Property="Width" Value="{size:ThicknessXxlDouble}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#RightTickBar">
      <Setter Property="Width" Value="{size:ThicknessXxlDouble}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingMd}}" />
    </Style>

    <!-- TickBar placement -->
    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Hover state: the thumb steps toward ink, the fill deepens one stage -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{color:SolidFillHoverBrush}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{color:SolidFillHoverBrush}" />
      </Style>
    </Style>

    <!-- Pressed state: one stage deeper again -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{color:SolidFillPressedBrush}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{color:SolidFillPressedBrush}" />
      </Style>
    </Style>

    <!-- Disabled state: the accented control dims as a whole, keeping its look -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:Scaled Value={size:DisabledOpacity}, By=1.4}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue) -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Style Selector="^ /template/ Thumb">
        <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
    </Style>

    <!-- Error state: the frame pins the error hue on the fill and the thumb -->
    <Style Selector="^:error">
      <Setter Property="Foreground" Value="{color:AccentErrorBrush}" />
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{color:AccentErrorBrush}" />
      </Style>
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{color:AccentErrorBrush}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
