<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- The RefreshVisualizer theme lives on; its gallery entry does not (task 140: the pull indicator
       is met inside the RefreshContainer that hosts it, so the standalone RefreshVisualizer preview is
       retired and every indicator state now rides inside the RefreshContainer preview). The
       ControlTheme below is unchanged -->
  <!-- The declared reason for that (task 176): the gallery lists a control only when the theme
       gives it a {Name}Preview, so a control shown inside another entry would otherwise vanish
       from the gallery with no record of why. This marker IS the record: it names the entry that
       shows the indicator, and the gallery reads it as a deliberate exclusion. -->

  <default:PreviewShownIn x:Key="RefreshVisualizerPreviewShownIn"
                           ShownIn="{x:Type RefreshContainer}"
                           Reason="The pull indicator is met inside the container that hosts it." />


  <ControlTheme x:Key="{x:Type RefreshVisualizer}"
                TargetType="RefreshVisualizer">
    <!-- Visual defaults -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background"
            Value="Transparent"/>
    <!-- Icon follows the control's accent hue; never a pinned seed. The arrow is a GLYPH (a mark,
         not a text run), so it takes the accent's own glyph role: {color:AccentGlyphDefault} -->
    <Setter Property="Foreground"
            Value="{color:AccentGlyphDefault}"/>
    <!-- Theme Exception: the indicator is a lone glyph in the middle of its slot, so it is centred
         there; the general control alignment would park it against the slot's left edge, where it
         reads as a stray mark rather than a spinner (Luke, 21 Oct 2026) -->
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Frame the refresh arrow slides through -->
        <Grid Name="PART_Root"
              Background="{TemplateBinding Background}">
          <!-- The circular-arrow refresh glyph, centred and sized with the control -->
          <PathIcon Name="PART_Icon"
                    Data="{icons:Refresh}"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
            <!-- The arrow's own rotation, about its centre. It sits at the identity here, so the
                 control's behaviour is untouched: the real pull drives Avalonia's own composition
                 animation, which turns the visualizer's CONTENT (this theme draws the glyph in the
                 template instead). The transform is the axis the gallery's pull demonstration
                 turns the very same arrow on (task 147), and every visualizer gets its own -->
            <PathIcon.RenderTransform>
              <RotateTransform />
            </PathIcon.RenderTransform>
          </PathIcon>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
