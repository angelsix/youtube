<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- Design preview: the spinner standalone at a fixed small size. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="RefreshVisualizerPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <RefreshVisualizer Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="RefreshVisualizer" ContentTemplate="{StaticResource RefreshVisualizerPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type RefreshVisualizer}"
                TargetType="RefreshVisualizer">
    <!-- Visual defaults -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background"
            Value="Transparent"/>
    <Setter Property="Foreground"
            Value="{color:TextDefault}"/>
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Content">
      <Template>
        <PathIcon Name="PART_Icon"
                  Data="{icons:Refresh}"
                  Width="{size:IconSizeMd}"
                  Height="{size:IconSizeMd}"
        />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root for the refresh spinner -->
        <Grid Name="PART_Root"
              Background="{TemplateBinding Background}"/>
    </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
