<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- The RefreshVisualizer theme lives on; its gallery entry does not (task 140: the pull indicator
       is met inside the RefreshContainer that hosts it, so the standalone RefreshVisualizer preview is
       retired and every indicator state now rides inside the RefreshContainer preview). The
       ControlTheme below is unchanged -->

  <ControlTheme x:Key="{x:Type RefreshVisualizer}"
                TargetType="RefreshVisualizer">
    <!-- Visual defaults -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background"
            Value="Transparent"/>
    <!-- Icon follows the control's accent hue (rest ink stage); never a pinned seed -->
    <Setter Property="Foreground"
            Value="{color:AccentBrush Dark3}"/>
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Frame the refresh arrow slides through -->
        <Grid Name="PART_Root"
              Background="{TemplateBinding Background}">
          <!-- The circular-arrow refresh glyph, centred and sized with the control -->
          <PathIcon Name="PART_Icon"
                    Data="{icons:Refresh}"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
