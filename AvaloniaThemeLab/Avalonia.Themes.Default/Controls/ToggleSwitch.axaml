<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:default="clr-namespace:Avalonia.Themes.Default"
    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
    xmlns:color="using:AngelSix.ThemeEngine.Colors"
    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: the shared state row, declared before Design.PreviewWith uses it.
       States and hues combine onto single switches (Pressed+On, Warning+On) to minimise the count -->
  <DataTemplate x:Key="ToggleSwitchPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <ToggleSwitch Content="Labels" OffContent="Off" OnContent="On" />
      <ToggleSwitch Content="On" IsChecked="True" />
      <ToggleSwitch Content="Hover" theme:Preview.State="Hover" />
      <ToggleSwitch Content="Pressed" theme:Preview.State="Pressed" IsChecked="True" />
      <ToggleSwitch Content="Off pressed" theme:Preview.State="Pressed" />
      <ToggleSwitch Content="Focused" theme:Preview.State="Focused" />
      <ToggleSwitch Content="Disabled" IsEnabled="False" IsChecked="True" />
      <ToggleSwitch Content="Warning" theme:Accent.Kind="Warning" IsChecked="True" />
      <ToggleSwitch Content="Success" theme:Accent.Kind="Success" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <default:LightDarkPreview Title="ToggleSwitch" Orientation="Horizontal" ContentTemplate="{StaticResource ToggleSwitchPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <!-- A switch has no surface: the canvas shows through behind the header and the track -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}, Vertical={size:SpacingSm}}" />
    <!-- The resting border weight the track draws at; {default:FocusThickness} reads this off the control so focus never resizes it -->
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition
            Easing="CubicEaseOut"
            Property="Canvas.Left"
            Duration="{theme:AnimationNormalMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Frame carrying the control's padding; the canvas shows through -->
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <!-- Layout root stacking the header above the switch -->
          <Grid RowDefinitions="Auto,*">

          <!-- The switch's header text -->
          <ContentPresenter
              x:Name="PART_ContentPresenter"
              Grid.Row="0"
              VerticalAlignment="Top"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />

          <!-- Places the on and off labels beside the switch -->
          <Grid
              Grid.Row="1"
              MinWidth="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">

            <Grid.RowDefinitions>
              <RowDefinition Height="{size:SpacingLg}" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="{size:SpacingLg}" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <!-- A GridLength takes no size token (a double there resolves to 0), so the gutter is the presenters' Margin -->
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Invisible click area covering the whole switch -->
            <Grid
                x:Name="SwitchAreaGrid"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                TemplatedControl.IsTemplateFocusTarget="True" />

            <!-- Label shown when the switch is off; hit-testability follows the checked state -->
            <ContentPresenter
                x:Name="PART_OffContentPresenter"
                Grid.RowSpan="3"
                Grid.Column="2"
                Margin="{size:Edges Left={size:SpacingXl}}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding OffContent}"
                ContentTemplate="{TemplateBinding OffContentTemplate}" />

            <!-- Label shown when the switch is on; hit-testability follows the checked state -->
            <ContentPresenter
                x:Name="PART_OnContentPresenter"
                Grid.RowSpan="3"
                Grid.Column="2"
                Margin="{size:Edges Left={size:SpacingXl}}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding OnContent}"
                ContentTemplate="{TemplateBinding OnContentTemplate}" />

            <!-- The switch's outline -->
            <Border
                x:Name="OuterBorder"
                Grid.Row="1"
                Width="{size:Scaled Value={size:BaseSize}, By=40}"
                Height="{size:Scaled Value={size:BaseSize}, By=20}" />

            <!-- The track the knob slides along; unstretched so it fills the cell set by the outline and its margin insets it by the border weight -->
            <Border
                x:Name="SwitchKnobBounds"
                Grid.Row="1" />

            <!-- Positions the knob along the track -->
            <Canvas
                x:Name="PART_SwitchKnob"
                Grid.Row="1"
                Width="{size:Scaled Value={size:BaseSize}, By=20}"
                Height="{size:Scaled Value={size:BaseSize}, By=20}"
                HorizontalAlignment="Left">

              <!-- The sliding knob -->
              <Grid x:Name="PART_MovingKnobs" Width="{size:Scaled Value={size:BaseSize}, By=20}" Height="{size:Scaled Value={size:BaseSize}, By=20}">
                <!-- Knob fill shown when on -->
                <Ellipse
                    x:Name="SwitchKnobOn"
                    Width="{size:Scaled Value={size:BaseSize}, By=10}"
                    Height="{size:Scaled Value={size:BaseSize}, By=10}" />
                <!-- Knob fill shown when off -->
                <Ellipse
                    x:Name="SwitchKnobOff"
                    Width="{size:Scaled Value={size:BaseSize}, By=10}"
                    Height="{size:Scaled Value={size:BaseSize}, By=10}" />
              </Grid>
            </Canvas>
          </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Default template element styles -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingLg}}" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="Margin" Value="{size:Edges}" />
    </Style>

    <Style Selector="^ /template/ Grid#SwitchAreaGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="{size:Edges Top={size:SpacingLg}, Bottom={size:SpacingLg}}" />
    </Style>

    <Style Selector="^ /template/ Border#OuterBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>

    <!-- The track covers the outline exactly: concentric with its drawn outer edge, from the outline's own tokens.
         Rest fill follows the outlined column (Button's rest); the checked face overrides it below -->
    <Style Selector="^ /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderThickness" Value="{size:Edges}" />
      <Setter Property="CornerRadius" Value="{default:ConcentricCorners Radius={size:RadiusMd}, Thickness={size:ThicknessSm}, Inset={ReflectionBinding Path=Margin, RelativeSource={RelativeSource Self}}, All=True}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="{color:AccentBrush Light10}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="{color:AccentBrush Dark1}" />
    </Style>

    <!-- Hover state: the outline keeps Button's constant rest border; only the inner fill steps up -->
    <Style Selector="^:pointerover /template/ Ellipse#SwitchKnobOn, ^[(theme|Preview.State)=Hover] /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Off track steps to Button's hover fill; the checked face keeps its own hue ramp -->
    <Style Selector="^:unchecked:pointerover /template/ Border#SwitchKnobBounds, ^:unchecked[(theme|Preview.State)=Hover] /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <!-- Pressed state: the outline keeps Button's constant rest border; the off track steps to Button's pressed fill -->
    <Style Selector="^:unchecked:pressed /template/ Border#SwitchKnobBounds, ^:unchecked[(theme|Preview.State)=Pressed] /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#SwitchKnobOn, ^[(theme|Preview.State)=Pressed] /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Disabled state: the whole switch dims under one opacity, checked fill included -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Checked state: the track keeps its outline, recoloured to the solid fill so the filled face has no mismatched ring -->
    <Style Selector="^:checked /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{color:SolidFillDefault}" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Opacity" Value="1" />
      <!-- The checked face is a solid fill, brighter than the outlined rest column; inset by the outline so the border shows -->
      <Setter Property="Background" Value="{color:SolidFillDefault}" />
      <Setter Property="Margin" Value="{size:Edges All={size:ThicknessSmDouble}}" />
    </Style>

    <!-- Checked (on) hover: the solid track deepens one step (bright solid-fill hover role; identical to Dark4 in dark).
         Kept AFTER the base checked rule above so it wins the specificity tie when Preview.State pins the state -->
    <Style Selector="^:checked:pointerover /template/ Border#SwitchKnobBounds, ^:checked[(theme|Preview.State)=Hover] /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{color:SolidFillHover}" />
    </Style>

    <!-- Checked (on) hover: the outline follows the deepened fill so the ring stays seamless -->
    <Style Selector="^:checked:pointerover /template/ Border#OuterBorder, ^:checked[(theme|Preview.State)=Hover] /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{color:SolidFillHover}" />
    </Style>

    <!-- Checked (on) pressed: the solid track deepens two steps (bright solid-fill pressed role; identical to Dark5 in dark) -->
    <Style Selector="^:checked:pressed /template/ Border#SwitchKnobBounds, ^:checked[(theme|Preview.State)=Pressed] /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{color:SolidFillPressed}" />
    </Style>

    <!-- Checked (on) pressed: the outline follows the deepened fill so the ring stays seamless -->
    <Style Selector="^:checked:pressed /template/ Border#OuterBorder, ^:checked[(theme|Preview.State)=Pressed] /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{color:SolidFillPressed}" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Opacity" Value="0" />
      <!-- The hidden label must not eat clicks aimed at the switch -->
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Unchecked state -->
    <Style Selector="^:unchecked /template/ Border#OuterBorder">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- The off track is a visible inner fill (Button's rest column), inset by the outline so the border shows; hover and press deepen it -->
    <Style Selector="^:unchecked /template/ Border#SwitchKnobBounds">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Margin" Value="{size:Edges All={size:ThicknessSmDouble}}" />
    </Style>

    <Style Selector="^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="Opacity" Value="0" />
      <!-- The hidden label must not eat clicks aimed at the switch -->
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Focus state (Rule 21): the track outline takes the focus colour at the rest weight; the outset ring is the default adornment -->
    <Style Selector="^:focus-visible /template/ Border#OuterBorder, ^[(theme|Preview.State)=Focused] /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{default:FocusBrush}" />
      <Setter Property="BorderThickness" Value="{default:FocusThickness}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
