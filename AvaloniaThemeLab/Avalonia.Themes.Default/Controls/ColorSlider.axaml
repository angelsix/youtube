<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="clr-namespace:Avalonia.Themes.Default"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Design preview: the colour, one strip per HSV component, the opacity strip over its checkerboard, then
       the vertical hue strip and the states. Every strip shares one colour seeded from the pane's accent
       (ColorSample), so dragging one moves the rest. Declared before Design.PreviewWith uses it -->
  <DataTemplate x:Key="ColorSliderPreview">
    <Grid x:Name="Sample" controls:ColorSample.Seed="{color:AccentColor}" ColumnDefinitions="Auto,Auto">
      <StackPanel Spacing="{size:SpacingXl}">
        <Label Content="Colour" />
        <ColorPreviewer Width="{size:SurfaceWidthSm}" IsAccentColorsVisible="False" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Hue" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Component1" IsPerceptive="True" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Saturation" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Component2" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Brightness" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Component3" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Opacity" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Alpha" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
        <Label Content="Focused" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Component1" IsPerceptive="True" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" theme:Preview.State="Focused" />
        <Label Content="Disabled" />
        <ColorSlider Width="{size:SurfaceWidthSm}" ColorModel="Hsva" ColorComponent="Component1" IsPerceptive="True" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" IsEnabled="False" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="{size:SpacingXl}" Margin="{size:Edges Left={size:SpacingXxl}}">
        <Label Content="Vertical hue" />
        <ColorSlider Height="{size:SurfaceWidthSm}" Orientation="Vertical" ColorModel="Hsva" ColorComponent="Component1" IsPerceptive="True" HsvColor="{Binding #Sample.(controls:ColorSample.HsvColor), Mode=TwoWay}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultThemeStyles />
      </Border.Styles>

      <controls:LightDarkPreview Title="ColorSlider" ContentTemplate="{StaticResource ColorSliderPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- Strip either side of the thumb: a click target with no face of its own -->
  <ControlTheme x:Key="DefaultColorSliderRepeatButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The clickable stretch of strip -->
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Thumb: a ring that rides the strip, so the colour under it stays visible -->
  <ControlTheme x:Key="DefaultColorSliderThumb" TargetType="Thumb">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{color:TextDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The draggable ring -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ColorSlider}" TargetType="ColorSlider">

    <!-- Visual defaults: the strip's own fill is the gradient the control paints in code -->
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Template: one for both orientations; the track follows Orientation -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking checkerboard, colour strip and track -->
        <Panel>
          <!-- Checkerboard light squares behind translucent colours -->
          <Border x:Name="CheckerBase" CornerRadius="{TemplateBinding CornerRadius}" />
          <!-- Checkerboard dark squares -->
          <Border x:Name="CheckerSquares"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  OpacityMask="{StaticResource DefaultColorCheckerMask}" />
          <!-- The colour strip, painted in code. No stroke of its own, so its background box is the whole strip:
               the code's bitmap is exactly the strip's size and stretches Uniform, so any smaller box would scale it
               down and leave checkerboard at each end; and with no stroke Avalonia clamps a radius too large for the
               strip into the same pill as the checkerboard beneath -->
          <Border x:Name="Strip"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <!-- The strip's outline, drawn over the colour -->
          <Border x:Name="Outline"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <!-- The region the thumb moves along -->
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                 Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseButton>
              <!-- Strip before the thumb -->
              <RepeatButton Name="PART_DecreaseButton"
                            Theme="{StaticResource DefaultColorSliderRepeatButton}"
                            Focusable="False" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <!-- Strip after the thumb -->
              <RepeatButton Name="PART_IncreaseButton"
                            Theme="{StaticResource DefaultColorSliderRepeatButton}"
                            Focusable="False" />
            </Track.IncreaseButton>
            <!-- The draggable ring -->
            <Thumb Name="ColorSliderThumb" Theme="{StaticResource DefaultColorSliderThumb}" />
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Checkerboard squares -->
    <Style Selector="^ /template/ Border#CheckerBase">
      <Setter Property="Background" Value="{color:NeutralLight10Brush}" />
    </Style>
    <Style Selector="^ /template/ Border#CheckerSquares">
      <Setter Property="Background" Value="{color:NeutralLight6Brush}" />
    </Style>

    <!-- Strip thickness by orientation: the strip is a control face, so it follows control height (24 at the default
         scale); the thumb is a circle as wide as the strip -->
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="{size:Scaled Value={size:ControlHeightSm}, By=0.75}" />
      <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
      <Style Selector="^ /template/ Thumb#ColorSliderThumb">
        <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="{size:Scaled Value={size:ControlHeightSm}, By=0.75}" />
      <Setter Property="MinHeight" Value="{size:ControlMinWidth}" />
      <Style Selector="^ /template/ Thumb#ColorSliderThumb">
        <Setter Property="Width" Value="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="Height" Value="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" />
      </Style>
    </Style>

    <!-- Thumb ring: dark on a light colour, light on a dark one, whatever the palette; with neither
         (a mostly clear colour) it keeps the theme's ink, which reads against the canvas showing through -->
    <Style Selector="^:dark-selector /template/ Thumb#ColorSliderThumb">
      <!-- Theme Exception: the strip is code-drawn artwork that never changes with the palette, so the ring
           takes the two seeds that never move either (Neutral ink, Surface paper) -->
      <Setter Property="BorderBrush" Value="{color:AccentNeutralBrush}" />
    </Style>
    <Style Selector="^:light-selector /template/ Thumb#ColorSliderThumb">
      <!-- Theme Exception: the palette-fixed paper seed, for the reason above -->
      <Setter Property="BorderBrush" Value="{color:AccentSurfaceBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state (Rule 21: the switch decides between the focus colour and the control's own hue).
         Keyboard focus also draws the default outset ring around the strip; the thumb ring carries the focus colour -->
    <Style Selector="^:focus-visible /template/ Thumb#ColorSliderThumb, ^[(theme|Preview.State)=Focused] /template/ Thumb#ColorSliderThumb">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
