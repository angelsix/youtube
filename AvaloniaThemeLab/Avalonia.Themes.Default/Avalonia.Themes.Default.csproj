<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Avalonia.Themes.Default</RootNamespace>

        <!-- No GenerateStyleClassDeclarations here, deliberately. The engine can emit a file of stub
             styles so an IDE stops underlining a Classes="..." it cannot resolve, and this theme
             needed one while its preview states were style classes. They are attached properties
             now — theme:Preview.State — which an analyser resolves like any other CLR member, so the
             stub file, the StyleInclude that consumers had to remember, and the whole class of drift
             between the two are gone. The only classes left are internal to a single control's own
             template and no consumer ever writes them. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <!-- Home of the CalendarView/CalendarSelectionEngine types. Their STYLING stays in this
             theme (Controls/CalendarView.axaml) — a ControlTheme targeting a foreign type is the
             same relationship as every other control file here (Button, ComboBox...). The engine's
             dictionary-list generator scans this project's .axaml by content, so the theme keeps
             merging the calendar's dictionaries automatically; nothing else needs wiring. -->
        <!-- 1.1.0 adds CalendarEvent/CalendarEvent<TData>, CalendarView.Events and the week-number
             properties (IsWeekNumberVisible, WeekNumberRule). 1.2.0 takes over the engine-level code
             this theme used to carry: LightDarkPreview, Icons, ColorSample and the LabelPairing,
             ScrollReveal, PickerPopupAlignment and WheelSnap behaviours. Their look stays here, in
             Controls/*.axaml, exactly as CalendarView's does. -->
        <PackageReference Include="AngelSix.ThemeEngine.Controls" Version="1.3.0"/>
        <!-- Home of ColorPicker, ColorView, ColorSpectrum, ColorSlider and ColorPreviewer; their styling is Controls/Color*.axaml. -->
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4"/>

        <!-- 1.12.0 or later is required, not merely preferred: the theme is built on attributes
             this version introduced — [Brush], [GradientBrush], [FontWeights], ColourRamp's
             OverlayLabels, and SizeScale's TypeSuffixes and TimeSpan support. On an older package
             the generator emits none of those members and the build fails with a few hundred
             "does not exist in the current context" errors rather than anything that names the
             real cause. (1.17.0 also adds ColourRamp's DarkSeed; 1.20.0 adds ColorRamp's HueAware, which the
             seeds in DefaultTheme.cs use.) -->
        <!-- 1.22.0 adds the PER-HUE POLICIES on [AccentRole] — BrightStage/BrightThreshold,
             ContrastAgainst/Alternate and FocusColour/NeutralHue/FocusSwitch — which is what lets the
             solid-fill and focus-border decisions live in the theme's DECLARATION rather than in a C#
             markup extension (task 175). Those policies are resolved inside the engine's own reactive
             binding, so a change of Accent.Kind re-resolves them with no other trigger. -->
        <!-- 1.24.0: a dark region's twin follows live edits to an observable theme (the gallery's
             dark pane follows the settings window), and ColorRamp's LightInk carries the hand-tuned
             light ink stages so they follow a live seed edit. -->
        <!-- 1.27.0 adds ConcentricCorners Padding (the ListBox's scroller); 1.29.0 removes the short-lived CornerFit.
             1.25.0 takes over {size:ConcentricCorners}, {color:AccentColor}, theme:Icon.Data/Placement and
             the theme:PreviewShownIn/PreviewExcluded gallery markers, which used to live in Theme/.
             1.26.0 adds [SizeScale(Floor)], which keeps the Thickness ladder at 1px or more when
             BaseSize shrinks, so borders never round away to nothing. -->
        <PackageReference Include="AngelSix.ThemeEngine" Version="1.30.0" />
        <!-- The theme's declared values are [ObservableProperty] partial properties, so a live
             instance can be edited at runtime; partial properties need 8.4.2 (the engine's own
             8.4.0 does not generate them). -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Icons/Svg/*.svg are the icon set — the engine reads them into ThemeIconGallery, so the
             geometry reaches the assembly as generated C# and the files themselves are build inputs
             rather than content. The package already hands them to the generator as AdditionalFiles;
             this is only so the folder shows up in the IDE beside the class it fills in. -->
        <None Include="Icons/Svg/Categories.md" />
    </ItemGroup>

</Project>
