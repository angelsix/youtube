<Project>

  <!-- Code style from .editorconfig fails the build, not just the IDE. LangVersion is latestMajor
       (the newest major the installed compiler supports), never a literal pin: a literal is a
       ceiling that silently lowers the language on newer SDKs. -->
  <PropertyGroup>
    <LangVersion>latestMajor</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Build despite the modern-syntax rules (mid-refactor, spikes) with -p:DisableModernSyntaxChecks=true. -->
  <PropertyGroup Condition="'$(DisableModernSyntaxChecks)' == 'true'">
    <NoWarn>$(NoWarn);IDE0028;IDE0300;IDE0301;IDE0306;IDE0090;IDE0063;IDE0016;IDE0066;IDE0071;IDE0041</NoWarn>
  </PropertyGroup>

</Project>
