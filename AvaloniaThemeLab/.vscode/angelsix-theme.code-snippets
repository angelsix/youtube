{
  "enginenamespaces": {
    "scope": "xml,axaml,xaml",
    "prefix": "enginenamespaces",
    "description": "The theme engine xmlns declarations (theme, color, size, controls, icons) for a root element",
    "body": [
      "xmlns:theme=\"using:AngelSix.ThemeEngine.Generated\"",
      "xmlns:color=\"using:AngelSix.ThemeEngine.Colors\"",
      "xmlns:size=\"using:AngelSix.ThemeEngine.Sizes\"",
      "xmlns:controls=\"using:AngelSix.ThemeEngine.Controls\"",
      "xmlns:icons=\"using:AngelSix.ThemeEngine.Icons\"$0"
    ]
  },
  "enginecontrol": {
    "scope": "xml,axaml,xaml",
    "prefix": "enginecontrol",
    "description": "A control theme file: the control's preview template, the designer preview and the ControlTheme (the preview needs AngelSix.ThemeEngine.Controls)",
    "body": [
      "<ResourceDictionary xmlns=\"https://github.com/avaloniaui\"",
      "                    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
      "                    xmlns:theme=\"using:AngelSix.ThemeEngine.Generated\"",
      "                    xmlns:color=\"using:AngelSix.ThemeEngine.Colors\"",
      "                    xmlns:size=\"using:AngelSix.ThemeEngine.Sizes\"",
      "                    xmlns:controls=\"using:AngelSix.ThemeEngine.Controls\"",
      "                    xmlns:icons=\"using:AngelSix.ThemeEngine.Icons\"",
      "                    xmlns:local=\"using:${2:MyApp.Theme}\">",
      "  <DataTemplate x:Key=\"${1:Button}Preview\">",
      "    <StackPanel Spacing=\"{size:SpacingMd\\}\">",
      "      <$1 />",
      "      <$1 theme:Preview.State=\"Hover\" />",
      "      <$1 theme:Preview.State=\"Pressed\" />",
      "      <$1 IsEnabled=\"False\" />",
      "    </StackPanel>",
      "  </DataTemplate>",
      "",
      "  <Design.PreviewWith>",
      "    <Border>",
      "      <Border.Styles>",
      "        <local:${3:MyTheme} />",
      "      </Border.Styles>",
      "      <controls:LightDarkPreview Title=\"$1\" ContentTemplate=\"{StaticResource $1Preview\\}\" />",
      "    </Border>",
      "  </Design.PreviewWith>",
      "",
      "  <ControlTheme x:Key=\"{x:Type $1\\}\" TargetType=\"$1\">",
      "    <Setter Property=\"Background\" Value=\"{color:AccentBrush Light10\\}\" />",
      "    <Setter Property=\"Foreground\" Value=\"{color:AccentBrush Dark9\\}\" />",
      "    <Setter Property=\"BorderBrush\" Value=\"{color:AccentBrush Light1\\}\" />",
      "    <Setter Property=\"Template\">",
      "      <ControlTemplate>",
      "        <Border Name=\"PART_Border\"",
      "                Background=\"{TemplateBinding Background\\}\"",
      "                BorderBrush=\"{TemplateBinding BorderBrush\\}\"",
      "                BorderThickness=\"{TemplateBinding BorderThickness\\}\"",
      "                CornerRadius=\"{TemplateBinding CornerRadius\\}\">",
      "          $0",
      "        </Border>",
      "      </ControlTemplate>",
      "    </Setter>",
      "",
      "    <Style Selector=\"^:pointerover /template/ Border#PART_Border\">",
      "      <Setter Property=\"Background\" Value=\"{color:AccentBrush Light8\\}\" />",
      "    </Style>",
      "  </ControlTheme>",
      "</ResourceDictionary>"
    ]
  },
  "enginecontrolpreview": {
    "scope": "xml,axaml,xaml",
    "prefix": "enginecontrolpreview",
    "description": "A control's preview: the {Control}Preview template and the Design.PreviewWith that shows it (needs AngelSix.ThemeEngine.Controls)",
    "body": [
      "<DataTemplate x:Key=\"${1:Button}Preview\">",
      "  <StackPanel Spacing=\"{size:SpacingMd\\}\">",
      "    <$1 />$0",
      "    <$1 theme:Preview.State=\"Hover\" />",
      "    <$1 theme:Preview.State=\"Pressed\" />",
      "    <$1 IsEnabled=\"False\" />",
      "  </StackPanel>",
      "</DataTemplate>",
      "",
      "<Design.PreviewWith>",
      "  <Border>",
      "    <Border.Styles>",
      "      <${2:local:MyTheme} />",
      "    </Border.Styles>",
      "    <controls:LightDarkPreview Title=\"$1\" ContentTemplate=\"{StaticResource $1Preview\\}\" />",
      "  </Border>",
      "</Design.PreviewWith>"
    ]
  },
  "enginecontrolstyle": {
    "scope": "xml,axaml,xaml",
    "prefix": "enginecontrolstyle",
    "description": "A plain style inside a ControlTheme: one template part takes a ramp stage; edit the Selector for a state such as ^:pointerover",
    "body": [
      "<Style Selector=\"${1:^ /template/ Border#PART_Border}\">",
      "  <Setter Property=\"${2:Background}\" Value=\"{color:AccentBrush ${3:Light10}\\}\" />$0",
      "</Style>"
    ]
  },
  "themeclass": {
    "scope": "csharp",
    "prefix": "themeclass",
    "description": "A theme class: one Defaults region (plain reuses, then stage defaults), then Seeds, Sizes and Typography",
    "body": [
      "[Theme(FallbackHue = \"Neutral\")]",
      "public partial class ${1:My}Theme : ThemeBase",
      "{",
      "    #region Defaults",
      "",
      "    // Surfaces",
      "    public virtual Color SurfaceDefault => SurfaceSeed;",
      "    [StageDefault] protected internal virtual Stage BackgroundDefault => Stage.Light10;",
      "    [StageDefault] protected internal virtual Stage CardDefault => Stage.Light10;",
      "",
      "    // Text",
      "    [StageDefault(PinHue = \"Neutral\")] protected internal virtual Stage TextDefault => Stage.Dark9;",
      "    [StageDefault(PinHue = \"Neutral\")] protected internal virtual Stage DimTextDefault => Stage.Dark5;",
      "",
      "    // Lines",
      "    [StageDefault] protected internal virtual Stage BorderDefault => Stage.Light2;",
      "",
      "    // Solid fills",
      "    [StageDefault] protected internal virtual Stage SolidFillDefault => Stage.Dark3;",
      "    [StageDefault(ContrastStage = nameof(SolidFillDefault), AlternateStage = nameof(TextDefault))]",
      "    protected internal virtual Stage OnSolidFillInkDefault => Stage.Light10;",
      "",
      "    #endregion Defaults",
      "",
      "    #region Seeds",
      "",
      "    [AccentHue, ColorRamp(HueAware = true, DarkSeed = \"#D1D1D1\")]",
      "    [Observable] public virtual partial Color AccentNeutral { get; set; \\} = Color.Parse(\"#2E2E2E\");",
      "",
      "    [AccentHue, ColorRamp(HueAware = true)]",
      "    [Observable] public virtual partial Color AccentPrimary { get; set; \\} = Color.Parse(\"${2:#2F6FEB}\");",
      "",
      "    /// <summary>The application canvas.</summary>",
      "    [AccentHue, ColorRamp(DarkSeed = \"#1E1E1E\")]",
      "    [Observable] public virtual partial Color AccentSurface { get; set; \\} = Color.Parse(\"#FAFAFA\");",
      "",
      "    #endregion Seeds",
      "",
      "    #region Sizes",
      "",
      "    [SizeScale(Multipliers = [4, 8, 12, 16])]",
      "    public virtual double Spacing => BaseSize;",
      "",
      "    [SizeScale(Multipliers = [4, 8], Types = [typeof(CornerRadius)], TypeSuffixes = [\"\"])]",
      "    public virtual double Radius => BaseSize;",
      "",
      "    [SizeScale(Multipliers = [1, 2], Types = [typeof(Thickness)], TypeSuffixes = [\"\"], Floor = 1)]",
      "    public virtual double Thickness => BaseSize;",
      "",
      "    #endregion Sizes",
      "",
      "    #region Typography",
      "",
      "    [SizeScale(Multipliers = [12, 14, 20])]",
      "    public virtual double FontSize => BaseSize;",
      "",
      "    #endregion Typography",
      "$0",
      "\\}"
    ]
  },
  "themeaccent": {
    "scope": "csharp",
    "prefix": "themeaccent",
    "description": "An accent hue seed: one colour that becomes a full light and dark ramp, selectable with theme:Accent.Kind",
    "body": [
      "[AccentHue, ColorRamp(HueAware = true)]",
      "[Observable] public virtual partial Color Accent${1:Primary} { get; set; \\} = Color.Parse(\"${2:#2F6FEB}\");$0"
    ]
  },
  "themesurface": {
    "scope": "csharp",
    "prefix": "themesurface",
    "description": "The canvas hue seed and the seed its dark palette uses",
    "body": [
      "/// <summary>The application canvas.</summary>",
      "[AccentHue, ColorRamp(DarkSeed = \"${2:#1E1E1E}\")]",
      "[Observable] public virtual partial Color AccentSurface { get; set; \\} = Color.Parse(\"${1:#FAFAFA}\");$0"
    ]
  },
  "themeladder": {
    "scope": "csharp",
    "prefix": "themeladder",
    "description": "A size ladder on BaseSize: {Name}Sm, {Name}Md… and a {Name}Scale to resize it alone",
    "body": [
      "[SizeScale(Multipliers = [${2:4, 8, 12, 16}], Scalable = true)]",
      "public virtual double ${1:Spacing} => BaseSize;$0"
    ]
  },
  "themeproperty": {
    "scope": "csharp",
    "prefix": "themeproperty",
    "description": "A live [Observable] token: change it at run time and every control follows",
    "body": [
      "[Observable] public virtual partial ${2:double} ${1:HoverScale} { get; set; \\} = ${3:1.05};$0"
    ]
  },
  "themealign": {
    "scope": "csharp",
    "prefix": "themealign",
    "description": "An alignment token: {Name}AlignmentHorizontal and {Name}AlignmentVertical in XAML",
    "body": [
      "[Observable] public virtual partial Alignment ${1:Standard}Alignment { get; set; \\} = new(HorizontalAlignment.${2:Left}, VerticalAlignment.${3:Center});$0"
    ]
  },
  "themefont": {
    "scope": "csharp",
    "prefix": "themefont",
    "description": "The theme's font family and one FontWeight token per weight",
    "body": [
      "[FontWeights(Weights = [FontWeight.Normal, FontWeight.Medium, FontWeight.SemiBold, FontWeight.Bold], Labels = [\"Regular\", \"Medium\", \"SemiBold\", \"Bold\"])]",
      "[Observable] public virtual partial FontFamily FontFamily { get; set; \\} = new(\"${1:fonts:Inter#Inter}, \\$Default\");$0"
    ]
  },
  "themegallery": {
    "scope": "csharp",
    "prefix": "themegallery",
    "description": "An icon gallery class: every .svg in the folder becomes an {icons:Name}",
    "body": [
      "// Extending DefaultTheme? Derive from ThemeIconGallery — it brings every default icon.",
      "[IconGallery(SvgFolder = \"${2:Icons/Svg}\")]",
      "public partial class ${1:MyIcons}",
      "{",
      "\\}$0"
    ]
  },
  "themeicons": {
    "scope": "csharp",
    "prefix": "themeicons",
    "description": "The theme's Icons override, handing its icon gallery to {icons:Name}",
    "body": [
      "public override ${1:MyIcons} Icons => new();$0"
    ]
  }
}
