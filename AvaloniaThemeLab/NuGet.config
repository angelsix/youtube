<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins this solution to nuget.org alone.

    The machine-wide config also carries local folder feeds pointing into the AngelSix.ThemeEngine
    source tree, which is how the package is tested before release. Without <clear /> those feeds
    win here too, so the lab would quietly build against whatever happens to be sitting in a bin
    folder rather than the published package — and would not restore at all on another machine.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
