<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins this solution to nuget.org alone.

    A development machine's user-level config may also carry local folder feeds pointing into the
    AngelSix.ThemeEngine source tree, which is how the package is tested before release. Without
    <clear /> those feeds would win here too, and the lab would quietly build against whatever
    happened to be sitting in a bin folder rather than against the published package.

    Nothing machine-specific belongs in this file. It is committed to a public repository, so an
    absolute path here is a path that does not exist for anyone else — NuGet reports the source as
    missing and the restore fails before it reaches nuget.org at all. If you are testing an
    unpublished build of the engine locally, add that folder feed to your own user-level config
    (~/.nuget/NuGet/NuGet.Config on macOS and Linux, %AppData%\NuGet\NuGet.Config on Windows) and
    temporarily comment out the <clear /> below, rather than editing this file.
  -->
  <packageSources>
    <clear />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
