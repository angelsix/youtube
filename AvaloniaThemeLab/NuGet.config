<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins this solution to nuget.org alone.

    The machine-wide config also carries local folder feeds pointing into the AngelSix.ThemeEngine
    source tree, which is how the package is tested before release. Without <clear /> those feeds
    win here too, so the lab would quietly build against whatever happens to be sitting in a bin
    folder rather than the published package — and would not restore at all on another machine.
  -->
  <packageSources>
    <clear />

    <!-- TEMPORARY. AngelSix.ThemeEngine 1.10.0 — the release that reads the icon set from
         Icons/Svg — is packed locally but not published yet, so the lab cannot restore without
         this. Delete this line once 1.10.0 is on nuget.org; until then the solution only builds
         on the machine that packed it, which is exactly what the note above warns against. -->
    <add key="local-test" value="/Users/lukemalpass/.nuget/local-packages" />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
