<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pins this solution to nuget.org alone.

    A development machine's user-level config may also carry local folder feeds pointing into the
    AngelSix.ThemeEngine source tree, which is how the package is tested before release. Without
    <clear /> those feeds would win here too, and the lab would quietly build against whatever
    happened to be sitting in a bin folder rather than against the published package.

    Nothing machine-specific belongs in this file. It is committed to a public repository, so an
    absolute path here is a path that does not exist for anyone else — NuGet reports the source as
    missing and the restore fails before it reaches nuget.org at all. If you are testing an
    unpublished build of the engine locally, add that folder feed to your own user-level config
    (~/.nuget/NuGet/NuGet.Config on macOS and Linux, %AppData%\NuGet\NuGet.Config on Windows) and
    temporarily comment out the <clear /> below, rather than editing this file.
  -->
  <packageSources>
    <clear />

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!--
      TEMPORARY local preview feed: AngelSix.ThemeEngine 2.0.8, the rename-only build in which
      RampStage became Stage and [AccentRole] became [StageDefault]. nuget.org's 2.0.8 predates that
      rename, so this absolute path lets the lab compile against the renamed engine. REMOVE this entry,
      and the packageSourceMapping section below, once the renamed engine is published; the
      machine-specific-path warning above applies to this entry and only to it.
    -->
    <add key="engine-preview" value="/private/var/tmp/aimecca-chat/392cbdd98dc540009d322e8d797a9da1/local-nupkgs" />
  </packageSources>

  <!--
    TEMPORARY, with the preview feed above: nuget.org carries a 2.0.8 that predates the rename, and a
    restored engine is cached by version, so 2.0.8 from either source is indistinguishable once in the
    global packages folder. The engine therefore comes from the preview feed alone. Delete this section
    with the feed.
  -->
  <packageSourceMapping>
    <packageSource key="engine-preview">
      <package pattern="AngelSix.ThemeEngine" />
      <package pattern="AngelSix.ThemeEngine.SourceGen" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
