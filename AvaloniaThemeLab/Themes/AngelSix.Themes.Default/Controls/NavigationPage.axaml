<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: a root page so the bar, its title and the content render. -->
  <DataTemplate x:Key="NavigationPagePreview">
    <!-- A single root page: Content takes exactly one child, so the bar, its title and the page content render. -->
    <Border Width="{size:Scaled 340}" Height="{size:Scaled 300}">
      <NavigationPage BarHeight="{size:ControlHeightLg}" HasShadow="True">
        <ContentPage Header="Home">
          <TextBlock Text="Welcome to the home page"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </ContentPage>
      </NavigationPage>
    </Border>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="NavigationPage" Orientation="Horizontal" ContentTemplate="{StaticResource NavigationPagePreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultNavigationBarButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^ /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{color:AccentLineDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />

      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type NavigationPage}" TargetType="NavigationPage">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BarHeight" Value="{size:ControlHeightLg}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Squares the hosted page's top corners where it meets the navigation bar. -->
    <Setter Property="PageTransition">
      <Setter.Value>
        <PageSlide Duration="0:0:0.3" Orientation="Horizontal" FillMode="Forward">
          <PageSlide.SlideInEasing>
            <SplineEasing X1="0.16" Y1="1" X2="0.3" Y2="1" />
          </PageSlide.SlideInEasing>
          <PageSlide.SlideOutEasing>
            <SplineEasing X1="0.2" Y1="0.85" X2="0.3" Y2="1" />
          </PageSlide.SlideOutEasing>
        </PageSlide>
      </Setter.Value>
    </Setter>
    <Setter Property="ModalTransition">
      <Setter.Value>
        <PageSlide Duration="0:0:0.25" Orientation="Vertical" FillMode="Forward">
          <PageSlide.SlideInEasing>
            <SplineEasing X1="0.16" Y1="1" X2="0.3" Y2="1" />
          </PageSlide.SlideInEasing>
          <PageSlide.SlideOutEasing>
            <SplineEasing X1="0.2" Y1="0.85" X2="0.3" Y2="1" />
          </PageSlide.SlideOutEasing>
        </PageSlide>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- ClipToBounds prevents slide animations bleeding outside the control bounds. -->
        <Panel ClipToBounds="True">
          <!-- Layout root docking the bars around the page -->
          <DockPanel>
            <Border Name="PART_NavBarSpacer"
                    Height="{Binding #PART_NavigationBar.Bounds.Height}"
                    IsVisible="False"
                    DockPanel.Dock="Top" />

            <ContentPresenter Name="PART_BottomCommandBar"
                              DockPanel.Dock="Bottom"
                              Background="{TemplateBinding Background}"
                              Content="{Binding CurrentPage?.(NavigationPage.BottomCommandBar), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}" />

            <!-- Back and front presenters enable slide transitions without Control recycling. -->
            <Grid Name="PART_ContentHost"
                  Background="{TemplateBinding Background}"
                  ClipToBounds="True">
              <ContentPresenter Name="PART_PageBackPresenter" />
              <ContentPresenter Name="PART_PagePresenter" />
            </Grid>
          </DockPanel>

          <!-- The bar and the edge under it, stacked so the edge always sits at the bar's real bottom. -->
          <StackPanel ZIndex="1" VerticalAlignment="Top">
            <Border Name="PART_NavigationBar"
                    ClipToBounds="True"
                    MinHeight="{TemplateBinding EffectiveBarHeight}">
              <!-- Places the back button left of the title -->
              <Grid x:Name="PART_NavBarGrid" ColumnDefinitions="Auto, *, Auto">
                <Button x:Name="PART_BackButton"
                        Theme="{StaticResource DefaultNavigationBarButton}"
                        Grid.Column="0"
                        Background="Transparent"
                        IsVisible="{TemplateBinding IsBackButtonEffectivelyVisible}"
                        ToolTip.Tip="{x:Null}">
                  <!-- Overlaps the default arrow and a custom icon -->
                  <Panel Background="Transparent">
                    <Path Data="{icons:ChevronLeft}"
                          x:Name="PART_BackButtonDefaultIcon"
                          Fill="{color:TextDefault}"
                          Stretch="Uniform" />
                    <!-- Custom back icon, when one is supplied -->
                    <ContentPresenter
                      x:Name="PART_BackButtonContentPresenter" />
                  </Panel>
                </Button>

                <ContentPresenter Name="PART_Header"
                                  Grid.Column="1"
                                  Content="{Binding CurrentPage?.Header, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}"
                                  ContentTemplate="{Binding CurrentPage?.HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}" />

                <ContentPresenter Name="PART_TopCommandBar"
                                  Grid.Column="2"
                                  Content="{Binding CurrentPage?.(NavigationPage.TopCommandBar), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}" />
              </Grid>
            </Border>

            <Border Name="PART_BarEdge"
                    IsHitTestVisible="False"
                    IsVisible="{Binding #PART_NavBarShadow.IsVisible}" />
          </StackPanel>

          <Border Name="PART_NavBarShadow"
                  ZIndex="1"
                  VerticalAlignment="Top"
                  IsVisible="False"
                  IsHitTestVisible="False" />

          <!-- Scrim dimming the pages beneath a modal, and taking their clicks -->
          <!-- Follows both presenters: the control swaps their roles when a stacked modal pops -->
          <Border Name="ModalScrim" ZIndex="98">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding ElementName="PART_ModalBackPresenter" Path="IsVisible" />
                <Binding ElementName="PART_ModalPresenter" Path="IsVisible" />
              </MultiBinding>
            </Border.IsVisible>
          </Border>
          <!-- Modal overlay: ZIndex 99 static, 100 animating -->
          <ContentPresenter Name="PART_ModalBackPresenter"
                            ZIndex="99"
                            IsVisible="False" />
          <!-- The page shown over everything as a modal -->
          <ContentPresenter Name="PART_ModalPresenter"
                            ZIndex="100"
                            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Default nav bar background, overridable via a more-specific style selector. -->
    <Style Selector="^ /template/ Border#PART_NavigationBar">
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    </Style>

    <!-- Nav bar grid margin: the side inset, and a spacing step above and below the title -->
    <Style Selector="^ /template/ Grid#PART_NavBarGrid">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXxl}, Vertical={size:SpacingLg}}" />
    </Style>

    <Style Selector="^ /template/ Button#PART_BackButton">
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXl}, Right={size:SpacingXl}}" />
    </Style>

    <Style Selector="^ /template/ Path#PART_BackButtonDefaultIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Header font size, margin, ink and alignment -->
    <Style Selector="^ /template/ ContentPresenter#PART_Header">
      <Setter Property="FontSize" Value="{size:FontSizeXl}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingXxl}}" />
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_TopCommandBar">
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
      <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_PageBackPresenter, ^ /template/ ContentPresenter#PART_PagePresenter">
    </Style>

    <Style Selector="^ /template/ Path#PART_BackButtonDefaultIcon">
      <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_BackButtonContentPresenter">
      <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>

    <!-- Strip beneath the bar: a solid role-token edge, not an overlay scrim. -->
    <Style Selector="^ /template/ Border#PART_BarEdge">
      <Setter Property="Height" Value="{size:ThicknessLgDouble}" />
      <Setter Property="Background" Value="{color:BorderDefault}" />
    </Style>

    <Style Selector="^ /template/ Border#PART_NavBarShadow">
      <Setter Property="Height" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^ /template/ Border#ModalScrim">
      <Setter Property="Background" Value="{color:OverlayMediumBrush}" />
    </Style>

    <!-- Modal surface: inset over the scrim, its padding the shadow band around the page -->
    <Style Selector="^ /template/ ContentPresenter#PART_ModalBackPresenter, ^ /template/ ContentPresenter#PART_ModalPresenter">
      <Setter Property="Margin" Value="{size:Edges {size:SpacingXxl}}" />
      <Setter Property="Padding" Value="{size:Edges {size:SpacingLg}}" />
      <Setter Property="Background" Value="{color:OverlayWeakBrush}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>

    <!-- :nav-bar-inset: spacer reserves nav-bar height so content is pushed below -->
    <Style Selector="^:nav-bar-inset /template/ Border#PART_NavBarSpacer">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- :nav-bar-compact: collapse CommandBar labels when bar is too short -->
    <Style Selector="^:nav-bar-compact /template/ ContentPresenter#PART_TopCommandBar CommandBar">
      <Setter Property="DefaultLabelPosition" Value="Collapsed" />
    </Style>

    <!-- CommandBar styles (moved from ContentPresenter.Styles per/3) -->
    <Style Selector="^ /template/ ContentPresenter#PART_TopCommandBar CommandBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_TopCommandBar CommandBarButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}, Right={size:SpacingXxl}}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_TopCommandBar CommandBarToggleButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}, Right={size:SpacingXxl}}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_TopCommandBar Button#PART_OverflowButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}, Right={size:SpacingXxl}}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
