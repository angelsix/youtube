<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: interaction states riding on a checked box so the tick shows alongside each effect, plus accent hues. -->
  <DataTemplate x:Key="CheckBoxPreview">
    <StackPanel Spacing="{size:SpacingXl}">
      <CheckBox>Unchecked</CheckBox>
      <CheckBox IsChecked="True">Checked</CheckBox>
      <CheckBox theme:Preview.State="Hover" IsChecked="True">Hover</CheckBox>
      <CheckBox theme:Preview.State="Pressed" IsChecked="True">Pressed</CheckBox>
      <CheckBox theme:Preview.State="Focused" IsChecked="True">Focused</CheckBox>
      <CheckBox IsChecked="True" IsEnabled="False">Disabled</CheckBox>
      <!-- Hues tint the AccentBrush-driven fill and the tick follows the hue, so combine hues with states instead of repeating rows -->
      <CheckBox IsThreeState="True" IsChecked="{x:Null}">Indeterminate</CheckBox>
      <CheckBox theme:Accent.Kind="Warning" IsChecked="True">Warning Checked</CheckBox>
      <CheckBox theme:Accent.Kind="Success" theme:Preview.State="Focused" IsChecked="True">Success + Focused</CheckBox>
      <CheckBox theme:Accent.Kind="Warning" IsChecked="True" IsEnabled="False">Warning Disabled</CheckBox>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="CheckBox" Orientation="Horizontal" ContentTemplate="{StaticResource CheckBoxPreview}" />
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">

    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <!-- The unchecked ring: the outlined-control border role, never an overlay -->
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <!-- Press animation: the whole control shrinks about its centre, box and label together -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root placing the box beside its label -->
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

          <Border x:Name="PART_Border"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}" />

          <Grid Grid.Column="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- The empty box the tick appears in; its fill follows the check state, not the face -->
            <Border x:Name="NormalRectangle"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    UseLayoutRounding="False" />

            <!-- Padded area holding the checked and indeterminate marks -->
            <Border x:Name="TickBorder">
              <!-- Overlaps the tick and the indeterminate square -->
              <Panel>
                <Viewbox x:Name="TickViewbox"
                         UseLayoutRounding="False"
                         Height="{Binding Width, RelativeSource={RelativeSource Self}}">
                  <Path x:Name="CheckGlyph"
                        Opacity="0"
                        Stretch="Uniform"
                        Data="{icons:Checkmark}" />
                </Viewbox>

                <Border x:Name="IndeterminateBox"
                        Opacity="0" />
              </Panel>
            </Border>
          </Grid>

          <ContentPresenter x:Name="PART_ContentPresenter"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextWrapping="Wrap"
                            Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Box face: pinned to the large-icon square so the tick inset never resizes the box -->
    <Style Selector="^ /template/ Border#NormalRectangle">
      <Setter Property="Width" Value="{size:IconSizeLg}" />
      <Setter Property="Height" Value="{size:IconSizeLg}" />
    </Style>

    <!-- Tick visuals: smaller than the icon size so the tick keeps clear air inside the box edge -->
    <Style Selector="^ /template/ Viewbox#TickViewbox">
      <Setter Property="Width" Value="{size:Scaled {size:IconSizeMd}, 0.75}" />
    </Style>

    <Style Selector="^ /template/ Border#TickBorder">
      <Setter Property="Padding" Value="{size:Edges {size:SpacingMd}}" />
    </Style>

    <!-- Bold tick: filled outline stroked in the same hue-neutral ink. -->
    <Style Selector="^ /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{color:OnSolidFillInkDefault}" />
      <Setter Property="Stroke" Value="{color:OnSolidFillInkDefault}" />
      <Setter Property="StrokeThickness" Value="{size:ThicknessSmDouble}" />
    </Style>

    <Style Selector="^ /template/ Border#IndeterminateBox">
      <Setter Property="Width" Value="{size:Scaled {size:IconSizeMd}, 0.625}" />
      <Setter Property="Height" Value="{size:Scaled {size:IconSizeMd}, 0.625}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
    </Style>

    <!-- Hover state: the box grows slightly and its fill steps to the lighter hover stage, a clear step above the pressed stage below -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:HoverScale}}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: the whole control sinks about its centre, box and label together -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:PressedScale}}" />
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <Style Selector="^:disabled, ^[(theme|Preview.State)=Disabled]">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state. -->
    <Style Selector="^:focus-visible /template/ Border#NormalRectangle, ^[(theme|Preview.State)=Focused] /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^:checked">
      <Setter Property="Background" Value="{color:SolidFillDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillDefaultBrush}" />

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Opacity" Value="1" />
        <!-- The tick rides the solid fill, so it takes the on-solid ink. -->
        <Setter Property="Fill" Value="{color:OnSolidFillInkDefaultBrush}" />
        <Setter Property="Stroke" Value="{color:OnSolidFillInkDefaultBrush}" />
      </Style>
    </Style>

    <!-- Checked and hovering: the solid face steps one stage deeper ({color:SolidFillHoverBrush}). -->
    <Style Selector="^:checked:pointerover, ^:checked[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:SolidFillHoverBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillHoverBrush}" />

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{color:OnSolidFillInkDefaultBrush}" />
        <Setter Property="Stroke" Value="{color:OnSolidFillInkDefaultBrush}" />
      </Style>
    </Style>

    <!-- Checked and pressed: the solid face steps two stages deeper ({color:SolidFillPressedBrush}). -->
    <Style Selector="^:checked:pressed, ^:checked[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:SolidFillPressedBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillPressedBrush}" />

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{color:OnSolidFillInkDefaultBrush}" />
        <Setter Property="Stroke" Value="{color:OnSolidFillInkDefaultBrush}" />
      </Style>
    </Style>

    <!-- Indeterminate state: the solid-fill face carries the dash -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{color:SolidFillDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillDefaultBrush}" />

      <Style Selector="^ /template/ Border#IndeterminateBox">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

    <!-- Indeterminate and hovering: the solid face steps one stage deeper ({color:SolidFillHoverBrush}) -->
    <Style Selector="^:indeterminate:pointerover, ^:indeterminate[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:SolidFillHoverBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillHoverBrush}" />
    </Style>

    <!-- Indeterminate and pressed: the solid face steps two stages deeper ({color:SolidFillPressedBrush}) -->
    <Style Selector="^:indeterminate:pressed, ^:indeterminate[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:SolidFillPressedBrush}" />
      <Setter Property="BorderBrush" Value="{color:SolidFillPressedBrush}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
