<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: one vertical column, one fixed width wide enough for the longest label. -->
  <DataTemplate x:Key="ToggleButtonPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <ToggleButton Width="{size:Scaled 240}" Content="Unchecked" />
      <ToggleButton Width="{size:Scaled 240}" theme:Preview.State="Hover" Content="Hover" />
      <ToggleButton Width="{size:Scaled 240}" theme:Preview.State="Pressed" Content="Pressed" />
      <ToggleButton Width="{size:Scaled 240}" theme:Preview.State="Focused" Content="Focused" />
      <ToggleButton Width="{size:Scaled 240}" IsEnabled="False" Content="Disabled" />
      <ToggleButton Width="{size:Scaled 240}" IsChecked="True" Content="Checked" />
      <ToggleButton Width="{size:Scaled 240}" theme:Accent.Kind="Warning" theme:Preview.State="Hover" IsChecked="True" Content="Checked · Warning · Hover" />
      <ToggleButton Width="{size:Scaled 240}" IsChecked="True" IsEnabled="False" Content="Checked · Disabled" />
      <ToggleButton Width="{size:Scaled 240}" IsThreeState="True" IsChecked="{x:Null}" Content="Indeterminate" />
      <ToggleButton Width="{size:Scaled 240}" theme:Accent.Kind="Success" IsThreeState="True" IsChecked="{x:Null}" Content="Indeterminate · Success" />
      <ToggleButton Width="{size:Scaled 240}" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" Content="Indeterminate · Disabled" />
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="ToggleButton" Orientation="Vertical" ContentTemplate="{StaticResource ToggleButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">

    <!-- Visual defaults: identical to Button (outlined column) -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges {size:SpacingXl}, {size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ButtonAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Hover state: identical to Button -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:HoverScale}}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: identical to Button -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:PressedScale}}" />
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: identical to Button (whole-face dimming, no recoloured fill) -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <!-- The focus weight is 0, the weight the pinned focus example has always drawn. -->
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Checked default: the solid-fill face with the on-fill ink the policy picks for it -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{color:SolidFillDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:OnSolidFillInkDefault}" />
    </Style>

    <!-- Checked hover: the solid face steps one stage deeper ({color:SolidFillHover}). -->
    <Style Selector="^:checked:pointerover, ^:checked[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:SolidFillHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:OnSolidFillInkDefault}" />
    </Style>

    <!-- Checked pressed: the solid face steps two stages deeper ({color:SolidFillPressed}). -->
    <Style Selector="^:checked:pressed, ^:checked[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:SolidFillPressed}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:OnSolidFillInkDefault}" />
    </Style>

    <Style Selector="^:checked:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacityChecked}" />
    </Style>

    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <Style Selector="^:indeterminate:pointerover, ^:indeterminate[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <Style Selector="^:indeterminate:pressed, ^:indeterminate[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
