<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Controls.Converters"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">

  <ControlTheme x:Key="DefaultMenuScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="IsScrollChainingEnabled" Value="False" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root docking the scroll arrows around the menu -->
        <DockPanel>
          <RepeatButton x:Name="PART_UpButton" DockPanel.Dock="Top"
                        BorderThickness="0"
                        Background="Transparent"
                        RenderTransform="{x:Null}"
                        Command="{Binding LineUp, RelativeSource={RelativeSource TemplatedParent}}">
            <RepeatButton.IsVisible>
              <MultiBinding Converter="{x:Static converters:MenuScrollingVisibilityConverter.Instance}"
                            ConverterParameter="0">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="VerticalScrollBarVisibility" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Offset.Y" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Extent.Height" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Viewport.Height" />
              </MultiBinding>
            </RepeatButton.IsVisible>
            <PathIcon x:Name="PART_UpPath"
                      IsHitTestVisible="False"
                      UseLayoutRounding="False" />
          </RepeatButton>
          <RepeatButton x:Name="PART_DownButton" DockPanel.Dock="Bottom"
                        BorderThickness="0"
                        Background="Transparent"
                        RenderTransform="{x:Null}"
                        Command="{Binding LineDown, RelativeSource={RelativeSource TemplatedParent}}">
            <RepeatButton.IsVisible>
              <MultiBinding Converter="{x:Static converters:MenuScrollingVisibilityConverter.Instance}"
                            ConverterParameter="100">
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="VerticalScrollBarVisibility" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Offset.Y" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Extent.Height" />
                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Viewport.Height" />
              </MultiBinding>
            </RepeatButton.IsVisible>
            <PathIcon x:Name="PART_DownPath"
                      IsHitTestVisible="False"
                      UseLayoutRounding="False" />
          </RepeatButton>
          <ScrollContentPresenter Name="PART_ContentPresenter">
            <ScrollContentPresenter.GestureRecognizers>
              <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                       CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}" />
            </ScrollContentPresenter.GestureRecognizers>
          </ScrollContentPresenter>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- Themed defaults for inner template elements -->
    <Style Selector="^ /template/ PathIcon#PART_UpPath">
      <Setter Property="Data" Value="{icons:ChevronUp}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <!-- Centre the chevron across the strip's full width -->
      <Setter Property="HorizontalAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>
    <Style Selector="^ /template/ PathIcon#PART_DownPath">
      <Setter Property="Data" Value="{icons:ChevronDown}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Foreground" Value="{color:TextDefault}" />
      <!-- Centre the chevron across the strip's full width -->
      <Setter Property="HorizontalAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>

    <!-- Chevron brightens with the hovered row's ink -->
    <Style Selector="^ /template/ RepeatButton:pointerover > PathIcon">
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <!-- Strips span the popup's full width; the chevron centres across that width -->
    <Style Selector="^ /template/ RepeatButton#PART_UpButton">
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
      <Setter Property="VerticalContentAlignment" Value="{theme:ButtonAlignmentVertical}" />
    </Style>
    <Style Selector="^ /template/ RepeatButton#PART_DownButton">
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
      <Setter Property="VerticalContentAlignment" Value="{theme:ButtonAlignmentVertical}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
