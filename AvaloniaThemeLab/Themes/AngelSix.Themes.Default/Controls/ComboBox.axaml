<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:sys="using:System"
                    xmlns:default="using:AngelSix.Themes.Default">
  <DataTemplate x:Key="ComboBoxPreview">
    <!-- Two columns: the box states and the item states, side by side so both fit the pane at the default window size -->
    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{size:SpacingXl}">
      <!-- Left column: the box's own states -->
      <StackPanel Grid.Column="0" Spacing="{size:SpacingLg}">
        <TextBlock Text="Rest · nothing chosen" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Resting face with nothing chosen: the prompt shows -->
        <ComboBox Width="{size:Scaled 180}" PlaceholderText="Select…">
          <ComboBoxItem>Rest</ComboBoxItem>
          <ComboBoxItem>Second</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Selected" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- A value chosen: the face carries the chosen value -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Hover" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" theme:Preview.State="Hover">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Pressed" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" theme:Preview.State="Pressed">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Focused" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Keyboard focus rings the frame -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" theme:Preview.State="Focused">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Focused · Warning hue" FontSize="{size:FontSizeSm}" theme:Accent.Kind="Warning" Foreground="{color:AccentInkDefault}" />
        <!-- An accented box keeps its own hue for the focus ring while FocusColorOnAccents is off -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" theme:Preview.State="Focused" theme:Accent.Kind="Warning">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Unusable: faded to the disabled strength -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" IsEnabled="False">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Failed validation" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Failed validation lights the error border and keeps the box's height -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Error</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Editable" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- Free-text mode swaps the picker face for a text field -->
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" IsEditable="True">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Editable · Disabled" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <ComboBox Width="{size:Scaled 180}" SelectedIndex="1" IsEditable="True" IsEnabled="False">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <!-- Right column: the drop-down's item states -->
      <StackPanel Grid.Column="1" Spacing="{size:SpacingLg}">
        <!-- Caption naming the section and the state of the first row -->
        <TextBlock Text="Items" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The list as the drop-down paints it. -->
        <Border Width="{size:Scaled 190}"
                Background="{color:BackgroundDefault}"
                BorderBrush="{color:BorderDefault}"
                BorderThickness="{size:ThicknessSm}"
                CornerRadius="{size:RadiusMd}"
                Padding="{size:Edges {size:SpacingMd}}">
          <!-- The rows of the list, packed as a list packs them -->
          <StackPanel>
            <ComboBoxItem>Rest</ComboBoxItem>
            <ComboBoxItem theme:Preview.State="Hover">Hover</ComboBoxItem>
            <ComboBoxItem theme:Preview.State="Pressed">Pressed</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Selected</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Preview.State="Hover">Selected · Hover</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Warning">Selected · Warning</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Success">Selected · Success</ComboBoxItem>
            <ComboBoxItem IsEnabled="False">Disabled</ComboBoxItem>
            <ComboBoxItem IsSelected="True" IsEnabled="False">Selected · Disabled</ComboBoxItem>
          </StackPanel>
        </Border>
        <TextBlock Text="Open · the real drop-down" FontSize="{size:FontSizeSm}" Foreground="{color:DimTextDefault}" />
        <!-- The box with its own drop-down open, so the real popup frame and its live rows are shown too (kept last so the popup overlays nothing) -->
        <ComboBox Width="{size:Scaled 190}" SelectedIndex="1" IsDropDownOpen="True">
          <ComboBoxItem>First</ComboBoxItem>
          <ComboBoxItem>Selected</ComboBoxItem>
          <ComboBoxItem>Third</ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="ComboBox" Orientation="Horizontal" ContentTemplate="{StaticResource ComboBoxPreview}" />
    </Border>
  </Design.PreviewWith>

  <x:Int32 x:Key="ComboBoxPopupMaxNumberOfItems">15</x:Int32>
  <x:Int32 x:Key="ComboBoxPopupMaxNumberOfItemsThatCanBeShownOnOneSide">7</x:Int32>

  <!-- The editable field: the frameless field terms, with the field's own disabled dim cancelled. -->
  <ControlTheme x:Key="DefaultComboBoxEditableField" TargetType="TextBox" BasedOn="{StaticResource DefaultFramelessTextBox}">
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">

    <!-- Face inset: one spacing on every side, so a large spacing setting grows the box evenly. -->
    <Setter Property="Padding" Value="{size:Edges {size:SpacingLg}}" />
    <!-- Focus ring is the default focus adorner. -->
    <Setter Property="MaxDropDownHeight" Value="{size:Scaled 504}" />
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="PlaceholderForeground" Value="{color:DimTextDefault}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Layout root: value on the left, arrow right (its column is the arrow plus its margin) -->
          <Grid ColumnDefinitions="*,Auto">
            <Border x:Name="Background"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBlock x:Name="PlaceholderTextBlock"
                       Grid.Column="0"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Margin="{TemplateBinding Padding}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <!-- The selected item, when not editable -->
            <ContentControl x:Name="ContentPresenter"
                            Content="{TemplateBinding SelectionBoxItem}"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />

            <TextBox Name="PART_EditableTextBox"
                     Theme="{StaticResource DefaultComboBoxEditableField}"
                     Grid.Column="0"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="Transparent"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     IsVisible="{TemplateBinding IsEditable}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
              </TextBox.Resources>
            </TextBox>

            <Border x:Name="DropDownOverlay"
                    Grid.Column="1"
                    Background="Transparent"
                    IsVisible="False"
                    HorizontalAlignment="Right" />

            <!-- The arrow marking this as a dropdown -->
            <PathIcon x:Name="DropDown"
                      Grid.Column="1"
                      UseLayoutRounding="False"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />

            <!-- The list shown when the box is open -->
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border x:Name="PopupBorder"
                      HorizontalAlignment="Stretch"
                      theme:Accent.Kind="{Binding (theme:Accent.Kind), RelativeSource={RelativeSource TemplatedParent}}">
                <!-- Scrolls the list when it overflows; the frame's padding is the list's inset -->
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              IsScrollChainingEnabled="False"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Frame keeps its own height; the error message sits below it instead of sharing the 32px with the box -->
    <Style Selector="^ /template/ Border#Background">
      <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    </Style>

    <Style Selector="^ /template/ Border#DropDownOverlay">
      <Setter Property="Width" Value="{size:ControlHeightSm}" />
      <Setter Property="Margin" Value="{size:Edges Top={size:BaseSize}, Right={size:BaseSize}, Bottom={size:BaseSize}}" />
    </Style>

    <!-- Chevron glyph: a style, not a template value, so it can be swapped by state -->
    <Style Selector="^ /template/ PathIcon#DropDown">
      <Setter Property="Data" Value="{icons:ChevronDown}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <!-- The same inset from the right edge as the value has from the left -->
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingLg}}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Even inset all round (matches MenuFlyoutPresenter); the list's own rows carry their padding -->
    <Style Selector="^ /template/ Border#PopupBorder">
      <Setter Property="Padding" Value="{size:Edges {size:SpacingMd}}" />
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>

    <!-- Scroller: no fill of its own; the popup frame paints it, and a square fill inside covers the frame's corners -->
    <Style Selector="^ /template/ ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#Background, ^[(theme|Preview.State)=Hover] /template/ Border#Background">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#Background, ^[(theme|Preview.State)=Pressed] /template/ Border#Background">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Disabled state: the whole box fades to the disabled strength -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state: the frame takes the focus weight and colour. -->
    <Style Selector="^:focus-visible /template/ Border#Background,
                     ^[(theme|Preview.State)=Focused] /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^:error /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{color:AccentErrorBrush}" />
    </Style>

    <Style Selector="^[IsEditable=true]">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
