<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:generic="using:System.Collections.Generic"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: the shared state column, declared before Design.PreviewWith uses it. -->
  <DataTemplate x:Key="AutoCompleteBoxPreview">
    <StackPanel Spacing="{size:SpacingXxl}" HorizontalAlignment="Left">
      <AutoCompleteBox Width="{size:Scaled 200}" PlaceholderText="Default">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            <x:String>Apple</x:String>
            <x:String>Banana</x:String>
            <x:String>Cherry</x:String>
            <x:String>Date</x:String>
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
      <AutoCompleteBox Width="{size:Scaled 200}" theme:Preview.State="Focused" PlaceholderText="Focused">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            <x:String>Apple</x:String>
            <x:String>Banana</x:String>
            <x:String>Cherry</x:String>
            <x:String>Date</x:String>
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
      <AutoCompleteBox Width="{size:Scaled 200}" theme:Accent.Kind="Warning" PlaceholderText="Warn">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            <x:String>Apple</x:String>
            <x:String>Banana</x:String>
            <x:String>Cherry</x:String>
            <x:String>Date</x:String>
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
      <AutoCompleteBox Width="{size:Scaled 200}" theme:Accent.Kind="Success" PlaceholderText="Success">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            <x:String>Apple</x:String>
            <x:String>Banana</x:String>
            <x:String>Cherry</x:String>
            <x:String>Date</x:String>
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
      <AutoCompleteBox Width="{size:Scaled 200}" IsEnabled="False" Text="Disabled">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            <x:String>Apple</x:String>
            <x:String>Banana</x:String>
            <x:String>Cherry</x:String>
            <x:String>Date</x:String>
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="AutoCompleteBox" Orientation="Vertical" ContentTemplate="{StaticResource AutoCompleteBoxPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">

    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="PlaceholderForeground" Value="{color:DimTextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentLineDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="Padding" Value="{size:Edges {size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MaxDropDownHeight" Value="{size:Scaled {size:ControlHeightSm}, 12}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>

          <!-- Layout root holding the field and its dropdown -->
          <Grid Name="PART_LayoutRoot">

            <!-- The text field the user types into -->
            <TextBox Name="PART_TextBox"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                     HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="{TemplateBinding CornerRadius}"
                     CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                     ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                     Padding="{TemplateBinding Padding}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontWeight="{TemplateBinding FontWeight}"
                     FontSize="{TemplateBinding FontSize}"
                     DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                     MaxLength="{TemplateBinding MaxLength}"
                     Width="{TemplateBinding Width}"
                     InnerLeftContent="{TemplateBinding InnerLeftContent}"
                     InnerRightContent="{TemplateBinding InnerRightContent}" />

            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}">

              <Border Name="PART_SuggestionsContainer">

                <ListBox Name="PART_SelectingItemsControl"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemTemplate="{TemplateBinding ItemTemplate}"
                         ScrollViewer.IsScrollChainingEnabled="False" />
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ TextBox#PART_TextBox">
      <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    </Style>
    
    <Style Selector="^ /template/ Border#PART_SuggestionsContainer">
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
      <Setter Property="Padding" Value="{size:Edges Vertical={size:SpacingSm}}" />
    </Style>

    <Style Selector="^ /template/ ListBox#PART_SelectingItemsControl">
      <Setter Property="Margin" Value="{size:Edges Left={size:Scaled -1}, Right={size:Scaled -1}}" />
    </Style>

    <Style Selector="^:pointerover /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ TextBox#PART_TextBox, ^[(theme|Preview.State)=Focused] /template/ TextBox#PART_TextBox">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

  </ControlTheme>

</ResourceDictionary>
