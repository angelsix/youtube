<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <!-- The declared reason this control has no gallery entry of its own. -->

  <theme:PreviewShownIn x:Key="MenuItemPreviewShownIn"
                        ShownIn="{x:Type ContextMenu}"
                        Reason="A menu row is met inside a real menu; the ContextMenu preview pins every row state." />

  <conv:PlatformKeyGestureConverter x:Key="KeyGestureConverter" />

  <!-- The tick drawn beside a checked item; local so the:checked:toggle style always resolves it. -->
  <PathGeometry x:Key="CheckedTickPathData" Figures="M 0,5 L 4,9 L 11,1" />

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <!-- An accented row takes the accent text stage, not the body stage. -->
    <Style Selector="^[(theme|Accent.Kind)=Primary], ^[(theme|Accent.Kind)=Success], ^[(theme|Accent.Kind)=Warning], ^[(theme|Accent.Kind)=Info], ^[(theme|Accent.Kind)=Error], ^[(theme|Accent.Kind)=Destructive], ^[(theme|Accent.Kind)=Subtle]">
      <Setter Property="Foreground" Value="{color:AccentInkDefault}" />
    </Style>
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Concentric with the menu container. -->
    <Setter Property="CornerRadius" Value="{size:ConcentricCorners Radius={size:RadiusMd}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled {size:SpacingMd}, 1.25}}, All=True}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Even vertical edges so the label sits true centre (was Top 4 / Bottom 8) -->
    <Setter Property="Padding" Value="{size:Edges {size:SpacingLg}}" />
    <!-- A menu row is a container: it fills the list's width, and so does its highlight and hit area -->
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <!-- Focus is the row's own inset border (below). -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the item and its submenu -->
        <Panel>
          <Border Name="PART_LayoutRoot"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Columns: one shared leading check-or-icon column, label, shortcut and chevron. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemLeading" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemIGT" />
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="MenuItemChevron" />
              </Grid.ColumnDefinitions>

              <!-- The tick shown when the item is checked -->
              <ContentControl Grid.Column="0"
                              x:Name="PART_ToggleIconPresenter"
                              IsVisible="False"
                              Theme="{StaticResource DefaultMenuItemIconTheme}" />

              <!-- The item's icon, in the same leading cell as the tick (a toggle's check wins) -->
              <ContentControl Grid.Column="0"
                              x:Name="PART_IconPresenter"
                              IsVisible="False"
                              Theme="{StaticResource DefaultMenuItemIconTheme}"
                              Content="{TemplateBinding Icon}" />

              <ContentPresenter Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Grid.Column="1"/>
              <!-- The keyboard shortcut, shown on the right -->
              <TextBlock x:Name="PART_InputGestureText"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource KeyGestureConverter}}"/>
              <!-- Chevron marking an item with a submenu -->
              <Path Name="PART_ChevronPath"
                    Stretch="Uniform"
                    Data="{icons:ChevronRight}"
                    Grid.Column="3" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <Border x:Name="PART_PopupBorder"
                    Padding="{size:Edges {size:SpacingMd}}"
                    MaxWidth="{size:Scaled 456}"
                    HorizontalAlignment="Stretch">
              <ScrollViewer Theme="{StaticResource DefaultMenuScrollViewer}">
                <ItemsPresenter x:Name="PART_PopupItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>

    <!-- Themed defaults for inner template elements -->
    <Style Selector="^ /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingLg}}" />
    </Style>
    <Style Selector="^ /template/ ContentControl#PART_IconPresenter">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Margin" Value="{size:Edges Right={size:SpacingLg}}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingXxl}}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>
    <!-- No extra left margin: the item's own right padding spaces the chevron from the label -->
    <Style Selector="^ /template/ Path#PART_ChevronPath">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Fill" Value="{color:AccentBrush Light1}" />
      <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    </Style>
    <Style Selector="^ /template/ Popup#PART_Popup">
      <Setter Property="HorizontalOffset" Value="{size:Scaled {size:SpacingMd}, -1}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_PopupBorder">
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>
    <Style Selector="^:icon /template/ ContentControl#PART_IconPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Selected: driven by the real:selected pseudo-class (IsSelected=True); no Preview.State needed -->
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:SelectedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot,
                     ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:SelectedBackgroundHover}" />
    </Style>
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot,
                     ^:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:SelectedBackgroundPressed}" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentLineDefault}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#PART_InputGestureText">
      <Setter Property="Foreground" Value="{color:TextDefault}" />
    </Style>

    <!-- Hover: an opaque ramp stage, not an overlay — translucency would erase the fill -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:pointerover /template/ Path#PART_ChevronPath,
                     ^[(theme|Preview.State)=Hover] /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentLineDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:pressed /template/ Path#PART_ChevronPath,
                     ^[(theme|Preview.State)=Pressed] /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentLineDefault}" />
    </Style>

    <!-- Disabled: the whole row fades, selected or not, so a chosen-but-unavailable item still reads as chosen -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus: the row's own inset border. -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot,
                     ^[(theme|Preview.State)=Focused] /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^:open /template/ Path#PART_ChevronPath">
      <Setter Property="Fill" Value="{color:AccentLineDefault}" />
    </Style>

    <Style Selector="^:empty /template/ Path#PART_ChevronPath">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Separator/>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^ /template/ Image#PART_ToggleIconImage">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Content">
        <Template>
          <!-- Stroked, not filled: the tick is an open polyline -->
          <Path Stroke="{Binding $parent[MenuItem].Foreground}"
                StrokeThickness="{size:ThicknessSmDouble}"
                Stretch="Uniform"
                Width="{size:IconSizeMd}" Height="{size:IconSizeMd}"
                Data="{StaticResource CheckedTickPathData}" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Content">
        <Template>
          <Ellipse Fill="{Binding $parent[MenuItem].Foreground}"
                   Margin="{size:Edges {size:SpacingMd}}" Width="{size:IconSizeMd}" Height="{size:IconSizeMd}" />
        </Template>
      </Setter>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="HorizontalMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DefaultTopLevelMenuItem}">
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXl}, Top={size:SpacingMd}, Right={size:SpacingXl}, Bottom={size:SpacingLg}}" />
    <Setter Property="Margin" Value="{size:Edges Horizontal={size:SpacingSm}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
  </ControlTheme>

  <ControlTheme x:Key="DefaultMenuItemIconTheme"
                TargetType="ContentControl">
    <Setter Property="Width"
            Value="{size:IconSizeMd}" />
    <Setter Property="Height"
            Value="{size:IconSizeMd}" />
    <!-- Centres the glyph in its shared leading cell. -->
    <Setter Property="HorizontalAlignment" Value="{theme:ButtonAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Scales the icon to fit its column -->
        <Viewbox
          StretchDirection="DownOnly"
          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
          VerticalAlignment="{TemplateBinding VerticalAlignment}">
          <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
