<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: one link per line, every instance the same width. -->
  <DataTemplate x:Key="HyperlinkButtonPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <HyperlinkButton Width="{size:Scaled 240}" Content="Default" />
      <HyperlinkButton Width="{size:Scaled 240}" theme:Preview.State="Hover" Content="Hover" />
      <HyperlinkButton Width="{size:Scaled 240}" theme:Preview.State="Pressed" Content="Pressed" />
      <HyperlinkButton Width="{size:Scaled 240}" theme:Preview.State="Focused" Content="Focused" />
      <HyperlinkButton Width="{size:Scaled 240}" Content="Disabled" IsEnabled="False" />
      <!-- Accents recolour the text through the hue-aware ramp -->
      <HyperlinkButton Width="{size:Scaled 240}" theme:Accent.Kind="Warning" theme:Preview.State="Hover" Content="Warning · Hover" />
      <HyperlinkButton Width="{size:Scaled 240}" theme:Accent.Kind="Success" theme:Preview.State="Focused" Content="Success · Focused" />
      <!-- Size parity with a Button: same padding, so both measure identically tall -->
      <StackPanel Orientation="Horizontal" Spacing="{size:SpacingLg}" HorizontalAlignment="Left">
        <Button Width="{size:Scaled 120}" Content="Button" />
        <HyperlinkButton Width="{size:Scaled 120}" Content="Link" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="HyperlinkButton" Orientation="Vertical" ContentTemplate="{StaticResource HyperlinkButtonPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton">

    <!-- Visual defaults: plain text, no fill, border or underline; the focus ring is the only frame -->
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="theme:Accent.Kind" Value="Primary" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
    <Setter Property="Foreground" Value="{color:AccentInkDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <!-- Same outer size as a Button: Button's padding, no fill or border -->
    <Setter Property="Padding" Value="{size:Edges {size:SpacingXl}, {size:SpacingLg}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Hover state: the ink stays at the accent text stage (Dark3) like every other accent text. -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:HoverScale}, 0.97664}" />
      <Setter Property="ZIndex" Value="{size:HoverZIndex}" />
    </Style>

    <!-- Pressed state: the ink stays at Dark3; feedback is the half-strength shrink -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:PressedScale}, 1.01}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <!-- The focus weight is 0, the weight the pinned focus example has always drawn. -->
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Visited state: stays at the accent text stage (Dark3). -->
    <Style Selector="^:visited">
      <Setter Property="Foreground" Value="{color:AccentInkDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
