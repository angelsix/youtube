<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:sys="using:System"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: one box per nameable state, ordered so the column reads (default, empty, hover, focused, Warning, disabled, error). -->
  <DataTemplate x:Key="TimePickerPreview">
    <StackPanel Spacing="{size:SpacingXl}">
      <!-- A chosen time: the resting face -->
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30" />
      <!-- Nothing chosen: the prompt dims to the placeholder strength -->
      <TimePicker Width="{size:Scaled 240}" />
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30" theme:Preview.State="Hover" />
      <!-- Keyboard focus rings the frame -->
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30" theme:Preview.State="Focused" />
      <!-- The Warning hue tints the face and keeps its own hue on focus -->
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30" theme:Accent.Kind="Warning" />
      <!-- Unusable: faded to the disabled strength -->
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30" IsEnabled="False" />
      <!-- Failed validation lights the error border and keeps the box's height -->
      <TimePicker Width="{size:Scaled 240}" SelectedTime="14:30">
        <DataValidationErrors.Error>
          <sys:Exception>
            <x:Arguments>
              <x:String>Error</x:String>
            </x:Arguments>
          </sys:Exception>
        </DataValidationErrors.Error>
      </TimePicker>
      <!-- The open pop-up is exercised by the crawler's picker action (open, wheel a column, confirm). -->
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="TimePicker" Orientation="Horizontal" ContentTemplate="{StaticResource TimePickerPreview}" />

    </Border>
  </Design.PreviewWith>

  <!-- The declared reason the pop-up presenter has no gallery entry of its own. -->

  <theme:PreviewShownIn x:Key="TimePickerPresenterPreviewShownIn"
                        ShownIn="{x:Type TimePicker}"
                        Reason="The pop-up presenter is met inside the picker that opens it." />

  <ControlTheme x:Key="DefaultTimePickerFlyoutButton" TargetType="Button">
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The button's label; carries the face inset from the control's padding -->
        <ContentPresenter Name="PART_ContentPresenter"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          Background="{TemplateBinding Background}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale {size:PressedScale}}" />
    </Style>

    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <!-- An opaque stage, never an overlay: the frame has its own fill, so a translucent state background shows whatever sits behind through it -->
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">

    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges {size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:Scaled {size:FontSizeMd}, 14}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <Grid Name="LayoutRoot" controls:PickerPopupAlignment.Apply="True">
            <!-- Opens the time picker when clicked; the label carries the control's padding -->
            <Button Name="PART_FlyoutButton"
                    Theme="{StaticResource DefaultTimePickerFlyoutButton}"
                    Foreground="{TemplateBinding Foreground}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <!-- Splits the button into hour, minute, second and period; column weights set in code -->
              <Grid Name="PART_FlyoutButtonContentGrid">
                <Border x:Name="PART_FirstPickerHost"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                  <TextBlock x:Name="PART_HourTextBlock"
                             Text="hour"
                             HorizontalAlignment="Center"
                             VerticalAlignment="{theme:StandardAlignmentVertical}" />
                </Border>

                <Rectangle Name="PART_FirstColumnDivider"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch" />

                <Border x:Name="PART_SecondPickerHost"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                  <TextBlock x:Name="PART_MinuteTextBlock"
                             Text="minute"
                             HorizontalAlignment="Center"
                             VerticalAlignment="{theme:StandardAlignmentVertical}" />
                </Border>

                <Rectangle Name="PART_SecondColumnDivider"
                           Grid.Column="3"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch" />

                <Border x:Name="PART_ThirdPickerHost"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                  <TextBlock x:Name="PART_SecondTextBlock"
                             Text="second"
                             HorizontalAlignment="Center"
                             VerticalAlignment="{theme:StandardAlignmentVertical}" />
                </Border>

                <!-- Divider before the AM or PM column -->
                <Rectangle Name="PART_ThirdColumnDivider"
                           Grid.Column="5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch" />

                <Border x:Name="PART_FourthPickerHost"
                        Grid.Column="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                  <TextBlock x:Name="PART_PeriodTextBlock"
                             HorizontalAlignment="Center"
                             VerticalAlignment="{theme:StandardAlignmentVertical}" />
                </Border>
              </Grid>
            </Button>

            <!-- The picker shown when choosing a time. -->
            <Popup Name="PART_Popup" WindowManagerAddShadowHint="False"
                   ShouldUseOverlayLayer="True"
                   IsLightDismissEnabled="True" PlacementTarget="{TemplateBinding}"
                   Placement="Bottom">
              <!-- Forwards the box's hue into the detached pop-up so the picker resolves its own accent -->
              <Border theme:Accent.Kind="{Binding (theme:Accent.Kind), RelativeSource={RelativeSource TemplatedParent}}">
                <!-- The spinning hour, minute, second and period columns. -->
                <TimePickerPresenter Name="PART_PickerPresenter"
                                      controls:WheelSnap.Apply="True" />
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Dividers: a hairline with air on either side, so the segments never touch -->
    <Style Selector="^ /template/ Rectangle#PART_FirstColumnDivider,
                     ^ /template/ Rectangle#PART_SecondColumnDivider,
                     ^ /template/ Rectangle#PART_ThirdColumnDivider">
      <Setter Property="Fill" Value="{color:AccentDividerDefault}" />
      <Setter Property="Width" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingLg}, Right={size:SpacingLg}}" />
    </Style>

    <Style Selector="^:pointerover /template/ Button#PART_FlyoutButton,
                     ^[(theme|Preview.State)=Hover] /template/ Button#PART_FlyoutButton">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="Foreground" Value="{color:HoverTextDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Button#PART_FlyoutButton,
                     ^[(theme|Preview.State)=Pressed] /template/ Button#PART_FlyoutButton">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: the whole box fades to the disabled strength -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ Button#PART_FlyoutButton,
                     ^[(theme|Preview.State)=Focused] /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{color:AccentErrorBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <!-- Five spin rows plus the accept row; the star columns need a definite box to divide -->
    <Setter Property="Width" Value="{size:Scaled {size:ControlHeightMd}, 9}" />
    <Setter Property="MaxHeight" Value="{size:Scaled {size:ControlHeightMd}, 8}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Background" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Splits the picker from its divider and its dismiss-and-accept row -->
          <Grid Name="ContentRoot" RowDefinitions="*,Auto,Auto">
            <!-- Holds the hour, minute, second and period columns -->
            <Grid Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource DefaultDateTimePickerItem}" />
                </Style>
              </Grid.Styles>
              <!-- Column definitions set in code, ignore here -->
              <!-- The centre highlight: a very light rounded face with a hairline border, like a resting Button. -->
              <Border Name="HighlightRect" IsHitTestVisible="False"
                      Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Center" />
              <Panel Name="PART_HourHost" Grid.Column="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_HourSelector"
                                       PanelType="Hour"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <!-- Scrolls the hours up; pinned to the top edge so it never meets the centred value -->
                <RepeatButton Name="PART_HourUpButton" Theme="{StaticResource DefaultDateTimePickerUpButton}"
                              VerticalAlignment="Top" />
                <!-- Scrolls the hours down; pinned to the bottom edge so it never meets the centred value -->
                <RepeatButton Name="PART_HourDownButton" Theme="{StaticResource DefaultDateTimePickerDownButton}"
                              VerticalAlignment="Bottom" />
              </Panel>
              <Panel Name="PART_MinuteHost" Grid.Column="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_MinuteSelector"
                                       PanelType="Minute"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <!-- Scrolls the minutes up; pinned to the top edge so it never meets the centred value -->
                <RepeatButton Name="PART_MinuteUpButton" Theme="{StaticResource DefaultDateTimePickerUpButton}"
                              VerticalAlignment="Top" />
                <!-- Scrolls the minutes down; pinned to the bottom edge so it never meets the centred value -->
                <RepeatButton Name="PART_MinuteDownButton" Theme="{StaticResource DefaultDateTimePickerDownButton}"
                              VerticalAlignment="Bottom" />
              </Panel>
              <Panel Name="PART_SecondHost" Grid.Column="4">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_SecondSelector"
                                       PanelType="Second"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <!-- Scrolls the seconds up; pinned to the top edge so it never meets the centred value -->
                <RepeatButton Name="PART_SecondUpButton" Theme="{StaticResource DefaultDateTimePickerUpButton}"
                              VerticalAlignment="Top" />
                <!-- Scrolls the seconds down; pinned to the bottom edge so it never meets the centred value -->
                <RepeatButton Name="PART_SecondDownButton" Theme="{StaticResource DefaultDateTimePickerDownButton}"
                              VerticalAlignment="Bottom" />
              </Panel>
              <Panel Name="PART_PeriodHost" Grid.Column="6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                  <DateTimePickerPanel Name="PART_PeriodSelector"
                                       PanelType="TimePeriod"
                                       ShouldLoop="False" />
                </ScrollViewer>
                <!-- Scrolls the period up; pinned to the top edge so it never meets the centred value -->
                <RepeatButton Name="PART_PeriodUpButton" Theme="{StaticResource DefaultDateTimePickerUpButton}"
                              VerticalAlignment="Top" />
                <!-- Scrolls the period down; pinned to the bottom edge so it never meets the centred value -->
                <RepeatButton Name="PART_PeriodDownButton" Theme="{StaticResource DefaultDateTimePickerDownButton}"
                              VerticalAlignment="Bottom" />
              </Panel>
              <Rectangle Name="PART_FirstSpacer"
                         HorizontalAlignment="Center"
                         Grid.Column="1" />
              <!-- Divider between the second and third columns -->
              <Rectangle Name="PART_SecondSpacer"
                         HorizontalAlignment="Center"
                         Grid.Column="3" />
              <Rectangle Name="PART_ThirdSpacer"
                         HorizontalAlignment="Center"
                         Grid.Column="5" />
            </Grid>

            <!-- Line above the dismiss and accept buttons -->
            <Rectangle x:Name="PART_TopDivider"
                       Grid.Row="1" />
            <Grid Name="AcceptDismissGrid"
                  Grid.Row="2"
                  ColumnDefinitions="*,Auto,*"
                  Margin="{size:Edges Left={size:SpacingLg}, Right={size:SpacingLg}, Top={size:SpacingXl}, Bottom={size:SpacingLg}}">
              <!-- Closes the picker without choosing; a stock theme Button with the Warning accent, filling the left half -->
              <Button Name="PART_DismissButton"
                      theme:Accent.Kind="Warning"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <!-- The cross mark, a theme icon taking the button's text colour -->
                <PathIcon x:Name="PART_DismissGlyph"
                          Data="{icons:Close}"
                          Width="{size:IconSizeMd}"
                          Height="{size:IconSizeMd}" />
              </Button>
              <!-- Air between the two faces: two standard spacing tokens wide -->
              <Rectangle Grid.Column="1" Width="{size:SpacingLg}" />
              <!-- Confirms the chosen time; a stock theme Button with the Success accent, filling the right half -->
              <Button Name="PART_AcceptButton"
                      theme:Accent.Kind="Success"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                <!-- The tick mark, a theme icon taking the button's text colour -->
                <PathIcon x:Name="PART_AcceptGlyph"
                          Data="{icons:Checkmark}"
                          Width="{size:IconSizeMd}"
                          Height="{size:IconSizeMd}" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Card inset: the frame pads its content, the columns breathe inside it -->
    <Style Selector="^ /template/ Border#Background">
      <Setter Property="Padding" Value="{size:Edges {size:SpacingMd}}" />
    </Style>

    <!-- Spin columns: one row tall, so the band and the centred value agree -->
    <Style Selector="^ /template/ DateTimePickerPanel#PART_HourSelector,
                     ^ /template/ DateTimePickerPanel#PART_MinuteSelector,
                     ^ /template/ DateTimePickerPanel#PART_SecondSelector,
                     ^ /template/ DateTimePickerPanel#PART_PeriodSelector">
      <Setter Property="ItemHeight" Value="{size:ControlHeightMd}" />
    </Style>

    <!-- Column scrollers: five rows tall, so the looping lists meet a declared bound and the centred row sits mid-card. -->
    <Style Selector="^ /template/ Panel > ScrollViewer">
      <Setter Property="Height" Value="{size:Scaled {size:ControlHeightMd}, 5}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="{size:Edges}" />
    </Style>

    <!-- Centre highlight: a very light rounded face with a hairline border, like a resting Button. -->
    <Style Selector="^ /template/ Border#HighlightRect">
      <Setter Property="Background" Value="{color:SurfaceBorderless}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
      <Setter Property="Height" Value="{size:ControlHeightMd}" />
    </Style>

    <!-- Column dividers: a hairline that blends into the selection band, so the band reads as one unbroken stripe -->
    <Style Selector="^ /template/ Rectangle#PART_FirstSpacer,
                     ^ /template/ Rectangle#PART_SecondSpacer,
                     ^ /template/ Rectangle#PART_ThirdSpacer">
      <Setter Property="Fill" Value="{color:AccentDividerDefault}" />
      <Setter Property="Width" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Margin" Value="{size:Edges Left={size:SpacingLg}, Right={size:SpacingLg}}" />
    </Style>

    <!-- Hairline above the accept and dismiss row -->
    <Style Selector="^ /template/ Rectangle#PART_TopDivider">
      <Setter Property="Height" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Fill" Value="{color:AccentDividerDefault}" />
    </Style>

    <!-- Stepper reveal: hovering a column fades its up and down chevrons in (and makes them usable). -->
    <Style Selector="^ /template/ Panel">
      <Style Selector="^:pointerover RepeatButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
