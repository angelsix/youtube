<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated">
  <!-- No design preview: an adorner layer draws only over elements it adorns; standalone it renders nothing -->

  <theme:PreviewExcluded x:Key="AdornerLayerPreviewExcluded"
                         Reason="An adorner layer draws only over the elements it adorns." />

  <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <!-- The focus ring, just outside the control and following its corners -->
        <!-- Outset by its own width plus the halo's; the radius reads the focused control (AdornedElement) -->
        <Border Margin="{size:Edges All={size:Scaled {size:Thickness}, -3}}"
                BorderThickness="{size:ThicknessMd}"
                BorderBrush="{color:AccentFocusBrush}"
                CornerRadius="{size:ConcentricCorners Radius={ReflectionBinding Path=(AdornerLayer.AdornedElement).CornerRadius, RelativeSource={RelativeSource Self}}, Thickness={ReflectionBinding Path=(AdornerLayer.AdornedElement).BorderThickness, RelativeSource={RelativeSource Self}}, Inset={ReflectionBinding Path=Margin, RelativeSource={RelativeSource Self}}, Stroke={ReflectionBinding Path=BorderThickness, RelativeSource={RelativeSource Self}}, All=True}">
          <!-- Light halo between the ring and the control -->
          <Border BorderThickness="{size:ThicknessSm}"
                  BorderBrush="{color:BackgroundDefault}"
                  CornerRadius="{size:ConcentricCorners Radius={Binding $parent[Border].CornerRadius}, Thickness={Binding $parent[Border].BorderThickness}, Stroke={ReflectionBinding Path=BorderThickness, RelativeSource={RelativeSource Self}}, All=True}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
