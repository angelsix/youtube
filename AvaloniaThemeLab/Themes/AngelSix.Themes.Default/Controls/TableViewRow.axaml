<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- Shown inside the TableView entry, as a table is the only place one is met -->
  <theme:PreviewShownIn x:Key="TableViewRowPreviewShownIn"
                        ShownIn="{x:Type TableView}"
                        Reason="Rows are met inside a table; the TableView entry shows every row state." />

  <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">

    <!-- Visual defaults: the list row's look (ListBoxItem, ComboBoxItem), with a resting transparent hairline border that focus colours in place -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <!-- Parallel to the table's curved frame: the frame's radius pulled in by its 1px border + 4px padding -->
    <Setter Property="CornerRadius" Value="{size:ConcentricCorners Radius={size:RadiusSm}, Thickness={size:ThicknessSm}, Inset={size:Edges All={size:Scaled {size:SpacingMd}, 1.25}}, All=True}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <!-- The cells carry the content padding, so the row adds none and its columns line up with the headers -->
    <Setter Property="Padding" Value="{size:Edges}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
    <!-- Focus is the row's own inset border (below). -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />

    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the row over its bottom hairline -->
        <DockPanel>
          <!-- Hairline ruling this row off from the next -->
          <Border Name="PART_Divider" DockPanel.Dock="Bottom" />
          <!-- The row face that shows hover, selection and focus -->
          <Border Name="PART_RowFace"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- One cell per column, laid out to the header widths -->
            <TableViewCellsPresenter Name="PART_CellsPresenter"
                                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_Divider">
      <Setter Property="Height" Value="{size:ThicknessSmDouble}" />
      <Setter Property="Background" Value="{color:AccentDividerDefault}" />
    </Style>

    <!-- Last row: the table's frame already closes it -->
    <Style Selector="^:nth-last-child(1) /template/ Border#PART_Divider">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_RowFace,
                     ^[(theme|Preview.State)=Hover] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_RowFace,
                     ^[(theme|Preview.State)=Pressed] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
    </Style>

    <!-- Disabled state: the whole row fades, selected or not, so a chosen-but-unavailable row still reads as chosen -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Selected state: the outlined column, not the filled one, exactly as ListBoxItem and ComboBoxItem -->
    <Style Selector="^:selected /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundDefault}" />
    </Style>

    <Style Selector="^:selected:pointerover /template/ Border#PART_RowFace,
                     ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundHover}" />
    </Style>

    <Style Selector="^:selected:pressed /template/ Border#PART_RowFace,
                     ^:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_RowFace">
      <Setter Property="Background" Value="{color:SelectedBackgroundPressed}" />
    </Style>

    <!-- Focus state. -->
    <Style Selector="^:focus-visible, ^:selected:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBorder}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
