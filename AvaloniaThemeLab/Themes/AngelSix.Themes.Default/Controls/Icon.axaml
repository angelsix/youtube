<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:default="using:AngelSix.Themes.Default">
  <Style Selector="default|Icon">
    <Setter Property="Size" Value="{size:IconSizeMd}" />
  </Style>
</Styles>
