<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:default="using:AngelSix.Themes.Default">
  <!-- Design preview: default, a markup-pinned selection and a Warning-hued pinned selection. -->
  <DataTemplate x:Key="SelectableTextBlockPreview">
    <StackPanel Spacing="{size:SpacingXl}" HorizontalAlignment="Left">
      <SelectableTextBlock Width="{size:Scaled 240}">Select me — this line is selectable.</SelectableTextBlock>
      <SelectableTextBlock Width="{size:Scaled 240}" SelectionStart="0" SelectionEnd="10">Select me — this line is selectable.</SelectableTextBlock>
      <SelectableTextBlock Width="{size:Scaled 240}" theme:Accent.Kind="Warning"
                           SelectionStart="0" SelectionEnd="10">Select me — this line is selectable.</SelectableTextBlock>
    </StackPanel>
  </DataTemplate>

  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <default:DefaultTheme />
      </Border.Styles>

      <controls:LightDarkPreview Title="SelectableTextBlock" ContentTemplate="{StaticResource SelectableTextBlockPreview}" />

    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">

    <!-- Visual defaults: bare text like TextBlock — no fill, no padding; ink from the theme -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="HorizontalAlignment" Value="{theme:StandardAlignmentHorizontal}" />
    <Setter Property="VerticalAlignment" Value="{theme:StandardAlignmentVertical}" />
    <!-- Selection: the solid-fill column (the filled face and its on-fill ink), so it follows Accent.Kind and reads on every hue -->
    <Setter Property="SelectionBrush" Value="{color:SolidFillDefault}" />
    <Setter Property="SelectionForegroundBrush" Value="{color:OnSolidFillInkDefault}" />

    <Style Selector="^[IsEnabled=True]">
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="ContextFlyout" Value="{StaticResource SelectableTextBlockContextFlyout}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <MenuFlyout x:Key="SelectableTextBlockContextFlyout" Placement="Bottom">
    <MenuItem Header="Copy" Command="{Binding $parent[SelectableTextBlock].Copy}"
              IsEnabled="{Binding $parent[SelectableTextBlock].CanCopy}" InputGesture="{x:Static TextBox.CopyGesture}" />
  </MenuFlyout>
</ResourceDictionary>
