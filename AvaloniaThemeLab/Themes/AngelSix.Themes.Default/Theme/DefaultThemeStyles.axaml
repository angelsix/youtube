<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <!-- App-wide rules a ControlTheme cannot hold: they select a control by what it sits inside, or match subclasses. -->

  <!-- An app's pages are UserControl subclasses, and a ControlTheme is found by exact type, so no control theme reaches them. -->
  <Style Selector=":is(UserControl)">
    <Setter Property="ClipToBounds" Value="{theme:ControlClipToBounds}" />
  </Style>

  <!-- Squares the hosted page's tab-side corners. -->

  <!-- The strip docks on top: the page's top pair squares and meets the strip. -->
  <Style Selector="TabbedPage[TabPlacement=Top] ContentPage">
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
  </Style>

  <!-- The strip docks on the bottom: the page's bottom pair squares. -->
  <Style Selector="TabbedPage[TabPlacement=Bottom] ContentPage">
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
  </Style>

  <!-- The strip docks on the left: the page's left pair squares. -->
  <Style Selector="TabbedPage[TabPlacement=Left] ContentPage">
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Right=True}" />
  </Style>

  <!-- The strip docks on the right: the page's right pair squares. -->
  <Style Selector="TabbedPage[TabPlacement=Right] ContentPage">
    <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Left=True}" />
  </Style>

  <!-- A modal page stands alone over the NavigationPage's scrim with no bar above it, so all four corners round. -->
  <Style Selector="ContentPresenter#PART_ModalPresenter > ContentPage[IsInNavigationPage=True], ContentPresenter#PART_ModalBackPresenter > ContentPage[IsInNavigationPage=True]">
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
  </Style>
</Styles>
