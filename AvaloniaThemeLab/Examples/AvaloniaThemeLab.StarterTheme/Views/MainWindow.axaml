<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:vm="using:AvaloniaThemeLab.StarterTheme.ViewModels"
        xmlns:views="using:AvaloniaThemeLab.StarterTheme.Views"
        x:Class="AvaloniaThemeLab.StarterTheme.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Design.DataContext="{DesignContext}"
        Width="{size:Scaled 640}"
        Height="{size:Scaled 360}"
        Title="Avalonia Theme Lab — Starter Theme">
  <!-- Main window content view -->
  <views:ExampleContent DataContext="{Binding Content}" />
</Window>
