<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaThemeLab.Icons.App"
             xmlns:local="using:AvaloniaThemeLab.Icons.Theme"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <!-- The app's own theme: DefaultTheme plus a custom icon gallery (Theme/IconsTheme.cs). -->
        <local:IconsTheme />
    </Application.Styles>
</Application>
