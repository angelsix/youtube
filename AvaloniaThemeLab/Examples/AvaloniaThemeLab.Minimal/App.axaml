<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaThemeLab.Minimal.App"
             xmlns:local="using:AvaloniaThemeLab.Minimal"
             xmlns:theme="using:AvaloniaThemeLab.Minimal.Theme"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <theme:MinimalTheme />
    </Application.Styles>
</Application>
