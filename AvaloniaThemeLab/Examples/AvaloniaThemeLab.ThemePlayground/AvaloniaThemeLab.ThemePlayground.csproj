<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9"/>
        <!-- A lower version here would be a package downgrade and NuGet fails the restore outright (NU1605). -->
        <PackageReference Include="AngelSix.ThemeEngine" Version="2.0.0"/>
        <!-- The calendar control's types live here (styling stays in the theme, which styles them exactly like a stock Avalonia control). -->
        <PackageReference Include="AngelSix.ThemeEngine.Controls" Version="2.0.0"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Runtime XAML parsing for the dev-only preview hot-reload watcher; Debug only, so Release never pulls it in -->
    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Themes\AngelSix.Themes.Default\AngelSix.Themes.Default.csproj" />
    </ItemGroup>
</Project>
