<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:vm="using:AvaloniaThemeLab.ThemePlayground.ViewModels"
        mc:Ignorable="d"
        x:Class="AvaloniaThemeLab.ThemePlayground.Views.ThemeSettingsWindow"
        x:DataType="vm:ThemeSettingsViewModel"
        Design.DataContext="{DesignContext}"
        Title="Theme settings"
        Classes="dialog"
        Width="560" Height="760">
  <Grid RowDefinitions="*,Auto" RowSpacing="{size:SpacingXxl}" Margin="{size:Edges {size:SpacingXxl}}">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="{size:SpacingXxl}">

        <!-- Scale: BaseSize moves every ladder; each ladder's own factor rides on it -->
        <GroupBox Header="Scale" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Base size" Target="BaseSizeBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0.5" Maximum="2" Value="{Binding Theme.BaseSize}" />
                <NumericUpDown Grid.Column="1" x:Name="BaseSizeBox" Width="{size:Scaled 192}" Minimum="0.5" Maximum="2" Increment="0.05" FormatString="0.00" Value="{Binding Theme.BaseSize}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Spacing" Target="SpacingScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="3" Value="{Binding Theme.SpacingScale}" />
                <NumericUpDown Grid.Column="1" x:Name="SpacingScaleBox" Width="{size:Scaled 192}" Minimum="0" Maximum="3" Increment="0.05" FormatString="0.00" Value="{Binding Theme.SpacingScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Font size" Target="FontSizeScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0.5" Maximum="2" Value="{Binding Theme.FontSizeScale}" />
                <NumericUpDown Grid.Column="1" x:Name="FontSizeScaleBox" Width="{size:Scaled 192}" Minimum="0.5" Maximum="2" Increment="0.05" FormatString="0.00" Value="{Binding Theme.FontSizeScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Control height" Target="ControlHeightScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="2" Value="{Binding Theme.ControlHeightScale}" />
                <NumericUpDown Grid.Column="1" x:Name="ControlHeightScaleBox" Width="{size:Scaled 192}" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.00" Value="{Binding Theme.ControlHeightScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Corner radius" Target="RadiusScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="4" Value="{Binding Theme.RadiusScale}" />
                <NumericUpDown Grid.Column="1" x:Name="RadiusScaleBox" Width="{size:Scaled 192}" Minimum="0" Maximum="4" Increment="0.05" FormatString="0.00" Value="{Binding Theme.RadiusScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Border thickness" Target="ThicknessScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="4" Value="{Binding Theme.ThicknessScale}" />
                <NumericUpDown Grid.Column="1" x:Name="ThicknessScaleBox" Width="{size:Scaled 192}" Minimum="0" Maximum="4" Increment="0.05" FormatString="0.00" Value="{Binding Theme.ThicknessScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Icon size" Target="IconSizeScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0.5" Maximum="3" Value="{Binding Theme.IconSizeScale}" />
                <NumericUpDown Grid.Column="1" x:Name="IconSizeScaleBox" Width="{size:Scaled 192}" Minimum="0.5" Maximum="3" Increment="0.05" FormatString="0.00" Value="{Binding Theme.IconSizeScale}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <!-- Colours: each hue's seed, from which its whole ramp is derived -->
        <GroupBox Header="Colours" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Neutral" Target="AccentNeutralPicker" />
              <ColorPicker x:Name="AccentNeutralPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentNeutral}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Primary" Target="AccentPrimaryPicker" />
              <ColorPicker x:Name="AccentPrimaryPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentPrimary}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Success" Target="AccentSuccessPicker" />
              <ColorPicker x:Name="AccentSuccessPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentSuccess}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Warning" Target="AccentWarningPicker" />
              <ColorPicker x:Name="AccentWarningPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentWarning}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Favourite" Target="AccentFavouritePicker" />
              <ColorPicker x:Name="AccentFavouritePicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentFavourite}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Error" Target="AccentErrorPicker" />
              <ColorPicker x:Name="AccentErrorPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentError}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Info" Target="AccentInfoPicker" />
              <ColorPicker x:Name="AccentInfoPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentInfo}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Destructive" Target="AccentDestructivePicker" />
              <ColorPicker x:Name="AccentDestructivePicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentDestructive}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Subtle" Target="AccentSubtlePicker" />
              <ColorPicker x:Name="AccentSubtlePicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentSubtle}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Surface (canvas)" Target="AccentSurfacePicker" />
              <ColorPicker x:Name="AccentSurfacePicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentSurface}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Focus ring" Target="AccentFocusPicker" />
              <ColorPicker x:Name="AccentFocusPicker" HorizontalAlignment="Stretch" IsAlphaEnabled="False" Color="{Binding Theme.AccentFocus}" />
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Font" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Family" Target="FontPicker" />
              <ComboBox x:Name="FontPicker" HorizontalAlignment="Stretch" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Theme.FontFamily}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="FontFamily">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Alignment" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Standard, horizontal" Target="StandardHorizontalPicker" />
              <ComboBox x:Name="StandardHorizontalPicker" HorizontalAlignment="Stretch" ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding Theme.StandardAlignmentHorizontal}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Standard, vertical" Target="StandardVerticalPicker" />
              <ComboBox x:Name="StandardVerticalPicker" HorizontalAlignment="Stretch" ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding Theme.StandardAlignmentVertical}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Button content, horizontal" Target="ButtonHorizontalPicker" />
              <ComboBox x:Name="ButtonHorizontalPicker" HorizontalAlignment="Stretch" ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding Theme.ButtonAlignmentHorizontal}" />
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Button content, vertical" Target="ButtonVerticalPicker" />
              <ComboBox x:Name="ButtonVerticalPicker" HorizontalAlignment="Stretch" ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding Theme.ButtonAlignmentVertical}" />
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="States" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Disabled opacity" Target="DisabledOpacityBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="1" Value="{Binding Theme.DisabledOpacity}" />
                <NumericUpDown Grid.Column="1" x:Name="DisabledOpacityBox" Width="{size:Scaled 192}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" Value="{Binding Theme.DisabledOpacity}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Hover scale" Target="HoverScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="1" Maximum="1.2" Value="{Binding Theme.HoverScale}" />
                <NumericUpDown Grid.Column="1" x:Name="HoverScaleBox" Width="{size:Scaled 192}" Minimum="1" Maximum="1.2" Increment="0.005" FormatString="0.000" Value="{Binding Theme.HoverScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Pressed scale" Target="PressedScaleBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0.8" Maximum="1" Value="{Binding Theme.PressedScale}" />
                <NumericUpDown Grid.Column="1" x:Name="PressedScaleBox" Width="{size:Scaled 192}" Minimum="0.8" Maximum="1" Increment="0.005" FormatString="0.000" Value="{Binding Theme.PressedScale}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="{size:SpacingMd}">
              <Label Content="Animation (ms)" Target="AnimationBox" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{size:SpacingXl}">
                <Slider HorizontalAlignment="Stretch" Minimum="0" Maximum="1000" IsSnapToTickEnabled="True" TickFrequency="10" Value="{Binding Theme.Animation}" />
                <NumericUpDown Grid.Column="1" x:Name="AnimationBox" Width="{size:Scaled 192}" Minimum="0" Maximum="1000" Increment="10" FormatString="0" Value="{Binding Theme.Animation}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Rendering" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="{size:SpacingXl}">
            <ToggleSwitch Content="Dark palette" IsChecked="{Binding Theme.IsDark}" />
            <ToggleSwitch Content="Draw like the web (no clipping)" IsChecked="{Binding Theme.WebRenderStyle}" />
            <ToggleSwitch Content="Focus colour on accented controls" IsChecked="{Binding Theme.FocusColorOnAccents}" />
          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="Reset to theme defaults" Command="{Binding ResetCommand}" />
  </Grid>
</Window>
