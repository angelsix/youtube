<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:AvaloniaThemeLab.ThemePlayground.ValueConverters"
             xmlns:local="using:AvaloniaThemeLab.ThemePlayground"
             x:Class="AvaloniaThemeLab.ThemePlayground.App"
             RequestedThemeVariant="Default">
    <!-- Default variant follows the system; Dark/Light are alternatives -->

    <Application.Resources>
        <converters:PreviewTemplateConverter x:Key="PreviewTemplateConverter" />
    </Application.Resources>

    <Application.Styles>
        <local:BrandTheme />
    </Application.Styles>
</Application>
