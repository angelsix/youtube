	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Applicability/=Live/@EntryIndexedValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Description/@EntryValue">A theme: neutral, primary and surface hues, and the size ladders</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Reformat/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Shortcut/@EntryValue">themeclass</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Text/@EntryValue">[Theme(FallbackHue = "Neutral")]
public partial class $Name$Theme : ThemeBase
{
    [AccentHue, ColorRamp(HueAware = true, DarkSeed = "#D1D1D1")]
    [Observable] public virtual partial Color AccentNeutral { get; set; } = Color.Parse("#2E2E2E");

    [AccentHue, ColorRamp(HueAware = true)]
    [Observable] public virtual partial Color AccentPrimary { get; set; } = Color.Parse("$Primary$");

    /// &lt;summary&gt;The application canvas.&lt;/summary&gt;
    [AccentHue, ColorRamp(DarkSeed = "#1E1E1E")]
    [Observable] public virtual partial Color AccentSurface { get; set; } = Color.Parse("#FAFAFA");

    [SizeScale(Multipliers = [4, 8, 12, 16])]
    public virtual double Spacing =&gt; BaseSize;

    [SizeScale(Multipliers = [4, 8], Types = [typeof(CornerRadius)], TypeSuffixes = [""])]
    public virtual double Radius =&gt; BaseSize;

    [SizeScale(Multipliers = [1, 2], Types = [typeof(Thickness)], TypeSuffixes = [""], Floor = 1)]
    public virtual double Thickness =&gt; BaseSize;

    [SizeScale(Multipliers = [12, 14, 20])]
    public virtual double FontSize =&gt; BaseSize;
$END$
}</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Field/=Name/@KeyIndexDefined">True</s:Boolean>
