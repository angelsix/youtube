	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7EE29B65B1577C740F4F0C5B20/Scope/=4FB2DAF0E2BB91D8F5F39D3AB33DA78C/Type/@EntryValue">InXmlFile</s:String>
