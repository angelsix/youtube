	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E995987E2E9423C5FC19EB103/Description/@EntryValue">A control's preview: its {Name}Preview template and the designer preview that shows it (needs AngelSix.ThemeEngine.Controls)</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E995987E2E9423C5FC19EB103/Reformat/@EntryValue">False</s:Boolean>
