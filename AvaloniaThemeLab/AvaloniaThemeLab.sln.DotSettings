	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E88E5D96C682E050225F13922/Scope/=7C99B44DCF4E37D69A23EB5B0F124DFA/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E88E5D96C682E050225F13922/Scope/=7C99B44DCF4E37D69A23EB5B0F124DFA/Type/@EntryValue">InXmlFile</s:String>
