	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7EB9FD9E30C2DEE38C385DF36F/Description/@EntryValue">A control's preview: its {Name}Preview template and the designer preview that shows it (needs AngelSix.ThemeEngine.Controls)</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7EB9FD9E30C2DEE38C385DF36F/Reformat/@EntryValue">False</s:Boolean>
