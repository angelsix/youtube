	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/Description/@EntryValue">An accent hue seed: one colour that becomes a full light and dark ramp, selectable with theme:Accent.Kind</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/Reformat/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/Shortcut/@EntryValue">themeaccent</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/Text/@EntryValue">[AccentHue, ColorRamp(HueAware = true)]
[Observable] public virtual partial Color Accent$Name$ { get; set; } = Color.Parse("$Color$");$END$</s:String>
