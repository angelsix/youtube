	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E995987E2E9423C5FC19EB103/Text/@EntryValue">&lt;DataTemplate x:Key="$Control$Preview"&gt;
  &lt;StackPanel Spacing="{size:SpacingMd}"&gt;
    &lt;$Control$ /&gt;$END$
    &lt;$Control$ theme:Preview.State="Hover" /&gt;
    &lt;$Control$ theme:Preview.State="Pressed" /&gt;
    &lt;$Control$ IsEnabled="False" /&gt;
  &lt;/StackPanel&gt;
&lt;/DataTemplate&gt;

&lt;Design.PreviewWith&gt;
  &lt;Border&gt;
    &lt;Border.Styles&gt;
      &lt;$Theme$ /&gt;
    &lt;/Border.Styles&gt;
    &lt;controls:LightDarkPreview Title="$Control$" ContentTemplate="{StaticResource $Control$Preview}" /&gt;
  &lt;/Border&gt;
&lt;/Design.PreviewWith&gt;</s:String>
