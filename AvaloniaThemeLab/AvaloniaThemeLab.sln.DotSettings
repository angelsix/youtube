	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E379B5D5E7953A7425E072C2C/Description/@EntryValue">A control's preview: the {Control}Preview template and the Design.PreviewWith that shows it (needs AngelSix.ThemeEngine.Controls)</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E379B5D5E7953A7425E072C2C/Reformat/@EntryValue">False</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E379B5D5E7953A7425E072C2C/Shortcut/@EntryValue">enginecontrolpreview</s:String>
