	<s:Int64 x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E6D5CC58EED36A5CF862011E6/Field/=Stage/Order/@EntryValue">2</s:Int64>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E6D5CC58EED36A5CF862011E6/Scope/=957999A63E3E28003ADF49B02906A83A/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E6D5CC58EED36A5CF862011E6/Scope/=957999A63E3E28003ADF49B02906A83A/Type/@EntryValue">InXmlFile</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/@KeyIndexDefined">True</s:Boolean>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Applicability/=Live/@EntryIndexedValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Description/@EntryValue">A theme class: one Defaults region (plain reuses, then stage defaults), then Seeds, Sizes and Typography</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Reformat/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Shortcut/@EntryValue">themeclass</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E35D666BD7AE45E05575B4A05/Text/@EntryValue">[Theme(FallbackHue = "Neutral")]
public partial class $Name$Theme : ThemeBase
{
    #region Defaults

    // Surfaces
    public virtual Color SurfaceDefault =&gt; SurfaceSeed;
    [StageDefault] protected internal virtual Stage BackgroundDefault =&gt; Stage.Light10;
    [StageDefault] protected internal virtual Stage CardDefault =&gt; Stage.Light10;

    // Text
    [StageDefault(PinHue = "Neutral")] protected internal virtual Stage TextDefault =&gt; Stage.Dark9;
    [StageDefault(PinHue = "Neutral")] protected internal virtual Stage DimTextDefault =&gt; Stage.Dark5;

    // Lines
    [StageDefault] protected internal virtual Stage BorderDefault =&gt; Stage.Light2;

    // Solid fills
    [StageDefault] protected internal virtual Stage SolidFillDefault =&gt; Stage.Dark3;
    [StageDefault(ContrastStage = nameof(SolidFillDefault), AlternateStage = nameof(TextDefault))]
    protected internal virtual Stage OnSolidFillInkDefault =&gt; Stage.Light10;

    #endregion Defaults

    #region Seeds

    [AccentHue, ColorRamp(HueAware = true, DarkSeed = "#D1D1D1")]
    [Observable] public virtual partial Color AccentNeutral { get; set; } = Color.Parse("#2E2E2E");

    [AccentHue, ColorRamp(HueAware = true)]
    [Observable] public virtual partial Color AccentPrimary { get; set; } = Color.Parse("$Primary$");

    /// &lt;summary&gt;The application canvas.&lt;/summary&gt;
    [AccentHue, ColorRamp(DarkSeed = "#1E1E1E")]
    [Observable] public virtual partial Color AccentSurface { get; set; } = Color.Parse("#FAFAFA");

    #endregion Seeds

    #region Sizes

    [SizeScale(Multipliers = [4, 8, 12, 16])]
    public virtual double Spacing =&gt; BaseSize;

    [SizeScale(Multipliers = [4, 8], Types = [typeof(CornerRadius)], TypeSuffixes = [""])]
    public virtual double Radius =&gt; BaseSize;

    [SizeScale(Multipliers = [1, 2], Types = [typeof(Thickness)], TypeSuffixes = [""], Floor = 1)]
    public virtual double Thickness =&gt; BaseSize;

    #endregion Sizes

    #region Typography

    [SizeScale(Multipliers = [12, 14, 20])]
    public virtual double FontSize =&gt; BaseSize;

    #endregion Typography
$END$
}</s:String>
