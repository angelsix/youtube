	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Applicability/=Live/@EntryIndexedValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Description/@EntryValue">The theme engine xmlns declarations (theme, color, size, controls, icons) for a root element</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Reformat/@EntryValue">False</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Shortcut/@EntryValue">enginenamespaces</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Text/@EntryValue">xmlns:theme="using:AngelSix.ThemeEngine.Generated"
xmlns:color="using:AngelSix.ThemeEngine.Colors"
xmlns:size="using:AngelSix.ThemeEngine.Sizes"
xmlns:controls="using:AngelSix.ThemeEngine.Controls"
xmlns:icons="using:AngelSix.ThemeEngine.Icons"$END$</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Scope/=4ADA8706A97BB34699BF4D4BAC4AE392/@KeyIndexDefined">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E15CA5CDB001FC4C1873B2AAD/Scope/=4ADA8706A97BB34699BF4D4BAC4AE392/Type/@EntryValue">InXmlFile</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/@KeyIndexDefined">True</s:Boolean>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/Applicability/=Live/@EntryIndexedValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/Description/@EntryValue">A control theme file: the control's preview template, the designer preview and the ControlTheme (the preview needs AngelSix.ThemeEngine.Controls)</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/Reformat/@EntryValue">False</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/Shortcut/@EntryValue">enginecontrol</s:String>
	<s:Boolean x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/ShortenQualifiedReferences/@EntryValue">True</s:Boolean>
	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E55593EE31AC350A3C2BC2EEE/Text/@EntryValue">&lt;ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:controls="using:AngelSix.ThemeEngine.Controls"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    xmlns:local="using:$ThemeNamespace$"&gt;
  &lt;DataTemplate x:Key="$Control$Preview"&gt;
    &lt;StackPanel Spacing="{size:SpacingMd}"&gt;
      &lt;$Control$ /&gt;
      &lt;$Control$ theme:Preview.State="Hover" /&gt;
      &lt;$Control$ theme:Preview.State="Pressed" /&gt;
      &lt;$Control$ IsEnabled="False" /&gt;
    &lt;/StackPanel&gt;
  &lt;/DataTemplate&gt;

  &lt;Design.PreviewWith&gt;
    &lt;Border&gt;
      &lt;Border.Styles&gt;
        &lt;local:$Theme$ /&gt;
      &lt;/Border.Styles&gt;
      &lt;controls:LightDarkPreview Title="$Control$" ContentTemplate="{StaticResource $Control$Preview}" /&gt;
    &lt;/Border&gt;
  &lt;/Design.PreviewWith&gt;

  &lt;ControlTheme x:Key="{x:Type $Control$}" TargetType="$Control$"&gt;
    &lt;Setter Property="Background" Value="{color:AccentBrush Light10}" /&gt;
    &lt;Setter Property="Foreground" Value="{color:AccentBrush Dark9}" /&gt;
    &lt;Setter Property="BorderBrush" Value="{color:AccentBrush Light1}" /&gt;
    &lt;Setter Property="Template"&gt;
      &lt;ControlTemplate&gt;
        &lt;Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"&gt;
          $END$
        &lt;/Border&gt;
      &lt;/ControlTemplate&gt;
    &lt;/Setter&gt;

    &lt;Style Selector="^:pointerover /template/ Border#PART_Border"&gt;
      &lt;Setter Property="Background" Value="{color:AccentBrush Light8}" /&gt;
    &lt;/Style&gt;
  &lt;/ControlTheme&gt;
&lt;/ResourceDictionary&gt;</s:String>
