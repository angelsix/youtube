	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=A6510E7E1D3386BD286505819FD69CFC/Scope/=F7FCD685533B2D63614A9921ABE57593/CustomProperties/=minimumLanguageVersion/@EntryIndexedValue">2.0</s:String>
