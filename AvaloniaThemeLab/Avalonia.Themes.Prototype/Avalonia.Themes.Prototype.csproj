<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Avalonia.Themes.Prototype</RootNamespace>

        <!-- The declarations live under Theme/, so the engine's generator has to be told where.
             Left at its default it looks in the project root, finds nothing, and silently stops
             generating — the classes would go stale without any error. -->
        <StyleClassDeclarationsFile>$(MSBuildProjectDirectory)/Theme/StyleClasses.axaml</StyleClassDeclarationsFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.1"/>

        <!-- 1.12.0 or later is required, not merely preferred: the theme is built on attributes
             this version introduced — [Brush], [GradientBrush], [FontWeights], ColourRamp's
             OverlayLabels, and SizeScale's TypeSuffixes and TimeSpan support. On an older package
             the generator emits none of those members and the build fails with a few hundred
             "does not exist in the current context" errors rather than anything that names the
             real cause. -->
        <PackageReference Include="AngelSix.ThemeEngine" Version="1.12.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Icons/Svg/*.svg are the icon set — the engine reads them into ThemeIconGallery, so the
             geometry reaches the assembly as generated C# and the files themselves are build inputs
             rather than content. The package already hands them to the generator as AdditionalFiles;
             this is only so the folder shows up in the IDE beside the class it fills in. -->
        <None Include="Icons/Svg/Categories.md" />
    </ItemGroup>

</Project>
