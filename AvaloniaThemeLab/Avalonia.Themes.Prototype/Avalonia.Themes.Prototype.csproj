<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Avalonia.Themes.Prototype</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.1"/>
        <!-- AngelSix.ThemeEngine bundles both the runtime library and the SourceGen analyzer
             (analyzers/dotnet/cs) — a single reference gets both wired automatically. -->
        <PackageReference Include="AngelSix.ThemeEngine" Version="1.2.2" />
    </ItemGroup>

</Project>
