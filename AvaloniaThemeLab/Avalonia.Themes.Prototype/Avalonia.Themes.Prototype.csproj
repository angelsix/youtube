<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Avalonia.Themes.Prototype</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Transitional cross-repo project refs until AngelSix.ThemeEngine is published on nuget.org.
             After publish, both lines collapse to a single <PackageReference Include="AngelSix.ThemeEngine" Version="1.0.0" />
             since that package bundles the SourceGen analyzer under analyzers/dotnet/cs. -->
        <ProjectReference Include="..\..\..\angelsix-consulting\Avalonia Themes\AngelSix.ThemeEngine\AngelSix.ThemeEngine.csproj"/>
        <ProjectReference Include="..\..\..\angelsix-consulting\Avalonia Themes\AngelSix.ThemeEngine.SourceGen\AngelSix.ThemeEngine.SourceGen.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
