<Styles x:Class="Avalonia.Themes.Prototype.PrototypeTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prototype="using:Avalonia.Themes.Prototype"
        xmlns:accents="using:Avalonia.Themes.Prototype.Accents">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Keep custom palettes higher priority than default BaseColorsPalette and SystemAccentColors
             As that's an only place for user to redefine palette in a good way -->
        <ResourceInclude Source="/Accents/BaseColorsPalette.axaml" />
        <accents:SystemAccentColors />
        <prototype:ColorPaletteResourcesCollection />

        <!-- Resources and brushes will be merged into current dictionary for slightly better performance and possible optimizations -->
        <MergeResourceInclude Source="/Accents/BaseResources.axaml" />
        <MergeResourceInclude Source="/Accents/PrototypeControlResources.axaml" />
        <MergeResourceInclude Source="/Strings/InvariantResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      
      <!-- These are not part of MergedDictionaries so we can add or remove them easier -->
      <ResourceInclude x:Key="CompactStyles" Source="/DensityStyles/Compact.axaml" />
    </ResourceDictionary>
  </Styles.Resources>
  
  <StyleInclude Source="/Controls/PrototypeControls.axaml" />
</Styles>
