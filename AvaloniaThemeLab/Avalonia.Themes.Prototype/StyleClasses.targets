<Project>

  <!--
    Regenerates the style-class declarations in StyleClasses.axaml from the ControlThemes.

    The declarations exist so an IDE can resolve Classes="accent" — see StyleClasses.axaml for why
    they are needed. They mirror the ControlThemes exactly, which makes them the kind of hand-kept
    pairing that drifts silently: the symptom shows up as an underline in somebody else's project,
    long after the edit that caused it.

    Written as an inline task rather than a script or a tool so the theme project stays
    self-contained — no dotnet tool to install, no interpreter assumed, and it runs the same way on
    a build server as it does here.

    It rewrites a source-controlled file during build, which is normally worth avoiding. Two things
    keep it honest: the write only happens when the content actually differs, so a build in sync
    touches nothing and there is no IDE churn or git noise; and only the region between the
    generated markers is replaced, so the explanatory prose above it stays hand-written.
  -->

  <UsingTask TaskName="GenerateStyleClassDeclarations"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectDir ParameterType="System.String" Required="true" />
      <DeclarationsFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        const string BeginMarker = "<!-- BEGIN GENERATED";
        const string EndMarker = "<!-- END GENERATED -->";

        if (!File.Exists(DeclarationsFile))
        {
            Log.LogWarning("StyleClasses: " + DeclarationsFile + " not found; nothing to regenerate.");
            return true;
        }

        XNamespace av = "https://github.com/avaloniaui";

        // class name -> the control types whose ControlTheme defines it.
        var found = new SortedDictionary<string, SortedSet<string>>(StringComparer.Ordinal);

        var sources = Directory.GetFiles(ProjectDir, "*.axaml", SearchOption.AllDirectories)
            .Where(f => !f.Equals(DeclarationsFile, StringComparison.OrdinalIgnoreCase))
            .Where(f => f.IndexOf(Path.DirectorySeparatorChar + "obj" + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) < 0)
            .Where(f => f.IndexOf(Path.DirectorySeparatorChar + "bin" + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) < 0)
            .OrderBy(f => f, StringComparer.Ordinal);

        foreach (var file in sources)
        {
            XDocument doc;
            try { doc = XDocument.Load(file); }
            catch { continue; } // a file that does not parse is the XAML compiler's problem to report, not ours

            foreach (var style in doc.Descendants(av + "Style"))
            {
                var selectorAttr = style.Attribute("Selector");
                if (selectorAttr == null) continue;

                // The nearest enclosing ControlTheme that states a TargetType is what "^" means here.
                var target = style.Ancestors(av + "ControlTheme")
                    .Select(c => (string)c.Attribute("TargetType"))
                    .FirstOrDefault(t => !string.IsNullOrEmpty(t));
                if (string.IsNullOrEmpty(target)) continue;

                foreach (var one in selectorAttr.Value.Split(','))
                {
                    // Only the part before a /template/ hop, and only up to the first space: past
                    // either of those the selector names a descendant or a template part, and a
                    // consumer never writes those classes.
                    var head = one.Split(new[] { "/template/" }, StringSplitOptions.None)[0].Trim();
                    if (head.Length == 0 || head[0] != '^') continue;

                    var space = head.IndexOf(' ');
                    if (space >= 0) head = head.Substring(0, space);

                    // Every ".class" in the head, so a chained "^.accent.previewHover" yields both.
                    foreach (Match m in Regex.Matches(head, @"\.([A-Za-z][A-Za-z0-9_-]*)"))
                    {
                        var name = m.Groups[1].Value;
                        SortedSet<string> types;
                        if (!found.TryGetValue(name, out types))
                        {
                            types = new SortedSet<string>(StringComparer.Ordinal);
                            found[name] = types;
                        }
                        types.Add(target);
                    }
                }
            }
        }

        var generated = new StringBuilder();
        foreach (var entry in found)
        {
            generated.AppendLine();
            generated.AppendLine("  <!-- " + entry.Key + " -->");
            foreach (var type in entry.Value)
                generated.AppendLine("  <Style Selector=\"" + type + "." + entry.Key + "\" />");
        }

        // Restores the blank line and indent the end marker sat on, so the splice is stable and the
        // file stays readable rather than drifting a little every regeneration.
        generated.AppendLine();
        generated.Append("  ");

        var text = File.ReadAllText(DeclarationsFile);
        var begin = text.IndexOf(BeginMarker, StringComparison.Ordinal);
        var end = text.IndexOf(EndMarker, StringComparison.Ordinal);

        if (begin < 0 || end < 0 || end < begin)
        {
            Log.LogError("StyleClasses: could not find the generated markers in " + DeclarationsFile + "; regeneration skipped rather than guessing where the block goes.");
            return false;
        }

        var beginLineEnd = text.IndexOf('\n', begin);
        if (beginLineEnd < 0) beginLineEnd = begin;

        var rebuilt = text.Substring(0, beginLineEnd + 1)
            + generated.ToString()
            + text.Substring(end);

        if (string.Equals(rebuilt, text, StringComparison.Ordinal))
        {
            Log.LogMessage(MessageImportance.Low, "StyleClasses: declarations already in sync.");
            return true;
        }

        File.WriteAllText(DeclarationsFile, rebuilt);
        Log.LogMessage(MessageImportance.High,
            "StyleClasses: regenerated " + Path.GetFileName(DeclarationsFile) + " from the ControlThemes (" + found.Count + " class(es)).");
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    Before the XAML compile, so a class added in this build is declared in this build rather than
    the next one.
  -->
  <Target Name="RegenerateStyleClassDeclarations" BeforeTargets="BeforeBuild">
    <GenerateStyleClassDeclarations ProjectDir="$(MSBuildProjectDirectory)"
                                    DeclarationsFile="$(MSBuildProjectDirectory)/StyleClasses.axaml" />
  </Target>

</Project>
