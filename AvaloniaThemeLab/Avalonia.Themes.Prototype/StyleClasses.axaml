<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Declares every style class this theme exposes, so an IDE can find them.

    THIS FILE ONLY WORKS IF THE CONSUMER INCLUDES IT DIRECTLY. Put this in App.axaml, next to
    the theme itself:

        <StyleInclude Source="avares://Avalonia.Themes.Prototype/StyleClasses.axaml" />

    It cannot be included from PrototypeTheme.axaml on the consumer's behalf. PrototypeTheme is a
    C# type whose XAML is loaded at runtime by AvaloniaXamlLoader, so <PrototypeTheme /> is a type
    reference — an analyser reading App.axaml statically cannot follow it into any of this. Only a
    StyleInclude written in the consumer's own XAML is a path it can walk.

    Why it is needed at all: the classes are real, but each is declared as a `^.name` selector
    nested inside a ControlTheme, where `^` only means the control by virtue of the enclosing
    ControlTheme's key, inside a ResourceDictionary reached through MergeResourceInclude. Static
    analysis resolves none of that, so every `Classes="accent"` a consumer writes is underlined
    "Style class 'accent' not found" despite working perfectly at runtime.

    Each entry below is deliberately empty and sets nothing, so there is no runtime behaviour and
    no effect on precedence — it exists to be read.

    Selectors are type-qualified rather than a bare `.accent`, so the inspection stays useful:
    putting `Classes="accent"` on a control that has no accent styling is still reported.

    Regenerated on build by StyleClasses.targets, and checked by AVL015 (guard xaml analyze)
    for anyone who edits a ControlTheme without building this project.
  -->

  <!-- BEGIN GENERATED — edited by StyleClasses.targets on build; hand edits here are overwritten -->

  <!-- MonthItem -->
  <Style Selector="ListBoxItem.MonthItem" />

  <!-- accent -->
  <Style Selector="Button.accent" />
  <Style Selector="ButtonSpinner.accent" />
  <Style Selector="CheckBox.accent" />
  <Style Selector="DropDownButton.accent" />
  <Style Selector="RepeatButton.accent" />
  <Style Selector="ToggleButton.accent" />

  <!-- clearButton -->
  <Style Selector="TextBox.clearButton" />

  <!-- previewFocused -->
  <Style Selector="AutoCompleteBox.previewFocused" />
  <Style Selector="Button.previewFocused" />
  <Style Selector="CheckBox.previewFocused" />
  <Style Selector="DropDownButton.previewFocused" />
  <Style Selector="HyperlinkButton.previewFocused" />
  <Style Selector="RepeatButton.previewFocused" />
  <Style Selector="ToggleButton.previewFocused" />

  <!-- previewHover -->
  <Style Selector="Button.previewHover" />
  <Style Selector="ButtonSpinner.previewHover" />
  <Style Selector="CheckBox.previewHover" />
  <Style Selector="DropDownButton.previewHover" />
  <Style Selector="HyperlinkButton.previewHover" />
  <Style Selector="RepeatButton.previewHover" />
  <Style Selector="ToggleButton.previewHover" />

  <!-- previewPressed -->
  <Style Selector="Button.previewPressed" />
  <Style Selector="ButtonSpinner.previewPressed" />
  <Style Selector="CheckBox.previewPressed" />
  <Style Selector="DropDownButton.previewPressed" />
  <Style Selector="HyperlinkButton.previewPressed" />
  <Style Selector="RepeatButton.previewPressed" />
  <Style Selector="ToggleButton.previewPressed" />

  <!-- revealPasswordButton -->
  <Style Selector="TextBox.revealPasswordButton" />

  <!-- END GENERATED -->

</Styles>
