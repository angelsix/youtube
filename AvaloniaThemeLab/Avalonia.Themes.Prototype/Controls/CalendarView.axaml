<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <StackPanel Spacing="20">
        <CalendarView />
        <CalendarView SelectionMode="Range" />
        <CalendarView DisplayAsPicker="True" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: PrototypeCalendarViewNavButton (header and arrows)
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarViewNavButton" TargetType="Button">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The header label or a nav arrow -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: the chromeless TextBox inside the picker

       A selector may cross only one /template/ boundary, so the TextBox's own
       PART_BorderElement cannot be reached from the CalendarView theme; the rules for it
       live in a theme for the TextBox itself, applied to PART_TextBox below.
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarViewTextBox"
                TargetType="TextBox"
                BasedOn="{StaticResource {x:Type TextBox}}">
    <!-- The picker's own Border draws the chrome; this TextBox sits inside it and draws none. -->
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: PrototypeCalendarMarkerStrip (bare dots host)
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarMarkerStrip" TargetType="ItemsControl">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The dots themselves, no chrome at all -->
        <ItemsPresenter Name="PART_ItemsPresenter"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarViewCell}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarViewCell}" TargetType="CalendarViewCell">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:TextDefault}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="FontSize" Value="{size:FontSizeMd}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Filled background of the cell -->
        <Border Name="Fill"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <!-- Overlays the label and its marker dots -->
          <Panel>
            <!-- The day number, month or year label -->
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <!-- Row of event dots along the cell's bottom edge -->
            <ItemsControl Name="MarkerStrip"
                          Theme="{StaticResource PrototypeCalendarMarkerStrip}"
                          ItemsSource="{TemplateBinding Markers}"
                          IsHitTestVisible="False"
                          HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                          VerticalAlignment="Bottom">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="{size:SpacingSm}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Ellipse Width="{size:RadiusMdDouble}"
                           Height="{size:RadiusMdDouble}"
                           Fill="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Fill spacing: inset by default so day cells read as separate squares -->
    <Style Selector="^ /template/ Border#Fill">
      <Setter Property="Margin" Value="{size:ThicknessSm}" />
    </Style>

    <!-- Marker strip spacing -->
    <Style Selector="^ /template/ ItemsControl#MarkerStrip">
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingSm}}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border#Fill">
      <Setter Property="Background" Value="{colour:HoverBackgroundDefault}" />
    </Style>

    <!-- Inactive state -->
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>

    <!-- Today state -->
    <Style Selector="^:today /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>

    <!-- Preview band state -->
    <Style Selector="^:preview /template/ Border#Fill">
      <Setter Property="Background" Value="{colour:AccentBrush Light9}" />
      <Setter Property="Margin" Value="{size:Edges Vertical={size:ThicknessSm}}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- In-range band state -->
    <Style Selector="^:in-range /template/ Border#Fill">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="Margin" Value="{size:Edges Vertical={size:ThicknessSm}}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Fill">
        <Setter Property="Background" Value="{colour:AccentBrush Dark1}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{colour:AccentBrush Light10}" />
        <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
      </Style>
    </Style>

    <!-- Keyboard focus state -->
    <Style Selector="^:day-focused /template/ Border#Fill">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Blackout state -->
    <Style Selector="^:blackout">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Fill">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>

    <!-- Day title class -->
    <Style Selector="^.title">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="FontSize" Value="{size:FontSizeSm}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
      </Style>
    </Style>

    <!-- Zoom cell class -->
    <Style Selector="^.zoom">
      <Setter Property="MinHeight" Value="{size:ControlHeightMd}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarView}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarView}" TargetType="CalendarView">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{colour:TextDefault}" />
    <Setter Property="BorderBrush" Value="{colour:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingLg}}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HeaderBackground" Value="{colour:BackgroundDefault}" />
    <Setter Property="MarkerBrush" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="Focusable" Value="True" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root overlaying the two presentations -->
        <Panel>
          <!-- The inline calendar card -->
          <Border Name="InlineRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- Rows: header, day titles, then the active grid -->
            <Grid RowDefinitions="Auto,Auto,*">
              <!-- Header row: month label left, arrows right -->
              <Grid ColumnDefinitions="*,Auto,Auto"
                    Background="{TemplateBinding HeaderBackground}">
                <!-- Zooms out from month to year to decade -->
                <Button Name="PART_HeaderButton"
                        Theme="{StaticResource PrototypeCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}"
                        Content="{TemplateBinding HeaderText}" />
                <!-- Goes to the previous month, year or decade -->
                <Button Name="PART_PreviousButton"
                        Grid.Column="1"
                        Theme="{StaticResource PrototypeCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}">
                  <PathIcon Name="PreviousArrow"
                            Data="{icons:ChevronLeft}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
                </Button>
                <!-- Goes to the next month, year or decade -->
                <Button Name="PART_NextButton"
                        Grid.Column="2"
                        Theme="{StaticResource PrototypeCalendarViewNavButton}"
                        Foreground="{TemplateBinding Foreground}">
                  <PathIcon Name="NextArrow"
                            Data="{icons:ChevronRight}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
                </Button>
              </Grid>
              <!-- The seven day-of-week titles -->
              <UniformGrid Name="PART_DayTitles"
                           Grid.Row="1"
                           Columns="7" />
              <!-- Hosts the month grid and the zoom grid -->
              <Panel Grid.Row="2">
                <!-- The six-week grid of day cells -->
                <UniformGrid Name="PART_MonthGrid"
                             Columns="7" />
                <!-- The grid of months or years when zoomed out -->
                <UniformGrid Name="PART_ZoomGrid"
                             Columns="4"
                             MinWidth="{size:Scaled Value={size:ControlHeightSm}, By=7}"
                             IsVisible="False" />
              </Panel>
            </Grid>
          </Border>

          <!-- The picker presentation: text box and open button -->
          <Border Name="PickerRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{size:ControlHeightSm}"
                  IsVisible="False">
            <!-- Places the open button right of the text -->
            <Grid ColumnDefinitions="*,Auto">
              <!-- The date, typed or filled from the calendar -->
              <TextBox Name="PART_TextBox"
                       Theme="{StaticResource PrototypeCalendarViewTextBox}"
                       Foreground="{TemplateBinding Foreground}"
                       Background="Transparent"
                       BorderBrush="Transparent"
                       BorderThickness="0"
                       VerticalAlignment="{theme:ControlVerticalAlignment}" />
              <!-- Opens the calendar popup -->
              <Button Name="PART_PickerButton"
                      Grid.Column="1"
                      Theme="{StaticResource PrototypeCalendarViewNavButton}"
                      Foreground="{TemplateBinding Foreground}"
                      Focusable="False">
                <PathIcon Name="PickerArrow"
                            Data="{icons:ChevronDown}"
                            HorizontalAlignment="{theme:ControlHorizontalContentAlignment}"
                            VerticalAlignment="{theme:ControlVerticalContentAlignment}" />
              </Button>
            </Grid>
          </Border>

          <!-- The calendar shown when picking from the text box -->
          <Popup Name="PART_Popup"
                 PlacementTarget="{TemplateBinding}"
                 IsLightDismissEnabled="True">
            <!-- The same control, inline, driving the same selection -->
            <CalendarView Name="PopupCalendar"
                          DisplayAsPicker="False"
                          SelectionMode="{TemplateBinding SelectionMode}"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          MinDate="{TemplateBinding MinDate}"
                          MaxDate="{TemplateBinding MaxDate}"
                          IsDateDisabled="{TemplateBinding IsDateDisabled}"
                          Markers="{TemplateBinding Markers}"
                          SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}"
                          RangeStart="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RangeStart, Mode=TwoWay}"
                          RangeEnd="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RangeEnd, Mode=TwoWay}" />
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Header button text -->
    <Style Selector="^ /template/ Button#PART_HeaderButton">
      <Setter Property="FontSize" Value="{size:FontSizeLg}" />
      <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
    </Style>

    <!-- Picker text box -->
    <Style Selector="^ /template/ TextBox#PART_TextBox">
      <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}, Vertical={size:SpacingMd}}" />
    </Style>

    <!-- Zoomed-out views -->
    <Style Selector="^:year, ^:decade">
      <Style Selector="^ /template/ UniformGrid#PART_ZoomGrid">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ UniformGrid#PART_MonthGrid">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ UniformGrid#PART_DayTitles">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>

    <!-- Picker presentation -->
    <Style Selector="^:picker">
      <Style Selector="^ /template/ Border#InlineRoot">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#PickerRoot">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <!-- Picker hover state -->
    <Style Selector="^:picker:pointerover /template/ Border#PickerRoot">
      <Setter Property="BorderBrush" Value="{colour:BorderDefault}" />
      <Setter Property="Background" Value="{colour:HoverBackgroundDefault}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ Border#InlineRoot">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Picker focus state -->
    <Style Selector="^:picker:focus-within /template/ Border#PickerRoot">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
