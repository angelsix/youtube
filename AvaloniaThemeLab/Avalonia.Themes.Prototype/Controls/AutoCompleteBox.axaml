<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:generic="using:System.Collections.Generic"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="AutoCompleteBox States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <AutoCompleteBox Width="200" PlaceholderText="Default">
            <AutoCompleteBox.ItemsSource>
              <generic:List x:TypeArguments="x:String">
                <x:String>Alabama</x:String>
                <x:String>Alaska</x:String>
                <x:String>Arizona</x:String>
                <x:String>Arkansas</x:String>
              </generic:List>
            </AutoCompleteBox.ItemsSource>
          </AutoCompleteBox>
          <AutoCompleteBox Width="200" Classes="previewFocused" PlaceholderText="Focused">
            <AutoCompleteBox.ItemsSource>
              <generic:List x:TypeArguments="x:String">
                <x:String>Alabama</x:String>
                <x:String>Alaska</x:String>
              </generic:List>
            </AutoCompleteBox.ItemsSource>
          </AutoCompleteBox>
          <AutoCompleteBox Width="200" IsEnabled="False" Text="Disabled">
            <AutoCompleteBox.ItemsSource>
              <generic:List x:TypeArguments="x:String">
                <x:String>Alabama</x:String>
                <x:String>Alaska</x:String>
              </generic:List>
            </AutoCompleteBox.ItemsSource>
          </AutoCompleteBox>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type AutoCompleteBox}
       ============================================================ -->

  <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="PlaceholderForeground" Value="{colour:AccentBrush Light2}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MaxDropDownHeight" Value="{size:Scaled Value={size:ControlHeightSm}, By=12}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>

          <!-- Layout root holding the field and its dropdown -->
          <Grid Name="PART_LayoutRoot">

            <!-- The text field the user types into -->
            <TextBox Name="PART_TextBox"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                     HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="{TemplateBinding CornerRadius}"
                     CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                     ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                     Padding="{TemplateBinding Padding}"
                     FontFamily="{TemplateBinding FontFamily}"
                     FontWeight="{TemplateBinding FontWeight}"
                     FontSize="{TemplateBinding FontSize}"
                     DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                     MaxLength="{TemplateBinding MaxLength}"
                     Width="{TemplateBinding Width}"
                     InnerLeftContent="{TemplateBinding InnerLeftContent}"
                     InnerRightContent="{TemplateBinding InnerRightContent}" />

            <!-- Dropdown that appears while typing -->
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}">

              <!-- Panel behind the suggestion list -->
              <Border Name="PART_SuggestionsContainer">

                <!-- The list of suggested items -->
                <ListBox Name="PART_SelectingItemsControl"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemTemplate="{TemplateBinding ItemTemplate}"
                         ScrollViewer.IsScrollChainingEnabled="False" />
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Default style -->
    <Style Selector="^ /template/ TextBox#PART_TextBox">
      <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    </Style>
    
    <!-- Popup styles -->
    <Style Selector="^ /template/ Border#PART_SuggestionsContainer">
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="BorderBrush" Value="{colour:AccentBrush Light6}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
      <Setter Property="Padding" Value="{size:Edges Vertical={size:SpacingSm}}" />
    </Style>

    <Style Selector="^ /template/ ListBox#PART_SelectingItemsControl">
      <Setter Property="Margin" Value="{size:Edges Left={size:Scaled Value={size:BaseSize}, By=-1}, Right={size:Scaled Value={size:BaseSize}, By=-1}}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ TextBox#PART_TextBox, ^.previewFocused /template/ TextBox#PART_TextBox">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

  </ControlTheme>

</ResourceDictionary>
