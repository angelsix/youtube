<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="CheckBox States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox>Unchecked</CheckBox>
          <CheckBox Classes="previewHover" IsChecked="True">Hover</CheckBox>
          <CheckBox Classes="previewPressed" IsChecked="True">Pressed</CheckBox>
          <CheckBox Classes="previewFocused" IsChecked="True">Focused</CheckBox>
          <CheckBox IsChecked="True" IsEnabled="False">Disabled</CheckBox>
        </StackPanel>
        <Label Content="Accent States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox Classes="accent" IsChecked="True">Default</CheckBox>
          <CheckBox Classes="accent previewHover" IsChecked="True">Hover</CheckBox>
          <CheckBox Classes="accent previewPressed" IsChecked="True">Pressed</CheckBox>
          <CheckBox Classes="accent previewFocused" IsChecked="True">Focused</CheckBox>
          <CheckBox Classes="accent" IsChecked="True" IsEnabled="False">Disabled</CheckBox>
        </StackPanel>
        <Label Content="Indeterminate" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox IsThreeState="True" IsChecked="{x:Null}">Default</CheckBox>
          <CheckBox Classes="accent" IsThreeState="True" IsChecked="{x:Null}">Accent</CheckBox>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type CheckBox}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:SurfaceOverlayMediumBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusMd}" />
    <Setter Property="Padding" Value="{theme:Edges Left={theme:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{theme:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root placing the box beside its label -->
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

          <!-- Click area fill -->
          <Border x:Name="PART_Border"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}" />

          <!-- Accent border overlay -->
          <Rectangle x:Name="PART_AccentBorder"
                     Grid.ColumnSpan="2"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     StrokeDashArray="3, 2, 6, 2" />

          <!-- Checkbox indicator -->
          <Grid Grid.Column="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- The empty box the tick appears in -->
            <Border x:Name="NormalRectangle"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    UseLayoutRounding="False" />

            <!-- Padded area holding the checked and indeterminate marks -->
            <Border x:Name="TickBorder">
              <!-- Overlaps the tick and the indeterminate square -->
              <Panel>
                <!-- Scales the tick to icon size -->
                <Viewbox x:Name="TickViewbox"
                         UseLayoutRounding="False"
                         Height="{Binding Width, RelativeSource={RelativeSource Self}}">
                  <!-- The tick shown when checked -->
                  <Path x:Name="CheckGlyph"
                        Opacity="0"
                        Stretch="Uniform"
                        Data="{icons:Checkmark}" />
                </Viewbox>

                <!-- The small square shown when indeterminate -->
                <Border x:Name="IndeterminateBox"
                        Opacity="0" />
              </Panel>
            </Border>
          </Grid>

          <!-- The checkbox's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextWrapping="Wrap"
                            Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Tick visuals -->
    <Style Selector="^ /template/ Viewbox#TickViewbox">
      <Setter Property="Width" Value="{theme:IconSize}" />
    </Style>

    <Style Selector="^ /template/ Border#TickBorder">
      <Setter Property="Padding" Value="{theme:Edges All={theme:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{theme:AccentPrimaryBrush}" />
    </Style>

    <!-- Indeterminate box visuals -->
    <Style Selector="^ /template/ Border#IndeterminateBox">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
      <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{theme:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{theme:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{theme:RadiusMdDouble}" />
      <Setter Property="RadiusY" Value="{theme:RadiusMdDouble}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
      <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={theme:PressedScale}}" />
    </Style>

    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^.previewFocused">
      <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
    </Style>

    <!-- Accent class -->
    <Style Selector="^.accent">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{theme:SurfaceBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryBrush}" />

      <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <!-- Accent hover state -->
    <Style Selector="^.accent:pointerover, ^.accent.previewHover">
      <Setter Property="Background" Value="{theme:AccentHoverOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark1Brush}" />

      <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
        <Setter Property="Stroke" Value="{theme:AccentPrimaryDark1Brush}" />
      </Style>
    </Style>

    <!-- Accent pressed state -->
    <Style Selector="^.accent:pressed, ^.accent.previewPressed">
      <Setter Property="Background" Value="{theme:AccentPressedOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark2Brush}" />

      <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
        <Setter Property="Stroke" Value="{theme:AccentPrimaryDark2Brush}" />
      </Style>
    </Style>

    <!-- Accent disabled state -->
    <Style Selector="^.accent:disabled">
      <Setter Property="Opacity" Value="{theme:Scaled Value={theme:DisabledOpacity}, By=1.4}" />

      <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
        <Setter Property="Opacity" Value="{theme:Scaled Value={theme:DisabledOpacity}, By=1.4}" />
      </Style>
    </Style>

    <!-- Checked state -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
      <Setter Property="BorderBrush" Value="{theme:SurfaceOverlayStrongBrush}" />

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

    <!-- Indeterminate state -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />

      <Style Selector="^ /template/ Border#IndeterminateBox">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
