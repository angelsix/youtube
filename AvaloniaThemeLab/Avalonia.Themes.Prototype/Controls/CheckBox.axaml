<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="CheckBox States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox>Unchecked</CheckBox>
          <CheckBox Classes="previewHover" IsChecked="True">Hover</CheckBox>
          <CheckBox Classes="previewPressed" IsChecked="True">Pressed</CheckBox>
          <CheckBox Classes="previewFocused" IsChecked="True">Focused</CheckBox>
          <CheckBox IsChecked="True" IsEnabled="False">Disabled</CheckBox>
        </StackPanel>
        <Label Content="Accent States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox theme:Accent.Kind="Primary" IsChecked="True">Default</CheckBox>
          <CheckBox Classes="previewHover" theme:Accent.Kind="Primary" IsChecked="True">Hover</CheckBox>
          <CheckBox Classes="previewPressed" theme:Accent.Kind="Primary" IsChecked="True">Pressed</CheckBox>
          <CheckBox Classes="previewFocused" theme:Accent.Kind="Primary" IsChecked="True">Focused</CheckBox>
          <CheckBox theme:Accent.Kind="Primary" IsChecked="True" IsEnabled="False">Disabled</CheckBox>
        </StackPanel>
        <Label Content="Indeterminate" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <CheckBox IsThreeState="True" IsChecked="{x:Null}">Default</CheckBox>
          <CheckBox theme:Accent.Kind="Primary" IsThreeState="True" IsChecked="{x:Null}">Accent</CheckBox>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type CheckBox}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:OverlayMediumBrush}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root placing the box beside its label -->
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">

          <!-- Click area fill -->
          <Border x:Name="PART_Border"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}" />

          <!-- Accent border overlay -->
          <Rectangle x:Name="PART_AccentBorder"
                     Grid.ColumnSpan="2"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     StrokeDashArray="3, 2, 6, 2" />

          <!-- Checkbox indicator -->
          <Grid Grid.Column="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- The empty box the tick appears in -->
            <Border x:Name="NormalRectangle"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    UseLayoutRounding="False" />

            <!-- Padded area holding the checked and indeterminate marks -->
            <Border x:Name="TickBorder">
              <!-- Overlaps the tick and the indeterminate square -->
              <Panel>
                <!-- Scales the tick to icon size -->
                <Viewbox x:Name="TickViewbox"
                         UseLayoutRounding="False"
                         Height="{Binding Width, RelativeSource={RelativeSource Self}}">
                  <!-- The tick shown when checked -->
                  <Path x:Name="CheckGlyph"
                        Opacity="0"
                        Stretch="Uniform"
                        Data="{icons:Checkmark}" />
                </Viewbox>

                <!-- The small square shown when indeterminate -->
                <Border x:Name="IndeterminateBox"
                        Opacity="0" />
              </Panel>
            </Border>
          </Grid>

          <!-- The checkbox's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Margin="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextWrapping="Wrap"
                            Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Tick visuals -->
    <Style Selector="^ /template/ Viewbox#TickViewbox">
      <Setter Property="Width" Value="{size:IconSize}" />
    </Style>

    <Style Selector="^ /template/ Border#TickBorder">
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{colour:AccentPrimaryBrush}" />
    </Style>

    <!-- Indeterminate box visuals -->
    <Style Selector="^ /template/ Border#IndeterminateBox">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{size:RadiusMdDouble}" />
      <Setter Property="RadiusY" Value="{size:RadiusMdDouble}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
    </Style>

    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^.previewFocused">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Checked state -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="{colour:OverlayStrongBrush}" />

      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

    <!-- Indeterminate state -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />

      <Style Selector="^ /template/ Border#IndeterminateBox">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
