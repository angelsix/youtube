<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="10">
        <RadioButton Content="Option 1" />
        <RadioButton Content="Option 2" IsChecked="True" />
        <RadioButton Content="Option 3" IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type RadioButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:SurfaceOverlayMediumBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    <Setter Property="Padding" Value="{theme:Edges Left={theme:SpacingLg}}" />
    <Setter Property="MinWidth" Value="{theme:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <!-- Outer frame around the button and label -->
        <Border
            x:Name="RootBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Places the circle beside its label -->
          <Grid ColumnDefinitions="Auto,*">
            <!-- Layout root stacking the circle's three rings -->
            <Grid
                x:Name="PART_CheckBoxGrid"
                VerticalAlignment="Top">

              <!-- The empty circle when unselected -->
              <Ellipse
                  x:Name="OuterEllipse"
                  UseLayoutRounding="False" />

              <!-- The filled ring shown when selected -->
              <Ellipse
                  x:Name="CheckOuterEllipse"
                  Opacity="0"
                  UseLayoutRounding="False" />

              <!-- The dot shown when selected -->
              <Ellipse
                  x:Name="CheckGlyph"
                  Opacity="0"
                  UseLayoutRounding="False" />
            </Grid>

            <!-- The radio button's label -->
            <ContentPresenter
                x:Name="PART_ContentPresenter"
                Grid.Column="1"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Check box grid size -->
    <Style Selector="^ /template/ Grid#PART_CheckBoxGrid">
      <Setter Property="Width" Value="{theme:IconSize}" />
      <Setter Property="Height" Value="{theme:IconSize}" />
    </Style>

    <!-- Ellipse sizes -->
    <Style Selector="^ /template/ Ellipse#OuterEllipse, ^ /template/ Ellipse#CheckOuterEllipse, ^ /template/ Ellipse#CheckGlyph">
      <Setter Property="Width" Value="{theme:IconSize}" />
      <Setter Property="Height" Value="{theme:IconSize}" />
    </Style>

    <!-- Default visuals -->
    <Style Selector="^ /template/ Ellipse#OuterEllipse">
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
      <Setter Property="Stroke" Value="{theme:AccentBorderBrush}" />
      <Setter Property="StrokeThickness" Value="{theme:ThicknessSm}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Fill" Value="{theme:AccentPrimaryBrush}" />
      <Setter Property="Stroke" Value="{theme:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{theme:ThicknessSm}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#CheckGlyph">
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
      <Setter Property="Stroke" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{theme:SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:AccentPrimaryLight1Brush}" />
      <Setter Property="Fill" Value="{theme:AccentPrimaryLight1Brush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{theme:SurfaceBrush}" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
      <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceBrush}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:AccentPrimaryDark1Brush}" />
      <Setter Property="Fill" Value="{theme:AccentPrimaryDark1Brush}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{theme:SurfaceBrush}" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{theme:SurfaceBrush}" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:AccentFocusBrush}" />
    </Style>

    <!-- Checked state -->
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Opacity" Value="1" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
