<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="10">
        <RadioButton Content="Option 1" Background="Green" />
        <RadioButton Content="Option 2" />
        <RadioButton IsEnabled="False" Content="Option 3" />
        <RadioButton Content="Option 2" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  
  <x:Double x:Key="RadioButtonMinHeight">32</x:Double>
  
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border
            Name="RootBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="20,*">
            <Grid Height="{DynamicResource RadioButtonMinHeight}" VerticalAlignment="Top">

              <Ellipse
                  Name="OuterEllipse"
                  Width="20"
                  Height="20"
                  Fill="Transparent"
                  Stroke="{theme:AccentBorderBrush}"
                  StrokeThickness="{theme:Thickness}"
                  UseLayoutRounding="False" />

              <Ellipse
                  Name="CheckOuterEllipse"
                  Width="20"
                  Height="20"
                  Fill="{theme:AccentPrimaryBrush}"
                  Opacity="0"
                  Stroke="{theme:AccentPrimaryBrush}"
                  StrokeThickness="{theme:Thickness}"
                  UseLayoutRounding="False" />

              <Ellipse
                  Name="CheckGlyph"
                  Width="8"
                  Height="8"
                  Fill="{theme:SurfaceBrush}"
                  Opacity="0"
                  Stroke="Transparent"
                  UseLayoutRounding="False" />
            </Grid>

            <ContentPresenter
                Name="PART_ContentPresenter"
                Grid.Column="1"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!--  PointerOver State  -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#RootBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:AccentPrimaryLight1Brush}" />
      <Setter Property="Fill" Value="{theme:AccentPrimaryLight1Brush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>


    <!--  Pressed State  -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#RootBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceBrush}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:AccentPrimaryDark1Brush}" />
      <Setter Property="Fill" Value="{theme:AccentPrimaryDark1Brush}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="Fill" Value="{theme:SurfaceBrush}" />
    </Style>


    <!--  Disabled State  -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Border#RootBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{theme:SurfaceBrush}" />
      <Setter Property="Fill" Value="Transparent" />
    </Style>


    <!--  Checked State  -->
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
