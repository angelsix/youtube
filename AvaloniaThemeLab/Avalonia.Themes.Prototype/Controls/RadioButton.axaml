<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Written once as a template: each pane instantiates its own copy -->
      <prototype:LightDarkPreview Title="RadioButton States" Orientation="Horizontal">
        <DataTemplate>
          <StackPanel Spacing="16">
            <!-- Selection is meaningful per group, so each column keeps a selected/unselected pair; the theme has no :error selector -->
            <StackPanel Orientation="Horizontal" Spacing="20">
              <RadioButton Content="Unselected" />
              <RadioButton theme:Preview.State="Hover" Content="Hover" />
              <RadioButton IsChecked="True" Content="Selected" />
              <RadioButton theme:Preview.State="Pressed" IsChecked="True" Content="Pressed" />
              <RadioButton theme:Preview.State="Focused" IsChecked="True" Content="Focused" />
              <RadioButton IsEnabled="False" Content="Disabled" />
            </StackPanel>
            <!-- Hues tint the AccentBrush-driven rings; combine them with states instead of repeating rows -->
            <StackPanel Orientation="Horizontal" Spacing="20">
              <RadioButton theme:Accent.Kind="Warning" Content="Warning" />
              <RadioButton theme:Accent.Kind="Success" theme:Preview.State="Focused" IsChecked="True" Content="Success + Focused" />
              <RadioButton theme:Accent.Kind="Warning" IsChecked="True" IsEnabled="False" Content="Warning Disabled" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type RadioButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:OverlayMediumBrush}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingLg}}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <!-- Outer frame around the button and label -->
        <Border
            x:Name="RootBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Places the circle beside its label -->
          <Grid ColumnDefinitions="Auto,*">
            <!-- Layout root stacking the circle's three rings -->
            <Grid
                x:Name="PART_CheckBoxGrid"
                VerticalAlignment="Top">

              <!-- The empty circle when unselected -->
              <Ellipse
                  x:Name="OuterEllipse"
                  UseLayoutRounding="False" />

              <!-- The filled ring shown when selected -->
              <Ellipse
                  x:Name="CheckOuterEllipse"
                  Opacity="0"
                  UseLayoutRounding="False" />

              <!-- The dot shown when selected -->
              <Ellipse
                  x:Name="CheckGlyph"
                  Opacity="0"
                  UseLayoutRounding="False" />
            </Grid>

            <!-- The radio button's label -->
            <ContentPresenter
                x:Name="PART_ContentPresenter"
                Grid.Column="1"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Check box grid size -->
    <Style Selector="^ /template/ Grid#PART_CheckBoxGrid">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Ellipse sizes -->
    <Style Selector="^ /template/ Ellipse#OuterEllipse, ^ /template/ Ellipse#CheckOuterEllipse, ^ /template/ Ellipse#CheckGlyph">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Default visuals -->
    <Style Selector="^ /template/ Ellipse#OuterEllipse">
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
      <Setter Property="Stroke" Value="{colour:AccentBrush Light6}" />
      <Setter Property="StrokeThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Fill" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="Stroke" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:ThicknessSm}" />
    </Style>

    <Style Selector="^ /template/ Ellipse#CheckGlyph">
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
      <Setter Property="Stroke" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^[(theme|Preview.State)=Hover] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse, ^[(theme|Preview.State)=Hover] /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light2}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckOuterEllipse, ^[(theme|Preview.State)=Hover] /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light1}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light1}" />
    </Style>

    <Style Selector="^:pointerover /template/ Ellipse#CheckGlyph, ^[(theme|Preview.State)=Hover] /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light10}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    </Style>

    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter, ^[(theme|Preview.State)=Pressed] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#OuterEllipse, ^[(theme|Preview.State)=Pressed] /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Dark1}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light2}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckOuterEllipse, ^[(theme|Preview.State)=Pressed] /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Dark1}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Dark1}" />
    </Style>

    <Style Selector="^:pressed /template/ Ellipse#CheckGlyph, ^[(theme|Preview.State)=Pressed] /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light10}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light2}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light2}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light2}" />
    </Style>

    <Style Selector="^:disabled /template/ Ellipse#CheckGlyph">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light10}" />
      <Setter Property="Fill" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Ellipse#OuterEllipse, ^[(theme|Preview.State)=Focused] /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{colour:AccentFocusBrush}" />
    </Style>

    <!-- Checked state -->
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Opacity" Value="1" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
