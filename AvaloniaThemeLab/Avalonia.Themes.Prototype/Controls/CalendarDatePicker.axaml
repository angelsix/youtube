<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Margin="20" Width="400" Height="400">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <CalendarDatePicker Width="200" VerticalAlignment="Top" HorizontalContentAlignment="Center" />
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Sub-theme: Calendar date button
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarDatePickerButton" TargetType="Button">
    <!-- Visual defaults -->
    <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Light2}" />
    <Setter Property="Margin" Value="{size:Edges Left={size:SpacingSm}, Right={size:SpacingMd}}" />
    <Setter Property="Width" Value="{size:Scaled Value={size:BaseSize}, By=10}" />
    <Setter Property="Height" Value="{size:Scaled Value={size:BaseSize}, By=12}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout grid for the calendar-page icon -->
        <Grid Height="{TemplateBinding Height}"
              Width="{TemplateBinding Width}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="23*,19*,19*,19*"
              ClipToBounds="False">
          <!-- The page body of the calendar icon -->
          <Border x:Name="Background"
                  Grid.ColumnSpan="4"
                  Grid.Row="1"
                  Grid.RowSpan="3"
                  BorderBrush="{TemplateBinding Foreground}" />
          <!-- The binding strip across the icon's top -->
          <Border x:Name="TopBorder"
                  Grid.ColumnSpan="4"
                  Grid.RowSpan="1"
                  BorderBrush="{TemplateBinding Foreground}" />
          <!-- Today's day number, shown on the icon -->
          <TextBlock x:Name="PART_DayText"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Grid.Column="0"
                     Grid.Row="1"
                     Grid.ColumnSpan="4"
                     Grid.RowSpan="3"
                     Foreground="{TemplateBinding Foreground}"
                     Text="{Binding Source={x:Static sys:DateTime.Today}, Path=Day}" />
          <!-- Dot beneath the day number -->
          <Ellipse x:Name="PART_Dot"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="{TemplateBinding Foreground}"
                   StrokeThickness="0"
                   Grid.ColumnSpan="4" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Background border visuals -->
    <Style Selector="^ /template/ Border#Background">
      <Setter Property="Margin" Value="{size:Edges Top={size:Scaled Value={size:BaseSize}, By=-1}}" />
      <Setter Property="BorderThickness" Value="{size:Edges Left={size:BaseSize}, Right={size:BaseSize}, Bottom={size:BaseSize}}" />
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Bottom=True}" />
    </Style>

    <!-- Top border visuals -->
    <Style Selector="^ /template/ Border#TopBorder">
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{size:Corners Radius={size:RadiusSm}, Top=True}" />
    </Style>

    <!-- Day text visuals -->
    <Style Selector="^ /template/ TextBlock#PART_DayText">
      <Setter Property="Margin" Value="{size:Edges Top={size:Scaled Value={size:BaseSize}, By=-1}}" />
      <Setter Property="FontSize" Value="{size:FontSizeSm}" />
    </Style>

    <!-- Dot indicator visuals -->
    <Style Selector="^ /template/ Ellipse#PART_Dot">
      <Setter Property="Width" Value="{size:ThicknessLg}" />
      <Setter Property="Height" Value="{size:ThicknessLg}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Sub-theme: the chromeless TextBox inside the picker

       A ControlTheme cannot reach through two templates — a selector may cross one /template/ boundary,
       so styling the TextBox's own PART_BorderElement from the CalendarDatePicker theme is not
       expressible and throws when the theme is built. The TextBox owns that part, so the rules for it
       belong in a theme for the TextBox, applied to PART_TextBox below.
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarDatePickerTextBox"
                TargetType="TextBox"
                BasedOn="{StaticResource {x:Type TextBox}}">
    <!-- The picker's own Border draws the chrome; this TextBox sits inside it and draws none. -->
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="^:disabled /template/ TextBlock#PART_Placeholder, ^:disabled /template/ TextBlock#PART_FloatingPlaceholder">
      <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Light2}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarDatePicker}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarDatePicker}" TargetType="CalendarDatePicker">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="PlaceholderForeground" Value="{colour:DimTextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Padding" Value="{size:SpacingMd}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Layout root stacking the frame and its contents -->
          <Panel x:Name="LayoutRoot"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            <!-- Outer frame around the field and button -->
            <Border x:Name="Background"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}" />
            <!-- Places the calendar button right of the text -->
            <Grid ColumnDefinitions="*,Auto">
              <!-- The date, typed or filled in from the calendar -->
              <TextBox Name="PART_TextBox"
                       Theme="{StaticResource PrototypeCalendarDatePickerTextBox}"
                       Foreground="{TemplateBinding Foreground}"
                       Background="Transparent"
                       BorderBrush="Transparent"
                       BorderThickness="0"
                       CornerRadius="{TemplateBinding CornerRadius}"
                       Margin="{TemplateBinding BorderThickness}"
                       Padding="{TemplateBinding Padding}"
                       PlaceholderText="{TemplateBinding PlaceholderText}"
                       PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                       UseFloatingPlaceholder="{TemplateBinding UseFloatingPlaceholder}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                       Grid.Column="0" />
              <!-- Opens the calendar for picking a date -->
              <Button Name="PART_Button"
                      Theme="{StaticResource PrototypeCalendarDatePickerButton}"
                      Grid.Column="1"
                      Focusable="False" />
              <!-- The calendar shown when picking a date -->
              <Popup Name="PART_Popup"
                     PlacementTarget="{TemplateBinding}"
                     IsLightDismissEnabled="True">
                <!-- The month grid to pick a date from -->
                <Calendar Name="PART_Calendar"
                          FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                          IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                          SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}"
                          DisplayDate="{TemplateBinding DisplayDate}"
                          DisplayDateStart="{TemplateBinding DisplayDateStart}"
                          DisplayDateEnd="{TemplateBinding DisplayDateEnd}" />
              </Popup>
            </Grid>
          </Panel>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Inner TextBox styles live in PrototypeCalendarDatePickerTextBox above, applied to PART_TextBox. -->

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{colour:BorderDefaultBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{colour:BorderDefaultBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#Background">
        <Setter Property="Background" Value="{colour:OverlayWeakBrush}" />
        <Setter Property="BorderBrush" Value="{colour:OverlayWeakBrush}" />
      </Style>

      <Style Selector="^ /template/ Button#PART_Button">
        <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Light2}" />
      </Style>
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-within:not(CalendarDatePicker:focus) /template/ Border#Background">
      <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{colour:AccentErrorBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
