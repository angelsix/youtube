<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Margin="20" Width="400" Height="600">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <DockPanel LastChildFill="True">
        <StackPanel Spacing="10" DockPanel.Dock="Top">
          <Slider Value="50" />
          <Slider IsDirectionReversed="True" Value="50" />
          <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10"/>
          <Slider Value="50" TickPlacement="BottomRight" TickFrequency="10"/>
          <Slider Value="50" TickPlacement="Outside" TickFrequency="10"/>
          <Slider IsEnabled="False" Value="50" />
          <Slider Value="50">
            <DataValidationErrors.Error>
              <sys:Exception>
                <x:Arguments>
                  <x:String>Error</x:String>
                </x:Arguments>
              </sys:Exception>
            </DataValidationErrors.Error>
          </Slider>
        </StackPanel>
        <StackPanel Spacing="10" Orientation="Horizontal">
          <Slider Value="50" Orientation="Vertical" />
          <Slider IsDirectionReversed="True" Value="50" Orientation="Vertical" />
          <Slider IsEnabled="False" Orientation="Vertical" Value="50" />
          <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10" Orientation="Vertical" />
          <Slider Value="50" TickPlacement="BottomRight" TickFrequency="10" Orientation="Vertical" />
          <Slider Value="50" TickPlacement="Outside" TickFrequency="10" Orientation="Vertical" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Sub-theme: Horizontal RepeatButton
       ============================================================ -->
  <ControlTheme x:Key="PrototypeSliderHorizontalRepeatButton" TargetType="RepeatButton">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="FocusTarget" Background="Transparent" />
          <!-- Structural: track height -->
          <Border x:Name="TrackBackground"
                  Background="{TemplateBinding Background}"
                  VerticalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Focus target margin -->
    <Style Selector="^ /template/ Border#FocusTarget">
      <Setter Property="Margin" Value="{theme:Edges Vertical={theme:Scaled Value={theme:IconSize}, By=-0.5}}" />
    </Style>

    <!-- Track background styling -->
    <Style Selector="^ /template/ Border#TrackBackground">
      <Setter Property="Height" Value="{theme:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Sub-theme: Vertical RepeatButton
       ============================================================ -->
  <ControlTheme x:Key="PrototypeSliderVerticalRepeatButton" TargetType="RepeatButton">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border x:Name="FocusTarget" Background="Transparent" />
          <!-- Structural: track width -->
          <Border x:Name="TrackBackground"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Focus target margin -->
    <Style Selector="^ /template/ Border#FocusTarget">
      <Setter Property="Margin" Value="{theme:Edges Vertical={theme:Scaled Value={theme:IconSize}, By=-0.5}}" />
    </Style>

    <!-- Track background styling -->
    <Style Selector="^ /template/ Border#TrackBackground">
      <Setter Property="Width" Value="{theme:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       Sub-theme: Thumb
       ============================================================ -->
  <ControlTheme x:Key="PrototypeSliderThumbTheme" TargetType="Thumb">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type Slider}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{theme:AccentPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />

    <!-- Horizontal template -->
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Grid x:Name="SliderContainer"
                      Margin="{TemplateBinding Padding}"
                      Background="Transparent">
                  <Grid.Styles>
                    <Style Selector="TickBar">
                      <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                    </Style>
                  </Grid.Styles>
                  <Grid
                      x:Name="HorizontalTemplate"
                      ColumnDefinitions="Auto,Auto,*">
                    <Grid.RowDefinitions>
                      <!-- Structural: grid row spacing (SpacingXxl = 16) -->
                      <RowDefinition Height="{theme:SpacingXxl}" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="{theme:SpacingXxl}" />
                    </Grid.RowDefinitions>
                    <TickBar
                        Name="TopTickBar"
                        Grid.ColumnSpan="3"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}"
                        VerticalAlignment="Bottom"
                        Placement="Top"
                        IsVisible="False"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                    <!-- Structural: tick bar height -->
                    <TickBar
                        Name="BottomTickBar"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}"
                        VerticalAlignment="Top"
                        Placement="Bottom"
                        IsVisible="False"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                    <Track
                        Name="PART_Track"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Minimum="{TemplateBinding Minimum}"
                        Maximum="{TemplateBinding Maximum}"
                        Value="{TemplateBinding Value, Mode=TwoWay}"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                        Orientation="Horizontal">
                      <Track.DecreaseButton>
                        <RepeatButton
                            Name="PART_DecreaseButton"
                            Theme="{StaticResource PrototypeSliderHorizontalRepeatButton}"
                            Background="{TemplateBinding Foreground}"
                            Focusable="False"/>
                      </Track.DecreaseButton>
                      <Track.IncreaseButton>
                        <RepeatButton
                            Name="PART_IncreaseButton"
                            Theme="{StaticResource PrototypeSliderHorizontalRepeatButton}"
                            Background="{TemplateBinding Background}"
                            Focusable="False"/>
                      </Track.IncreaseButton>
                      <Thumb
                          Name="thumb"
                          Margin="0"
                          Padding="0"
                          BorderThickness="0"
                          Theme="{StaticResource PrototypeSliderThumbTheme}"
                          DataContext="{TemplateBinding Value}"/>
                    </Track>
                  </Grid>
                </Grid>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Vertical template -->
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Grid x:Name="SliderContainer"
                      Background="Transparent"
                      Margin="{TemplateBinding Padding}">
                  <Grid.Styles>
                    <Style Selector="TickBar">
                      <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                    </Style>
                  </Grid.Styles>
                  <Grid
                      x:Name="VerticalTemplate"
                      RowDefinitions="*,Auto,Auto">
                    <Grid.ColumnDefinitions>
                      <!-- Structural: grid column spacing (SpacingXxl = 16) -->
                      <ColumnDefinition Width="{theme:SpacingXxl}" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="{theme:SpacingXxl}" />
                    </Grid.ColumnDefinitions>
                    <TickBar
                        Name="LeftTickBar"
                        Grid.RowSpan="3"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}"
                        HorizontalAlignment="Right"
                        Placement="Left"
                        IsVisible="False"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                    <!-- Structural: tick bar width -->
                    <TickBar 
                        Name="RightTickBar"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}"
                        HorizontalAlignment="Left"
                        Placement="Right" 
                        IsVisible="False"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"/>
                    <Track
                        Name="PART_Track"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="1"
                        Minimum="{TemplateBinding Minimum}"
                        Maximum="{TemplateBinding Maximum}"
                        Value="{TemplateBinding Value, Mode=TwoWay}"
                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                        Orientation="Vertical">
                      <Track.DecreaseButton>
                        <RepeatButton
                            Name="PART_DecreaseButton"
                            Theme="{StaticResource PrototypeSliderVerticalRepeatButton}"
                            Background="{TemplateBinding Foreground}"
                            Focusable="False"/>
                      </Track.DecreaseButton>
                      <Track.IncreaseButton>
                        <RepeatButton
                            Name="PART_IncreaseButton"
                            Background="{TemplateBinding Background}"
                            Theme="{StaticResource PrototypeSliderVerticalRepeatButton}"
                            Focusable="False"/>
                      </Track.IncreaseButton>
                      <Thumb
                          Name="thumb"
                          Margin="0"
                          Padding="0"
                          BorderThickness="0"
                          Theme="{StaticResource PrototypeSliderThumbTheme}"
                          DataContext="{TemplateBinding Value}" />
                    </Track>
                  </Grid>
                </Grid>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Template element defaults -->
    <Style Selector="^ /template/ Grid#HorizontalTemplate">
      <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    </Style>

    <Style Selector="^ /template/ Grid#VerticalTemplate">
      <Setter Property="MinWidth" Value="{theme:ControlHeightSm}" />
    </Style>

    <Style Selector="^ /template/ Thumb">
      <Setter Property="Width" Value="{theme:IconSize}" />
      <Setter Property="Height" Value="{theme:IconSize}" />
      <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="{theme:RadiusMd}" />
    </Style>

    <Style Selector="^ /template/ TickBar">
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <Style Selector="^ /template/ TickBar#TopTickBar">
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Margin" Value="{theme:Edges Bottom={theme:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#BottomTickBar">
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Margin" Value="{theme:Edges Top={theme:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#LeftTickBar">
      <Setter Property="Width" Value="{theme:ThicknessXxl}" />
      <Setter Property="Margin" Value="{theme:Edges Right={theme:SpacingMd}}" />
    </Style>

    <Style Selector="^ /template/ TickBar#RightTickBar">
      <Setter Property="Width" Value="{theme:ThicknessXxl}" />
      <Setter Property="Margin" Value="{theme:Edges Left={theme:SpacingMd}}" />
    </Style>

    <!-- TickBar placement -->
    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Grid#SliderContainer">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{theme:AccentPrimaryLight1Brush}" />
      </Style>
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Grid#SliderContainer">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{theme:AccentPrimaryDark1Brush}" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
      <Style Selector="^ /template/ TickBar">
        <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Style Selector="^ /template/ Thumb">
        <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
        <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
      </Style>
    </Style>

    <!-- Error state -->
    <Style Selector="^:error">
      <Setter Property="Foreground" Value="{theme:AccentErrorBrush}" />
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{theme:AccentErrorBrush}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>