<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Written once as a template: each pane instantiates its own copy, so nothing may depend on appearing twice -->
      <prototype:LightDarkPreview Title="ToggleButton States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Spacing="20">
            <!-- Interaction states behave identically across all three logical states, so only the unchecked row demos them -->
            <StackPanel Orientation="Horizontal" Spacing="20">
              <ToggleButton Content="Default" />
              <ToggleButton theme:Preview.State="Hover" Content="Hover" />
              <ToggleButton theme:Preview.State="Pressed" Content="Pressed" />
              <ToggleButton theme:Preview.State="Focused" Content="Focused" />
              <ToggleButton Content="Disabled" IsEnabled="False" />
            </StackPanel>
            <!-- Non-default hues ride along with a stateful instance instead of owning a row -->
            <StackPanel Orientation="Horizontal" Spacing="20">
              <ToggleButton Content="Checked" IsChecked="True" />
              <ToggleButton theme:Accent.Kind="Warning" theme:Preview.State="Hover" Content="Checked + Hover" IsChecked="True" />
              <ToggleButton theme:Preview.State="Pressed" Content="Checked + Pressed" IsChecked="True" />
              <ToggleButton Content="Checked + Disabled" IsChecked="True" IsEnabled="False" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="20">
              <ToggleButton Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
              <ToggleButton theme:Accent.Kind="Success" theme:Preview.State="Hover" Content="Indet + Hover" IsThreeState="True" IsChecked="{x:Null}" />
              <ToggleButton theme:Preview.State="Pressed" Content="Indet + Pressed" IsThreeState="True" IsChecked="{x:Null}" />
              <ToggleButton Content="Indet + Disabled" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}, Vertical={size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the label and accent outline -->
        <Grid>
          <!-- The button's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

          <!-- Accent border overlay -->
          <Rectangle x:Name="PART_AccentBorder"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     StrokeDashArray="3, 2, 6, 2" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{color:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{size:RadiusSmDouble}" />
      <Setter Property="RadiusY" Value="{size:RadiusSmDouble}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
    </Style>

    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
    </Style>

    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{color:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- ============================================================
         Template
         ============================================================ -->

    <!-- Checked default -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{color:AccentPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Checked hover -->
    <Style Selector="^:checked:pointerover, ^:checked[(theme|Preview.State)=Hover]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="Background" Value="{color:AccentBrush Light1}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Checked pressed -->
    <Style Selector="^:checked:pressed, ^:checked[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:AccentBrush Light10}" />
    </Style>

    <!-- Checked disabled -->
    <Style Selector="^:checked:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Setter Property="Background" Value="{color:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

    <!-- ============================================================
         Template
         ============================================================ -->

    <!-- Indeterminate default -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Indeterminate hover -->
    <Style Selector="^:indeterminate:pointerover, ^:indeterminate[(theme|Preview.State)=Hover]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="Background" Value="{color:AccentBrush Light8}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    </Style>

    <!-- Indeterminate pressed -->
    <Style Selector="^:indeterminate:pressed, ^:indeterminate[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{color:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Indeterminate disabled -->
    <Style Selector="^:indeterminate:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Setter Property="Background" Value="{color:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
