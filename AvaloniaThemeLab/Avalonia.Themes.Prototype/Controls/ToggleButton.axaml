<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="ToggleButton States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <ToggleButton Content="Default" />
          <ToggleButton Classes="previewHover" Content="Hover" />
          <ToggleButton Classes="previewPressed" Content="Pressed" />
          <ToggleButton Classes="previewFocused" Content="Focused" />
          <ToggleButton Content="Disabled" IsEnabled="False" />
        </StackPanel>
        <Label Content="Checked States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <ToggleButton Content="Checked" IsChecked="True" />
          <ToggleButton Classes="previewHover" Content="Checked+Hover" IsChecked="True" />
          <ToggleButton Classes="previewPressed" Content="Checked+Pressed" IsChecked="True" />
          <ToggleButton Content="Checked+Disabled" IsChecked="True" IsEnabled="False" />
        </StackPanel>
        <Label Content="Indeterminate States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <ToggleButton Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
          <ToggleButton Classes="previewHover" Content="Indet+Hover" IsThreeState="True" IsChecked="{x:Null}" />
          <ToggleButton Classes="previewPressed" Content="Indet+Pressed" IsThreeState="True" IsChecked="{x:Null}" />
          <ToggleButton Content="Indet+Disabled" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" />
        </StackPanel>
        <Label Content="Accent States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <ToggleButton theme:Accent.Kind="Primary" Content="Default" />
          <ToggleButton Classes="previewHover" theme:Accent.Kind="Primary" Content="Hover" />
          <ToggleButton Classes="previewPressed" theme:Accent.Kind="Primary" Content="Pressed" />
          <ToggleButton Classes="previewFocused" theme:Accent.Kind="Primary" Content="Focused" />
          <ToggleButton theme:Accent.Kind="Primary" Content="Disabled" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type ToggleButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}, Vertical={size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the label and accent outline -->
        <Grid>
          <!-- The button's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

          <!-- Accent border overlay -->
          <Rectangle x:Name="PART_AccentBorder"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     StrokeDashArray="3, 2, 6, 2" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{size:RadiusSmDouble}" />
      <Setter Property="RadiusY" Value="{size:RadiusSmDouble}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
    </Style>

    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
    </Style>

    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^.previewFocused">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- ============================================================
         Checked states
         ============================================================ -->

    <!-- Checked default -->
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Checked hover -->
    <Style Selector="^:checked:pointerover, ^:checked.previewHover">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light1}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Checked pressed -->
    <Style Selector="^:checked:pressed, ^:checked.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light10}" />
    </Style>

    <!-- Checked disabled -->
    <Style Selector="^:checked:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
    </Style>

    <!-- ============================================================
         Indeterminate states
         ============================================================ -->

    <!-- Indeterminate default -->
    <Style Selector="^:indeterminate">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Indeterminate hover -->
    <Style Selector="^:indeterminate:pointerover, ^:indeterminate.previewHover">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="BorderBrush" Value="{colour:AccentBorderBrush}" />
    </Style>

    <!-- Indeterminate pressed -->
    <Style Selector="^:indeterminate:pressed, ^:indeterminate.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Indeterminate disabled -->
    <Style Selector="^:indeterminate:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
