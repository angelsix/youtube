<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Vertical: three lists exceed half-pane width. Item states ride item properties — the ListBoxItem theme has no Preview.State hooks -->
      <prototype:LightDarkPreview Title="ListBox States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <!-- Mixed-item list: every item state the ListBoxItem theme implements, forced via item properties -->
            <ListBox Width="180">
              <ListBoxItem>Default</ListBoxItem>
              <ListBoxItem IsSelected="True">Selected</ListBoxItem>
              <ListBoxItem IsEnabled="False">Disabled</ListBoxItem>
              <ListBoxItem IsSelected="True" IsEnabled="False">Selected · Disabled</ListBoxItem>
            </ListBox>
            <!-- Frame-only options compose onto one instance each: selection mode + inherited accent hue -->
            <ListBox Width="180" SelectionMode="Multiple" theme:Accent.Kind="Warning">
              <ListBoxItem IsSelected="True">A</ListBoxItem>
              <ListBoxItem>B</ListBoxItem>
              <ListBoxItem IsSelected="True">C</ListBoxItem>
            </ListBox>
            <!-- Toggle = ctrl-click multi-select: Avalonia 12's SelectionMode has no MultiExtended member -->
            <ListBox Width="180" SelectionMode="Toggle" SelectedIndex="1" theme:Accent.Kind="Success">
              <ListBoxItem>X</ListBoxItem>
              <ListBoxItem>Y</ListBoxItem>
              <ListBoxItem>Z</ListBoxItem>
            </ListBox>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Light2}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}, Vertical={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />

    <!-- ScrollViewer options -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the list -->
        <Border Name="border"
                ClipToBounds="{TemplateBinding ClipToBounds}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Scrolls the list when it overflows -->
          <ScrollViewer Name="PART_ScrollViewer"
                        VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                        HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        IsScrollInertiaEnabled="{TemplateBinding (ScrollViewer.IsScrollInertiaEnabled)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
            <!-- The list items -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
