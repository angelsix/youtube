<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="600">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="12">
        <CommandBar>
          <CommandBarButton Label="New">
            <CommandBarButton.Icon>
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton Label="Save">
            <CommandBarButton.Icon>
              <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" />
            </CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarSeparator />
          <CommandBarToggleButton Label="Bold">
            <CommandBarToggleButton.Icon>
              <PathIcon Data="M15.6,10.79C17.04,10.07 18,8.64 18,7C18,4.79 16.21,3 14,3H7V21H14.73C16.78,21 18.5,19.37 18.5,17.32C18.5,15.82 17.72,14.53 16.5,13.77C16.2,13.59 15.9,13.44 15.6,13.32V10.79M10,6.5H13C13.83,6.5 14.5,7.17 14.5,8C14.5,8.83 13.83,9.5 13,9.5H10V6.5M13.5,17.5H10V14H13.5C14.33,14 15,14.67 15,15.5C15,16.33 14.33,17.5 13.5,17.5Z" />
            </CommandBarToggleButton.Icon>
          </CommandBarToggleButton>
        </CommandBar>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- CommandBarButton ControlTheme -->
  <ControlTheme x:Key="{x:Type CommandBarButton}" TargetType="CommandBarButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingLg}, Vertical={theme:SpacingMd}}" />
    <Setter Property="Width" Value="{theme:Scaled Value={theme:ControlHeightSm}, By=2}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightMd}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the command button -->
        <Border x:Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Stacks the icon above its label -->
          <StackPanel x:Name="PART_LayoutRoot"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- The command's icon -->
            <ContentPresenter x:Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <!-- The command's label, trimmed when too long -->
            <TextBlock x:Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Template element styles -->
    <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Spacing" Value="{theme:SpacingMd}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{theme:FontSizeSm}" />
    </Style>

    <!-- Hover -->
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>

    <!-- Compact: hide label, reduce width -->
    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- LabelPosition=Right: horizontal layout, auto-width -->
    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>

    <!-- IsInOverflow: full-width horizontal layout -->
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
  </ControlTheme>

  <!-- CommandBarToggleButton ControlTheme -->
  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingLg}, Vertical={theme:SpacingMd}}" />
    <Setter Property="Width" Value="{theme:Scaled Value={theme:ControlHeightSm}, By=2}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightMd}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the toggle command -->
        <Border x:Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- Stacks the icon above its label -->
          <StackPanel x:Name="PART_LayoutRoot"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <!-- The command's icon -->
            <ContentPresenter x:Name="PART_IconPresenter"
                              Content="{TemplateBinding Icon}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <!-- The command's label, trimmed when too long -->
            <TextBlock x:Name="PART_Label"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Template element styles -->
    <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Spacing" Value="{theme:SpacingMd}" />
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{theme:FontSizeSm}" />
    </Style>

    <!-- Hover -->
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>

    <!-- Checked -->
    <Style Selector="^:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
    </Style>

    <!-- Compact: hide label, reduce width -->
    <Style Selector="^[IsCompact=True]">
      <Setter Property="Width" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- LabelPosition=Right: horizontal layout, auto-width -->
    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#PART_Label">
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>

    <!-- IsInOverflow: full-width horizontal layout -->
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="{theme:ControlHeightMd}" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ StackPanel#PART_LayoutRoot">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
  </ControlTheme>

  <!-- CommandBarSeparator ControlTheme -->
  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator">
    <Setter Property="Width" Value="{theme:ThicknessSm}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    <Setter Property="Margin" Value="{theme:Edges Horizontal={theme:SpacingLg}, Vertical={theme:SpacingMd}}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The divider line between command groups -->
        <Border x:Name="PART_SeparatorBorder"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                MinHeight="{TemplateBinding MinHeight}" />
      </ControlTemplate>
    </Setter>

    <!-- Template element styles -->
    <Style Selector="^ /template/ Border#PART_SeparatorBorder">
      <Setter Property="Background" Value="{theme:AccentBorderBrush}" />
    </Style>

    <!-- IsInOverflow: horizontal separator -->
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="{theme:ThicknessSm}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="{theme:Edges All={theme:SpacingMd}}" />
    </Style>
  </ControlTheme>

  <!-- CommandBar ControlTheme -->
  <!-- ============================================================
       Sub-theme: the overflow button

       PART_ContentPresenter is inside the Button's own template, so its states cannot be reached from
       the CommandBar theme — that would be two /template/ hops, which Avalonia rejects when the theme
       is built. They belong to a Button theme, applied to PART_OverflowButton below.
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCommandBarOverflowButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar">
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightLg}" />
    <Setter Property="Padding" Value="{theme:Edges Left={theme:SpacingMd}, Right={theme:SpacingMd}}" />
    <Setter Property="ItemWidthBottom" Value="{theme:Scaled Value={theme:ControlHeightMd}, By=2}" />
    <Setter Property="ItemWidthRight" Value="{theme:Scaled Value={theme:ControlHeightMd}, By=2.5}" />
    <Setter Property="ItemWidthCollapsed" Value="{theme:ControlHeightMd}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the whole bar -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{TemplateBinding MinHeight}">
          <!-- Layout root stacking the bar and its overflow -->
          <Panel>
            <!-- Places content left, commands and overflow right -->
            <DockPanel KeyboardNavigation.TabNavigation="Cycle">
              <!-- Overflow button (docked right) -->
              <Button x:Name="PART_OverflowButton"
                      DockPanel.Dock="Right"
                      VerticalAlignment="Stretch"
                      IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                <!-- The three dots opening the overflow menu -->
                <PathIcon x:Name="PART_OverflowIcon"
                          Foreground="{TemplateBinding Foreground}"
                          Data="M6,10A2,2 0 0,0 4,12A2,2 0 0,0 6,14A2,2 0 0,0 8,12A2,2 0 0,0 6,10M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M18,10A2,2 0 0,0 16,12A2,2 0 0,0 18,14A2,2 0 0,0 20,12A2,2 0 0,0 18,10Z" />
              </Button>

              <!-- Custom content area (docked left) -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center" />

              <!-- Primary commands (fills remaining space, right-aligned) -->
              <ItemsControl x:Name="PART_PrimaryCommands"
                            ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Lays the visible commands out in a row -->
                    <StackPanel x:Name="PART_PrimaryPanel" Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>

            <!-- Overflow popup -->
            <Popup x:Name="PART_OverflowPopup"
                   IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding #PART_OverflowButton}"
                   Placement="Bottom"
                   IsLightDismissEnabled="True"
                   WindowManagerAddShadowHint="True">
              <!-- Panel behind the overflow menu -->
              <Border x:Name="PART_OverflowBorder">
                <!-- Commands that did not fit on the bar -->
                <ItemsControl x:Name="PART_OverflowPresenter"
                              ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <!-- Stacks the overflow commands vertically -->
                      <StackPanel x:Name="PART_OverflowPanel" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Template element styles -->
    <Style Selector="^ /template/ Button#PART_OverflowButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{theme:Edges Left={theme:SpacingXxl}, Right={theme:SpacingXxl}}" />
      <Setter Property="MinWidth" Value="{theme:ControlHeightMd}" />
      <Setter Property="FontSize" Value="{theme:IconSize}" />
      <Setter Property="Theme" Value="{StaticResource PrototypeCommandBarOverflowButton}" />
    </Style>

    <Style Selector="^ /template/ PathIcon#PART_OverflowIcon">
      <Setter Property="Width" Value="{theme:IconSize}" />
      <Setter Property="Height" Value="{theme:IconSize}" />
    </Style>

    <Style Selector="^ /template/ Border#PART_OverflowBorder">
      <Setter Property="Background" Value="{theme:SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{theme:AccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
      <Setter Property="CornerRadius" Value="{theme:RadiusMd}" />
      <Setter Property="Padding" Value="{theme:Edges All={theme:SpacingMd}}" />
      <Setter Property="MinWidth" Value="160" />
    </Style>

    <Style Selector="^ /template/ StackPanel#PART_PrimaryPanel">
      <Setter Property="Spacing" Value="{theme:SpacingSm}" />
    </Style>

    <Style Selector="^ /template/ StackPanel#PART_OverflowPanel">
      <Setter Property="Spacing" Value="{theme:SpacingSm}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
