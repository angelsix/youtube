<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors">
  <!-- Two identical panes, the second flipped into a dark region; each presents an independent
       instantiation of the caller's template -->
  <ControlTheme x:Key="{x:Type p:LightDarkPreview}" TargetType="p:LightDarkPreview">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}">
          <!-- Light -->
          <Border Padding="20" Background="{color:SurfaceDefaultBrush}">
            <StackPanel Spacing="10">
              <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Light'}" />
              <ContentControl ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
            </StackPanel>
          </Border>

          <!-- Dark -->
          <Border Padding="20" theme:ThemeRegion.IsDark="True" Background="{color:SurfaceDefaultBrush}">
            <StackPanel Spacing="10">
              <Label Content="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}, StringFormat='{}{0} - Dark'}" />
              <ContentControl ContentTemplate="{Binding PaneContentTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=p:LightDarkPreview}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
