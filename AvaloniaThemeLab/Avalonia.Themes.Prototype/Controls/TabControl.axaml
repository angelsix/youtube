<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Written once as a template: each pane (light + dark) instantiates its own copy -->
      <prototype:LightDarkPreview Title="TabControl States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Spacing="20">
            <!-- Every state and accent hue composed into one strip; the selected tab feeds the page below -->
            <TabControl>
              <TabItem Header="Home" IsSelected="True">
                <Border Background="{color:OverlayWeakBrush}" Height="90" CornerRadius="{size:RadiusSm}">
                  <TextBlock Text="Selected page content" Foreground="{color:TextDefault}"
                             FontSize="{size:FontSizeMd}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </TabItem>
              <TabItem Header="Hover" theme:Preview.State="Hover" theme:Accent.Kind="Warning" />
              <TabItem Header="Pressed" theme:Preview.State="Pressed" theme:Accent.Kind="Success" />
              <!-- The theme defines no :focus selector for tabs, so Focused renders identically to Rest -->
              <TabItem Header="Off" IsEnabled="False" />
              <TabItem Header="Rest" />
            </TabControl>

            <!-- Left and Right mirror the vertical-strip layout; Bottom shares Top's geometry so it is omitted -->
            <StackPanel Orientation="Horizontal" Spacing="20">
              <TabControl TabStripPlacement="Left" Height="120">
                <TabItem Header="A" IsSelected="True">
                  <TextBlock Text="Page A" Foreground="{color:TextDefault}" />
                </TabItem>
                <TabItem Header="B" />
              </TabControl>
              <TabControl TabStripPlacement="Right" Height="120">
                <TabItem Header="C" IsSelected="True">
                  <TextBlock Text="Page C" Foreground="{color:TextDefault}" />
                </TabItem>
                <TabItem Header="D" />
              </TabControl>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the tabs and page -->
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                VerticalAlignment="{TemplateBinding VerticalAlignment}">
          <!-- Docks the tab strip against the page -->
          <DockPanel>
            <!-- The row of tabs -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            DockPanel.Dock="{TemplateBinding TabStripPlacement}" />
            <!-- Layout root cross-fading between pages -->
            <Panel ClipToBounds="True">
              <!-- The outgoing page, during a transition -->
              <ContentPresenter Name="PART_SelectedContentHost2"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="False" />
              <!-- The selected tab's page -->
              <ContentPresenter Name="PART_SelectedContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- TabStripPlacement orientation -->
    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>

    <!-- TabStripPlacement spacing -->
    <Style Selector="^[TabStripPlacement=Top] /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingSm}}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
