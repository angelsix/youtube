<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
    xmlns:color="using:AngelSix.ThemeEngine.Colors"
    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Shared state column written once as a template; each pane instantiates its own copy -->
      <prototype:LightDarkPreview Title="TabStripItem States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Orientation="Vertical" Spacing="16">
            <TabStripItem>Unselected</TabStripItem>
            <TabStripItem IsSelected="True">Selected</TabStripItem>
            <TabStripItem theme:Preview.State="Hover">Hover</TabStripItem>
            <TabStripItem IsSelected="True" theme:Preview.State="Hover">Selected · Hover</TabStripItem>
            <TabStripItem theme:Preview.State="Pressed">Pressed</TabStripItem>
            <TabStripItem IsEnabled="False">Disabled</TabStripItem>
            <TabStripItem theme:Accent.Kind="Warning">Warning</TabStripItem>
            <TabStripItem IsSelected="True" theme:Accent.Kind="Success">Success · Selected</TabStripItem>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>


  <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem">
    <Setter Property="FontSize" Value="{size:FontSizeXxl}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:DimTextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="{size:ControlHeightLg}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the tab -->
        <Border
            Name="PART_LayoutRoot"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
          <!-- Layout root stacking the pipe over the label -->
          <Panel>
            <!-- The tab's label -->
            <ContentPresenter
                Name="PART_ContentPresenter"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- Bar marking the selected tab -->
            <Border Name="PART_SelectedPipe"
                    IsVisible="False"
                    VerticalAlignment="Bottom"/>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!--  Selected state  -->
    <!-- Leaves PART_LayoutRoot unselected so TabStripItem.Background can override it -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^ /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{color:AccentPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
      <Setter Property="Height" Value="{size:SpacingSm}" />
      <Setter Property="Margin" Value="{size:Edges Bottom={size:SpacingSm}}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--  PointerOver state  -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot, ^[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light2}" />
    </Style>

    <!--  Selected PointerOver state  -->
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot, ^:selected[(theme|Preview.State)=Hover] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light2}" />
    </Style>

    <!--  Pressed state  -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot, ^[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light2}" />
    </Style>

    <!--  Selected Pressed state  -->
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot, ^:selected[(theme|Preview.State)=Pressed] /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light2}" />
    </Style>

    <!--  Disabled state  -->
    <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{color:AccentBrush Light2}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
