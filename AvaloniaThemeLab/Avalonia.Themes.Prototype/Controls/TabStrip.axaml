<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- One strip mixing every state the theme paints; written once as a template so each pane instantiates its own copy -->
      <prototype:LightDarkPreview Title="Tab Strip States" Orientation="Vertical">
        <DataTemplate>
          <TabStrip>
            <!-- Baseline: DimTextDefault label, no pipe -->
            <TabStripItem>Plain</TabStripItem>
            <!-- :selected reveals the accent-colored pipe under the label -->
            <TabStripItem IsSelected="True">Selected</TabStripItem>
            <!-- :disabled recolors the label to the accent Light2 tint, like the hover/pressed branches -->
            <TabStripItem IsEnabled="False">Disabled</TabStripItem>
            <!-- Non-default hues: the pipe resolves {color:AccentPrimaryBrush} against each item's Accent.Kind -->
            <TabStripItem IsSelected="True" theme:Accent.Kind="Warning">Warn</TabStripItem>
            <TabStripItem IsSelected="True" theme:Accent.Kind="Success">Ok</TabStripItem>
          </TabStrip>
        </DataTemplate>
      </prototype:LightDarkPreview>

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:SpacingSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the strip -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- The row of tabs -->
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Items panel -->
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
