<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Presented directly (not via right-click) so the framed surface shows statically; one list mixes icon, checkbox, separator and :disabled -->
      <prototype:LightDarkPreview Title="ContextMenu States" Orientation="Horizontal">
        <DataTemplate>
          <ContextMenu Width="240">
            <MenuItem Header="Standard _Item" />
            <MenuItem Header="With _Icon">
              <MenuItem.Icon>
                <TextBlock>😊</TextBlock>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="With _Checkbox">
              <MenuItem.Icon>
                <CheckBox BorderThickness="0"
                          IsHitTestVisible="False"
                          IsChecked="True" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Disabled" IsEnabled="False" />
          </ContextMenu>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="MaxWidth" Value="456" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Panel behind the menu -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                MaxWidth="{TemplateBinding MaxWidth}"
                MinHeight="{TemplateBinding MinHeight}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Scrolls the menu when it overflows -->
          <ScrollViewer Theme="{StaticResource PrototypeMenuScrollViewer}">
            <!-- The menu entries -->
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"
                            Grid.IsSharedSizeScope="True" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Template element styles -->
    <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="{size:Edges Vertical={size:SpacingSm}}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
