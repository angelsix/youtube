<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <StackPanel>
      <StackPanel.Styles>
        <prototype:PrototypeTheme />
      </StackPanel.Styles>
      <PathIcon Data="{icons:Star}" />
    </StackPanel>
  </Design.PreviewWith>
  <!-- ============================================================
       ControlTheme: {x:Type PathIcon}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">

    <!-- Visual defaults (Foreground is deliberately unset: it inherits, so an icon takes its container's colour) -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{size:IconSize}" />
    <Setter Property="Width" Value="{size:IconSize}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The icon's background area -->
        <Border Background="{TemplateBinding Background}">
          <!-- Scales the glyph to the requested size -->
          <Viewbox Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
            <!-- The icon artwork -->
            <Path Fill="{TemplateBinding Foreground}" Data="{TemplateBinding Data}" Stretch="Uniform" />
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
