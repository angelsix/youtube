<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="0" Background="{theme:SurfaceBrush}">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <NotificationCard Content="Testing" />
    </Border>
  </Design.PreviewWith>
  <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Width" Value="{theme:Scaled Value={theme:ControlMinWidth}, By=5}"/>
    <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,75%"/>
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
          <Panel>
            <Border x:Name="PART_ShadowBorder"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"/>
            <Border x:Name="PART_OuterBorder"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      ClipToBounds="True">
                <DockPanel>
                  <Panel x:Name="PART_HeaderBar" DockPanel.Dock="Top" />
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </DockPanel>
              </Border>
            </Border>
          </Panel>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>

    <ControlTheme.Animations>
      <Animation Duration="0:0:0.45" Easing="QuadraticEaseIn" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="TranslateTransform.Y" Value="20"/>
          <Setter Property="ScaleTransform.ScaleX" Value="0.85"/>
          <Setter Property="ScaleTransform.ScaleY" Value="0.85"/>
        </KeyFrame>
        <KeyFrame Cue="30%">
          <Setter Property="TranslateTransform.Y" Value="-20"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="TranslateTransform.Y" Value="0"/>
          <Setter Property="ScaleTransform.ScaleX" Value="1"/>
          <Setter Property="ScaleTransform.ScaleY" Value="1"/>
        </KeyFrame>
      </Animation>
    </ControlTheme.Animations>

    <Style Selector="^[IsClosing=true] /template/ LayoutTransformControl#PART_LayoutTransformControl">
      <Setter Property="RenderTransformOrigin" Value="50%,0%"/>
      <Style.Animations>
        <Animation Duration="0:0:0.75" Easing="QuadraticEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0"/>
            <Setter Property="ScaleTransform.ScaleY" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="TranslateTransform.X" Value="800"/>
            <Setter Property="ScaleTransform.ScaleY" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleY" Value="0"/>
            <Setter Property="TranslateTransform.X" Value="800"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:1.25" Easing="QuadraticEaseOut" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^:information /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{theme:AccentInfoBrush}"/>
    </Style>
    <Style Selector="^:success /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{theme:AccentSuccessBrush}"/>
    </Style>
    <Style Selector="^:warning /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{theme:AccentWarningBrush}"/>
    </Style>
    <Style Selector="^:error /template/ Panel#PART_HeaderBar">
      <Setter Property="Background" Value="{theme:AccentErrorBrush}"/>
    </Style>

    <!-- Shadow border (elevation behind card) -->
    <Style Selector="^ /template/ Border#PART_ShadowBorder">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
      <Setter Property="Margin" Value="{theme:Edges Left={theme:SpacingLg}, Top={theme:SpacingLg}, Right={theme:SpacingLg}, Bottom={theme:SpacingXxl}}" />
    </Style>

    <!-- Outer border margin (offset from edge for shadow visibility) -->
    <Style Selector="^ /template/ Border#PART_OuterBorder">
      <Setter Property="Margin" Value="{theme:Edges Left={theme:SpacingLg}, Top={theme:SpacingLg}, Right={theme:SpacingLg}, Bottom={theme:SpacingXxl}}" />
    </Style>

    <!-- Header bar default (height and neutral background) -->
    <Style Selector="^ /template/ Panel#PART_HeaderBar">
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Background" Value="{theme:OnSurfaceDimBrush}" />
    </Style>

    <!-- Content presenter minimum height -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="MinHeight" Value="{theme:Scaled Value={theme:ControlHeightMd}, By=2}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
