<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <ControlTheme x:Key="{x:Type PopupRoot}" TargetType="PopupRoot">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="TransparencyLevelHint" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="FontSize" Value="{size:FontSizeMd}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="FontStyle" Value="Normal" />
    <Setter Property="Inline.TextDecorations" Value="" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Applies the popup's own scaling and rotation -->
        <LayoutTransformControl LayoutTransform="{TemplateBinding Transform}">
          <!-- Layout root stacking the fallback behind the content -->
          <Panel>
            <!-- Opaque fill used when transparency is unavailable -->
            <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
            <!-- Hosts overlays such as tooltips and adorners -->
            <VisualLayerManager Name="PART_VisualLayerManager">
              <!-- The popup's content -->
              <ContentPresenter Name="PART_ContentPresenter"
                                Background="{TemplateBinding Background}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}" />
            </VisualLayerManager>
          </Panel>
        </LayoutTransformControl>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
