<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <GroupBox Padding="10" Margin="10">
        <TextBlock Text="Hello World" />
      </GroupBox>
    </Border>
  </Design.PreviewWith>

  <!-- Border gap mask converter (GroupBox-specific: creates the header notch cutout) -->
  <converters:BorderGapMaskConverter x:Key="BorderGapMaskConverter" />

  <!-- ============================================================
       ControlTheme: {x:Type GroupBox}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type GroupBox}"
                TargetType="GroupBox">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="FontSize" Value="{size:FontSizeLg}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Gap of 6 for the header notch mask (structural — BorderGapMaskConverter requirement) -->
        <Grid x:Name="RootGrid" UseLayoutRounding="true" ColumnDefinitions="6,Auto,*,6" RowDefinitions="Auto,Auto,*,6">
          <!-- Background border (separate from stroke border so the opacity mask does not clip the background) -->
          <Border Grid.Row="1"
                  Grid.RowSpan="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="Transparent"
                  Background="{TemplateBinding Background}" />

          <!-- Stroke border with opacity mask for the header notch -->
          <Border Grid.Row="1"
                  Grid.RowSpan="3"
                  Grid.ColumnSpan="4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <Border.OpacityMask>
              <MultiBinding Converter="{StaticResource BorderGapMaskConverter}"
                            ConverterParameter="6">
                <Binding ElementName="Header"
                         Path="Bounds.Width" />
                <Binding RelativeSource="{RelativeSource Self}"
                         Path="Bounds.Width" />
                <Binding RelativeSource="{RelativeSource Self}"
                         Path="Bounds.Height" />
              </MultiBinding>
            </Border.OpacityMask>
          </Border>

          <!-- Header -->
          <Border x:Name="Header"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="1">
            <!-- The group's title -->
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              UseLayoutRounding="{TemplateBinding UseLayoutRounding}" />
          </Border>

          <!-- Content -->
          <ContentPresenter Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            UseLayoutRounding="{TemplateBinding UseLayoutRounding}"
                            Margin="{TemplateBinding Padding}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Header padding and typography -->
    <Style Selector="^ /template/ Border#Header">
      <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}}" />
    </Style>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
