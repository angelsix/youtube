<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:colour="using:AngelSix.ThemeEngine.Colours"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <Calendar DisplayDate="2000-01-01">
        <Calendar.BlackoutDates>
          <CalendarDateRange>
            <x:Arguments>
              <sys:DateTime>2000-01-01</sys:DateTime>
              <sys:DateTime>2000-01-05</sys:DateTime>
            </x:Arguments>
          </CalendarDateRange>
        </Calendar.BlackoutDates>
      </Calendar>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: PrototypeCalendarButton (internal nav button)
       ============================================================ -->
  <ControlTheme x:Key="PrototypeCalendarButton" TargetType="Button">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The month or year name on the header button -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarItem}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges All={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <!-- HorizontalContentAlignment and VerticalContentAlignment not on CalendarItem -->

    <!-- Day title template -->
    <Setter Property="DayTitleTemplate">
      <Template x:DataType="x:String">
        <TextBlock Text="{Binding}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="{size:FontSizeSm}" />
      </Template>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the whole calendar -->
        <Border BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Verbose, not the RowDefinitions shorthand: a leading '{' makes Avalonia evaluate the whole
               attribute as one markup extension, which yields a Binding and throws converting it to
               RowDefinitions. The per-row Height binds correctly. -->
          <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="{size:ControlHeightMd}" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Header row: month name and the two arrows -->
            <Grid ColumnDefinitions="5*,*,*">
              <!-- Switches between day, month and year views -->
              <Button Name="PART_HeaderButton"
                      Theme="{StaticResource PrototypeCalendarButton}"
                      Foreground="{TemplateBinding Foreground}"
                      HorizontalContentAlignment="Left" />
              <!-- Goes to the previous month or year -->
              <Button Name="PART_PreviousButton"
                      Grid.Column="1"
                      Theme="{StaticResource PrototypeCalendarButton}"
                      Foreground="{TemplateBinding Foreground}"
                      HorizontalContentAlignment="Center">
                <!-- The back arrow -->
                <Path Name="PART_PreviousArrow"
                      Data="{icons:ChevronUp}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Button>
              <!-- Goes to the next month or year -->
              <Button Name="PART_NextButton"
                      Grid.Column="2"
                      Theme="{StaticResource PrototypeCalendarButton}"
                      Foreground="{TemplateBinding Foreground}"
                      HorizontalContentAlignment="Center">
                <!-- The forward arrow -->
                <Path Name="PART_NextArrow"
                      Data="{icons:ChevronDown}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Button>
            </Grid>
            <!-- Tint behind the day grid -->
            <Border Name="BackgroundLayer"
                    Background="{TemplateBinding BorderBrush}"
                    IsVisible="{Binding #PART_MonthView.IsVisible}"
                    Grid.Row="1" />
            <!-- The grid of days for the month -->
            <Grid Name="PART_MonthView"
                  Grid.Row="1"
                  IsVisible="False" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <!-- Verbose for the same reason as above: the first row's height is a markup extension. -->
              <Grid.RowDefinitions>
                <RowDefinition Height="{size:ControlHeightMd}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            </Grid>
            <!-- The grid of months or years to pick from -->
            <Grid Name="PART_YearView"
                  Background="{TemplateBinding BorderBrush}"
                  Grid.Row="1"
                  IsVisible="False" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*">
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Header button -->
    <Style Selector="^ /template/ Button#PART_HeaderButton">
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}}" />
    </Style>

    <!-- Nav buttons -->
    <Style Selector="^ /template/ Button#PART_PreviousButton, ^ /template/ Button#PART_NextButton">
      <Setter Property="Padding" Value="{size:Edges All={size:BaseSize}}" />
    </Style>

    <!-- Nav arrows -->
    <Style Selector="^ /template/ Path#PART_PreviousArrow, ^ /template/ Path#PART_NextArrow">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light2}" />
      <Setter Property="StrokeThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Background layer -->
    <Style Selector="^ /template/ Border#BackgroundLayer">
      <Setter Property="Margin" Value="{size:Edges Top={size:ControlHeightMd}}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^ /template/ Button:pointerover > Path">
      <Setter Property="Stroke" Value="{colour:AccentBrush Dark1}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^ /template/ Button:pressed > Path">
      <Setter Property="Stroke" Value="{colour:AccentBrush Light2}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
