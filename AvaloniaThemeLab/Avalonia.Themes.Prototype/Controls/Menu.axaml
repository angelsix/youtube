<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- One bar mixes every top-level state the theme paints (:selected overlay, :disabled dimming, separator); hover/press need a live pointer -->
      <prototype:LightDarkPreview Title="Menu States" Orientation="Horizontal">
        <DataTemplate>
          <Menu>
            <MenuItem Header="_Standard" />
            <MenuItem Header="_Selected" IsSelected="True" />
            <Separator />
            <MenuItem Header="_Disabled" IsEnabled="False" />
          </Menu>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>


  <ControlTheme x:Key="PrototypeTopLevelMenuItem" TargetType="MenuItem">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <!-- Narrow padding for mouse; widen for touch input later -->
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the top-level menu item -->
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- Layout root stacking the item and its popup -->
          <Panel>
            <!-- The menu item's label -->
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Margin="{TemplateBinding Padding}"/>
            <!-- The submenu shown when opened -->
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="BottomEdgeAlignedLeft"
                   OverlayInputPassThroughElement="{Binding $parent[Menu]}">
              <!-- Panel behind the submenu -->
              <Border x:Name="PART_PopupBorder"
                      MaxWidth="456"
                      HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                <!-- Scrolls the submenu when it overflows -->
                <ScrollViewer Theme="{StaticResource PrototypeMenuScrollViewer}">
                  <!-- The submenu entries -->
                  <ItemsPresenter x:Name="PART_PopupItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Grid.IsSharedSizeScope="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalContentAlignment}" />
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>

    <!-- Popup border and items presenter theming -->
    <Style Selector="^ /template/ Border#PART_PopupBorder">
      <Setter Property="Background" Value="{color:BackgroundDefault}" />
      <Setter Property="BorderBrush" Value="{color:BorderDefault}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
      <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    </Style>
    <Style Selector="^ /template/ ItemsPresenter#PART_PopupItemsPresenter">
      <Setter Property="Margin" Value="{size:Edges Vertical={size:SpacingMd}}" />
    </Style>

    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{color:OverlayWeakBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      </Style>
    </Style>

    <!-- Uses PART_LayoutRoot:pointerover so subitem presses do not trigger it -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{color:HoverBackgroundDefault}" />
      <Style Selector="^ ContentPresenter#PART_HeaderPresenter">
      </Style>
    </Style>

    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{color:DimTextDefault}" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource PrototypeTopLevelMenuItem}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the menu bar -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                Padding="{TemplateBinding Padding}">
          <!-- The top-level menu items -->
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Inner element alignment theming (Rule 12) -->
    <Style Selector="^ /template/ Border">
      <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    </Style>
    <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
