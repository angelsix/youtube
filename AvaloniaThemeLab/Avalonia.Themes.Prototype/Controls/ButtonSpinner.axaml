<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        
        <!-- Full width buttons -->
        <StackPanel.Styles>
          <Style Selector="ButtonSpinner">
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
          </Style>
        </StackPanel.Styles>
        
        <ButtonSpinner Content="Right spinner" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left spinner" />
        <!-- Accent hues. The `accent` class opts into the accented look; Accent.Kind picks the
             hue and defaults to Primary, so the first one needs no Kind at all. -->
        <ButtonSpinner theme:Accent.Kind="Primary"
                       Content="Accent (default Primary)" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Accent Warning" theme:Accent.Kind="Warning"/>
        <ButtonSpinner Content="Accent Success" theme:Accent.Kind="Success"/>
        <ButtonSpinner Content="Accent Destructive" theme:Accent.Kind="Destructive"/>

        <!-- Kind inherits, so tinting the panel tints every control beneath it. There is no
             opting out with a class any more: a child either states its own Kind or wears the
             panel's. Only a control outside the scope falls back to Neutral. -->
        <StackPanel theme:Accent.Kind="Subtle" Spacing="20">
          <ButtonSpinner Content="Inherited Subtle" />
          <ButtonSpinner theme:Accent.Kind="Primary" Content="Overrides to Primary" />
        </StackPanel>

        <ButtonSpinner Content="Right disabled"
                       AllowSpin="False"/>
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left disabled"
                       AllowSpin="False" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Fully disabled"
                       IsEnabled="False" />
        <ButtonSpinner ShowButtonSpinner="False"
                       Content="Hide spinner" />
        <ButtonSpinner Content="Error">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Error</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
        </ButtonSpinner>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="PrototypeButtonSpinnerRepeatButton" TargetType="RepeatButton">

    <!-- Visual defaults -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <!-- Theme Exception: Stretch required to make spinner button hover effects full height -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template: deliberately not BasedOn the RepeatButton theme, whose state backgrounds and MinWidth
         do not apply to a spinner chevron. Without this the buttons fall back to Avalonia's built-in template. -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The chevron icon -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Pressed state (state colours live on the ButtonSpinner theme, which knows whether it is accent) -->
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type ButtonSpinner}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">

    <!-- Visual defaults -->
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}}" />
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Focusable" Value="True"/>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Validation error message for the whole control -->
        <DataValidationErrors>
          <!-- Outer frame around the value and its buttons -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <!-- Layout root docking the buttons beside the value -->
            <DockPanel>
              <!-- The stacked up and down buttons -->
              <StackPanel Name="PART_SpinnerPanel"
                          TabIndex="2"
                          DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">

                <!-- Steps the value up, repeating while held -->
                <RepeatButton Name="PART_IncreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}">
                  <PathIcon Data="{icons:ChevronUp}" />
                </RepeatButton>

                <!-- Steps the value down, repeating while held -->
                <RepeatButton Name="PART_DecreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}">
                  <PathIcon Data="{icons:ChevronDown}" />
                </RepeatButton>

              </StackPanel>

              <!-- The value the spinner is stepping -->
              <ContentPresenter Name="PART_ContentPresenter"
                                TabIndex="1"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Background="{TemplateBinding Background}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Spinner button padding -->
    <Style Selector="^ /template/ RepeatButton">
      <Setter Property="Padding" Value="{size:Edges All={size:SpacingXl}}" />
      <Setter Property="BorderThickness" Value="{size:Edges Left={TemplateBinding BorderThickness}}" />
    </Style>

    <!-- Spinner icon size -->
    <Style Selector="^ /template/ RepeatButton > PathIcon">
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Corner radius: round edge button's outer corners to match control (Border does not clip children) -->
    <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="CornerRadius" Value="{size:Corners Radius={TemplateBinding CornerRadius}, Right=True}" />
    </Style>

    <!-- Hover state — carried by the spinner buttons, deliberately not by the Border.
         Avalonia clears IsPointerOver on the ButtonSpinner when the pointer is released over a disabled
         chevron (AllowSpin=False) and does not restore it until the pointer moves, so a Border hover colour
         flashes back to its rest value on every click. Reproduced on the stock Fluent theme. -->
    <Style Selector="^ /template/ RepeatButton:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{colour:HoverBackgroundDefaultBrush}" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Dark7}" />
    </Style>

    <!-- Hover content area -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:pointerover,
                     ^[(theme|Preview.State)=Hover] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:AccentBrush Light9}" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Dark7}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ^[(theme|Preview.State)=Pressed] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}" />
    </Style>

    <Style Selector="^ /template/ RepeatButton:pressed:not(:disabled)">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ Border">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{colour:AccentErrorBrush}" />
    </Style>
    
    <!-- Accent class. Hue-agnostic: {colour:AccentBrush Light10} resolves against whatever
         prototype:Accent.Kind the control is carrying, so this one block serves every accent
         rather than being copy-pasted once per hue. Accent.Kind inherits, which is what carries
         the hue into the /template/ RepeatButton styles below. -->

    <!-- Left spinner position -->
    <Style Selector="^:left">
      <Style Selector="^ /template/ StackPanel#PART_SpinnerPanel">
        <Setter Property="DockPanel.Dock" Value="Left" />
      </Style>
      <Style Selector="^ /template/ RepeatButton">
        <Setter Property="BorderThickness" Value="{size:Edges Right={TemplateBinding BorderThickness}}" />
      </Style>
      <!-- Corner radius workaround (see above): spinner on the left swaps the edge-touching button. -->
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="CornerRadius" Value="{size:Corners Radius={TemplateBinding CornerRadius}, Left=True}" />
      </Style>
    </Style>

  </ControlTheme>

</ResourceDictionary>
