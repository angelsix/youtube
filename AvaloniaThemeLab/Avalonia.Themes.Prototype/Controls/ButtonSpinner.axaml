<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <ButtonSpinner Content="Right spinner" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left spinner" />
        <ButtonSpinner  Classes="accent"
                        Content="Right Border" />
        <ButtonSpinner ButtonSpinnerLocation="Left" Classes="accent"
                       Content="Left Border" />
        <ButtonSpinner Content="Right disabled"
                       AllowSpin="False"/>
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left disabled"
                       AllowSpin="False" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Fully disabled"
                       IsEnabled="False" />
        <ButtonSpinner ShowButtonSpinner="False"
                       Content="Hide spinner" />
        <ButtonSpinner Content="Error">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Error</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
        </ButtonSpinner>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="PrototypeButtonSpinnerRepeatButton" TargetType="RepeatButton">

    <!-- Visual defaults -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Pressed state (state colours live on the ButtonSpinner theme, which knows whether it is accent) -->
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={theme:PressedScale}}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type ButtonSpinner}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">

    <!-- Visual defaults -->
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingXl}}" />
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{theme:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Focusable" Value="True"/>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <DockPanel>
              <StackPanel Name="PART_SpinnerPanel"
                          TabIndex="2"
                          DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">

                <RepeatButton Name="PART_IncreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}">
                  <PathIcon Data="{icons:ChevronUpGlyph}" />
                </RepeatButton>

                <RepeatButton Name="PART_DecreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}">
                  <PathIcon Data="{icons:ChevronDownGlyph}" />
                </RepeatButton>

              </StackPanel>

              <ContentPresenter Name="PART_ContentPresenter"
                                TabIndex="1"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Background="{TemplateBinding Background}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- Spinner button padding -->
    <Style Selector="^ /template/ RepeatButton">
      <Setter Property="Padding" Value="{theme:Edges All={theme:SpacingXl}}" />
      <Setter Property="BorderThickness" Value="{theme:Edges Left={TemplateBinding BorderThickness}}" />
    </Style>

    <!-- Spinner icon size -->
    <Style Selector="^ /template/ RepeatButton > PathIcon">
      <Setter Property="Height" Value="{theme:IconSize}" />
      <Setter Property="Width" Value="{theme:IconSize}" />
    </Style>

    <!-- Corner radius: round edge button's outer corners to match control (Border does not clip children) -->
    <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="CornerRadius" Value="{theme:Corners Radius={TemplateBinding CornerRadius}, Right=True}" />
    </Style>

    <!-- Hover state — carried by the spinner buttons, deliberately not by the Border.
         Avalonia clears IsPointerOver on the ButtonSpinner when the pointer is released over a disabled
         chevron (AllowSpin=False) and does not restore it until the pointer moves, so a Border hover colour
         flashes back to its rest value on every click. Reproduced on the stock Fluent theme. -->
    <Style Selector="^ /template/ RepeatButton:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>

    <Style Selector="^ /template/ RepeatButton:pressed:not(:disabled)">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ Border">
      <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{theme:AccentErrorBrush}" />
    </Style>
    
    <!-- Accent class -->
    <Style Selector="^.accent">
      <Setter Property="Foreground" Value="{theme:AccentPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{theme:AccentPrimaryBrush}" />
    </Style>

    <!-- Accent hover state -->
    <Style Selector="^.accent:pointerover, ^.accent.previewHover">
      <Setter Property="Background" Value="{theme:AccentHoverOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark1Brush}" />
    </Style>

    <Style Selector="^.accent /template/ RepeatButton:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{theme:AccentHoverOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark1Brush}" />
    </Style>

    <!-- Accent pressed state -->
    <Style Selector="^.accent:pressed, ^.accent.previewPressed">
      <Setter Property="Background" Value="{theme:AccentPressedOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark2Brush}" />
    </Style>

    <Style Selector="^.accent /template/ RepeatButton:pressed:not(:disabled)">
      <Setter Property="Background" Value="{theme:AccentPressedOverlayBrush}" />
      <Setter Property="Foreground" Value="{theme:AccentPrimaryDark2Brush}" />
    </Style>

    <!-- Accent disabled state -->
    <Style Selector="^.accent:disabled">
      <Setter Property="Opacity" Value="{theme:Scaled Value={theme:DisabledOpacity}, By=2}" />
    </Style>

    <!-- Left spinner position -->
    <Style Selector="^:left">
      <Style Selector="^ /template/ StackPanel#PART_SpinnerPanel">
        <Setter Property="DockPanel.Dock" Value="Left" />
      </Style>
      <Style Selector="^ /template/ RepeatButton">
        <Setter Property="BorderThickness" Value="{theme:Edges Right={TemplateBinding BorderThickness}}" />
      </Style>
      <!-- Corner radius workaround (see above): spinner on the left swaps the edge-touching button. -->
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="CornerRadius" Value="{theme:Corners Radius={TemplateBinding CornerRadius}, Left=True}" />
      </Style>
    </Style>

  </ControlTheme>

</ResourceDictionary>
