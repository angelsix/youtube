<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <ButtonSpinner Content="Right spinner" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left spinner" />
        <ButtonSpinner BorderBrush="{theme:AccentPrimaryBrush}"
                       Content="Right Border" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       BorderBrush="{theme:AccentPrimaryBrush}"
                       Content="Left Border" />
        <ButtonSpinner Content="Right disabled"
                       AllowSpin="False"/>
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Left disabled"
                       AllowSpin="False" />
        <ButtonSpinner ButtonSpinnerLocation="Left"
                       Content="Fully disabled"
                       IsEnabled="False" />
        <ButtonSpinner ShowButtonSpinner="False"
                       Content="Hide spinner" />
        <ButtonSpinner Content="Error">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Error</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
        </ButtonSpinner>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <StreamGeometry x:Key="ButtonSpinnerIncreaseButtonIcon">M0,9 L10,0 20,9 19,10 10,2 1,10 z</StreamGeometry>

  <ControlTheme x:Key="PrototypeButtonSpinnerRepeatButton" TargetType="RepeatButton">

    <!-- Visual defaults -->
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="FontSize" Value="{theme:FontSizeMd}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{theme:SurfaceOverlayMediumBrush}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={theme:PressedScale}}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">

    <!-- Visual defaults -->
    <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingXl}}" />
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="FontSize" Value="{theme:FontSizeMd}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{theme:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <DockPanel>
              <StackPanel Name="PART_SpinnerPanel"
                          TabIndex="2"
                          DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
                
                <RepeatButton Name="PART_IncreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              Padding="{theme:Edges All={theme:SpacingXl}}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}">
                  <PathIcon Data="{StaticResource ButtonSpinnerIncreaseButtonIcon}" />
                </RepeatButton>

                <RepeatButton Name="PART_DecreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Theme="{StaticResource PrototypeButtonSpinnerRepeatButton}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{theme:Edges All={theme:SpacingXl}}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}">
                  <PathIcon Data="{StaticResource ButtonSpinnerIncreaseButtonIcon}"
                            RenderTransformOrigin="50%,50%">
                    <PathIcon.RenderTransform>
                      <RotateTransform Angle="180" />
                    </PathIcon.RenderTransform>
                  </PathIcon>
                </RepeatButton>
                
              </StackPanel>

              <ContentPresenter Name="PART_ContentPresenter"
                                Grid.Column="1"
                                TabIndex="1"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}"
                                FontSize="{TemplateBinding FontSize}" />
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ RepeatButton">
      <Setter Property="BorderThickness" Value="{theme:Edges Left={TemplateBinding BorderThickness}}"/>
    </Style>
    <!--
      Workaround for an Avalonia clipping limitation: a Border does not clip its
      child to its CornerRadius (ClipToBounds only ever clips to the rectangular
      bounds), so the edge spinner button's square, opaque background paints over
      the outer Border's rounded corners and squares them off. We can't clip it
      away, so instead we round the matching outer corners of the button that sits
      against the control's edge. Remove this block if Avalonia gains corner-radius
      child clipping on Border.
    -->
    <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="CornerRadius" Value="{theme:Corners Radius={TemplateBinding CornerRadius}, Right=True}"/>
    </Style>
    <Style Selector="^:left">
      <Style Selector="^ /template/ StackPanel#PART_SpinnerPanel">
        <Setter Property="DockPanel.Dock" Value="Left"/>
      </Style>
      <Style Selector="^ /template/ RepeatButton">
        <Setter Property="BorderThickness" Value="{theme:Edges Right={TemplateBinding BorderThickness}}"/>
      </Style>
      <!--
        Workaround (see above): with the spinner on the left, the edge-touching
        button swaps. Square the Decrease button (now mid-control) back off and
        round the Increase button's left corners instead.
      -->
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="CornerRadius" Value="0"/>
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="CornerRadius" Value="{theme:Corners Radius={TemplateBinding CornerRadius}, Left=True}"/>
      </Style>
    </Style>
    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ Border">
      <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
    </Style>

    <!-- Error state -->
    <Style Selector="^:error">
      <Setter Property="BorderBrush" Value="{theme:AccentErrorBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>
    
    
    
  </ControlTheme>

</ResourceDictionary>
