<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours">
  <ControlTheme x:Key="{x:Type ThemeVariantScope}"
                TargetType="ThemeVariantScope">
    <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Dark1}"/>
  </ControlTheme>
</ResourceDictionary>
