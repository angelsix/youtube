<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated">
  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <Setter Property="Background" Value="{theme:AccentBrush Light10}"/>
    <Setter Property="TransparencyBackgroundFallback" Value="{theme:AccentBrush Light10}" />
    <Setter Property="TopLevel.SystemBarColor" Value="{theme:AccentBrush Light10}"/>
    <Setter Property="Foreground" Value="{theme:AccentBrush Dark1}"/>
    <Setter Property="FontSize" Value="{theme:FontSizeMd}"/>
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the surface behind the content -->
        <Panel>
          <!-- Opaque fill used when transparency is unavailable -->
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <!-- The window surface -->
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <!-- Reserves space for the system title bar -->
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <!-- Hosts overlays such as tooltips and adorners -->
          <VisualLayerManager Name="PART_VisualLayerManager">
            <!-- The window's content -->
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
