<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <!-- Canvas colour: SurfaceDefault is the dedicated application-background token — paper seed
         when light, mirrored near-black when dark — so the window tracks the palette without any
         consumer branching on IsDark. -->
    <Setter Property="Background" Value="{colour:SurfaceDefaultBrush}"/>
    <Setter Property="TransparencyBackgroundFallback" Value="{colour:SurfaceDefaultBrush}" />
    <Setter Property="TopLevel.SystemBarColor" Value="{colour:SurfaceDefaultBrush}"/>
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark5}"/>
    <Setter Property="FontSize" Value="{size:FontSizeMd}"/>
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <!-- Window content must fill the client area: the Control* content tokens (Center) would lay
         the content out at its desired size, so a root ScrollViewer or panel could never stretch. -->
    <Setter Property="HorizontalContentAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the surface behind the content -->
        <Panel>
          <!-- Opaque fill used when transparency is unavailable -->
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <!-- The window surface -->
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <!-- Reserves space for the system title bar -->
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <!-- Hosts overlays such as tooltips and adorners -->
          <VisualLayerManager Name="PART_VisualLayerManager">
            <!-- The window's content -->
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
