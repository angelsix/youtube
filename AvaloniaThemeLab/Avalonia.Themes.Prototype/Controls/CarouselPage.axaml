<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="400" Height="300">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <CarouselPage>
        <ContentPage Header="Page 1">
          <TextBlock Text="First page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Page 2">
          <TextBlock Text="Second page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
      </CarouselPage>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type CarouselPage}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CarouselPage}" TargetType="CarouselPage">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingLg}, Vertical={theme:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The swipeable pages -->
        <Carousel Name="PART_Carousel"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  ItemTemplate="{TemplateBinding PageTemplate}"
                  PageTransition="{TemplateBinding PageTransition}"
                  ItemsPanel="{TemplateBinding ItemsPanel}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>

  </ControlTheme>
</ResourceDictionary>
