<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Written once as a template; each pane clones it. Vertical so the paired carousels span full pane width; the theme only branches on ^:disabled -->
      <prototype:LightDarkPreview Title="Carousel States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <!-- Enabled: three slides reveal the clipped viewport and page-slide affordance -->
            <Carousel Width="340" Height="160">
              <Border Margin="8"><Label Content="Slide 1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Margin="8"><Label Content="Slide 2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Margin="8"><Label Content="Slide 3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Carousel>
            <!-- Disabled: exercises the theme's lone state hook (^:disabled -> DisabledOpacity) -->
            <Carousel Width="340" Height="160" IsEnabled="False">
              <Border Margin="8"><Label Content="Slide 1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Margin="8"><Label Content="Slide 2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Border Margin="8"><Label Content="Slide 3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Carousel>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type Carousel}" TargetType="Carousel">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{color:BackgroundDefault}" />
    <Setter Property="Foreground" Value="{color:TextDefault}" />
    <Setter Property="BorderBrush" Value="{color:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingLg}, Vertical={size:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Clipped viewport the pages slide through -->
        <ScrollViewer Name="PART_ScrollViewer"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      BringIntoViewOnFocusChange="False"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
          <!-- The currently visible page -->
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          Margin="{TemplateBinding Padding}"/>
        </ScrollViewer>
      </ControlTemplate>
    </Setter>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>
