<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
      <Setter Property="PreviewContent">
        <Template>
          <Rectangle Fill="{colour:AccentPrimaryBrush}" />
        </Template>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <!-- The draggable bar between two panes -->
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
</ResourceDictionary>
