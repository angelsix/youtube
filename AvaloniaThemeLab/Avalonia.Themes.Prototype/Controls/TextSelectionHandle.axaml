<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Grid>
      <Grid.Styles>
        <prototype:PrototypeTheme />
      </Grid.Styles>
      <Border>
        <Image Stretch="Uniform" HorizontalAlignment="Left"
               Cursor="Arrow"
               Name="PART_HandlePathIcon"
               Height="{size:ControlHeightSm}"
               Source="{DynamicResource TextSelectionHandleDrawing}">
        </Image>
      </Border>
    </Grid>
  </Design.PreviewWith>

  <DrawingImage x:Key="TextSelectionHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextSelectionHandlePath}"
                       Brush="{colour:AccentPrimaryBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{colour:AccentBrush Dark1}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="TextCaretHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextCaretHandlePath}"
                       Brush="{colour:AccentPrimaryBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{colour:AccentBrush Dark1}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <GeometryGroup x:Key="TextSelectionHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16"/>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,16"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>

  <GeometryGroup x:Key="TextCaretHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16">
          <RectangleGeometry.Transform>
            <TransformGroup >
              <RotateTransform CenterX="16"
                               Angle="-45"/>
            </TransformGroup>
          </RectangleGeometry.Transform>
        </RectangleGeometry>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,22.7"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>
  <ControlTheme x:Key="{x:Type TextSelectionHandle}"
                TargetType="TextSelectionHandle">
    <Setter Property="Background"
            Value="{colour:AccentPrimaryBrush}" />
    <Setter Property="HorizontalAlignment"
            Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- Layout root stacking the grip over its hit area -->
          <Grid>
            <!-- Enlarged touch area around the grip -->
            <Border x:Name="PART_HitTarget" IsHitTestVisible="True" Background="Transparent">
              <!-- The grip artwork -->
              <Image Stretch="Uniform"
                     Cursor="Arrow"
                     Name="PART_HandlePathIcon"
                     Source="{DynamicResource TextSelectionHandleDrawing}"/>
            </Border>
            <!-- The line joining the grip to the caret -->
            <Border Background="Transparent"
                    Name="PART_Indicator"
                    HorizontalAlignment="Center"
                    Width="1" 
                    VerticalAlignment="Top" 
                    Height="5"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:caret /template/ Image#PART_HandlePathIcon">
      <Setter Property="Source" Value="{DynamicResource TextCaretHandleDrawing}" />
    </Style>
    <Style Selector="^:start /template/ Image#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1"/>
      </Setter>
    </Style>
    <!-- Theme Exception: indicator alignment is part of the handle's identity (caret=centre, end=left, start=right) — applies to the HorizontalAlignment setter in each of the three styles below. Luke to validate reason -->
    <Style Selector="^:caret /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:end /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ Border#PART_HitTarget">
      <Setter Property="Padding" Value="{size:Edges Bottom={size:SpacingXxl}}" />
    </Style>
    <Style Selector="^ /template/ Image#PART_HandlePathIcon">
      <Setter Property="Height" Value="{size:ControlHeightSm}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
