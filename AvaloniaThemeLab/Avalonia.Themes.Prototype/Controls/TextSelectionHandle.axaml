<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated">
  <Design.PreviewWith>
    <Grid>
      <Grid.Styles>
        <prototype:PrototypeTheme />
      </Grid.Styles>
      <Border>
        <Image Stretch="Uniform" HorizontalAlignment="Left"
               Cursor="Arrow"
               Name="PART_HandlePathIcon"
               Height="{DynamicResource TextSelectHandleSize}"
               Source="{DynamicResource TextSelectionHandleDrawing}">
        </Image>
      </Border>
    </Grid>
  </Design.PreviewWith>
  <x:Double x:Key="TextSelectHandleSize">32</x:Double>

  <DrawingImage x:Key="TextSelectionHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextSelectionHandlePath}"
                       Brush="{theme:AccentPrimaryBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{theme:OnSurfaceBrush}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <DrawingImage x:Key="TextCaretHandleDrawing">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="{DynamicResource TextCaretHandlePath}"
                       Brush="{theme:AccentPrimaryBrush}"
                       >
        <GeometryDrawing.Pen>
          <Pen Thickness="0.5" Brush="{theme:OnSurfaceBrush}" LineJoin="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <GeometryGroup x:Key="TextSelectionHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16"/>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,16"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>

  <GeometryGroup x:Key="TextCaretHandlePath">
    <CombinedGeometry>
      <CombinedGeometry.Geometry1>
        <RectangleGeometry Rect="0,0,16,16">
          <RectangleGeometry.Transform>
            <TransformGroup >
              <RotateTransform CenterX="16"
                               Angle="-45"/>
            </TransformGroup>
          </RectangleGeometry.Transform>
        </RectangleGeometry>
      </CombinedGeometry.Geometry1>
      <CombinedGeometry.Geometry2>
        <EllipseGeometry Center="16,22.7"
                         RadiusX="16"
                         RadiusY="16"/>
      </CombinedGeometry.Geometry2>
    </CombinedGeometry>
  </GeometryGroup>
  <ControlTheme x:Key="{x:Type TextSelectionHandle}"
                TargetType="TextSelectionHandle">
    <Setter Property="Background"
            Value="{theme:AccentPrimaryBrush}" />
    <Setter Property="HorizontalAlignment"
            Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border Padding="0,0,0,10" IsHitTestVisible="True" Background="Transparent">
              <Image Stretch="Uniform"
                     Cursor="Arrow"
                     Name="PART_HandlePathIcon"
                     Height="{DynamicResource TextSelectHandleSize}"
                     Source="{DynamicResource TextSelectionHandleDrawing}"/>
            </Border>
            <Border Background="Transparent"
                    Name="PART_Indicator"
                    HorizontalAlignment="Center"
                    Width="1" 
                    VerticalAlignment="Top" 
                    Height="5"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:caret /template/ Image#PART_HandlePathIcon">
      <Setter Property="Source" Value="{DynamicResource TextCaretHandleDrawing}" />
    </Style>
    <Style Selector="^:start /template/ Image#PART_HandlePathIcon">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="-1" ScaleY="1"/>
      </Setter>
    </Style>
    <Style Selector="^:caret /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:end /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
