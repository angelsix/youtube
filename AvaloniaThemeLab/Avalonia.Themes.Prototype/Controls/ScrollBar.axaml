<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Orientation="Horizontal" Spacing="20">
        <StackPanel Spacing="20">
          <ScrollBar Orientation="Horizontal" AllowAutoHide="False" VerticalAlignment="Center" Width="100"/>
          <ScrollBar Orientation="Horizontal" AllowAutoHide="False" VerticalAlignment="Center" Width="100" IsEnabled="False"/>
          <ScrollBar Orientation="Horizontal" AllowAutoHide="True" VerticalAlignment="Center" Width="100"/>
          <ScrollBar Orientation="Horizontal" AllowAutoHide="True" VerticalAlignment="Center" Width="100" IsEnabled="False"/>
        </StackPanel>
        <ScrollBar Orientation="Vertical" AllowAutoHide="False" HorizontalAlignment="Center" Height="100"/>
        <ScrollBar Orientation="Vertical" AllowAutoHide="False" HorizontalAlignment="Center" Height="100" IsEnabled="False"/>
        <ScrollBar Orientation="Vertical" AllowAutoHide="True" HorizontalAlignment="Center" Height="100"/>
        <ScrollBar Orientation="Vertical" AllowAutoHide="True" HorizontalAlignment="Center" Height="100" IsEnabled="False"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- Transform resources -->
  <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.125) translateX(-2px)</TransformOperations>
  <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.125) translateY(-2px)</TransformOperations>

  <!-- ScrollBar Thumb sub-theme -->
  <ControlTheme x:Key="PrototypeScrollBarThumb" TargetType="Thumb">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light2}"/>
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light2}"/>
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}"/>
    <Setter Property="CornerRadius" Value="{size:RadiusSm}"/>

    <!-- Template -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- The draggable thumb's shape -->
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!-- Transitions -->
    <Setter Property="Transitions">
      <Transitions>
        <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{colour:AccentBrush Light2}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed  /template/ Border">
      <Setter Property="Background" Value="{colour:AccentBrush Light2}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled  /template/ Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- ScrollBar Page Button sub-theme -->
  <ControlTheme x:Key="PrototypeScrollBarPageButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}"/>
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light2}"/>
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}"/>
    <Setter Property="CornerRadius" Value="{size:RadiusSm}"/>
    <Setter Property="VerticalAlignment" Value="{theme:ContainerVerticalAlignment}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Opacity" Value="0" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Invisible click area above or below the thumb -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ScrollBar Line Button sub-theme -->
  <ControlTheme x:Key="PrototypeScrollBarLineButton" TargetType="RepeatButton">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}"/>
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light2}"/>
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}"/>
    <Setter Property="CornerRadius" Value="{size:RadiusSm}"/>
    <Setter Property="Opacity" Value="0" />
    <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Dark1}"/>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The arrow on a line button -->
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          Content="{TemplateBinding Content}"/>
      </ControlTemplate>
    </Setter>

    <!-- Transitions -->
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
      </Transitions>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Dark1}"/>

      <Style Selector="^ /template/ ContentPresenter" >
        <Setter Property="Background" Value="{colour:OverlayWeakBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="TextElement.Foreground" Value="{colour:AccentBrush Light10}"/>

      <Style Selector="^ /template/ ContentPresenter" >
        <Setter Property="Background" Value="{colour:AccentBrush Light2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="TextElement.Foreground" Value="{colour:OverlayWeakBrush}"/>

      <Style Selector="^ /template/ ContentPresenter" >
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- ScrollBar main theme -->
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <!-- Visual defaults -->
    <Setter Property="MinWidth" Value="{size:ControlHeightSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light2}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />

    <!-- Vertical template -->
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Layout root for the vertical scrollbar -->
          <Grid x:Name="Root">
            <!-- The scrollbar's background -->
            <Border x:Name="VerticalRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Stacks the arrows above and below the track -->
              <Grid RowDefinitions="Auto,*,Auto">
                <!-- Track fill that fades in on hover -->
                <Rectangle x:Name="TrackRect"
                           Stroke="Transparent"
                           StrokeThickness="0"
                           Opacity="0"
                           Grid.RowSpan="3">
                  <Rectangle.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    </Transitions>
                  </Rectangle.Transitions>
                </Rectangle>

                <!-- Scrolls up one line -->
                <RepeatButton Name="PART_LineUpButton"
                              HorizontalAlignment="Center"
                              Theme="{StaticResource PrototypeScrollBarLineButton}"
                              Grid.Row="0"
                              Focusable="False"
                              AutomationProperties.Name="Line up">
                  <!-- The up arrow -->
                  <PathIcon x:Name="PART_LineUpIcon"
                            Data="{icons:ChevronUp}"/>
                </RepeatButton>

                <!-- The draggable region between the arrows -->
                <Track Grid.Row="1"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="{TemplateBinding Orientation}"
                       IsDirectionReversed="True">
                  <Track.DecreaseButton>
                    <!-- Jumps a page up when clicked -->
                    <RepeatButton Name="PART_PageUpButton"
                                  Theme="{StaticResource PrototypeScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page up"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <!-- Jumps a page down when clicked -->
                    <RepeatButton Name="PART_PageDownButton"
                                  Theme="{StaticResource PrototypeScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page down"/>
                  </Track.IncreaseButton>
                  <!-- The draggable thumb -->
                  <Thumb x:Name="PART_Thumb"
                         Theme="{StaticResource PrototypeScrollBarThumb}"
                         RenderTransform="{StaticResource VerticalSmallScrollThumbScaleTransform}"
                         RenderTransformOrigin="100%,50%"
                         AutomationProperties.Name="Position"/>
                </Track>

                <!-- Scrolls down one line -->
                <RepeatButton Name="PART_LineDownButton"
                              HorizontalAlignment="Center"
                              Theme="{StaticResource PrototypeScrollBarLineButton}"
                              Grid.Row="2"
                              Focusable="False"
                              AutomationProperties.Name="Line down">
                  <!-- The down arrow -->
                  <PathIcon x:Name="PART_LineDownIcon"
                            Data="{icons:ChevronDown}"/>
                </RepeatButton>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Horizontal template -->
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- Layout root for the horizontal scrollbar -->
          <Grid x:Name="Root">
            <!-- The scrollbar's background -->
            <Border x:Name="HorizontalRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <!-- Stacks the arrows either side of the track -->
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Track fill that fades in on hover -->
                <Rectangle x:Name="TrackRect"
                           Stroke="Transparent"
                           StrokeThickness="0"
                           Opacity="0"
                           Grid.ColumnSpan="3">
                  <Rectangle.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                    </Transitions>
                  </Rectangle.Transitions>
                </Rectangle>

                <!-- Scrolls left one line -->
                <RepeatButton Name="PART_LineUpButton"
                              Theme="{StaticResource PrototypeScrollBarLineButton}"
                              VerticalAlignment="Center"
                              Grid.Column="0"
                              Focusable="False"
                              AutomationProperties.Name="Column left">
                  <!-- The left arrow -->
                  <PathIcon x:Name="PART_LineUpIcon"
                            Data="{icons:ChevronLeft}"/>
                </RepeatButton>

                <!-- The draggable region between the arrows -->
                <Track Grid.Column="1"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="{TemplateBinding Orientation}">
                  <Track.DecreaseButton>
                    <!-- Jumps a page left when clicked -->
                    <RepeatButton Name="PART_PageUpButton"
                                  Theme="{StaticResource PrototypeScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page left"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <!-- Jumps a page right when clicked -->
                    <RepeatButton Name="PART_PageDownButton"
                                  Theme="{StaticResource PrototypeScrollBarPageButton}"
                                  Focusable="False"
                                  AutomationProperties.Name="Page right"/>
                  </Track.IncreaseButton>
                  <!-- The draggable thumb -->
                  <Thumb x:Name="PART_Thumb"
                         Theme="{StaticResource PrototypeScrollBarThumb}"
                         RenderTransform="{StaticResource HorizontalSmallScrollThumbScaleTransform}"
                         RenderTransformOrigin="50%,100%"
                         AutomationProperties.Name="Position"/>
                </Track>

                <!-- Scrolls right one line -->
                <RepeatButton Name="PART_LineDownButton"
                              Theme="{StaticResource PrototypeScrollBarLineButton}"
                              VerticalAlignment="Center"
                              Grid.Column="2"
                              Focusable="False"
                              AutomationProperties.Name="Column right">
                  <!-- The right arrow -->
                  <PathIcon x:Name="PART_LineDownIcon"
                            Data="{icons:ChevronRight}"/>
                </RepeatButton>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Default template element styles — vertical orientation -->
    <Style Selector="^:vertical /template/ Rectangle#TrackRect">
      <Setter Property="Fill" Value="{colour:OverlayWeakBrush}" />
    </Style>
    <Style Selector="^:vertical /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ PathIcon#PART_LineUpIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:vertical /template/ PathIcon#PART_LineDownIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Default template element styles — horizontal orientation -->
    <Style Selector="^:horizontal /template/ Rectangle#TrackRect">
      <Setter Property="Fill" Value="{colour:OverlayWeakBrush}" />
    </Style>
    <Style Selector="^:horizontal /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ PathIcon#PART_LineUpIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
      <Setter Property="Height" Value="{size:IconSizeMd}" />
      <Setter Property="MinWidth" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="MinHeight" Value="{size:IconSizeMd}" />
      <Setter Property="Width" Value="{size:IconSizeMd}" />
    </Style>
    <Style Selector="^:horizontal /template/ PathIcon#PART_LineDownIcon">
      <Setter Property="Width" Value="{size:IconSizeMd}" />
      <Setter Property="Height" Value="{size:IconSizeMd}" />
    </Style>

    <!-- Expanded state -->
    <Style Selector="^[IsExpanded=true]">
      <Style Selector="^ /template/ Grid#Root">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="{colour:OverlayWeakBrush}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{colour:OverlayWeakBrush}" />
        <Setter Property="RenderTransform" Value="none" />
      </Style>
      <Style Selector="^ /template/ RepeatButton">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>
