<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="0">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <ListBox>
        <ListBoxItem IsEnabled="False">Disabled</ListBoxItem>
        <ListBoxItem Background="{colour:OverlayWeakBrush}"
                     Padding="{size:SpacingXxl}">
          Test
        </ListBoxItem>
        <ListBoxItem>Test</ListBoxItem>
      </ListBox>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type ListBoxItem}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXxl}, Top={size:SpacingXl}, Right={size:SpacingXxl}, Bottom={size:SpacingXl}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The item's label -->
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">

      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>

      <!-- Selected unfocused state -->
      <Style Selector="^:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>

      <!-- Selected hover state -->
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>

      <!-- Selected pressed state -->
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
