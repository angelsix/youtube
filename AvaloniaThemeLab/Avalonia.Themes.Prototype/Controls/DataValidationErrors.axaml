<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:collections="using:System.Collections"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- One shared row templated per pane: untouched passthrough beside real error chrome, proving the wrapper themes itself -->
      <prototype:LightDarkPreview Title="DataValidationErrors States" Orientation="Horizontal">
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="32">
            <!-- Clean value: the wrapper renders nothing extra around healthy content -->
            <TextBox Text="Valid" Width="140" />
            <!-- Single error: glyph + message in the error colour beneath the field -->
            <TextBox Text="Invalid" Width="140">
              <DataValidationErrors.Error>
                <sys:Exception>
                  <x:Arguments>
                    <x:String>Value is not valid</x:String>
                  </x:Arguments>
                </sys:Exception>
              </DataValidationErrors.Error>
            </TextBox>
            <!-- Long error: message wraps to two lines without stretching the field -->
            <TextBox Text="Too long" Width="200">
              <DataValidationErrors.Error>
                <sys:Exception>
                  <x:Arguments>
                    <x:String>A much longer validation message that would otherwise stretch the control well beyond its natural width</x:String>
                  </x:Arguments>
                </sys:Exception>
              </DataValidationErrors.Error>
            </TextBox>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type DataValidationErrors}"
                TargetType="DataValidationErrors">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="DataValidationErrors">
        <!-- Layout root stacking the message under the control -->
        <DockPanel LastChildFill="True">
          <!-- Error message shown while the value is invalid -->
          <ContentControl Name="PART_ErrorIndicator"
                          DockPanel.Dock="Bottom"
                          Width="{Binding #PART_ContentPresenter.Bounds.Width}"
                          Content="{Binding (DataValidationErrors.Errors)}"
                          ContentTemplate="{TemplateBinding ErrorTemplate}"
                          DataContext="{TemplateBinding Owner}"
                          IsVisible="{Binding (DataValidationErrors.HasErrors)}" />
          <!-- The control being validated -->
          <ContentPresenter Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- Message spacing -->
    <Style Selector="^ /template/ ContentControl#PART_ErrorIndicator">
      <Setter Property="Margin" Value="{size:Edges Top={size:SpacingMd}}" />
    </Style>

    <!-- Error message: the glyph and the text of each error, in the error colour -->
    <Setter Property="ErrorTemplate">
      <DataTemplate>
        <ItemsControl ItemsSource="{Binding}"
                      x:DataType="collections:IEnumerable"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Foreground="{colour:AccentErrorBrush}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True">
                <PathIcon DockPanel.Dock="Left"
                          Data="{icons:Error}"
                          VerticalAlignment="Top"
                          Width="{size:IconSizeMd}"
                          Height="{size:IconSizeMd}"
                          Margin="{size:Edges Right={size:SpacingMd}}" />
                <TextBlock Text="{Binding Converter={x:Static prototype:ValidationErrorMessageConverter.Instance}}"
                           ToolTip.Tip="{Binding Converter={x:Static prototype:ValidationErrorMessageConverter.Instance}}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
