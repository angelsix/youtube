<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:collections="using:System.Collections"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="The message sits below; the field keeps its own width" />
        <TextBox Text="Sample" />
        <TextBox Text="Sample">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>Value is not valid</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
        </TextBox>
        <TextBox Text="Sample" Width="300">
          <DataValidationErrors.Error>
            <sys:Exception>
              <x:Arguments>
                <x:String>A much longer validation message that would otherwise stretch the control well beyond its natural width</x:String>
              </x:Arguments>
            </sys:Exception>
          </DataValidationErrors.Error>
        </TextBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type DataValidationErrors}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type DataValidationErrors}"
                TargetType="DataValidationErrors">
    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="DataValidationErrors">
        <!-- Layout root stacking the message under the control -->
        <DockPanel LastChildFill="True">
          <!-- The error message, shown below while the value is invalid.
               Width tracks the control so a long message wraps instead of widening it. -->
          <ContentControl Name="PART_ErrorIndicator"
                          DockPanel.Dock="Bottom"
                          Width="{Binding #PART_ContentPresenter.Bounds.Width}"
                          Content="{Binding (DataValidationErrors.Errors)}"
                          ContentTemplate="{TemplateBinding ErrorTemplate}"
                          DataContext="{TemplateBinding Owner}"
                          IsVisible="{Binding (DataValidationErrors.HasErrors)}" />
          <!-- The control being validated -->
          <ContentPresenter Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <!-- Message spacing -->
    <Style Selector="^ /template/ ContentControl#PART_ErrorIndicator">
      <Setter Property="Margin" Value="{size:Edges Top={size:SpacingMd}}" />
    </Style>

    <!-- Error message: the glyph and the text of each error, in the error colour -->
    <Setter Property="ErrorTemplate">
      <DataTemplate>
        <ItemsControl ItemsSource="{Binding}"
                      x:DataType="collections:IEnumerable"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Foreground="{colour:AccentErrorBrush}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True">
                <PathIcon DockPanel.Dock="Left"
                          Data="{icons:Error}"
                          VerticalAlignment="Top"
                          Width="{size:IconSize}"
                          Height="{size:IconSize}"
                          Margin="{size:Edges Right={size:SpacingMd}}" />
                <TextBlock Text="{Binding Converter={x:Static prototype:ValidationErrorMessageConverter.Instance}}"
                           ToolTip.Tip="{Binding Converter={x:Static prototype:ValidationErrorMessageConverter.Instance}}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
