<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:DataType="WindowNotificationManager"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated">
  <ControlTheme x:Key="{x:Type WindowNotificationManager}" TargetType="WindowNotificationManager">
    <Setter Property="Margin" Value="0 0" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Stacks notifications toward the chosen corner -->
        <ReversibleStackPanel Name="PART_Items">
          <ReversibleStackPanel.DataTemplates>
            <DataTemplate DataType="INotification">
              <!-- One notification: its title above its message -->
              <StackPanel
                  Margin="{theme:Edges All={theme:SpacingXxl}}"
                  Spacing="{theme:SpacingXl}"
                  TextElement.Foreground="{theme:OnSurfaceBrush}">
                <!-- The notification's title -->
                <TextBlock Text="{Binding Title}"
                           FontWeight="{theme:FontWeightSemiBold}" />
                <!-- The notification's message -->
                <TextBlock MaxHeight="80"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Margin="{theme:Edges Right={theme:SpacingXxl}}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="x:String">
              <!-- A plain text notification -->
              <TextBlock Text="{Binding}"
                         Margin="{theme:Edges All={theme:SpacingXxl}}"
                         Foreground="{theme:OnSurfaceBrush}" />
            </DataTemplate>
          </ReversibleStackPanel.DataTemplates>
        </ReversibleStackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Theme Exception: :topleft means exactly the top-left corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:topleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Theme Exception: :topright means exactly the top-right corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:topright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Theme Exception: :topcenter means exactly the top-centre corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:topcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Theme Exception: :bottomleft means exactly the bottom-left corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:bottomleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Theme Exception: :bottomright means exactly the bottom-right corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:bottomright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Theme Exception: :bottomcenter means exactly the bottom-centre corner — the literals are the placement itself,
         not a theme layout choice. Applies to both alignment setters in this style. Luke to validate reason -->
    <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
