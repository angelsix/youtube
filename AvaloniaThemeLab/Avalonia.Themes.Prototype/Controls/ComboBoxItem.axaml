<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- The shared state column, written once as a template: each pane instantiates its own copy -->
      <prototype:LightDarkPreview Title="ComboBoxItem States" Orientation="Vertical">
        <DataTemplate>
          <!-- Item states come from item properties only: the theme exposes no Preview.State hooks, so hover/pressed/focus need live interaction -->
          <StackPanel Orientation="Vertical" Spacing="8">
            <ComboBoxItem>Default</ComboBoxItem>
            <ComboBoxItem IsSelected="True">Selected</ComboBoxItem>
            <ComboBoxItem IsEnabled="False">Disabled</ComboBoxItem>
            <ComboBoxItem IsSelected="True" IsEnabled="False">Selected · Disabled</ComboBoxItem>
            <!-- Non-default accent hues ride the generic {colour:AccentPrimaryBrush} selected fill -->
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Warning">Warn</ComboBoxItem>
            <ComboBoxItem IsSelected="True" theme:Accent.Kind="Success">Success</ComboBoxItem>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>

    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       Template
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusMd}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXxl}, Vertical={size:SpacingLg}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The item's label -->
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- PointerOver state -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:HoverBackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">

      <!-- Selected default -->
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <!-- Selected PointerOver state -->
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <!-- Selected Pressed state -->
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <!-- Selected Disabled state -->
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{colour:DimTextDefaultBrush}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
