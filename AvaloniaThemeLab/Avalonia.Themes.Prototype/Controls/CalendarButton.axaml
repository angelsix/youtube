<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <CalendarButton/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:ThicknessSm}, Vertical={size:ThicknessSm}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="MinWidth" Value="{size:ControlHeightMd}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightMd}" />
    <Setter Property="Margin" Value="{size:ThicknessSm}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ClickMode" Value="Release" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the fill and its outline -->
        <Panel>
          <!-- Filled background of the month or year cell -->
          <Border Name="Root" Background="{TemplateBinding Background}"
                  BorderThickness="0" ClipToBounds="True"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- The month or year name -->
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <!-- Outline drawn over the fill, for selection and hover -->
          <Border Name="Border"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="Foreground" Value="{colour:AccentBorderBrush}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{colour:AccentBorderBrush}" />
      </Style>
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark2}" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{colour:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{colour:AccentBrush Light10}" />
        <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
      </Style>
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark1}" />
      </Style>
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>
    </Style>

    <!-- Selected pressed state -->
    <Style Selector="^:selected:pressed">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{colour:AccentBrush Dark2}" />
      </Style>
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{colour:AccentPrimaryBrush}" />
      </Style>
    </Style>

    <!-- Inactive state -->
    <Style Selector="^:inactive">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{colour:OverlayWeakBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      </Style>
    </Style>

    <!-- Blackout state -->
    <Style Selector="^:blackout">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
