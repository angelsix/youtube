<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <CalendarButton/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type CalendarButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontSize" Value="{theme:FontSizeMd}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:ThicknessSm}, Vertical={theme:ThicknessSm}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="MinWidth" Value="{theme:ControlHeightMd}" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightMd}" />
    <Setter Property="Margin" Value="{theme:ThicknessSm}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ClickMode" Value="Release" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Root" Background="{TemplateBinding Background}"
                  BorderThickness="0" ClipToBounds="True"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <Border Name="Border"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={theme:PressedScale}, By=1.07}" />
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{theme:AccentBorderBrush}" />
      </Style>
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={theme:PressedScale}}" />
      <Setter Property="Background" Value="{theme:SurfaceOverlayStrongBrush}" />
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{theme:AccentPrimaryDark2Brush}" />
      </Style>
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{theme:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible">
      <Setter Property="BorderBrush" Value="{theme:AccentFocusBrush}" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{theme:AccentPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{theme:SurfaceBrush}" />
        <Setter Property="FontWeight" Value="{theme:FontWeightSemiBold}" />
      </Style>
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{theme:AccentPrimaryDark1Brush}" />
      </Style>
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      </Style>
    </Style>

    <!-- Selected pressed state -->
    <Style Selector="^:selected:pressed">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{theme:AccentPrimaryDark2Brush}" />
      </Style>
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{theme:AccentPrimaryBrush}" />
      </Style>
    </Style>

    <!-- Inactive state -->
    <Style Selector="^:inactive">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
      </Style>
    </Style>

    <!-- Blackout state -->
    <Style Selector="^:blackout">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{theme:OnSurfaceDimBrush}" />
      </Style>
    </Style>

  </ControlTheme>
</ResourceDictionary>
