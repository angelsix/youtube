<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
  xmlns:theme="using:AngelSix.ThemeEngine.Generated"
  xmlns:colour="using:AngelSix.ThemeEngine.Colours"
  xmlns:size="using:AngelSix.ThemeEngine.Sizes">
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <!-- Structural showcase: the theme paints no Preview.State/:error tokens, so each instance composes the real
           options — bar orientation, AllowAutoHide overlay, enablement, [IsExpanded] corner box, accent hue -->
      <prototype:LightDarkPreview Title="ScrollViewer States" Orientation="Vertical">
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="20">
            <!-- Both bars beside content, enabled, corner hidden: the resting look -->
            <ScrollViewer Width="180" Height="150" Margin="0,0,0,4">
              <Grid ColumnDefinitions="100,100,100" RowDefinitions="60,60,60">
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
              </Grid>
            </ScrollViewer>
            <!-- Bars overlay the content (AllowAutoHide) with a Warning-accented frame -->
            <ScrollViewer Width="180" Height="150" Margin="0,0,0,4" AllowAutoHide="True" theme:Accent.Kind="Warning">
              <Grid ColumnDefinitions="100,100,100" RowDefinitions="60,60,60">
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
              </Grid>
            </ScrollViewer>
            <!-- Disabled: dimmed frame and ghosted bars, still occupying their lanes -->
            <ScrollViewer Width="180" Height="150" Margin="0,0,0,4" IsEnabled="False">
              <Grid ColumnDefinitions="100,100,100" RowDefinitions="60,60,60">
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
              </Grid>
            </ScrollViewer>
            <!-- Success-accented frame. Corner box omitted: the theme keys it off [IsExpanded=true], but
                 ScrollViewer.set_IsExpanded is non-public in Avalonia 12, so the branch cannot fire from markup -->
            <ScrollViewer Width="180" Height="150" Margin="0,0,0,4" theme:Accent.Kind="Success">
              <Grid ColumnDefinitions="100,100,100" RowDefinitions="60,60,60">
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="0" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="1" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="0" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="1" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
                <Rectangle Grid.Column="2" Grid.Row="2" Fill="{colour:OverlayWeakBrush}" Margin="4" />
              </Grid>
            </ScrollViewer>
          </StackPanel>
        </DataTemplate>
      </prototype:LightDarkPreview>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type ScrollViewer}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light2}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingMd}, Vertical={size:SpacingMd}}" />
    <!-- Scrollbars sit beside the content, not over it -->
    <Setter Property="AllowAutoHide" Value="False" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root placing the bars beside the content -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <!-- The scrolling content -->
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Background="{TemplateBinding Background}"
                                  HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                  VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                  HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                  VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                  Padding="{TemplateBinding Padding}"
                                  ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
            <ScrollContentPresenter.GestureRecognizers>
              <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                       CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                       IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"/>
            </ScrollContentPresenter.GestureRecognizers>
          </ScrollContentPresenter>
          <!-- The horizontal scrollbar -->
          <ScrollBar Name="PART_HorizontalScrollBar"
                     Orientation="Horizontal"
                     Grid.Row="1"/>
          <!-- The vertical scrollbar -->
          <ScrollBar Name="PART_VerticalScrollBar"
                     Orientation="Vertical"
                     Grid.Column="1"/>
          <!-- Fills the corner where the two bars meet -->
          <Panel x:Name="PART_ScrollBarsSeparator"
                 Grid.Row="1"
                 Grid.Column="1"
                 Opacity="0">
            <Panel.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
              </Transitions>
            </Panel.Transitions>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Scroll bars separator state -->
    <Style Selector="^[IsExpanded=true] /template/ Panel#PART_ScrollBarsSeparator">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Separator background -->
    <Style Selector="^ /template/ Panel#PART_ScrollBarsSeparator">
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
    </Style>

    <!-- Auto hide mode -->
    <Style Selector="^[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Grid.RowSpan" Value="2" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
