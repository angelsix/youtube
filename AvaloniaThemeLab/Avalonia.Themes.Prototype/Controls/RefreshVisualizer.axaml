<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <ControlTheme x:Key="{x:Type RefreshVisualizer}"
                TargetType="RefreshVisualizer">
    <!-- Visual defaults -->
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background"
            Value="Transparent"/>
    <Setter Property="Foreground"
            Value="{theme:OnSurfaceBrush}"/>
    <Setter Property="Content">
      <Template>
        <PathIcon Name="PART_Icon"
                  Data="{icons:Refresh}"
                  Width="{theme:IconSize}"
                  Height="{theme:IconSize}"
        />
      </Template>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root for the refresh spinner -->
        <Grid Name="PART_Root"
              Background="{TemplateBinding Background}"/>
    </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
