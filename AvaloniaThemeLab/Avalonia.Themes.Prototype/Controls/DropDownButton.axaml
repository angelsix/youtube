<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="DropDownButton States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <DropDownButton Content="Default" />
          <DropDownButton Classes="previewHover" Content="Hover" />
          <DropDownButton Classes="previewPressed" Content="Pressed" />
          <DropDownButton Classes="previewFocused" Content="Focused" />
          <DropDownButton Content="Disabled" IsEnabled="False" />
        </StackPanel>
        <Label Content="Accent States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <DropDownButton theme:Accent.Kind="Primary" Content="Default" />
          <DropDownButton Classes="previewHover" theme:Accent.Kind="Primary" Content="Hover" />
          <DropDownButton Classes="previewPressed" theme:Accent.Kind="Primary" Content="Pressed" />
          <DropDownButton Classes="previewFocused" theme:Accent.Kind="Primary" Content="Focused" />
          <DropDownButton theme:Accent.Kind="Primary" Content="Disabled" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type DropDownButton}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light6}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}, Vertical={size:SpacingLg}}" />
    <Setter Property="MinHeight" Value="{size:ControlHeightSm}" />
    <Setter Property="MinWidth" Value="{size:ControlMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the button and accent outline -->
        <Grid>
          <!-- Outer frame around the button -->
          <Border x:Name="RootBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <!-- Places the arrow right of the label -->
            <Grid ColumnDefinitions="*,Auto">

              <!-- The button's label -->
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Column="0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

              <!-- The arrow marking this as a dropdown -->
              <PathIcon x:Name="DropDown"
                        Grid.Column="1"
                        UseLayoutRounding="False"
                        IsHitTestVisible="False"
                        Data="{icons:DropDown}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

              <!-- Accent border overlay (required: Border lacks StrokeDashArray) -->
              <Rectangle x:Name="PART_AccentBorder"
                         IsVisible="False"
                         IsHitTestVisible="False"
                         Fill="Transparent"
                         StrokeDashArray="3, 2, 6, 2" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Drop-down glyph -->
    <Style Selector="^ /template/ PathIcon#DropDown">
      <Setter Property="Foreground" Value="{colour:AccentBrush Light2}" />
      <Setter Property="Height" Value="{size:IconSize}" />
      <Setter Property="Width" Value="{size:IconSize}" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{size:RadiusSmDouble}" />
      <Setter Property="RadiusY" Value="{size:RadiusSmDouble}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
    </Style>
    <Style Selector="^:pointerover /template/ PathIcon#DropDown, ^.previewHover /template/ PathIcon#DropDown">
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
    </Style>
    <Style Selector="^:pressed /template/ PathIcon#DropDown, ^.previewPressed /template/ PathIcon#DropDown">
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^.previewFocused">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>

  </ControlTheme>
</ResourceDictionary>