<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <PipsPager NumberOfPages="5" SelectedPageIndex="2" />
    </Border>
  </Design.PreviewWith>

  <!-- Icon path data — horizontal arrows -->
  <StreamGeometry x:Key="PipsPagerPreviousPageButtonData">M 8.12,2.29 L 3.41,7.00 C 3.14,7.27 3.14,7.71 3.41,7.98 L 8.12,12.69 C 8.57,13.14 9.33,12.82 9.33,12.19 L 9.33,2.79 C 9.33,2.16 8.57,1.84 8.12,2.29 Z</StreamGeometry>
  <StreamGeometry x:Key="PipsPagerNextPageButtonData">M 3.88,2.29 L 8.59,7.00 C 8.86,7.27 8.86,7.71 8.59,7.98 L 3.88,12.69 C 3.43,13.14 2.67,12.82 2.67,12.19 L 2.67,2.79 C 2.67,2.16 3.43,1.84 3.88,2.29 Z</StreamGeometry>

  <!-- Icon path data — vertical arrows -->
  <StreamGeometry x:Key="PipsPagerPreviousPageButtonVerticalData">M 2.29,8.12 L 7.00,3.41 C 7.27,3.14 7.71,3.14 7.98,3.41 L 12.69,8.12 C 13.14,8.57 12.82,9.33 12.19,9.33 L 2.79,9.33 C 2.16,9.33 1.84,8.57 2.29,8.12 Z</StreamGeometry>
  <StreamGeometry x:Key="PipsPagerNextPageButtonVerticalData">M 2.29,3.88 L 7.00,8.59 C 7.27,8.86 7.71,8.86 7.98,8.59 L 12.69,3.88 C 13.14,3.43 12.82,2.67 12.19,2.67 L 2.79,2.67 C 2.16,2.67 1.84,3.43 2.29,3.88 Z</StreamGeometry>

  <!-- ============================================================
       ControlTheme: PipsPagerNavigationButtonTheme (base)
       ============================================================ -->
  <ControlTheme x:Key="PipsPagerNavigationButtonTheme" TargetType="Button">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{theme:OnSurfaceDimBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <!-- Structural: 24x24 icon button (no matching theme token) -->
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{theme:OnSurfaceDimBrush}" />
    </Style>
  </ControlTheme>

  <!-- Previous button theme -->
  <ControlTheme x:Key="PipsPagerPreviousButtonTheme" TargetType="Button" BasedOn="{StaticResource PipsPagerNavigationButtonTheme}" />

  <!-- Next button theme -->
  <ControlTheme x:Key="PipsPagerNextButtonTheme" TargetType="Button" BasedOn="{StaticResource PipsPagerNavigationButtonTheme}" />

  <!-- ============================================================
       ControlTheme: PipsPagerItemTheme (ListBoxItem)
       ============================================================ -->
  <ControlTheme x:Key="PipsPagerItemTheme" TargetType="ListBoxItem">
    <!-- Visual defaults -->
    <!-- Structural: pip item dimensions (no matching theme token) -->
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Ellipse Name="PipBackground"
                   Width="{theme:IconSize}"
                   Height="{theme:IconSize}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="Transparent"
                   Stroke="Transparent"
                   StrokeThickness="1" />
          <Ellipse Name="Pip"
                   Width="{theme:SpacingMd}"
                   Height="{theme:SpacingMd}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Pip default fill and transitions -->
    <Style Selector="^ /template/ Ellipse#PipBackground">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="{theme:AnimationNormalMs}" />
          <BrushTransition Property="Stroke" Duration="{theme:AnimationNormalMs}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Ellipse#Pip">
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{theme:AnimationNormalMs}" />
          <DoubleTransition Property="Height" Duration="{theme:AnimationNormalMs}" />
          <BrushTransition Property="Fill" Duration="{theme:AnimationNormalMs}" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{theme:ThicknessXxl}" />
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Ellipse#PipBackground">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{theme:SpacingMd}" />
      <Setter Property="Height" Value="{theme:SpacingMd}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#PipBackground">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <!-- Disabled state -->
    <Style Selector="^:disabled /template/ Ellipse#Pip">
      <Setter Property="Fill" Value="{theme:OnSurfaceDimBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#PipBackground">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{theme:ThicknessXxl}" />
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Ellipse#PipBackground">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <!-- Selected hover state -->
    <Style Selector="^:selected:pointerover /template/ Ellipse#Pip">
      <Setter Property="Width" Value="{theme:ThicknessXxl}" />
      <Setter Property="Height" Value="{theme:ThicknessXxl}" />
      <Setter Property="Fill" Value="{theme:OnSurfaceBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Ellipse#PipBackground">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- ============================================================
       ControlTheme: {x:Type PipsPager}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type PipsPager}" TargetType="PipsPager">
    <!-- Visual defaults -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="PreviousButtonTheme" Value="{StaticResource PipsPagerPreviousButtonTheme}" />
    <Setter Property="NextButtonTheme" Value="{StaticResource PipsPagerNextButtonTheme}" />

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Name="PART_RootPanel"
                    Orientation="{TemplateBinding Orientation}"
                    Background="{TemplateBinding Background}"
                    ClipToBounds="False">
          <Button Name="PART_PreviousButton"
                  Theme="{TemplateBinding PreviousButtonTheme}"
                  IsVisible="{TemplateBinding IsPreviousButtonVisible}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
            <PathIcon Name="PreviousButtonIcon"
                      Width="{theme:IconSize}"
                      Height="{theme:IconSize}"
                      Data="{StaticResource PipsPagerPreviousPageButtonData}" />
          </Button>

          <ListBox Name="PART_PipsPagerList"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden"
                   ItemsSource="{Binding TemplateSettings.Pips, RelativeSource={RelativeSource TemplatedParent}}"
                   SelectedIndex="{Binding SelectedPageIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   AutoScrollToSelectedItem="False"
                   ClipToBounds="False"
                   ItemContainerTheme="{StaticResource PipsPagerItemTheme}">
            <ListBox.Styles>
              <Style Selector="ScrollViewer">
                <Setter Property="ClipToBounds" Value="False" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=PipsPager}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <Button Name="PART_NextButton"
                  Theme="{TemplateBinding NextButtonTheme}"
                  IsVisible="{TemplateBinding IsNextButtonVisible}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
            <PathIcon Name="NextButtonIcon"
                      Width="{theme:IconSize}"
                      Height="{theme:IconSize}"
                      Data="{StaticResource PipsPagerNextPageButtonData}" />
          </Button>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Pressed state -->
    <Style Selector="^ /template/ Button#PART_PreviousButton:pressed">
      <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
      <!-- Structural: stronger press scale for small icon buttons -->
      <Setter Property="RenderTransform" Value="scale(0.875)" />
    </Style>
    <Style Selector="^ /template/ Button#PART_NextButton:pressed">
      <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
      <!-- Structural: stronger press scale for small icon buttons -->
      <Setter Property="RenderTransform" Value="scale(0.875)" />
    </Style>

    <!-- Horizontal orientation -->
    <Style Selector="^:horizontal /template/ StackPanel#PART_RootPanel">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- Vertical orientation -->
    <Style Selector="^:vertical /template/ StackPanel#PART_RootPanel">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Structural: vertical pip item dimensions (no matching theme token) -->
    <Style Selector="^:vertical /template/ ListBox ListBoxItem">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="12" />
    </Style>

    <!-- Vertical navigation icons -->
    <Style Selector="^:vertical /template/ Button#PART_PreviousButton PathIcon#PreviousButtonIcon">
      <Setter Property="Data" Value="{StaticResource PipsPagerPreviousPageButtonVerticalData}" />
    </Style>
    <Style Selector="^:vertical /template/ Button#PART_NextButton PathIcon#NextButtonIcon">
      <Setter Property="Data" Value="{StaticResource PipsPagerNextPageButtonVerticalData}" />
    </Style>

    <!-- First page state -->
    <Style Selector="^:first-page /template/ Button#PART_PreviousButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Last page state -->
    <Style Selector="^:last-page /template/ Button#PART_NextButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
