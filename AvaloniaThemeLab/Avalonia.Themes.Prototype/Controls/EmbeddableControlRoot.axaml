<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
  <ControlTheme x:Key="{x:Type EmbeddableControlRoot}" TargetType="EmbeddableControlRoot">
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}"/>
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}"/>
    <Setter Property="TopLevel.SystemBarColor" Value="{colour:BackgroundDefaultBrush}"/>
    <Setter Property="FontSize" Value="{size:FontSizeMd}"/>
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontWeight" Value="{theme:FontWeightRegular}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the fallback behind the content -->
        <Panel>
          <!-- Opaque fill used when transparency is unavailable -->
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <!-- The window surface -->
          <Border Background="{TemplateBinding Background}">
            <!-- Hosts overlays such as tooltips and adorners -->
            <VisualLayerManager Name="PART_VisualLayerManager">
              <!-- The hosted content -->
              <ContentPresenter Name="PART_ContentPresenter"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Content="{TemplateBinding Content}"
                                Margin="{TemplateBinding Padding}"/>
            </VisualLayerManager>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
