<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:colour="using:AngelSix.ThemeEngine.Colours"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:icons="using:AngelSix.ThemeEngine.Icons">
  <Design.PreviewWith>
    <Border Padding="20" Width="200">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <ListBoxItem Theme="{DynamicResource PrototypeDateTimePickerItem}">Standard Item</ListBoxItem>
        <ListBoxItem Theme="{DynamicResource PrototypeDateTimePickerItem}" Classes="MonthItem">Month Item</ListBoxItem>
        <RepeatButton Theme="{DynamicResource PrototypeDateTimePickerButton}">Button</RepeatButton>
        <RepeatButton Theme="{DynamicResource PrototypeDateTimePickerUpButton}" IsVisible="True"/>
        <RepeatButton Theme="{DynamicResource PrototypeDateTimePickerDownButton}" IsVisible="True"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- DateTimePicker item theme -->
  <ControlTheme x:Key="PrototypeDateTimePickerItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Padding" Value="{size:Edges Top={size:SpacingMd}, Bottom={size:SpacingLg}}"/>
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Style Selector="^/template/ Rectangle#PressedBackground">
        <Setter Property="Fill" Value="Transparent"/>
      </Style>
      <Style Selector="^/template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{colour:TextDefaultBrush}"/>
      </Style>
    </Style>

    <!-- Month item: left-aligned -->
    <Style Selector="^.MonthItem">
      <Setter Property="Padding" Value="{size:Edges Left={size:SpacingXl}, Top={size:SpacingMd}, Bottom={size:SpacingLg}}"/>
      <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    </Style>
  </ControlTheme>

  <!-- DateTimePicker button theme -->
  <ControlTheme x:Key="PrototypeDateTimePickerButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}"/>
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Outer frame around the picker item -->
        <Border Background="{TemplateBinding Background}">
          <!-- The item's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  Padding="{TemplateBinding Padding}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Template element defaults -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    </Style>

    <!-- Hover state -->
    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{colour:HoverBackgroundDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{colour:TextDefaultBrush}"/>
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{colour:PressedBackgroundDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{colour:TextDefaultBrush}"/>
    </Style>
  </ControlTheme>

  <!-- DateTimePicker up button theme -->
  <ControlTheme x:Key="PrototypeDateTimePickerUpButton" TargetType="RepeatButton" BasedOn="{StaticResource PrototypeDateTimePickerButton}">
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}"/>
    <Setter Property="Height" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Content">
      <Template>
        <Viewbox Height="{size:IconSizeMd}" Width="{size:IconSizeMd}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Stroke="{Binding $parent[RepeatButton].Foreground}" StrokeThickness="{size:ThicknessSm}" Data="{icons:ChevronUp}"/>
        </Viewbox>
      </Template>
    </Setter>
  </ControlTheme>

  <!-- DateTimePicker down button theme -->
  <ControlTheme x:Key="PrototypeDateTimePickerDownButton" TargetType="RepeatButton" BasedOn="{StaticResource PrototypeDateTimePickerButton}">
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}"/>
    <Setter Property="Height" Value="{size:ControlHeightSm}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ContainerHorizontalAlignment}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{colour:BackgroundDefaultBrush}" />
    <Setter Property="Foreground" Value="{colour:TextDefaultBrush}" />
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Content">
      <Template>
        <Viewbox Height="{size:IconSizeMd}" Width="{size:IconSizeMd}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Stroke="{Binding $parent[RepeatButton].Foreground}" StrokeThickness="{size:ThicknessSm}" Data="{icons:ChevronDown}"/>
        </Viewbox>
      </Template>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
