<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated">
  <Design.PreviewWith>
    <Border Width="400" Height="400">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>
      <TabbedPage>
        <ContentPage Header="Home">
          <TextBlock Text="Home page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Favorites">
          <TextBlock Text="Favorites page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Profile">
          <TextBlock Text="Profile page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
      </TabbedPage>
    </Border>
  </Design.PreviewWith>

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundUnselected" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundSelected" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundUnselectedPointerOver" Color="{theme:SurfaceOverlay}" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundUnselectedPressed" Color="{theme:SurfaceOverlay}" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderBackgroundDisabled" Color="Transparent" />

  <!-- Foregrounds (override via TabbedPageTabItemHeaderForegroundSelected / TabbedPageTabItemHeaderForegroundUnselected resources) -->
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderForegroundUnselected" Color="{theme:OnSurfaceDim}" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderForegroundSelected" Color="{theme:AccentPrimary}" />
  <SolidColorBrush x:Key="TabbedPageTabItemHeaderForegroundDisabled" Color="{theme:OnSurfaceDim}" />


  <!-- Tab item sizing & shape -->

  <!-- Icon + text header layout -->

  <!-- Tab strip (bar) styling -->
  <SolidColorBrush x:Key="TabbedPageTabStripBackground" Color="Transparent" />
  <SolidColorBrush x:Key="TabbedPageTabStripBorderBrush" Color="Transparent" />

  <!-- TabbedPage TabControl theme -->
  <ControlTheme x:Key="TabbedPageTabControlTheme" TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource TabbedPageTabStripBackground}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabbedPageTabStripBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="PART_TabStrip"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Margin="0"
                  Padding="{TemplateBinding Padding}"
                  DockPanel.Dock="{TemplateBinding TabStripPlacement}">
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </Border>
          <Panel ClipToBounds="True">
            <ContentPresenter Name="PART_SelectedContentHost2"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="False" />
            <ContentPresenter Name="PART_SelectedContentHost"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid,
           ^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid">
      <Setter Property="Rows" Value="0" />
      <Setter Property="Columns" Value="1" />
    </Style>
  </ControlTheme>

  <!-- TabbedPage TabItem theme -->
  <ControlTheme x:Key="TabbedPageTabItemTheme" TargetType="TabItem">
    <Setter Property="FontSize" Value="{theme:FontSizeXxl}" />
    <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundUnselected}" />
    <Setter Property="Foreground" Value="{DynamicResource TabbedPageTabItemHeaderForegroundUnselected}" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingXl}, Vertical={theme:SpacingMd}}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="{theme:ControlHeightLg}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />
    <Setter Property="IndicatorTemplate">
      <DataTemplate>
        <Border Background="{Binding $parent[TabItem].Foreground}"
                CornerRadius="0"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Name="PART_HeaderPanel"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter Name="PART_IconPresenter"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}" />
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_SelectedPipe"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding DataContext}"
                            ContentTemplate="{TemplateBinding IndicatorTemplate}"
                            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource TabbedPageTabItemHeaderForegroundSelected}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Placement-specific pipe positioning (structural: indicator aligns to tab strip edge) -->
    <Style Selector="^[TabStripPlacement=Top] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: the selected pipe sits at the bottom edge of the tab when the strip is on top; the literal is the placement, not a theme layout choice. Luke to validate reason -->
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Height" Value="{theme:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: the selected pipe sits at the top edge of the tab when the strip is on the bottom; the literal is the placement, not a theme layout choice. Luke to validate reason -->
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Height" Value="{theme:SpacingSm}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="IndicatorTemplate">
        <DataTemplate>
          <Border Background="{Binding $parent[TabItem].Foreground}"
                  CornerRadius="0"
                  Margin="0"
                  Width="{theme:SpacingSm}"
                  Height="{theme:IconSize}" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: the selected pipe sits at the right edge when the strip is on the right; the literal is the placement, not a theme layout choice. Luke to validate reason -->
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="IndicatorTemplate">
        <DataTemplate>
          <Border Background="{Binding $parent[TabItem].Foreground}"
                  CornerRadius="0"
                  Margin="0"
                  Width="{theme:SpacingSm}"
                  Height="{theme:IconSize}" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedPipe">
      <!-- Theme Exception: the selected pipe sits at the left edge when the strip is on the left; the literal is the placement, not a theme layout choice. Luke to validate reason -->
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    </Style>

    <!-- Pointer-over -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundUnselectedPointerOver}" />
    </Style>

    <!-- Selected + pointer-over -->
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundSelectedPointerOver}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundUnselectedPressed}" />
    </Style>

    <!-- Selected + pressed -->
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundSelectedPressed}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource TabbedPageTabItemHeaderBackgroundDisabled}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TabbedPageTabItemHeaderForegroundDisabled}" />
    </Style>

    <!-- Focus visible -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="{theme:ThicknessMd}" />
    </Style>

    <!-- Themed properties moved out of ControlTemplate -->
    <Style Selector="^ /template/ StackPanel#PART_HeaderPanel">
      <Setter Property="Spacing" Value="{theme:SpacingMd}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Width" Value="{theme:IconSize}" />
      <Setter Property="Height" Value="{theme:IconSize}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="FontSize" Value="{theme:FontSizeSm}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage">
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <TabControl Name="PART_TabControl"
                      Theme="{StaticResource TabbedPageTabControlTheme}"
                      ItemContainerTheme="{StaticResource TabbedPageTabItemTheme}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
