<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel Spacing="20">
        <Label Content="Button States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <Button Content="Default" />
          <Button Classes="previewHover" Content="Hover" />
          <Button Classes="previewPressed" Content="Pressed" />
          <Button Content="Disabled" IsEnabled="False" />
        </StackPanel>
        <Label Content="Accent States" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <Button Classes="accent" Content="Default" />
          <Button Classes="accent previewHover" Content="Hover" />
          <Button Classes="accent previewPressed" Content="Pressed" />
          <Button Classes="accent" Content="Disabled" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type Button}
       Replaces the stock Avalonia Button with a clean token-based
       theme.  Default states: normal, :pointerover, :pressed,
       :disabled.  Additional class: .accent (dashed focus ring).
       ============================================================ -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">

    <!--
      Visual property defaults — all bound to theme tokens so a theme
      swap restyles every button without touching this file.
    -->
    <Setter Property="Background" Value="{theme:SurfaceBrush}" />
    <Setter Property="Foreground" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{theme:OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="{theme:ThicknessSm}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="CornerRadius" Value="{theme:RadiusSm}" />
    <Setter Property="Padding" Value="{theme:Edges Horizontal={theme:SpacingLg}, Vertical={theme:SpacingMd}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!--
      Press animation: a subtle scale-down on :pressed.  The transition
      is driven off RenderTransform so hover/opacity changes are not
      caught in the same animation curve.
    -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:.075" />
      </Transitions>
    </Setter>

    <!--
      Template — the structural layout of the button.
      All bindings use {TemplateBinding} exclusively (Rule 2) so that
      consumers can style every visual property through the theme.
    -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <!--
            Content surface: renders the button label/icon and applies
            the themed background, border, corner radius and padding.
          -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

          <!--
            Dashed accent border — hidden by default.
            Only made visible when the .accent class is applied (see
            style below).  Renders on top of the content surface as a
            decorative focus/keyboard ring that replaces the normal
            solid border with a dashed stroke.
          -->
          <Rectangle x:Name="PART_AccentBorder"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     Stroke="{TemplateBinding BorderBrush}"
                     RadiusX="2"
                     RadiusY="2"
                     StrokeThickness="1"
                     StrokeDashArray="3, 2, 6, 2" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!--
      Enable access key (Alt+letter) on the content presenter.
    -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- ============================================================
         State: :pointerover (and designer preview .previewHover)
         Light overlay on the button background.
         ============================================================ -->
    <Style Selector="^:pointerover, ^.previewHover">
      <Setter Property="Background" Value="{theme:SurfaceOverlayWeakBrush}" />
    </Style>

    <!-- ============================================================
         State: :pressed (and designer preview .previewPressed)
         Subtle scale-down for tactile feedback + strong overlay.
         ============================================================ -->
    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="^:pressed, ^.previewPressed">
      <Setter Property="Background" Value="{theme:SurfaceOverlayStrongBrush}" />
    </Style>

    <!-- ============================================================
         State: :disabled
         Reduced opacity to visually disable without altering colours.
         ============================================================ -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- ============================================================
         Class: .accent
         Removes the solid outer border and reveals the dashed accent
         border overlay (PART_AccentBorder) for a "highlighted" look.
         ============================================================ -->
    <Style Selector="^.accent">
      <Setter Property="BorderThickness" Value="0" />

      <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    
  </ControlTheme>
</ResourceDictionary>
