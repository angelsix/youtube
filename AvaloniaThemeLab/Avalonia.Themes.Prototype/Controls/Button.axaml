<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prototype="clr-namespace:Avalonia.Themes.Prototype"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:colour="using:AngelSix.ThemeEngine.Colours"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes"
                    >
  <Design.PreviewWith>
    <Border>
      <Border.Styles>
        <prototype:PrototypeTheme />
      </Border.Styles>

      <StackPanel>
        <!-- Light -->
        <Border Padding="20" Background="{colour:AccentBrush Light10}">
          <StackPanel Spacing="10" >
            <Label Content="Button States - Dark" />
            <StackPanel Orientation="Horizontal" Spacing="20">
              <Button Content="Default" />
              <Button theme:Preview.State="Hover" Content="Hover" />
              <Button theme:Preview.State="Pressed" Content="Pressed" />
              <Button theme:Preview.State="Focused" Content="Focused" />
              <Button Content="Disabled" IsEnabled="False" />
            </StackPanel>
            <StackPanel theme:Accent.Kind="Primary" Orientation="Horizontal" Spacing="20">
              <Button Content="Default" />
              <Button theme:Preview.State="Hover" Content="Hover" />
              <Button theme:Preview.State="Pressed" Content="Pressed" />
              <Button theme:Preview.State="Focused" Content="Focused" />
              <Button Content="Disabled" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </Border>
        
        <!-- Dark -->
        <Border Padding="20" theme:ThemeRegion.IsDark="True" Background="{colour:AccentBrush Light10}">
          <StackPanel Spacing="10" >
            <Label Content="Button States - Dark" />
            <StackPanel Orientation="Horizontal" Spacing="20">
              <Button Content="Default" />
              <Button theme:Preview.State="Hover" Content="Hover" />
              <Button theme:Preview.State="Pressed" Content="Pressed" />
              <Button theme:Preview.State="Focused" Content="Focused" />
              <Button Content="Disabled" IsEnabled="False" />
            </StackPanel>
            <StackPanel theme:Accent.Kind="Primary" Orientation="Horizontal" Spacing="20">
              <Button Content="Default" />
              <Button theme:Preview.State="Hover" Content="Hover" />
              <Button theme:Preview.State="Pressed" Content="Pressed" />
              <Button theme:Preview.State="Focused" Content="Focused" />
              <Button Content="Disabled" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      
    </Border>
  </Design.PreviewWith>

  <!-- ============================================================
       ControlTheme: {x:Type Button}
       ============================================================ -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">

    <!-- Visual defaults -->
    <Setter Property="Background" Value="{colour:AccentBrush Light10}" />
    <Setter Property="Foreground" Value="{colour:AccentBrush Dark2}" />
    <Setter Property="BorderBrush" Value="{colour:AccentBrush Light6}" />
    <Setter Property="BorderThickness" Value="{size:ThicknessSm}" />
    <Setter Property="CornerRadius" Value="{size:RadiusSm}" />
    <Setter Property="Padding" Value="{size:Edges Horizontal={size:SpacingXl}, Vertical={size:SpacingLg}}" />
    <Setter Property="HorizontalAlignment" Value="{theme:ControlHorizontalAlignment}" />
    <Setter Property="VerticalAlignment" Value="{theme:ControlVerticalAlignment}" />
    <Setter Property="HorizontalContentAlignment" Value="{theme:ControlHorizontalContentAlignment}" />
    <Setter Property="VerticalContentAlignment" Value="{theme:ControlVerticalContentAlignment}" />

    <!-- Press animation -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:AnimationFastMs}" />
      </Transitions>
    </Setter>

    <!-- Template -->
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Layout root stacking the label and accent outline -->
        <Grid>
          <!-- The button's label -->
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

          <!-- Accent border overlay -->
          <Rectangle x:Name="PART_AccentBorder"
                     IsVisible="False"
                     IsHitTestVisible="False"
                     Fill="Transparent"
                     StrokeDashArray="3, 2, 6, 2" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Access key support -->
    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!-- Accent border visuals -->
    <Style Selector="^ /template/ Rectangle#PART_AccentBorder">
      <Setter Property="Stroke" Value="{colour:AccentPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="{size:AccentBorderStrokeThickness}" />
      <Setter Property="RadiusX" Value="{size:RadiusSmDouble}" />
      <Setter Property="RadiusY" Value="{size:RadiusSmDouble}" />
    </Style>

    <!-- Hover state. An opaque ramp stage rather than an Overlay brush: Background is a single
         property, so a translucent value replaces the button's fill instead of layering over it,
         and the page would show through. That read correctly only while the button and the page
         were the same colour. -->
    <Style Selector="^:pointerover, ^[(theme|Preview.State)=Hover]">
      <Setter Property="Background" Value="{colour:AccentBrush Light8}" />
      <Setter Property="Foreground" Value="{colour:AccentBrush Dark7}" />
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}, By=1.07}" />
    </Style>

    <!-- Pressed state -->
    <Style Selector="^:pressed, ^[(theme|Preview.State)=Pressed]">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="Background" Value="{colour:AccentBrush Light6}" />
    </Style>
    
    <!-- Disabled state -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{size:DisabledOpacity}" />
    </Style>

    <!-- Focus state -->
    <Style Selector="^:focus-visible, ^[(theme|Preview.State)=Focused]">
      <Setter Property="BorderBrush" Value="{colour:AccentFocusBrush}" />
      <Setter Property="BorderThickness" Value="{size:ThicknessMd}" />
    </Style>
    
  </ControlTheme>
</ResourceDictionary>
