<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <!-- Real Skia drawing, so text and glyph metrics are the ones the app renders with -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Examples\AvaloniaThemeLab.ThemePlayground\AvaloniaThemeLab.ThemePlayground.csproj" />
  </ItemGroup>

  <!-- The tests drive the playground app, so its App and windows are in scope everywhere -->
  <ItemGroup>
    <Using Include="AvaloniaThemeLab.ThemePlayground" />
  </ItemGroup>

</Project>
