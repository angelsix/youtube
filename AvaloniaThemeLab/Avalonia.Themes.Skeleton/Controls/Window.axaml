<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">

  <!-- The one control every app needs styled: with no theme at all a Window has no template, so it shows nothing.
       This gives it a canvas, ink and font for the content to inherit, and a presenter to show that content -->
  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <Setter Property="Background" Value="{color:SurfaceBrush}" />
    <Setter Property="Foreground" Value="{color:TextBrush}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontSize" Value="{size:FontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
