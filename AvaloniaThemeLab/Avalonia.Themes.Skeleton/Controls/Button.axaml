<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:AngelSix.ThemeEngine.Generated"
                    xmlns:color="using:AngelSix.ThemeEngine.Colors"
                    xmlns:size="using:AngelSix.ThemeEngine.Sizes">

  <!-- The smallest button: its text inside a border, which grows and takes the hover ink under the pointer and shrinks
       and takes the pressed ink while pressed. No fill in any state. Every value comes from SkeletonTheme, and the
       template reads the button's own properties, so an app can still restyle any of them -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <!-- Transparent, not unset: an element with no background is not hit-testable, so only the text would catch the
         pointer. The hover state grows the button, the text moves out from under the pointer, the hover drops, the
         button shrinks back and the text comes back under it: it flickers. A transparent fill paints nothing but
         makes the whole face hit-testable -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{color:TextBrush}" />
    <Setter Property="BorderBrush" Value="{color:TextBrush}" />
    <Setter Property="BorderThickness" Value="{size:BorderThickness}" />
    <Setter Property="Padding" Value="{size:ButtonPadding}" />
    <Setter Property="FontFamily" Value="{theme:FontFamily}" />
    <Setter Property="FontSize" Value="{size:FontSize}" />
    <!-- At rest: no scale, as one fixed value. With no resting value the scale transition ran from unset, and every
         time it started the hover or press scale binding published a new, unequal transform, which restarted the
         transition until the stack overflowed: a few clicks crashed the app. Engine 1.31.0 fixes the cause (the same
         scale is now the same transform); a resting value is still the clear way to say "no scale" -->
    <Setter Property="RenderTransform" Value="none" />
    <!-- Each state change eases in rather than snapping -->
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{theme:StateDuration}" />
        <BrushTransition Property="BorderBrush" Duration="{theme:StateDuration}" />
        <BrushTransition Property="Foreground" Duration="{theme:StateDuration}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>

    <!-- Hover: grows, and the border and text take the hover ink -->
    <Style Selector="^:pointerover">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:HoverScale}}" />
      <Setter Property="BorderBrush" Value="{color:HoverBrush}" />
      <Setter Property="Foreground" Value="{color:HoverBrush}" />
    </Style>

    <!-- Pressed: shrinks, and the border and text take the pressed ink -->
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="{theme:TransformScale Value={size:PressedScale}}" />
      <Setter Property="BorderBrush" Value="{color:PressedBrush}" />
      <Setter Property="Foreground" Value="{color:PressedBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
