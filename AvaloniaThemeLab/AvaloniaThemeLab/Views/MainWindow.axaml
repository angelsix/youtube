<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:size="using:AngelSix.ThemeEngine.Sizes"
        xmlns:color="using:AngelSix.ThemeEngine.Colors"
        xmlns:default="using:Avalonia.Themes.Default"
        xmlns:converters="using:AvaloniaThemeLab.ValueConverters"
        xmlns:vm="using:AvaloniaThemeLab.ViewModels"
        xmlns:views="using:AvaloniaThemeLab.Views"
        mc:Ignorable="d"
        x:Class="AvaloniaThemeLab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AvaloniaThemeLab"
        Width="1200" Height="800">
  <!-- Design-time data context: the previewer runtime-loads this file and binds the window's
       DataContext to this element (Design.ApplyDesignModeProperties), so the gallery populates
       without the desktop start-up that normally wires it. It is the real view model: its
       parameterless design-time constructor reaches the booted app's catalogue, so the preview
       shows the full control list exactly like the running app -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <!-- Per-preview options the theme files key beside their {Name}Preview template. Declared HERE,
       not in App.axaml, so the proof host (which boots the real MainWindow but not the lab App)
       still resolves them; a control asks for stacked panes with a {Name}PreviewOrientation key -->
  <Window.Resources>
    <converters:PreviewOrientationConverter x:Key="PreviewOrientationConverter" />
  </Window.Resources>
  <Window.Styles>
    <!-- The page's inset inside its viewer is the page's Margin: a viewer's Padding is left out of its scroll extent -->
    <Style Selector="ScrollViewer#PageHost > :is(ContentControl)">
      <Setter Property="Margin" Value="{size:Edges All={size:SpacingMd}}" />
    </Style>
  </Window.Styles>
  <!-- Sidebar and page -->
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*"
        ColumnSpacing="{size:SpacingXxl}" RowSpacing="{size:SpacingXxl}" Margin="{size:Edges All={size:SpacingXxl}}">
    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search controls"
             HorizontalAlignment="Stretch" />
    <ListBox Grid.Row="1" Grid.Column="0" Width="{size:SurfaceWidthSm}"
             ItemsSource="{Binding Catalogue.Entries}" SelectedItem="{Binding SelectedEntry}">
      <!-- One template for every entry kind (both derive GalleryEntryViewModel.Name). A bare
           {Binding DataType=} in DisplayMemberBinding is a template-shaped slot the compiled-binding
           tooling cannot resolve; a real DataTemplate carries the type instead. x:DataType is the
           compiled-binding scope (the DataType property is only the template's match key) -->
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:GalleryEntryViewModel" x:DataType="vm:GalleryEntryViewModel">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- The app's ONE accent picker (task 87): the same swatch row the previews used to repeat in
         every pane's header, now in the header top right. Every preview's SelectedAccent binds to
         its SelectedItem, so one pick styles the whole application -->
    <DockPanel Grid.Row="0" Grid.Column="1">
      <ListBox x:Name="AccentPicker" DockPanel.Dock="Right"
               Theme="{StaticResource LightDarkPreviewSwatches}"
               ItemsSource="{x:Static default:LightDarkPreview.AccentChoices}"
               SelectedItem="{Binding SelectedAccent, Mode=TwoWay}">
        <!-- Each header swatch paints its hue's LIST-ROW PRESSED fill — the exact colour a ComboBoxItem
             shows while pressed ({color:PressedBackgroundDefault}, Light6 of the item's own hue), read from
             ComboBoxItem.axaml's :pressed state. Task 148: this replaces the old {color:SolidFillDefault}
             (checked-face) swatch so the picker mirrors how the accent reads inside a drop-down row.
             Scoped to this picker only; the selection ring (BorderBrush) is left alone so it stays readable -->
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="{color:PressedBackgroundDefault}" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      <!-- Tracks ShownEntry (not SelectedEntry) so the title changes at the same instant the page does -->
      <TextBlock Text="{Binding ShownEntry?.Name}" />
    </DockPanel>
    <!-- Bound to ShownEntry, not SelectedEntry: the sidebar selects on pointer PRESS, so a clicked row
         flips SelectedEntry mid-click; the view holds ShownEntry back until that click's release has fully
         routed (see MainWindow.axaml.cs), so the incoming page is never born into a still-propagating
         release that an overlay drawer would treat as an outside click and light-dismiss -->
    <ScrollViewer x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding ShownEntry}">
      <ScrollViewer.DataTemplates>
        <!-- Control shown by its theme preview: light and dark halves side by side, each preview centred in its half.
             Both panes' content takes their hue from the header's ONE accent picker (task 87): SelectedAccent binds
             TwoWay to the picker's SelectedItem, so every entry in the gallery shares the app-level selection.
             DataType is the template's match key; x:DataType is the compiled-binding scope for its bindings -->
        <DataTemplate DataType="vm:ControlEntryViewModel" x:DataType="vm:ControlEntryViewModel">
          <!-- Orientation comes from each control's own theme file ({Name}PreviewOrientation, Rule 20) -->
          <default:LightDarkPreview Title="{Binding Name}"
                                    Orientation="{Binding ControlType, Converter={StaticResource PreviewOrientationConverter}}"
                                    HorizontalContentAlignment="Center"
                                    SelectedAccent="{Binding SelectedItem, ElementName=AccentPicker, Mode=TwoWay}"
                                    ContentTemplate="{Binding ControlType, Converter={StaticResource PreviewTemplateConverter}}" />
        </DataTemplate>
        <!-- Hand-written page -->
        <views:ViewLocator />
      </ScrollViewer.DataTemplates>
    </ScrollViewer>
  </Grid>
</Window>
