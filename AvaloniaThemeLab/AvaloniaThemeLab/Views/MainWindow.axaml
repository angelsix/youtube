<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="1000"
        Width="700" Height="1000"
        xmlns:generic="using:System.Collections.Generic"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        xmlns:controls="using:AngelSix.ThemeEngine.Controls"
        x:Class="AvaloniaThemeLab.MainWindow"
        Title="AvaloniaThemeLab">
    <ScrollViewer AllowAutoHide="True">
    <StackPanel Spacing="20" Margin="20">
        
        <!-- Full width buttons -->
        <StackPanel.Styles>
            <Style Selector="ButtonSpinner">
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            </Style>
        </StackPanel.Styles>
        
        <AutoCompleteBox HorizontalAlignment="Stretch">
            <AutoCompleteBox.ItemsSource>
                <generic:List x:TypeArguments="x:String">
                    <x:String>Alabama</x:String>
                    <x:String>Alaska</x:String>
                    <x:String>Arizona</x:String>
                    <x:String>Arkansas</x:String>
                    <x:String>California</x:String>
                    <x:String>Colorado</x:String>
                    <x:String>Connecticut</x:String>
                    <x:String>Delaware</x:String>
                </generic:List>
            </AutoCompleteBox.ItemsSource>
        </AutoCompleteBox>

        <!-- Accent spike: one set of accent styles, many hues -->
        <ButtonSpinner theme:Accent.Kind="Primary" Content="Primary (default)" />
        <ButtonSpinner theme:BrandAccent.Kind="Warning" Content="Warning" />
        <ButtonSpinner theme:BrandAccent.Kind="Success" Content="Success" />
        <ButtonSpinner theme:BrandAccent.Kind="Destructive" Content="Destructive" />
        <!-- Downstream hue, via this assembly's own generated enum -->
        <ButtonSpinner theme:BrandAccent.Kind="Brand" Content="Brand (typed enum)" />
        <!-- Same hue, via the runtime's open string property — no generated enum needed -->
        <ButtonSpinner theme:ThemeAccent.Hue="Brand" Content="Brand (open string)" />
        <ButtonSpinner theme:BrandAccent.Kind="Info"
                       ButtonSpinnerLocation="Left" Content="Info (left)" />

        <!-- Variant suffixes: hover uses Dark1 + HoverOverlay, pressed uses Dark2 + PressedOverlay -->
        <ButtonSpinner theme:Preview.State="Hover" theme:BrandAccent.Kind="Warning" Content="Warning hover" />
        <ButtonSpinner theme:Preview.State="Pressed" theme:BrandAccent.Kind="Warning" Content="Warning pressed" />

        <!-- Kind inherits; the accent class does not -->
        <StackPanel theme:BrandAccent.Kind="Subtle" Spacing="20">
            <ButtonSpinner Content="Inherited Subtle" />
            <ButtonSpinner theme:Accent.Kind="Primary" Content="Primary override" />
        </StackPanel>
        
        <ButtonSpinner Content="No accent" />
    

        <!-- This app's own style classes, from BrandControls.axaml.
             The hue still comes from Accent.Kind, so .hero serves any accent. -->
        <StackPanel Orientation="Horizontal" Spacing="12" theme:BrandAccent.Kind="Brand">
            <Button Classes="hero" Content="Get started" />
            <Button Classes="quiet" Content="Maybe later" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" theme:BrandAccent.Kind="Success">
            <Button Classes="hero" Content="Same class, Success" />
        </StackPanel>

        <!-- CalendarView: single selection, weekends disabled and marker dots from code-behind -->
        <controls:CalendarView x:Name="DemoCalendar" />
        <TextBlock x:Name="SingleLabel"
                   Text="{Binding #DemoCalendar.SelectedDate, StringFormat='Selected: {0:d}'}" />

        <!-- CalendarView: range selection -->
        <controls:CalendarView x:Name="RangeCalendar" SelectionMode="Range" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="RangeStartLabel"
                       Text="{Binding #RangeCalendar.RangeStart, StringFormat='From: {0:d}'}" />
            <TextBlock x:Name="RangeEndLabel"
                       Text="{Binding #RangeCalendar.RangeEnd, StringFormat='To: {0:d}'}" />
        </StackPanel>

        <!-- CalendarView: picker presentation -->
        <controls:CalendarView x:Name="PickerCalendar" DisplayAsPicker="True" HorizontalAlignment="Stretch" />
    </StackPanel>
    </ScrollViewer>
</Window>
