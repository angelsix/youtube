<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             xmlns:vm="using:AvaloniaThemeLab.ViewModels"
             x:Class="AvaloniaThemeLab.Pages.WindowPage"
             x:DataType="vm:WindowPageViewModel">
  <!-- Windows and dialogs: a dialog window over this one, a second over that, and a modal page -->
  <StackPanel Spacing="{size:SpacingXl}">
    <TextBlock Text="Windows and dialogs. A dialog window opens over this window, and another can be opened from inside it, so two layers stack."
               TextWrapping="Wrap" />
    <Button Content="Open a dialog window" Command="{Binding OpenDialogCommand}" />
    <TextBlock Text="A modal page covers the navigation page below it."
               TextWrapping="Wrap" />
    <NavigationPage x:Name="ModalHost" Height="{size:Scaled Value={size:BaseSize}, By=360}">
      <ContentPage Header="Root page">
        <Button Content="Push a modal page"
                Command="{Binding PushModalCommand}"
                CommandParameter="{Binding #ModalHost}" />
      </ContentPage>
    </NavigationPage>
  </StackPanel>
</UserControl>
