<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.NumericUpDownPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <NumericUpDown Value="10" />
    <NumericUpDown PlaceholderText="Empty, with placeholder" />
    <NumericUpDown Value="100" Maximum="100" />
    <NumericUpDown Value="10" ButtonSpinnerLocation="Left" />
    <NumericUpDown Value="10" ShowButtonSpinner="False" />
    <NumericUpDown Value="10" IsEnabled="False" />
  </StackPanel>
</UserControl>
