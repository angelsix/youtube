<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.SplitViewPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <SplitView IsPaneOpen="True" DisplayMode="Inline" Height="{size:Scaled Value={size:BaseSize}, By=140}">
      <SplitView.Pane>
        <TextBlock Text="Inline pane, open" />
      </SplitView.Pane>
      <TextBlock Text="Content" />
    </SplitView>
    <SplitView DisplayMode="CompactInline" Height="{size:Scaled Value={size:BaseSize}, By=140}">
      <SplitView.Pane>
        <TextBlock Text="Compact pane" />
      </SplitView.Pane>
      <TextBlock Text="Content beside a closed compact pane" />
    </SplitView>
    <SplitView IsPaneOpen="True" DisplayMode="Overlay" Height="{size:Scaled Value={size:BaseSize}, By=140}">
      <SplitView.Pane>
        <TextBlock Text="Overlay pane, open" />
      </SplitView.Pane>
      <TextBlock Text="Content" />
    </SplitView>
    <SplitView IsPaneOpen="True" DisplayMode="Inline" PanePlacement="Right" Height="{size:Scaled Value={size:BaseSize}, By=140}">
      <SplitView.Pane>
        <TextBlock Text="Right pane" />
      </SplitView.Pane>
      <TextBlock Text="Content" />
    </SplitView>
  </StackPanel>
</UserControl>
