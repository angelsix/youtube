<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.SliderPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <Slider Value="40" />
    <Slider Value="40" TickPlacement="BottomRight" TickFrequency="10" IsSnapToTickEnabled="True" />
    <Slider Value="40" Orientation="Vertical" Height="160" />
    <Slider Value="40" IsEnabled="False" />
  </StackPanel>
</UserControl>
