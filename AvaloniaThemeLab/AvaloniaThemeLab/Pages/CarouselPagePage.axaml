<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.CarouselPagePage">
  <StackPanel Spacing="{size:SpacingXl}">
    <CarouselPage Height="240">
      <ContentPage Header="Page 1">
        <TextBlock Text="First page" />
      </ContentPage>
      <ContentPage Header="Page 2">
        <TextBlock Text="Second page" />
      </ContentPage>
    </CarouselPage>
  </StackPanel>
</UserControl>
