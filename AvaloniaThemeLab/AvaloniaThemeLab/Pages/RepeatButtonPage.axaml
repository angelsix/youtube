<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.RepeatButtonPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <RepeatButton Content="Repeats while held" />
    <RepeatButton Content="Disabled" IsEnabled="False" />
  </StackPanel>
</UserControl>
