<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.ContentPagePage">
  <StackPanel Spacing="{size:SpacingXl}">
    <ContentPage Header="Page header" Height="200">
      <TextBlock Text="Page content" />
    </ContentPage>
  </StackPanel>
</UserControl>
