<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.TabStripPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <TabStrip SelectedIndex="0">
      <TabStripItem Content="Selected" />
      <TabStripItem Content="Second" />
      <TabStripItem Content="Disabled" IsEnabled="False" />
    </TabStrip>
  </StackPanel>
</UserControl>
