<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.ListBoxPage">
  <Grid RowDefinitions="*,*,*" RowSpacing="{size:SpacingXl}">
    <ListBox Grid.Row="0" SelectedIndex="1">
      <ListBoxItem Content="First" />
      <ListBoxItem Content="Selected" />
      <ListBoxItem Content="Third" />
      <ListBoxItem Content="Disabled item" IsEnabled="False" />
    </ListBox>
    <ListBox Grid.Row="1" SelectionMode="Multiple">
      <ListBoxItem Content="Multiple selection" IsSelected="True" />
      <ListBoxItem Content="Second" IsSelected="True" />
      <ListBoxItem Content="Third" />
    </ListBox>
    <ListBox Grid.Row="2" IsEnabled="False">
      <ListBoxItem Content="Disabled list" />
      <ListBoxItem Content="Second" />
    </ListBox>
  </Grid>
</UserControl>
