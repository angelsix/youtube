<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             xmlns:vm="using:AvaloniaThemeLab.ViewModels"
             x:Class="AvaloniaThemeLab.Pages.WindowPageModal"
             x:DataType="vm:WindowPageViewModel"
             Header="Modal page">
  <!-- The modal's message and the action that dismisses it -->
  <StackPanel Spacing="{size:SpacingXl}" Margin="{size:Edges All={size:SpacingXxl}}">
    <TextBlock Text="A modal page, pushed over the navigation page." TextWrapping="Wrap" />
    <Button Content="Close the modal page"
            Command="{Binding PopModalCommand}"
            CommandParameter="{Binding $parent[NavigationPage]}" />
  </StackPanel>
</ContentPage>
