<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.HyperlinkButtonPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <HyperlinkButton Content="Hyperlink" NavigateUri="https://avaloniaui.net" />
    <HyperlinkButton Content="Visited" IsVisited="True" />
    <HyperlinkButton Content="Disabled" IsEnabled="False" />
  </StackPanel>
</UserControl>
