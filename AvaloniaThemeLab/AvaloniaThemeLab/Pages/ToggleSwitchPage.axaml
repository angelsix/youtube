<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.ToggleSwitchPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <ToggleSwitch />
    <ToggleSwitch IsChecked="True" />
    <ToggleSwitch Content="Header" OnContent="On content" OffContent="Off content" />
    <ToggleSwitch IsEnabled="False" />
    <ToggleSwitch IsChecked="True" IsEnabled="False" />
  </StackPanel>
</UserControl>
