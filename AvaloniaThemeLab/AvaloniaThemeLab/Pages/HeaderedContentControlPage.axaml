<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.HeaderedContentControlPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <HeaderedContentControl Header="Header" Content="Content" />
    <HeaderedContentControl Header="Disabled" Content="Content" IsEnabled="False" />
  </StackPanel>
</UserControl>
