<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.NavigationPagePage">
  <StackPanel Spacing="{size:SpacingXl}">
    <NavigationPage Height="240">
      <ContentPage Header="Root page">
        <TextBlock Text="Page content" />
      </ContentPage>
    </NavigationPage>
  </StackPanel>
</UserControl>
