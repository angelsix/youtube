<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.SeparatorPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <TextBlock Text="Above the separator" />
    <Separator />
    <TextBlock Text="Below the separator" />
  </StackPanel>
</UserControl>
