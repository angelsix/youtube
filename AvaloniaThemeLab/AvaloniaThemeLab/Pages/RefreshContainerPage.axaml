<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.RefreshContainerPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <TextBlock Text="Pull down (touch or trackpad) to refresh" />
    <RefreshContainer Height="200">
      <ListBox>
        <ListBoxItem Content="First" />
        <ListBoxItem Content="Second" />
        <ListBoxItem Content="Third" />
      </ListBox>
    </RefreshContainer>
  </StackPanel>
</UserControl>
