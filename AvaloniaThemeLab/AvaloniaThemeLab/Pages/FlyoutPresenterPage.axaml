<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.FlyoutPresenterPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <Button Content="Open the flyout">
      <Button.Flyout>
        <Flyout>
          <TextBlock Text="Flyout content" />
        </Flyout>
      </Button.Flyout>
    </Button>
  </StackPanel>
</UserControl>
