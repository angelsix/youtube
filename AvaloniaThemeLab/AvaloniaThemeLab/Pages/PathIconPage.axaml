<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             xmlns:icons="using:AngelSix.ThemeEngine.Icons"
             x:Class="AvaloniaThemeLab.Pages.PathIconPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <PathIcon Data="{icons:Star}" />
    <PathIcon Data="{icons:Save}" />
    <PathIcon Data="{icons:Star}" IsEnabled="False" />
  </StackPanel>
</UserControl>
