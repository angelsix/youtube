<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             x:Class="AvaloniaThemeLab.Pages.SelectableTextBlockPage">
  <StackPanel Spacing="{size:SpacingXl}">
    <SelectableTextBlock Text="Selectable text, part of it selected" SelectionStart="11" SelectionEnd="15" />
    <SelectableTextBlock Text="Disabled selectable text" IsEnabled="False" />
  </StackPanel>
</UserControl>
