<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:size="using:AngelSix.ThemeEngine.Sizes"
             xmlns:vm="using:AvaloniaThemeLab.ViewModels"
             x:Class="AvaloniaThemeLab.Pages.DatePickerPage"
             x:DataType="vm:DatePickerPageViewModel">
  <StackPanel Spacing="{size:SpacingXl}">
    <DatePicker />
    <DatePicker SelectedDate="{Binding SelectedDate, Mode=OneTime}" />
    <DatePicker SelectedDate="{Binding SelectedDate, Mode=OneTime}" DayVisible="False" />
    <DatePicker IsEnabled="False" />
  </StackPanel>
</UserControl>
