<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaThemeLab.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <PrototypeTheme />
        <!--
            The theme's style-class declarations, so the IDE can resolve Classes="accent". Has to be
            here rather than inside the theme: PrototypeTheme is a C# type whose XAML loads at
            runtime, so an analyser reading this file cannot follow it into anything. Sets nothing.
        -->
        <StyleInclude Source="avares://Avalonia.Themes.Prototype/StyleClasses.axaml" />

        <!-- This app's own variant classes, layered over the theme's ControlThemes. -->
        <StyleInclude Source="avares://AvaloniaThemeLab/BrandControls.axaml" />
    </Application.Styles>
</Application>