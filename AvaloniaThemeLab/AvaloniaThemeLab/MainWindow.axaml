<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="1000"
        Width="400" Height="1000"
        xmlns:generic="using:System.Collections.Generic"
        xmlns:theme="using:AngelSix.ThemeEngine.Generated"
        x:Class="AvaloniaThemeLab.MainWindow"
        Title="AvaloniaThemeLab">
    <StackPanel Spacing="20" Margin="20">
        
        <!-- Full width buttons -->
        <StackPanel.Styles>
            <Style Selector="ButtonSpinner">
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            </Style>
        </StackPanel.Styles>
        
        <AutoCompleteBox HorizontalAlignment="Stretch">
            <AutoCompleteBox.ItemsSource>
                <generic:List x:TypeArguments="x:String">
                    <x:String>Alabama</x:String>
                    <x:String>Alaska</x:String>
                    <x:String>Arizona</x:String>
                    <x:String>Arkansas</x:String>
                    <x:String>California</x:String>
                    <x:String>Colorado</x:String>
                    <x:String>Connecticut</x:String>
                    <x:String>Delaware</x:String>
                </generic:List>
            </AutoCompleteBox.ItemsSource>
        </AutoCompleteBox>

        <!-- Accent spike: one set of accent styles, many hues -->
        <ButtonSpinner Classes="accent" Content="Primary (default)" />
        <ButtonSpinner Classes="accent" theme:AvaloniaThemeLabAccent.Kind="Warning" Content="Warning" />
        <ButtonSpinner Classes="accent" theme:AvaloniaThemeLabAccent.Kind="Success" Content="Success" />
        <ButtonSpinner Classes="accent" theme:AvaloniaThemeLabAccent.Kind="Destructive" Content="Destructive" />
        <!-- Downstream hue, via this assembly's own generated enum -->
        <ButtonSpinner Classes="accent" theme:AvaloniaThemeLabAccent.Kind="Brand" Content="Brand (typed enum)" />
        <!-- Same hue, via the runtime's open string property — no generated enum needed -->
        <ButtonSpinner Classes="accent" theme:ThemeAccent.Hue="Brand" Content="Brand (open string)" />
        <ButtonSpinner Classes="accent" theme:AvaloniaThemeLabAccent.Kind="Info"
                       ButtonSpinnerLocation="Left" Content="Info (left)" />

        <!-- Variant suffixes: hover uses Dark1 + HoverOverlay, pressed uses Dark2 + PressedOverlay -->
        <ButtonSpinner Classes="accent previewHover" theme:AvaloniaThemeLabAccent.Kind="Warning" Content="Warning hover" />
        <ButtonSpinner Classes="accent previewPressed" theme:AvaloniaThemeLabAccent.Kind="Warning" Content="Warning pressed" />

        <!-- Kind inherits; the accent class does not -->
        <StackPanel theme:AvaloniaThemeLabAccent.Kind="Subtle" Spacing="20">
            <ButtonSpinner Classes="accent" Content="Inherited Subtle" />
            <ButtonSpinner Content="No accent class" />
        </StackPanel>

        <!-- This app's own style classes, from BrandControls.axaml.
             The hue still comes from Accent.Kind, so .hero serves any accent. -->
        <StackPanel Orientation="Horizontal" Spacing="12" theme:AvaloniaThemeLabAccent.Kind="Brand">
            <Button Classes="hero" Content="Get started" />
            <Button Classes="quiet" Content="Maybe later" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" theme:AvaloniaThemeLabAccent.Kind="Success">
            <Button Classes="hero" Content="Same class, Success" />
        </StackPanel>
    </StackPanel>
</Window>
