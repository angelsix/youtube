<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="32"
             x:Class="BatchProcess3.Controls.SortMenuItem"
             xmlns:controls="clr-namespace:BatchProcess3.Controls"
             x:DataType="controls:SortMenuItem">

    <Button Command="{Binding $parent[controls:SortMenuItem].Command}" CommandParameter="{Binding $parent[controls:SortMenuItem].CommandParameter}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
            Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="14 8"
            Effect="{x:Null}">
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock Text="{Binding $parent[controls:SortMenuItem].Text}" FontSize="12"
                       Foreground="{DynamicResource LightForeground}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding $parent[controls:SortMenuItem].SortArrow}" FontSize="10"
                       Foreground="{DynamicResource AccentPurple}" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:SortMenuItem].IsSortActive}" />
        </Grid>
    </Button>

</UserControl>
