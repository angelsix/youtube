<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             xmlns:pages="clr-namespace:BatchProcess3.ViewModels.Pages"
             xmlns:design="clr-namespace:BatchProcess3.Design"
             xmlns:controls="clr-namespace:BatchProcess3.Controls"

             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="pages:JobsPageViewModel"
             x:Class="BatchProcess3.Views.Pages.JobsPageView"
             d:DataContext="{x:Static design:DesignData.JobsPageViewModel}"
             Focusable="True">

    <UserControl.Styles>
        <!-- Flyout presenter theme -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerMd}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Header -->
        <HeaderBanner
            BackgroundImage="{SvgImage /Assets/Images/background-actions.svg}"
            Header="Jobs"
            SubHeaderB="An overview of all active and past jobs — track progress, status, and runtime at a glance." />

        <!-- Summary Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" ColumnSpacing="16" Margin="{StaticResource PagePaddingFirst}">

            <controls:SummaryCard Grid.Column="0"
                Header="TOTAL RUNTIME"
                Value="{Binding TotalRuntime}"
                Subtitle="Across all jobs"
                IconData="{StaticResource ClockIcon}"
                AccentBrush="{DynamicResource CyanAccent}"
                CardGradient="{DynamicResource CyanCardGradient}" />

            <controls:SummaryCard Grid.Column="1"
                Header="TOTAL JOBS"
                Value="{Binding TotalJobs}"
                Subtitle="{Binding CurrentlyRunning, StringFormat='{}{0} currently running'}"
                IconData="{StaticResource BoltIcon}"
                AccentBrush="{DynamicResource FuchsiaAccent}"
                CardGradient="{DynamicResource FuchsiaCardGradient}"
                IsActive="{Binding IsFilterAll}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="All" />

            <controls:SummaryCard Grid.Column="2"
                Header="SUCCESSFUL"
                Value="{Binding SuccessfulJobs}"
                Subtitle="{Binding SuccessRate}"
                IconData="{StaticResource CheckIcon}"
                AccentBrush="{DynamicResource GreenAccent}"
                CardGradient="{DynamicResource GreenCardGradient}"
                IsActive="{Binding IsFilterSuccessful}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="Successful" />

            <controls:SummaryCard Grid.Column="3"
                Header="FAILED"
                Value="{Binding FailedJobs}"
                Subtitle="{Binding FailedSummary}"
                IconData="{StaticResource CloseIcon}"
                AccentBrush="{DynamicResource RedAccent}"
                CardGradient="{DynamicResource RedCardGradient}"
                IsActive="{Binding IsFilterFailed}"
                Command="{Binding SetFilterCommand}"
                CommandParameter="Failed" />

        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="8" Margin="{StaticResource PagePaddingMiddle}">

            <!-- Search Box -->
            <TextBox Grid.Column="0" Width="320"
                     Watermark="Search jobs..."
                     Text="{Binding SearchText}"
                     CornerRadius="{StaticResource CornerMd}"
                     Padding="8 8 12 8"
                     FontSize="13">
                <TextBox.InnerLeftContent>
                    <Viewbox Width="14" Height="14" Margin="4 0 0 0" VerticalAlignment="Center">
                        <Path Fill="{DynamicResource LabelForeground}" Data="{StaticResource SearchIcon}" />
                    </Viewbox>
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- Sort Button with Flyout -->
            <Button Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerMd}" Padding="12 8" Cursor="Hand"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="200">
                            <!-- Sort menu header -->
                            <TextBlock Text="SORT BY" FontSize="10" Foreground="{DynamicResource LabelForeground}"
                                       FontFamily="{DynamicResource NotoSansJP-Semibold}"
                                       Margin="16 8" />

                            <controls:SortMenuItem Text="Job Name" Command="{Binding SortByCommand}" CommandParameter="Name"
                                SortArrow="{Binding SortArrowName}" IsSortActive="{Binding IsSortByName}" />
                            <controls:SortMenuItem Text="Description" Command="{Binding SortByCommand}" CommandParameter="Description"
                                SortArrow="{Binding SortArrowDescription}" IsSortActive="{Binding IsSortByDescription}" />
                            <controls:SortMenuItem Text="Progress" Command="{Binding SortByCommand}" CommandParameter="Progress"
                                SortArrow="{Binding SortArrowProgress}" IsSortActive="{Binding IsSortByProgress}" />
                            <controls:SortMenuItem Text="Status" Command="{Binding SortByCommand}" CommandParameter="Status"
                                SortArrow="{Binding SortArrowStatus}" IsSortActive="{Binding IsSortByStatus}" />
                            <controls:SortMenuItem Text="Date" Command="{Binding SortByCommand}" CommandParameter="Date"
                                SortArrow="{Binding SortArrowDate}" IsSortActive="{Binding IsSortByDate}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Width="13" Height="13">
                        <Path Fill="{DynamicResource SecondaryForeground}" Data="{StaticResource SortIcon}" />
                    </Viewbox>
                    <TextBlock Text="Sort" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" />
                </StackPanel>
            </Button>

            <!-- Filter Tabs -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <controls:FilterButton Text="All" AccentBrush="{DynamicResource FuchsiaAccent}"
                    IsActive="{Binding IsFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All" />
                <controls:FilterButton Text="Running" AccentBrush="{DynamicResource CyanAccent}"
                    IsActive="{Binding IsFilterRunning}" Command="{Binding SetFilterCommand}" CommandParameter="Running" />
                <controls:FilterButton Text="Successful" AccentBrush="{DynamicResource GreenAccent}"
                    IsActive="{Binding IsFilterSuccessful}" Command="{Binding SetFilterCommand}" CommandParameter="Successful" />
                <controls:FilterButton Text="Failed" AccentBrush="{DynamicResource RedAccent}"
                    IsActive="{Binding IsFilterFailed}" Command="{Binding SetFilterCommand}" CommandParameter="Failed" />
                <controls:FilterButton Text="Paused" AccentBrush="{DynamicResource AmberAccent}"
                    IsActive="{Binding IsFilterPaused}" Command="{Binding SetFilterCommand}" CommandParameter="Paused" />
            </StackPanel>

        </Grid>

        <!-- Jobs Table -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{StaticResource CornerLg}"
                ClipToBounds="True" Margin="{StaticResource PagePaddingLast}">

            <Grid RowDefinitions="Auto, *">

                <!-- Table Header (clickable for sorting) -->
                <Border Background="{DynamicResource TableHeaderBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0 0 0 1">
                    <!-- NOTE: ColumnDefinitions must match the table row Grid below -->
                    <Grid ColumnDefinitions="2*, 3*, 1.5*, 1.2*, 1.6*">

                        <controls:SortColumnHeader Grid.Column="0" Text="JOB NAME" Command="{Binding SortByCommand}" CommandParameter="Name"
                            SortArrow="{Binding SortArrowName}" IsSortActive="{Binding IsSortByName}" />
                        <controls:SortColumnHeader Grid.Column="1" Text="DESCRIPTION" Command="{Binding SortByCommand}" CommandParameter="Description"
                            SortArrow="{Binding SortArrowDescription}" IsSortActive="{Binding IsSortByDescription}" />
                        <controls:SortColumnHeader Grid.Column="2" Text="PROGRESS" Command="{Binding SortByCommand}" CommandParameter="Progress"
                            SortArrow="{Binding SortArrowProgress}" IsSortActive="{Binding IsSortByProgress}" />
                        <controls:SortColumnHeader Grid.Column="3" Text="STATUS" Command="{Binding SortByCommand}" CommandParameter="Status"
                            SortArrow="{Binding SortArrowStatus}" IsSortActive="{Binding IsSortByStatus}" />
                        <controls:SortColumnHeader Grid.Column="4" Text="DATE" Command="{Binding SortByCommand}" CommandParameter="Date"
                            SortArrow="{Binding SortArrowDate}" IsSortActive="{Binding IsSortByDate}" />

                    </Grid>
                </Border>

                <!-- Table Rows (virtualized) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredJobs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:JobItemViewModel">
                                <Border Classes="table-row" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0 0 0 1"
                                        Padding="0" Background="Transparent">
                                    <Border.Styles>
                                        <Style Selector="Border.table-row:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                                        </Style>
                                    </Border.Styles>
                                    <!-- NOTE: ColumnDefinitions must match the table header Grid above -->
                                    <Grid ColumnDefinitions="2*, 3*, 1.5*, 1.2*, 1.6*" MinHeight="46">

                                        <!-- Job Name -->
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center" Margin="{StaticResource SpacingHMd}"
                                                   FontSize="13"
                                                   FontFamily="{DynamicResource NotoSansJP-Semibold}" />

                                        <!-- Description -->
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   VerticalAlignment="Center" Margin="{StaticResource SpacingHMd}"
                                                   FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Progress -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="{StaticResource SpacingHMd}">
                                            <!-- Progress bar: two stacked borders -->
                                            <Grid Height="5" Margin="{StaticResource SpacingBXs}">
                                                <!-- Background track -->
                                                <Border CornerRadius="{StaticResource CornerSm}" Background="{DynamicResource CardBorderSubtle}" />
                                                <!-- Foreground fill -->
                                                <Border x:CompileBindings="False"
                                                        CornerRadius="{StaticResource CornerSm}" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource JobStatusToProgressBrushConverter}}">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource FractionToWidthConverter}">
                                                            <Binding Path="ProgressFraction" />
                                                            <Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource LabelForeground}" />
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Margin="{StaticResource SpacingHMd}"
                                                Background="{Binding Status, Converter={StaticResource JobStatusToBadgeBackgroundConverter}}"
                                                CornerRadius="{StaticResource CornerPill}" Padding="10 5 12 5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                         Fill="{Binding Status, Converter={StaticResource JobStatusToBadgeForegroundConverter}}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           FontFamily="{DynamicResource NotoSansJP-Semibold}"
                                                           Foreground="{Binding Status, Converter={StaticResource JobStatusToBadgeForegroundConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="4" Text="{Binding DateText}"
                                                   VerticalAlignment="Center" Margin="{StaticResource SpacingHMd}"
                                                   FontSize="12" Foreground="{DynamicResource SecondaryForeground}" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>
