<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="pages:ActionsPageViewModel"
             x:Class="BatchProcess3.Views.Actions.ActionSaveModelView"
             xmlns:design="clr-namespace:BatchProcess3.Design"
             xmlns:pages="clr-namespace:BatchProcess3.ViewModels.Pages"
             xmlns:actions="clr-namespace:BatchProcess3.ViewModels.Actions"
             d:DataContext="{x:Static design:DesignData.ActionsPageViewModel}">

    <Grid ColumnDefinitions="*, 30, 3*">
        <!-- Save Model List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2" Content="Save Model Actions" />
            <TextBlock Grid.Row="2"
                       Text="Save Model actions can be used to export models in various formats."
                       TextWrapping="Wrap" Margin="0 -10 0 10" />
            <Button Grid.Row="4" Classes="small outline" Content="New Save Model Action"
                    Command="{Binding SaveModelList.AddNewItemCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6"
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding SaveModelList.List}"
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding SaveModelList.SelectedItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="actions:ActionSaveModelViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}"
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((pages:ActionsPageViewModel)DataContext).SaveModelList.DeleteItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Opacity="{Binding !SaveModelList.HasItems}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="Save Model actions can be used to export models in various formats."
                       HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Save Model Action." HorizontalAlignment="Center" />
            <Button Content="New Save Model Action" HorizontalAlignment="Center"
                    Command="{Binding SaveModelList.AddNewItemCommand}"
                    Margin="20" />
        </StackPanel>

        <Grid Grid.Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding SaveModelList.HasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10 *">
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the Save Model job." Margin="0 -10 0 10" />

                <Grid Grid.Row="4" ColumnDefinitions="120, 10, 20, 5, *"
                      RowDefinitions="Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto">

                    <!-- Job Name -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="4"
                             Text="{Binding  SaveModelList.SelectedItem.JobName}" />

                    <!-- Description -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="4" AcceptsReturn="True"
                             Text="{Binding  SaveModelList.SelectedItem.Description}" Height="80" TextWrapping="Wrap" />

                    <!-- Filename -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Filename" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="4"
                             Text="{Binding  SaveModelList.SelectedItem.FileName}" />

                    <!-- Save Location -->
                    <Label Grid.Row="6" Grid.Column="0" Content="Save Location" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="4"
                             Text="{Binding  SaveModelList.SelectedItem.SaveLocation}" />

                    <!-- Save All Configurations -->
                    <Label Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"
                           Classes="icon-only icon-outline subtle-hover"
                           Content="&#xE3E8;"
                           ToolTip.Tip="Saves the model for every configuration as a separate file." />
                    <CheckBox Grid.Row="8" Grid.Column="4" Content="Save All Configs"
                              IsChecked="{Binding  SaveModelList.SelectedItem.SaveAllConfigurations}" />

                </Grid>
            </Grid>

            <!-- Details Column -->
            <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, *, 10, 40">
                <Label Grid.Row="0" Classes="h2" Content="Save As Formats" />
                <TextBlock Grid.Row="2" TextWrapping="Wrap"
                           Text="Select all the formats you wish to export the model files to." Margin="0 -10 0 10" />

                <!-- Export Formats -->
                <ScrollViewer Grid.Row="4">
                    <ItemsControl ItemsSource="{Binding SaveModelList.SelectedItem.ExportFormats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    IsChecked="{Binding Value}"
                                    Content="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="6"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="10"
                            Opacity="{Binding SaveModelList.SelectedItem.HasChanged, FallbackValue=0}">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                                </Transitions>
                            </Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Cancel" Classes="outline" Command="{Binding SaveModelList.CancelItemCommand}" />
                    <Button Content="Save" Classes="success" Command="{Binding SaveModelList.SaveItemCommand}" />
                </StackPanel>
            </Grid>

        </Grid>

    </Grid>
</UserControl>