<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="vm:ActionsPageViewModel"
             x:Class="BatchProcess3.Views.ActionsTabImportFileView">

    <Design.DataContext>
        <vm:ActionsPageViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, 30, 3*">
        <!-- Import File List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2" Content="Import File Actions" />
            <TextBlock Grid.Row="2"
                       Text="Import File actions can import various file formats using custom arguments."
                       TextWrapping="Wrap" Margin="0 -10 0 10" />
            <Button Grid.Row="4" Classes="small outline" Content="New Import File Action"
                    Command="{Binding AddNewImportFileItemCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6"
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding ImportFileList}"
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding SelectedImportFileListItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionImportFileViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}"
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).DeleteImportFileItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Opacity="{Binding !ImportFileListHasItems}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="Import File actions can import various file formats using custom arguments."
                       HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Import File Action." HorizontalAlignment="Center" />
            <Button Content="New Import File Action" HorizontalAlignment="Center"
                    Command="{Binding AddNewImportFileItemCommand}"
                    Margin="20" />
        </StackPanel>

        <Grid Grid.Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding ImportFileListHasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10 *">
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the Import File job." Margin="0 -10 0 10" />

                <Grid Grid.Row="4" ColumnDefinitions="120, 10, 20, 5, *"
                      RowDefinitions="Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto">

                    <!-- Job Name -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="4"
                             Text="{Binding  SelectedImportFileListItem.JobName}" />

                    <!-- Description -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="4" AcceptsReturn="True"
                             Text="{Binding  SelectedImportFileListItem.Description}" Height="80" TextWrapping="Wrap" />

                    <!-- Filename -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Filename" />
                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding  SelectedImportFileListItem.FileName}" />

                    <!-- Save Location -->
                    <Label Grid.Row="6" Grid.Column="0" Content="Save Location" />
                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding  SelectedImportFileListItem.SaveLocation}" />

                    <!-- Import Arguments -->
                    <Label Grid.Row="8" Grid.Column="0" Content="Import Arguments" Grid.ColumnSpan="2" />
                    <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding  SelectedImportFileListItem.ImportArguments}" />

                    <!-- Add to Project -->
                    <Label Grid.Row="10" Grid.Column="2" VerticalAlignment="Center"
                           Classes="icon-only icon-outline subtle-hover"
                           Content="&#xE3E8;"
                           ToolTip.Tip="Add imported file to project list once imported" />
                    <CheckBox Grid.Row="10" Grid.Column="4" Content="Add to Project"
                              IsChecked="{Binding  SelectedImportFileListItem.AddToProject}" />

                </Grid>
            </Grid>

            <!-- Details Column -->
            <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
                <!-- <Label Grid.Row="0" Classes="h2" Content="Details" /> -->
                <!-- <TextBlock Grid.Row="2" Text="Specify the additional details." Margin="0 -10 0 10" /> -->

                <!-- Extra details here -->

                <StackPanel Grid.Row="6"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="10"
                            Opacity="{Binding SelectedImportFileListItem.HasChanged, FallbackValue=0}">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                                </Transitions>
                            </Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Cancel" Classes="outline" Command="{Binding CancelImportFileItemCommand}" />
                    <Button Content="Save" Classes="success" Command="{Binding SaveImportFileItemCommand}" />
                </StackPanel>
            </Grid>

        </Grid>

    </Grid>
</UserControl>