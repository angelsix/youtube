<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="vm:ActionsPageViewModel"
             x:Class="BatchProcess3.Views.ActionPrintView"
             xmlns:design="clr-namespace:BatchProcess3.Design"
             d:DataContext="{x:Static design:DesignData.ActionsPageViewModel}">

    <Grid ColumnDefinitions="*, 30, 3*">
        <!-- Print List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2" Content="Print Actions" />
            <TextBlock Grid.Row="2" Text="Print actions can be used to print drawings or models to specific printers with specific settings." TextWrapping="Wrap" Margin="0 -10 0 10"></TextBlock>
            <Button Grid.Row="4" Classes="small outline" Content="New Print Action" Command="{Binding PrintList.AddNewItemCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6" 
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding PrintList.List}" 
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding PrintList.SelectedItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionPrintViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}" 
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).PrintList.DeleteItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
        </Grid>
        
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Opacity="{Binding !PrintList.HasItems}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="Print actions can be used to print drawings and models with specific printer settings." HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Print Action." HorizontalAlignment="Center" />
            <Button Content="New Print Action" HorizontalAlignment="Center" Command="{Binding PrintList.AddNewItemCommand}" Margin="20" />
        </StackPanel>
        
        <Grid Grid.Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding PrintList.HasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10 *">
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the print job." Margin="0 -10 0 10" />
                <Grid Grid.Row="4" ColumnDefinitions="140, 15, *" RowDefinitions="Auto, 15, Auto, 15, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="2" Text="{Binding  PrintList.SelectedItem.JobName}" />
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="2" AcceptsReturn="True" Text="{Binding  PrintList.SelectedItem.Description}" Height="80" TextWrapping="Wrap" />
                    <Label Grid.Row="4" Grid.Column="0" Content="Print" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <CheckBox Content="Models" IsChecked="{Binding PrintList.SelectedItem.PrintModels}" />
                        <CheckBox Content="Drawings" IsChecked="{Binding PrintList.SelectedItem.PrintDrawings}" />
                    </StackPanel>
                </Grid>
                
                <Label Grid.Row="6" Classes="h2" Content="Printer Settings" />
                <TextBlock Grid.Row="8" Text="Selects the profiles to use for paper sizes" Margin="0 -10 0 0" />
                <Button Grid.Row="10" Classes="small outline" Content="New Print Settings" Command="{Binding AddNewPrintSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                <ListBox Grid.Row="12" 
                         ItemsSource="{Binding PrinterSettings}" 
                         SelectedValueBinding="{Binding Id}"
                         SelectedValue="{Binding PrintList.SelectedItem.PrinterSettingsId}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionPrintSettingsViewModel">
                            <Grid ColumnDefinitions="*, 10, Auto, 10, Auto">
                                
                                <StackPanel>
                                    <Label FontWeight="Black" Content="{Binding Name}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Description}" />
                                </StackPanel>
                                
                                <Panel Grid.Column="2" IsVisible="{Binding CanEdit}">
                                    <Button Margin="0 -4 -4 -6"
                                            Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).EditPrintSettingsCommand}"
                                            CommandParameter="{Binding Id}"
                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                            VerticalAlignment="Center"
                                            Classes="smaller alert">
                                        <Label Classes="icon-only icon-outline" Content="&#xe3b2;" />
                                    </Button>
                                </Panel>
                                
                                <Panel Grid.Column="4" IsVisible="{Binding CanDelete}">
                                    <Button Margin="0 -4 -4 -6"
                                            Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).DeletePrintSettingsCommand}"
                                            CommandParameter="{Binding Id}"
                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                            VerticalAlignment="Center"
                                            Classes="smaller danger">
                                        <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                                    </Button>
                                </Panel>
                            </Grid>
                            
                        </DataTemplate>
                        
                    </ListBox.ItemTemplate>
                    
                </ListBox>
                
            </Grid>
            
            <!-- Drawings Column -->
            <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
                <Label Grid.Row="0" Classes="h2" Content="Drawings" />
                <TextBlock Grid.Row="2" Text="Set the properties that apply only to drawings." Margin="0 -10 0 10" />
                <Grid Grid.Row="4" ColumnDefinitions="140, 15, *" RowDefinitions="Auto, 15, Auto, 15, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Content="Print Range" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding  PrintList.SelectedItem.PrintDrawingRange}" />
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                        <ToggleButton 
                            IsChecked="{Binding PrintList.SelectedItem.DrawingExclusionIsWhiteList}" 
                            Content="{Binding PrintList.SelectedItem.DrawingExclusionListTitle}"
                            VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding  PrintList.SelectedItem.DrawingExclusionList}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
                </Grid>
                
                <StackPanel Grid.Row="6" 
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Right" 
                            Orientation="Horizontal" 
                            Spacing="10"
                            Opacity="{Binding PrintList.SelectedItem.HasChanged, FallbackValue=0}">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                                </Transitions>
                            </Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Cancel" Classes="outline" Command="{Binding PrintList.CancelItemCommand}"></Button>
                    <Button Content="Save" Classes="success" Command="{Binding PrintList.SaveItemCommand}"></Button>
                </StackPanel>
            </Grid>
    
        </Grid>
        
    </Grid>
</UserControl>
