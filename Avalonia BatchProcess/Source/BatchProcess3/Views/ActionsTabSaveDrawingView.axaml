<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="vm:ActionsPageViewModel"
             x:Class="BatchProcess3.Views.ActionsTabSaveDrawingView">

    <Design.DataContext>
        <vm:ActionsPageViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, 30, 3*">
        <!-- Save Drawing List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2" Content="Save Drawing Actions" />
            <TextBlock Grid.Row="2"
                       Text="Save Drawing actions can be used to export drawings in various formats."
                       TextWrapping="Wrap" Margin="0 -10 0 10" />
            <Button Grid.Row="4" Classes="small outline" Content="New Save Drawing Action"
                    Command="{Binding AddNewSaveDrawingItemCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6"
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding SaveDrawingList}"
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding SelectedSaveDrawingListItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionsTabSaveDrawingViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}"
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).DeleteSaveDrawingItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Opacity="{Binding !SaveDrawingListHasItems}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="Save Drawing actions can be used to export drawings in various formats."
                       HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Save Drawing Action." HorizontalAlignment="Center" />
            <Button Content="New Save Drawing Action" HorizontalAlignment="Center"
                    Command="{Binding AddNewSaveDrawingItemCommand}"
                    Margin="20" />
        </StackPanel>

        <Grid Grid.Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding SaveDrawingListHasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10 *">
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the Save Drawing job." Margin="0 -10 0 10" />

                <Grid Grid.Row="4" ColumnDefinitions="110, 10, 25, 15, *"
                      RowDefinitions="Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto">

                    <!-- Job Name -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="4"
                             Text="{Binding  SelectedSaveDrawingListItem.JobName}" />

                    <!-- Description -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="4" AcceptsReturn="True"
                             Text="{Binding  SelectedSaveDrawingListItem.Description}" Height="80" TextWrapping="Wrap" />

                    <!-- Filename -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Filename" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="4"
                             Text="{Binding  SelectedSaveDrawingListItem.FileName}" />

                    <!-- Save Location -->
                    <Label Grid.Row="6" Grid.Column="0" Content="Save Location" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="4"
                             Text="{Binding  SelectedSaveDrawingListItem.SaveLocation}" />

                    <!-- Sheets Filter -->
                    <Label Grid.Row="8" Grid.Column="0" Content="Sheets Filter" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8" Grid.Column="4"
                             Text="{Binding  SelectedSaveDrawingListItem.SheetsFilter}" />

                    <!-- Single PDF -->
                    <Label Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Content="Single PDF" />
                    <Label Grid.Row="10" Grid.Column="2" VerticalAlignment="Center"
                           Classes="icon-only icon-outline subtle-hover"
                           Content="&#xE3E8;"
                           ToolTip.Tip="When saving a PDF save all sheets to a single PDF" />
                    <CheckBox Grid.Row="10" Grid.Column="4"
                              IsChecked="{Binding  SelectedSaveDrawingListItem.SinglePdf}" />

                    <!-- Single eDrawing -->
                    <Label Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" Content="Single eDrawing" />
                    <Label Grid.Row="12" Grid.Column="2" VerticalAlignment="Center"
                           Classes="icon-only icon-outline subtle-hover"
                           Content="&#xE3E8;"
                           ToolTip.Tip="When saving an eDrawing save all sheets to a single eDrawing" />
                    <CheckBox Grid.Row="12" Grid.Column="4"
                              IsChecked="{Binding  SelectedSaveDrawingListItem.SingleEDrawing}" />

                    <!-- Single DWG/DF -->
                    <Label Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Content="Single DWG/DXF" />
                    <Label Grid.Row="14" Grid.Column="2" VerticalAlignment="Center"
                           Classes="icon-only icon-outline subtle-hover"
                           Content="&#xE3E8;"
                           ToolTip.Tip="When saving a DWG or DXF save all sheets to a single file" />
                    <CheckBox Grid.Row="14" Grid.Column="4"
                              IsChecked="{Binding  SelectedSaveDrawingListItem.SingleDwgDxf}" />

                </Grid>
            </Grid>

            <!-- Details Column -->
            <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
                <Label Grid.Row="0" Classes="h2" Content="Save As Formats" />
                <TextBlock Grid.Row="2" TextWrapping="Wrap"
                           Text="Select all the formats you wish to export the drawing files to." Margin="0 -10 0 10" />

                <!-- Export Formats -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding SelectedSaveDrawingListItem.ExportFormats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                IsChecked="{Binding Value}"
                                Content="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="6"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="10"
                            Opacity="{Binding SelectedSaveDrawingListItem.HasChanged, FallbackValue=0}">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                                </Transitions>
                            </Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Cancel" Classes="outline" Command="{Binding CancelSaveDrawingItemCommand}" />
                    <Button Content="Save" Classes="success" Command="{Binding SaveSaveDrawingItemCommand}" />
                </StackPanel>
            </Grid>

        </Grid>

    </Grid>
</UserControl>