<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="vm:ActionsPageViewModel"
             x:Class="BatchProcess3.Views.ActionDrawingTemplateView">

    <Design.DataContext>
        <vm:ActionsPageViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, 30, 3*">

        <!-- Drawing Template List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2">
                <TextBlock TextWrapping="Wrap" Text="Drawing Template Actions" />
            </Label>
            <TextBlock Grid.Row="2"
                       Text="Drawing Template actions can be used to update, set or replace the sheet templates of a drawing."
                       TextWrapping="Wrap" Margin="0 -10 0 10" />
            <Button Grid.Row="4" Classes="small outline" Content="New Drawing Template Action"
                    Command="{Binding DrawingTemplateList.AddNewItemCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6"
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding DrawingTemplateList.List}"
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding DrawingTemplateList.SelectedItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionDrawingTemplateViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}"
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((vm:ActionsPageViewModel)DataContext).DrawingTemplateList.DeleteItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>
        
        <StackPanel ZIndex="10" Name="NewActionStack" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Opacity="{Binding !DrawingTemplateList.HasItems}"
                    IsVisible="{Binding #NewActionStack.Opacity}"
                    >
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock
                Text="Drawing Template actions can be used to update, set or replace the sheet templates of a drawing."
                HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Drawing Template Action." HorizontalAlignment="Center" />
            <Button Content="New Drawing Template Action" HorizontalAlignment="Center"
                    Command="{Binding DrawingTemplateList.AddNewItemCommand}"
                    Margin="20" />
        </StackPanel>

        <Grid Grid.Column="2" 
              ColumnDefinitions="*, 30, *" 
              RowDefinitions="Auto, *, 10, Auto"
              Opacity="{Binding DrawingTemplateList.HasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto">
                
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the Drawing Template job." Margin="0 -10 0 10" />

                <Grid Grid.Row="4" ColumnDefinitions="140, 15, *"
                      RowDefinitions="Auto, 15, Auto, 15, Auto, 15, Auto, 15, Auto">

                    <!-- Job Name -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="2"
                             Text="{Binding  DrawingTemplateList.SelectedItem.JobName}" />
 
                    <!-- Description -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="2" AcceptsReturn="True"
                             Text="{Binding  DrawingTemplateList.SelectedItem.Description}" Height="80"
                             TextWrapping="Wrap" />

                </Grid>
            </Grid>
            
            <Grid Grid.Column="2" ColumnDefinitions="Auto, 30, *" 
                  RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, Auto">
                
                    <Label Grid.Row="0" Classes="h2" Content="Operation" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Specify the type of operation to perform." Margin="0 -10 0 10" />

                    <!-- Operation -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Operation" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="2"
                              ItemsSource="{Binding DrawingTemplateOperations}"
                              SelectedItem="{Binding DrawingTemplateList.SelectedItem.Operation}"
                              HorizontalAlignment="Stretch"
                               />

                    <!-- Current Template -->
                    <Label Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 0 10"
                           IsVisible="{Binding DrawingTemplateList.SelectedItem.CurrentTemplatePathIsVisible}"
                           Content="Current Template" />
                    <ComboBox Grid.Row="6" Grid.Column="2" Margin="0 0 0 10"
                              IsVisible="{Binding DrawingTemplateList.SelectedItem.CurrentTemplatePathIsVisible}"
                              ItemsSource="{Binding DrawingTemplatePaths}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="{Binding DrawingTemplateList.SelectedItem.CurrentTemplatePath}"
                              SelectedItem="{Binding DrawingTemplateList.SelectedItem.CurrentTemplatePath}">
                        
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Label ToolTip.Tip="{Binding }" Content="{Binding Converter={StaticResource FilenameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        
                    </ComboBox>

                    <!-- New Template -->
                    <Label Grid.Row="7" Grid.Column="0"
                           IsVisible="{Binding DrawingTemplateList.SelectedItem.NewTemplatePathIsVisible}"
                           Content="New Template" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="7" Grid.Column="2"
                              IsVisible="{Binding DrawingTemplateList.SelectedItem.NewTemplatePathIsVisible}"
                              ItemsSource="{Binding DrawingTemplatePaths}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="{Binding DrawingTemplateList.SelectedItem.NewTemplatePath}"
                              SelectedItem="{Binding DrawingTemplateList.SelectedItem.NewTemplatePath}">
                        
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Label ToolTip.Tip="{Binding }" Content="{Binding Converter={StaticResource FilenameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
            </Grid>
            
            <!-- Manage Templates -->
            <Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" RowDefinitions="Auto, 10, *">
                
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" RowDefinitions="Auto, 10, Auto">
                    <!-- Manage Templates -->
                    <Label Grid.Column="0" Classes="h2" Content="Manage Templates" />
                    <TextBlock Grid.Column="0" Grid.Row="2" TextWrapping="Wrap"
                               Text="Manage the template locations that are available for Drawing Template Jobs."
                               Margin="0 -10 0 10" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    
                        <!-- Add Templates -->
                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding AddDrawingTemplatePathsCommand}"
                            Classes="small">
                            <Label Classes="icon-only icon-outline" Content="&#xE3d4;" />
                        </Button>
                    
                        <!-- Delete -->
                        <Button
                            VerticalAlignment="Center"
                            IsEnabled="{Binding DrawingTemplateSelectedPaths.Count}"
                            Command="{Binding DeleteDrawingTemplatePathsCommand}"
                            Classes="small danger">
                            <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                        </Button>
                    
                    </StackPanel>

                </Grid>

                <ListBox Grid.Row="2" Name="DrawingTemplateListBox"
                         ItemsSource="{Binding DrawingTemplatePaths}"
                         SelectedItems="{Binding DrawingTemplateSelectedPaths}"
                         SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                         SelectionMode="Multiple" />

            </Grid>
            
            <!-- Save / Cancel Buttons -->
            <StackPanel Grid.Column="2" Grid.Row="3"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10"
                        Opacity="{Binding DrawingTemplateList.SelectedItem.HasChanged, FallbackValue=0}">
                <StackPanel.Styles>
                    <Style Selector="StackPanel">
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                            </Transitions>
                        </Setter>
                    </Style>
                </StackPanel.Styles>
                <Button Content="Cancel" Classes="outline" Command="{Binding DrawingTemplateList.CancelItemCommand}" />
                <Button Content="Save" Classes="success" Command="{Binding DrawingTemplateList.SaveItemCommand}" />
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>