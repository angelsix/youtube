<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BatchProcess3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Background="{DynamicResource PrimaryBackground}"
             Foreground="{DynamicResource PrimaryForeground}"
             x:DataType="vm:ProcessPageViewModel"
             x:Class="BatchProcess3.Views.ProcessPageView">
    
    
    <Design.DataContext><vm:ProcessPageViewModel></vm:ProcessPageViewModel></Design.DataContext>
    
    <Grid ColumnDefinitions="*" RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Name="HeaderGrid">
            <StackPanel Height="100" ClipToBounds="True">
                <Image Source="{SvgImage /Assets/Images/background-actions.svg}" Stretch="UniformToFill" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Classes="h1" HorizontalAlignment="Center" Content="Processes" />
                <Label Classes="sub2" HorizontalAlignment="Center"
                       Content="Create and manage all processes that can be used in a job" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="25">
            <Grid ColumnDefinitions="*, 30, 3*">
        <!-- Print List Column -->
        <Grid RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
            <Label Classes="h2" Content="Processes" />
            <TextBlock Grid.Row="2" Text="A list of processes. Each process is a set of actions to be performed on each file in a job." TextWrapping="Wrap" Margin="0 -10 0 10"></TextBlock>
            <Button Grid.Row="4" Classes="small outline" Content="New Process" Command="{Binding AddNewProcessCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ListBox Grid.Row="6" 
                     SelectionChanged="SelectingItemsControl_OnSelectionChanged"
                     ItemsSource="{Binding ProcessList}" 
                     SelectedValueBinding="{Binding Id}"
                     SelectedValue="{Binding SelectedProcessListItemId}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProcessViewModel">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   FontWeight="{Binding HasChanged, Converter={StaticResource BooleanToBoldFontConverter}}"
                                   Content="{Binding JobName}" 
                                   VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Margin="0 -4 -4 -6"
                                    Command="{Binding $parent[ListBox].((vm:ProcessPageViewModel)DataContext).DeleteProcessItemCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    VerticalAlignment="Center"
                                    Classes="smaller danger">
                                <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
        </Grid>
        
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Opacity="{Binding !ProcessListHasItems}">
            <StackPanel.Styles>
                <Style Selector="StackPanel">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                        </Transitions>
                    </Setter>
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="Processes can be used to run a set of actions on a set of files." HorizontalAlignment="Center" />
            <TextBlock Text="To get started, create a new Process." HorizontalAlignment="Center" />
            <Button Content="New Process" HorizontalAlignment="Center" Command="{Binding AddNewProcessCommand}" Margin="20" />
        </StackPanel>
        
        <Grid Grid.Column="2" ColumnDefinitions="*, 30, *" Opacity="{Binding ProcessListHasItems}">
            <Grid.Styles>
                <Style Selector="Grid">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                        </Transitions>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!-- General Settings Column -->
            <Grid Grid.Column="0" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10, Auto, 10 *">
                <Label Classes="h2" Content="General Settings" />
                <TextBlock Grid.Row="2" Text="Set the main properties of the process." Margin="0 -10 0 10" />
                <Grid Grid.Row="4" ColumnDefinitions="140, 15, *" RowDefinitions="Auto, 15, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Content="Job Name" VerticalAlignment="Center" />
                    <TextBox Name="JobNameTextBox" Grid.Row="0" Grid.Column="2" Text="{Binding  SelectedProcessListItem.JobName}" />
                    <Label Grid.Row="2" Grid.Column="0" Content="Description" />
                    <TextBox Grid.Row="2" Grid.Column="2" AcceptsReturn="True" Text="{Binding  SelectedProcessListItem.Description}" Height="80" TextWrapping="Wrap" />
                </Grid>
                
                <Label Grid.Row="6" Classes="h2" Content="Actions List" />
                <TextBlock Grid.Row="8" Text="Selects the actions to be used in this process." Margin="0 -10 0 0" />

                <ListBox Grid.Row="12" 
                         ItemsSource="{Binding SelectedProcessListItem.Actions}" 
                         SelectedValueBinding="{Binding Id}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionViewModel">
                            <Grid ColumnDefinitions="*, 10, Auto">
                                
                                <Label FontWeight="Black" 
                                       Content="{Binding JobName}"
                                       ToolTip.Tip="{Binding Description}"
                                       />
                                
                                <Panel Grid.Column="2">
                                    <Button Margin="0 -4 -4 -6"
                                            Command="{Binding $parent[ListBox].((vm:ProcessPageViewModel)DataContext).DeleteSelectedProcessActionCommand}"
                                            CommandParameter="{Binding SortOrder}"
                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                            VerticalAlignment="Center"
                                            Classes="smaller danger">
                                        <Label Classes="icon-only icon-outline" Content="&#xe4a6;" />
                                    </Button>
                                </Panel>
                            </Grid>
                            
                        </DataTemplate>
                        
                    </ListBox.ItemTemplate>
                    
                </ListBox>
                
            </Grid>
            
            <!-- Available Actions Column -->
            <Grid Grid.Column="2" RowDefinitions="Auto, 10, Auto, 10, Auto, 10, *">
                <Label Grid.Row="0" Classes="h2" Content="Available Actions" />
                <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="Select the actions you would like to add to the process and click Add or Drag-and-Drop onto the list." Margin="0 -10 0 10" />
                
                <StackPanel Grid.Row="6" 
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Right" 
                            Orientation="Horizontal" 
                            Spacing="10"
                            Opacity="{Binding SelectedProcessListItem.HasChanged, FallbackValue=0}">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"></DoubleTransition>
                                </Transitions>
                            </Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Cancel" Classes="outline" Command="{Binding CancelProcessItemCommand}"></Button>
                    <Button Content="Save" Classes="success" Command="{Binding SaveProcessItemCommand}"></Button>
                </StackPanel>
            </Grid>
    
        </Grid>
        
    </Grid>
        </Border>
    </Grid>
    
</UserControl>
