                        </StackPanel>
                        
                        <Button.Styles>
                            <Style Selector="Button.active /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="Orange"></Setter>
                            </Style>
                            <Style Selector="Button.active Viewbox Path">
                                <Setter Property="Fill" Value="Orange"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover Viewbox Path">
                                <Setter Property="Fill" Value="Orange"></Setter>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <!-- Button: V AC -->
                    <Button Grid.Row="4" Grid.Column="0" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            BorderThickness="2"
                            CornerRadius="15"
                            Background="Transparent">
