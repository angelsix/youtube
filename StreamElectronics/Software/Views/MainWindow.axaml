                                <Setter Property="Fill" Value="Red"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover Viewbox Path">
                                <Setter Property="Fill" Value="Red"></Setter>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
