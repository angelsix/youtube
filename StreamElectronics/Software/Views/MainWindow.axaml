<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StreamElectronics.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="420"
        Width="1000" Height="420"
        MinWidth="1000" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        x:Class="StreamElectronics.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Foreground="{DynamicResource PrimaryForeground}"
        Icon="/Assets/bolt-icon.ico"
        Title="Stream Electronics">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding InitalizeCommand}"></InvokeCommandAction>
        </EventTriggerBehavior>
    </Interaction.Behaviors>
    
    <Window.Styles>
        <Style Selector="Button Viewbox Path">
            <Setter Property="Fill" Value="#7c7c7c"></Setter>
        </Style>
        <Style Selector="Button.pending /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#7c7c7c"></Setter>
        </Style>
    </Window.Styles>

    <Border Padding="40">
        <Grid ShowGridLines="False" RowDefinitions="Auto, 30, *" ColumnDefinitions="23*, 30, 19*">

            <!-- Header Stack -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="20" Orientation="Horizontal">
                
                <!-- Header Icon -->
                <Image Source="{SvgImage /Assets/Bolt Icon.svg}" Width="60" />
                
                <!-- Header Text -->
                <StackPanel Spacing="10" Orientation="Vertical">
                    <Label Content="Stream Electronics" FontSize="40" FontWeight="Black" Margin="-10 -12 -10 -8" Padding="0" />
                    <Label Content="Live Stream Overlays for your Electronic Equipment" FontSize="16" FontStyle="Italic" FontWeight="Light" Margin="-10 -5" Padding="0" />
                </StackPanel>
                
            </StackPanel>
            
            <!-- VISA Textbox + Checkbox -->
            <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*, 10, Auto" VerticalAlignment="Bottom">
                <TextBox Grid.Column="0" Watermark="Enter VISA ID of instrument..." Height="40" Text="{Binding VisaId}">
                </TextBox>
                <ToggleButton Name="IsEnabledToggle" Grid.Column="2" Height="40" IsChecked="{Binding IsEnabled}">
                    <Interaction.Behaviors>
                        <PropertyChangedTrigger Binding="{Binding #IsEnabledToggle.IsChecked}">
                            <InvokeCommandAction Command="{Binding EnabledChangedCommand}" />
                        </PropertyChangedTrigger>
                    </Interaction.Behaviors>
                </ToggleButton>
            </Grid>
            
            <!-- Stream Overlay -->
            <Border Grid.Row="2" Grid.Column="0" 
                    Background="#dd000000" CornerRadius="60"
                    BorderBrush="Yellow" BorderThickness="2"
                    Padding="30">
                
                <!-- Stream Overlay Inner Grid -->
                <Grid RowDefinitions="Auto, *" 
                      ColumnDefinitions="*, Auto"
                      HorizontalAlignment="Center">
                    
                    <!-- Stream Overlay Title -->
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Content="MULTIMETER" HorizontalAlignment="Center" FontStyle="Italic" FontSize="30" FontWeight="Black" />
                    
                    <!-- Stream Overlay Big Text -->
                    <Viewbox Grid.Row="1" Grid.Column="0" Margin="0 20 0 20">
                        <Label Content="5.102" FontWeight="Black"
                               Padding="0" Margin="0 -5 0 -3" FontSize="14"
                               Foreground="Yellow"/>
                    </Viewbox>
                    
                    <!-- Stream Overlay Right Small Text -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="10" Margin="15 0 0 0">
                        <Label Content="V" HorizontalAlignment="Center" FontSize="70" FontWeight="Black" Padding="0" Margin="0 -25" />
                        <Label Content="DC" HorizontalAlignment="Center" FontSize="30" FontWeight="Black" Padding="0" Margin="0 0" />
                    </StackPanel>
                </Grid>
                
            </Border>
            
            <!-- Button Control Container -->
            <Border Grid.Row="2" Grid.Column="2" Background="#1C1C35" CornerRadius="20">
                
                <!-- Button Control Grid -->
                <Grid ColumnDefinitions="*, 10, *, 10, *, 10, *, 10, *"
                      RowDefinitions="Auto, 30, *, 10, *"
                      Margin="25">
                    
                    <!-- Header Stack -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="9" Grid.Column="0" ColumnDefinitions="*, 30, Auto">
                
                        <!-- Header Text -->
                        <StackPanel Spacing="10" Orientation="Vertical">
                            <Label Content="RIGOL DM3068" FontSize="25" FontWeight="Black" Margin="0 -6 -10 -8" Padding="0" />
                            <Label Content="Click below to change mode" FontSize="12" FontStyle="Italic" FontWeight="Light" Margin="0 -5" Padding="0" />
                        </StackPanel>
                
                        <!-- Header Pill -->
                        <Border Grid.Column="2" Background="{Binding StatusBrush}" Padding="8 2" CornerRadius="10" VerticalAlignment="Center">
                            <Label Content="{Binding ConnectedStatus}" Foreground="Black" FontWeight="Black" Padding="0" Margin="0" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    
                    <!-- Button: V DC -->
                    <Button Grid.Row="2" Grid.Column="0" Classes="active"
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            BorderThickness="2"
                            CornerRadius="15"
                            Background="Transparent">
                        <StackPanel>
                            <Viewbox>
                                <Path Width="2048" Height="2048" Data="M1685.301,685.488C1700.744,685.488 1715.159,693.225 1723.694,706.095C1732.229,718.964 1733.747,735.254 1727.739,749.48L1237.442,1910.333C1230.238,1927.391 1213.52,1938.477 1195.004,1938.477L852.996,1938.477C834.48,1938.477 817.762,1927.391 810.558,1910.333L320.261,749.48C314.253,735.254 315.771,718.964 324.306,706.094C332.841,693.225 347.257,685.487 362.699,685.488L662.924,685.488C681.843,685.487 698.838,697.054 705.78,714.653L986.313,1425.905C993.255,1443.504 1010.25,1455.07 1029.168,1455.07C1048.086,1455.07 1065.082,1443.504 1072.023,1425.905L1352.557,714.653C1359.498,697.054 1376.493,685.488 1395.411,685.488L1685.301,685.488ZM1754.767,181.515L1754.767,325.498C1754.767,365.232 1722.508,397.49 1682.775,397.49L365.225,397.49C325.492,397.49 293.233,365.232 293.233,325.498L293.233,181.515C293.233,141.781 325.492,109.523 365.225,109.523L1682.775,109.523C1722.508,109.523 1754.767,141.781 1754.767,181.515Z" />
                            </Viewbox>
                        </StackPanel>
                        
                        <Button.Styles>
                            <Style Selector="Button.active /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="Yellow"></Setter>
                            </Style>
                            <Style Selector="Button.active Viewbox Path">
                                <Setter Property="Fill" Value="Yellow"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover Viewbox Path">
                                <Setter Property="Fill" Value="Yellow"></Setter>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <!-- Button: I DC -->
                    <Button Grid.Row="2" Grid.Column="2"
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            BorderThickness="2"
                            CornerRadius="15"
                            Background="Transparent">
                        <StackPanel>
                            <Viewbox>
                                <Path Width="2048" Height="2048" Data="M1645.864,1828.772C1645.864,1857.861 1634.864,1885.77 1615.25,1906.342C1595.609,1926.914 1569,1938.48 1541.267,1938.48L506.731,1938.48C478.998,1938.48 452.389,1926.914 432.775,1906.342C413.134,1885.77 402.134,1857.861 402.134,1828.772L402.134,1781.326C402.134,1752.237 413.134,1724.328 432.775,1703.756C452.389,1683.155 478.998,1671.618 506.731,1671.618L821.292,1671.618C830.564,1671.618 839.452,1667.733 846.035,1660.857C852.591,1653.98 856.267,1644.658 856.267,1634.933L856.267,1058.912C856.267,1049.187 852.591,1039.865 846.035,1032.988C839.452,1026.083 830.564,1022.227 821.292,1022.227L506.731,1022.227C478.998,1022.227 452.389,1010.661 432.775,990.089C413.134,969.516 402.134,941.607 402.134,912.519L402.134,865.073C402.134,835.984 413.134,808.075 432.775,787.503C452.389,766.931 478.998,755.364 506.731,755.364L1541.267,755.364C1569,755.364 1595.609,766.931 1615.25,787.503C1634.864,808.075 1645.864,835.984 1645.864,865.073L1645.864,912.519C1645.864,941.607 1634.864,969.516 1615.25,990.089C1595.609,1010.661 1569,1022.227 1541.267,1022.227L1226.706,1022.227C1217.434,1022.227 1208.546,1026.083 1201.99,1032.988C1195.406,1039.865 1191.731,1049.187 1191.731,1058.912L1191.731,1634.933C1191.731,1644.658 1195.406,1653.98 1201.99,1660.857C1208.546,1667.733 1217.434,1671.618 1226.706,1671.618L1541.267,1671.618C1569,1671.618 1595.609,1683.155 1615.25,1703.756C1634.864,1724.328 1645.864,1752.237 1645.864,1781.326L1645.864,1828.772ZM1738.666,179.919L1738.666,320.73C1738.666,359.602 1707.119,391.136 1668.248,391.136L379.75,391.136C340.879,391.136 309.332,359.602 309.332,320.73L309.332,179.919C309.332,141.076 340.879,109.513 379.75,109.513L1668.248,109.513C1707.119,109.513 1738.666,141.076 1738.666,179.919Z" />
                            </Viewbox>
                        </StackPanel>
                        
                        <Button.Styles>
                            <Style Selector="Button.active /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="MediumPurple"></Setter>
                            </Style>
                            <Style Selector="Button.active Viewbox Path">
                                <Setter Property="Fill" Value="MediumPurple"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover Viewbox Path">
                                <Setter Property="Fill" Value="MediumPurple"></Setter>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <!-- Button: Ohms -->
                    <Button Grid.Row="2" Grid.Column="4" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            BorderThickness="2"
                            CornerRadius="15"
                            Background="Transparent">
                        <StackPanel>
                            <Viewbox>
                                <Path Width="2048" Height="2048" Data="M1918.026,1813.935C1918.026,1846.953 1904.884,1878.623 1881.525,1901.982C1858.214,1925.34 1826.496,1938.482 1793.479,1938.482L1271.285,1938.482C1202.51,1938.482 1146.738,1882.71 1146.738,1813.935L1146.738,1441.178C1146.738,1403.471 1163.828,1367.806 1193.176,1344.169C1217.835,1324.573 1239.196,1306.276 1257.446,1289.326C1286.331,1262.439 1310.757,1232.579 1330.818,1199.655C1354.92,1160.368 1373.123,1118.249 1385.569,1073.343C1398.014,1028.392 1404.237,968.254 1404.237,892.839C1404.237,755.662 1370.151,647.183 1301.934,567.356C1233.763,487.529 1141.119,447.639 1024.003,447.639C910.88,447.639 819.258,486.136 749.044,563.13C678.876,640.171 643.769,750.043 643.769,892.839C643.769,962.635 650.178,1021.797 663.041,1070.325C675.858,1118.853 693.922,1161.993 717.188,1199.655C738.038,1232.579 763.672,1263.228 794.182,1291.741C812.571,1308.923 832.865,1326.476 855.108,1344.402C884.271,1368.038 901.175,1403.563 901.175,1441.085C901.268,1530.2 901.268,1698.026 901.268,1813.935C901.268,1882.71 845.496,1938.482 776.721,1938.482L254.527,1938.482C221.463,1938.482 189.792,1925.34 166.434,1901.982C143.122,1878.623 129.98,1846.953 129.98,1813.935L129.98,1726.121C129.98,1657.3 185.752,1601.575 254.527,1601.575L414.505,1601.575C441.486,1601.575 467.352,1590.848 486.438,1571.762C505.524,1552.722 516.204,1526.81 516.204,1499.876L516.204,1490.96C516.204,1484.876 513.325,1479.164 508.403,1475.542C417.942,1408.904 340.948,1322.576 277.374,1216.512C211.99,1107.429 179.297,985.901 179.297,851.927C179.297,626.518 256.338,446.432 410.326,311.669C564.361,176.906 768.92,109.525 1024.003,109.525C1287.12,109.525 1493.676,177.51 1643.67,313.48C1793.665,449.45 1868.709,628.515 1868.709,850.72C1868.709,990.312 1835.784,1112.258 1770.028,1216.512C1708.544,1313.985 1635.172,1397.387 1549.912,1466.858C1538.442,1476.099 1531.801,1490.031 1531.801,1504.752L1531.755,1504.752C1531.755,1530.432 1541.971,1555.044 1560.129,1573.201C1578.286,1