                        </StackPanel>
                        
                        <Button.Styles>
                            <Style Selector="Button.active /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="BorderBrush" Value="CornflowerBlue"></Setter>
                            </Style>
                            <Style Selector="Button.active Viewbox Path">
                                <Setter Property="Fill" Value="CornflowerBlue"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover Viewbox Path">
                                <Setter Property="Fill" Value="CornflowerBlue"></Setter>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <!-- Button: Continuity -->
                    <Button Grid.Row="2" Grid.Column="6" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" 
                            BorderThickness="2"
                            CornerRadius="15"
                            Background="Transparent">
                        <StackPanel>
                            <Viewbox>
                                <Path Width="2048" Height="2048" Data="M1344.535,1857.13C1346.948,1854.869 1381.39,1822.552 1413.885,1790.064C1509.5,1694.465 1662.942,1513.431 1721.749,1227.384C1805.276,821.105 1623.238,463.449 1420.658,263.701C1395.112,238.513 1373.453,219.656 1356.937,202.614C1344.479,189.76 1334.599,180.869 1335.807,164.582C1337.785,137.962 1358.423,121.793 1381.418,114.34C1409.314,105.299 1442.756,108.393 1466.729,128.692C1555.357,203.738 1771.912,418.371 1853.91,739.299C1892.795,891.492 1892.135,991.65 1889.351,1081.943L1889.339,1082.237C1884.157,1155.259 1868.153,1561.284 1475.115,1911.479C1429.654,1951.985 1374.231,1942.805 1347.534,1911.004C1335.449,1896.608 1332.08,1876.461 1344.535,1857.13ZM1304.682,969.768C1287.568,685.354 1086.804,503.019 1052.104,471.794C1032.892,454.504 1022.968,438.967 1026.437,423.45C1029.669,408.981 1042.087,398.339 1056.404,391.044C1084.017,376.975 1121.641,377.016 1151.091,403.375C1354.238,585.202 1447.159,814.37 1441.857,1038.938C1436.551,1263.517 1333.36,1482.408 1148.236,1643.36C1117.522,1670.062 1077.235,1666.729 1050.083,1648.77C1037.952,1640.744 1027.686,1629.998 1026.228,1616.175C1025.363,1607.969 1028.336,1599.408 1034.1,1590.433C1041.066,1579.589 1067.847,1558.61 1100.374,1524.267C1190.686,1428.902 1322.206,1251.982 1304.682,969.768ZM884.66,1002.409C884.629,1000.524 884.504,998.642 884.286,996.767C881.901,976.239 879.062,859.508 766.669,744.952C764.854,743.102 752.48,734.446 740.691,720.181C732.085,709.765 721.367,693.981 731.34,674.5C747.569,642.791 807.198,619.644 859.261,670.031C969.184,776.414 1015.863,891.969 1020.188,1001.495C1026.643,1164.952 940.761,1313.135 841.861,1390.6C821.428,1406.606 794.357,1407.348 771.203,1399.944C744.057,1391.269 717.475,1370.074 730.472,1339.381C735.018,1328.652 744.216,1321.998 754.311,1312.256C772.15,1295.039 793.504,1274.26 816.079,1241.537C895.197,1126.849 884.906,1017.37 884.66,1002.409ZM553.198,1001.992C553.36,1010.792 554.44,1070.016 531.507,1110.044C427.279,1291.965 151.94,1207.469 157.604,1018.638C164.323,794.725 508.77,749.794 553.198,1001.992Z" />
