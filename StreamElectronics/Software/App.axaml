<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StreamElectronics.App"
             xmlns:local="using:StreamElectronics"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource SegoeUI}" />
        </Style>
        
    </Application.Styles>
             
     <Application.Resources>
         <ResourceDictionary>

             <FontFamily x:Key="SegoeUI">avares://Assets/SegoeUI.ttf</FontFamily>

             <SolidColorBrush x:Key="PrimaryForeground">White</SolidColorBrush>     
             <SolidColorBrush x:Key="PrimaryBorder">#33FFFFFF</SolidColorBrush>     
             <SolidColorBrush x:Key="PrimaryBackground">#0F1024</SolidColorBrush>     

             <ResourceDictionary.MergedDictionaries>
                 <MergeResourceInclude Source="/Controls/TextBox.axaml" />
                 <MergeResourceInclude Source="/Controls/ToggleButton.axaml" />
             </ResourceDictionary.MergedDictionaries>
             
         </ResourceDictionary>

     </Application.Resources>
             
</Application>